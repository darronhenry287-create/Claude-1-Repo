<section class="section">
  <div class="wrap" style="max-width:840px">
    <div class="center" style="margin-bottom:2rem"><span class="eyebrow">Order {{ order.name }}</span><h1 style="margin-top:.6rem">Order details</h1><p class="muted" style="margin-top:.6rem">Placed {{ order.created_at | date: '%B %-d, %Y' }}</p></div>

    <table class="account-table">
      <thead><tr><th>Product</th><th>Qty</th><th>Total</th></tr></thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>{{ line_item.title }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><td colspan="2" style="text-align:right">Subtotal</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
        <tr><td colspan="2" style="text-align:right">Shipping</td><td>{{ order.shipping_price | money }}</td></tr>
        <tr><td colspan="2" style="text-align:right"><strong>Total</strong></td><td><strong>{{ order.total_price | money }}</strong></td></tr>
      </tfoot>
    </table>

    <div class="account-grid" style="margin-top:2.5rem">
      <div><h3 style="margin-bottom:.8rem">Shipping address</h3><p class="muted" style="line-height:1.8">{{ order.shipping_address | format_address }}</p></div>
      <div><h3 style="margin-bottom:.8rem">Billing address</h3><p class="muted" style="line-height:1.8">{{ order.billing_address | format_address }}</p></div>
    </div>

    <p style="margin-top:2.5rem"><a href="{{ routes.account_url }}" class="form__note">← Back to account</a></p>
  </div>
</section>
