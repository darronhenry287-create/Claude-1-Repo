<section class="section">
  <div class="wrap form">
    <div class="center" style="margin-bottom:2rem"><span class="eyebrow">CREO</span><h1 style="margin-top:.8rem">Reset password</h1></div>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label>New password</label><input type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label>Confirm password</label><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn-primary btn-block btn-lg">Reset password</button>
    {%- endform -%}
  </div>
</section>
