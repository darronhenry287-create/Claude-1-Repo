<section style="background:var(--cream);padding-block:clamp(2.5rem,5vw,4rem)">
  <div class="wrap center">
    <span class="eyebrow">The Journal</span>
    <h1 style="margin-top:.8rem">{{ blog.title }}</h1>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="grid products" style="grid-template-columns:repeat(3,1fr)">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="card reveal">
          <div class="card__media">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" loading="lazy">
            {%- else -%}
              <div style="width:100%;height:100%;background:linear-gradient(160deg,var(--twilight-2),var(--twilight-1))"></div>
            {%- endif -%}
          </div>
          <h3 class="card__title">{{ article.title }}</h3>
          <div class="card__reviews">{{ article.published_at | date: '%B %-d, %Y' }}</div>
          <p class="muted" style="font-size:.9rem;margin-top:.5rem">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
        </a>
      {%- else -%}
        <p>No posts yet.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div class="center" style="margin-top:3rem">{{ paginate | default_pagination }}</div>{%- endif -%}
  </div>
</section>
