<footer class="foot">
  {%- if section.settings.show_wordmark -%}
    <div class="foot__cta">
      <a href="{{ section.settings.wordmark_link | default: routes.all_products_collection_url }}" class="wordmark">{{ settings.logo_text | default: shop.name }}<span>.</span></a>
    </div>
  {%- endif -%}
  <div class="foot__top">
    <div class="foot__brand">
      <span class="logo" style="color:#fff">{{ settings.logo_text | default: shop.name }}<span style="color:var(--coral)">.</span></span>
      <p>{{ section.settings.tagline }}</p>
      {%- form 'customer', class: 'signup' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.signup_placeholder }}" required aria-label="Email">
        <button class="btn btn-coral" type="submit">{{ section.settings.signup_button }}</button>
      {%- endform -%}
    </div>
    {%- for block in section.blocks -%}
      {%- if block.type == 'menu' -%}
        <div class="foot__col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          {%- for link in block.settings.menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="foot__bottom">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. These statements have not been evaluated by the FDA.</p>
    <div class="foot__legal">
      {%- if shop.privacy_policy.url -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{%- endif -%}
      {%- if shop.terms_of_service.url -%}<a href="{{ shop.terms_of_service.url }}">Terms</a>{%- endif -%}
      {%- if shop.refund_policy.url -%}<a href="{{ shop.refund_policy.url }}">Refunds</a>{%- endif -%}
      {%- if shop.shipping_policy.url -%}<a href="{{ shop.shipping_policy.url }}">Shipping</a>{%- endif -%}
    </div>
    <div class="foot__socials">
      {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
      {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
      {%- if section.settings.youtube != blank -%}<a href="{{ section.settings.youtube }}" aria-label="YouTube">{% render 'icon', name: 'pinterest' %}</a>{%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_wordmark", "label": "Show giant wordmark", "default": true },
    { "type": "url", "id": "wordmark_link", "label": "Wordmark link" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Creatine made effortless. 5g a day in a gummy you'll actually look forward to. Formulated in the USA, third-party tested." },
    { "type": "text", "id": "signup_placeholder", "label": "Signup placeholder", "default": "Email for 15% off" },
    { "type": "text", "id": "signup_button", "label": "Signup button", "default": "Join" },
    { "type": "header", "content": "Social" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok", "label": "TikTok URL" },
    { "type": "url", "id": "youtube", "label": "YouTube URL" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "Footer", "blocks": [ { "type": "menu" }, { "type": "menu" }, { "type": "menu" } ] } ]
}
{% endschema %}
