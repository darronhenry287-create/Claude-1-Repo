<section class="section" style="background:var(--cream)">
  <div class="wrap">
    <div class="center" style="margin-bottom:2.5rem">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 style="margin-top:.8rem">{{ section.settings.heading }}</h2>
    </div>
    <div style="overflow-x:auto">
      <table class="compare">
        <thead>
          <tr><th></th><th class="col-us">{{ section.settings.col_us }}</th><th>{{ section.settings.col_a }}</th><th>{{ section.settings.col_b }}</th></tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.feature }}</td>
              <td class="col-us yes">{{ block.settings.us }}</td>
              <td class="no">{{ block.settings.a }}</td>
              <td class="no">{{ block.settings.b }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why FORM" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The easiest way to take creatine." },
    { "type": "text", "id": "col_us", "label": "Our column", "default": "FORM Gummies" },
    { "type": "text", "id": "col_a", "label": "Column A", "default": "Creatine powder" },
    { "type": "text", "id": "col_b", "label": "Column B", "default": "Capsules" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Tastes like a treat" },
      { "type": "text", "id": "us", "label": "Us", "default": "✓" },
      { "type": "text", "id": "a", "label": "Column A", "default": "Chalky" },
      { "type": "text", "id": "b", "label": "Column B", "default": "Flavorless" }
    ] }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Tastes like a treat", "us": "✓", "a": "Chalky", "b": "Flavorless" } },
        { "type": "row", "settings": { "feature": "No shaker, no clumps", "us": "✓", "a": "Needs mixing", "b": "Pills only" } },
        { "type": "row", "settings": { "feature": "Full 5g in one serving", "us": "✓", "a": "Only if measured", "b": "5–7 capsules" } },
        { "type": "row", "settings": { "feature": "Easy to take every day", "us": "✓", "a": "Often skipped", "b": "Often skipped" } },
        { "type": "row", "settings": { "feature": "Travel-friendly", "us": "✓", "a": "Messy", "b": "OK" } }
      ]
    }
  ]
}
{% endschema %}
