<section class="section {{ section.settings.bg }}">
  <div class="wrap facts">
    <div class="sfacts reveal">
      <div class="sfacts__title">Supplement Facts</div>
      <div class="sfacts__sub"><span>Serving size: {{ section.settings.serving }}</span><span>{{ section.settings.servings }}</span></div>
      <div class="sfacts__sub" style="font-weight:700"><span>Amount per serving</span><span>% DV</span></div>
      <div class="sfacts__row"><b>Calories</b><span class="v">{{ section.settings.calories }}</span></div>
      <div class="sfacts__row"><b>Total Sugars</b><span class="v">{{ section.settings.sugar }}</span></div>
      <div class="sfacts__row"><b>{{ section.settings.active_name }}</b><span class="v">{{ section.settings.active_amt }}</span></div>
      <p class="sfacts__note">{{ section.settings.other }}</p>
    </div>
    <div class="facts__copy reveal d1">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
      <ul class="notlist">
        {%- for block in section.blocks -%}
          {%- if block.type == 'no' -%}<li {{ block.shopify_attributes }}><span class="x">✕</span> {{ block.settings.text }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="taglist">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tag' -%}<span class="tag {{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients / facts",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "bg-sky", "label": "Sky" }, { "value": "bg-cream", "label": "Cream" }, { "value": "", "label": "White" } ], "default": "bg-sky" },
    { "type": "header", "content": "Supplement facts panel" },
    { "type": "text", "id": "serving", "label": "Serving size", "default": "4 gummies" },
    { "type": "text", "id": "servings", "label": "Servings", "default": "30 servings" },
    { "type": "text", "id": "calories", "label": "Calories", "default": "20" },
    { "type": "text", "id": "sugar", "label": "Total sugars", "default": "2 g" },
    { "type": "text", "id": "active_name", "label": "Active ingredient", "default": "Creatine Monohydrate" },
    { "type": "text", "id": "active_amt", "label": "Active amount", "default": "5 g†" },
    { "type": "textarea", "id": "other", "label": "Other ingredients note", "default": "† Daily Value not established. Other ingredients: organic tapioca syrup, cane sugar, pectin, citric acid, natural flavor, fruit & vegetable juice (color)." },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's inside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four gummies. Everything they need." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The exact clinical dose, dosed to the gram — and a short, clean ingredient list you can actually pronounce." }
  ],
  "blocks": [
    { "type": "no", "name": "Not-in-it point", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "No artificial dyes or flavors" } ] },
    { "type": "tag", "name": "Tag", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Vegan" },
      { "type": "select", "id": "style", "label": "Colour", "options": [ { "value": "", "label": "Mint" }, { "value": "tag--sky", "label": "Sky" }, { "value": "tag--butter", "label": "Butter" } ], "default": "" }
    ] }
  ],
  "presets": [
    { "name": "Ingredients / facts", "blocks": [
      { "type": "no", "settings": { "text": "No artificial dyes or flavors" } },
      { "type": "no", "settings": { "text": "No gelatin — ever" } },
      { "type": "no", "settings": { "text": "No fillers, no proprietary blends" } },
      { "type": "tag", "settings": { "text": "Vegan", "style": "" } },
      { "type": "tag", "settings": { "text": "Gluten-free", "style": "tag--sky" } },
      { "type": "tag", "settings": { "text": "Third-party tested", "style": "tag--butter" } },
      { "type": "tag", "settings": { "text": "Made in USA", "style": "" } }
    ] }
  ]
}
{% endschema %}
