<section class="section {{ section.settings.bg }}" id="reviews">
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow eyebrow--plain">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="wall">
      {%- for block in section.blocks -%}
        {%- assign nm = block.settings.name -%}
        <div class="vouch {% if block.settings.lead %}vouch--lead{% endif %} reveal" {{ block.shopify_attributes }}>
          <span class="star">★★★★★</span>
          <p>"{{ block.settings.quote }}"</p>
          <div class="vouch__by">
            <div class="vouch__av">{{ nm | slice: 0, 1 }}{{ nm | split: ' ' | last | slice: 0, 1 }}</div>
            <div><div class="vouch__nm">{{ nm }}</div><div class="vouch__mt">{{ block.settings.meta }}</div></div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Review wall",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" } ], "default": "" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "9,000+ five-star reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "People don't just take it. They stick with it." }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "checkbox", "id": "lead", "label": "Featured (large coral)", "default": false },
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "I've quit creatine powder three times. These I actually look forward to." },
      { "type": "text", "id": "name", "label": "Name", "default": "Maya R." },
      { "type": "text", "id": "meta", "label": "Meta", "default": "Verified · 4 months in" }
    ] }
  ],
  "presets": [
    { "name": "Review wall", "blocks": [
      { "type": "review", "settings": { "lead": true, "quote": "I've quit creatine powder three times. These I actually look forward to — I haven't missed a day in four months.", "name": "Maya R.", "meta": "Verified · 4 months in" } },
      { "type": "review", "settings": { "quote": "No bloat, no chalky shake. My lifts are up and recovery is noticeably faster.", "name": "Daniel K.", "meta": "Verified · Wild Berry" } },
      { "type": "review", "settings": { "quote": "Wild Berry is genuinely delicious. My wife and I both take them now — part of our morning.", "name": "Tom & Priya", "meta": "Verified · Subscribers" } },
      { "type": "review", "settings": { "quote": "I travel constantly and powder was a non-starter. The jar goes in my bag and I never skip.", "name": "Jess H.", "meta": "Verified · Peach" } }
    ] }
  ]
}
{% endschema %}
