<section class="section" id="shop">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 style="margin-top:.8rem">{{ section.settings.heading }}</h2>
    </div>
    <div class="grid products">
      {%- assign coll = collections[section.settings.collection] -%}
      {%- if coll.products.size > 0 -%}
        {%- for product in coll.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Bundled demo products until a collection is connected {%- endcomment -%}
        <article class="card reveal"><div class="card__media"><span class="pill pill-clay card__badge">Bestseller</span><img src="{{ 'jar-berry.svg' | asset_url }}" alt="FORM Wild Berry creatine gummies"></div><h3 class="card__title">Wild Berry</h3><div class="card__reviews"><span class="star">★★★★★</span> 6,200 reviews</div><div class="card__row"><span class="card__price">$39</span></div></article>
        <article class="card reveal"><div class="card__media"><img src="{{ 'jar-peach.svg' | asset_url }}" alt="FORM Peach creatine gummies"></div><h3 class="card__title">Peach</h3><div class="card__reviews"><span class="star">★★★★★</span> 1,840 reviews</div><div class="card__row"><span class="card__price">$39</span></div></article>
        <article class="card reveal"><div class="card__media"><img src="{{ 'jar-citrus.svg' | asset_url }}" alt="FORM Citrus creatine gummies"></div><h3 class="card__title">Citrus</h3><div class="card__reviews"><span class="star">★★★★☆</span> 970 reviews</div><div class="card__row"><span class="card__price">$39</span></div></article>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pick your flavor" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three flavors. One simple habit." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 3 }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
