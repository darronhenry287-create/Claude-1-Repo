<section class="hero-split">
  <div class="hero-split__copy">
    <div class="hero-split__inner">
      {%- if section.settings.show_rating -%}
        <div class="hero__rating"><span class="star">★★★★★</span><span class="muted" style="font-size:.85rem">{{ section.settings.rating_text }}</span></div>
      {%- endif -%}
      <h1 class="display">{{ section.settings.heading }}</h1>
      <p class="hero__lede lede">{{ section.settings.subheading }}</p>
      <div class="hero__cta">
        {%- if section.settings.cta_text != blank -%}<a href="{{ section.settings.cta_link }}" class="btn btn-primary btn-lg">{{ section.settings.cta_text }}</a>{%- endif -%}
        {%- if section.settings.cta2_text != blank -%}<a href="{{ section.settings.cta2_link }}" class="btn btn-ghost btn-lg">{{ section.settings.cta2_text }}</a>{%- endif -%}
      </div>
      <ul class="hero__trust">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %} {{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
  <div class="hero-split__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.image.alt | escape }}" fetchpriority="high">
    {%- else -%}
      <img src="{{ 'hero.svg' | asset_url }}" alt="FORM Daily Creatine Gummies" fetchpriority="high">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image (defaults to bundled illustration)" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9 · 9,000+ five-star reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "5g creatine. One simple ritual." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Skip the chalky powder and the shaker you always forget to clean. FORM packs the full clinically studied dose of creatine monohydrate into a daily gummy that actually tastes good — so you'll actually keep taking it." },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Shop FORM" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "How it works" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link", "default": "#how" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "trial", "label": "Check / guarantee" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }
        ], "default": "shield" },
        { "type": "text", "id": "text", "label": "Text", "default": "Third-party tested" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "trust", "settings": { "icon": "shield", "text": "Third-party tested" } },
        { "type": "trust", "settings": { "icon": "truck", "text": "Free shipping over $35" } },
        { "type": "trust", "settings": { "icon": "trial", "text": "Cancel anytime" } }
      ]
    }
  ]
}
{% endschema %}
