<section class="hx">
  <div class="hx__inner">
    <div class="hx__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="display hx__title">{{ section.settings.heading }}</h1>
      <p class="hx__lede lede">{{ section.settings.subheading }}</p>
      <div class="hx__cta">
        {%- if section.settings.cta_text != blank -%}<a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn-coral btn-lg">{{ section.settings.cta_text }}</a>{%- endif -%}
        {%- if section.settings.cta2_text != blank -%}<a href="{{ section.settings.cta2_link }}" class="btn btn-line btn-lg">{{ section.settings.cta2_text }}</a>{%- endif -%}
      </div>
      <div class="hx__rating">
        <div class="hx__avatars"><span>MR</span><span>DK</span><span>SL</span><span>+</span></div>
        <div><span class="star">★★★★★</span> <strong>{{ section.settings.rating_score }}</strong> <span class="muted">· {{ section.settings.rating_text }}</span></div>
      </div>
    </div>
    <div class="hx__media">
      <div class="hx__blob"></div>
      {%- if section.settings.image != blank -%}
        <img class="hx__product" src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape | default: shop.name }}" fetchpriority="high">
      {%- else -%}
        <img class="hx__product" src="{{ 'jar-berry.svg' | asset_url }}" alt="FORM Daily Creatine Gummies" fetchpriority="high">
      {%- endif -%}
      <div class="chip chip--1"><span class="chip__ic">{{ section.settings.chip1_value }}</span><span>{{ section.settings.chip1_label }}</span></div>
      <div class="chip chip--2"><span class="chip__ic is-mint">✓</span><span>{{ section.settings.chip2_label }}</span></div>
      <div class="chip chip--3"><span class="chip__ic is-sky">★</span><span>{{ section.settings.chip3_label }}</span></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Product image (defaults to bundled illustration)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "5g creatine · one daily gummy" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Creatine you'll actually keep taking.</p>" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The full clinically studied dose of creatine monohydrate — no chalky powder, no shaker, no clumps. Just four gummies a day that taste like something you'd reach for anyway." },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Get FORM — $39" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "How it works" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "text", "id": "rating_score", "label": "Rating score", "default": "4.9" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "9,000+ happy reviews" },
    { "type": "header", "content": "Floating chips" },
    { "type": "text", "id": "chip1_value", "label": "Chip 1 value", "default": "5g" },
    { "type": "text", "id": "chip1_label", "label": "Chip 1 label", "default": "creatine per serving" },
    { "type": "text", "id": "chip2_label", "label": "Chip 2 label", "default": "vegan · 2g sugar" },
    { "type": "text", "id": "chip3_label", "label": "Chip 3 label", "default": "9,000+ 5-star" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
