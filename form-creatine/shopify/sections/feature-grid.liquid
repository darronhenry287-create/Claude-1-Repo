<section class="section">
  <div class="wrap">
    <div class="grid feature-grid">
      {%- for block in section.blocks -%}
        <div class="feature-card reveal" {{ block.shopify_attributes }}>
          <div class="ic">{% render 'icon', name: block.settings.icon %}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature grid",
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "check", "label": "Check" }, { "value": "shield", "label": "Shield" },
          { "value": "trial", "label": "Guarantee" }, { "value": "truck", "label": "Truck" }
        ], "default": "check" },
        { "type": "text", "id": "title", "label": "Title", "default": "Full 5g dose" },
        { "type": "text", "id": "text", "label": "Text", "default": "The clinically studied daily dose of creatine monohydrate — no half-scoops, no guesswork." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature grid",
      "blocks": [
        { "type": "feature", "settings": { "icon": "check", "title": "Full 5g dose", "text": "The clinically studied daily amount of creatine monohydrate in every serving — no half-scoops." } },
        { "type": "feature", "settings": { "icon": "check", "title": "No chalk, no shaker", "text": "Just chew. No clumps stuck to a blender bottle, no gritty aftertaste to power through." } },
        { "type": "feature", "settings": { "icon": "check", "title": "Lab-tested purity", "text": "Every batch is third-party tested for purity and potency. Vegan, gluten-free, no artificial dyes." } },
        { "type": "feature", "settings": { "icon": "check", "title": "Actually tastes good", "text": "Wild Berry, Peach, or Citrus — with just 2g of sugar, so the daily habit sticks." } }
      ]
    }
  ]
}
{% endschema %}
