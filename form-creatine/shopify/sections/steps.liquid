<section class="section" id="how">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 style="margin-top:.8rem">{{ section.settings.heading }}</h2>
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step reveal" {{ block.shopify_attributes }}>
          <div class="step__num">{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stronger in three easy steps." }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Take four a day" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Four gummies, any time — with coffee, after a workout, whenever. No shaker, no mess." }
    ] }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Take four a day", "text": "Four gummies, any time — with coffee, after a workout, whenever. No shaker, no mess." } },
        { "type": "step", "settings": { "title": "Stay consistent", "text": "Creatine works by saturating your muscles, so the magic is simply in the daily habit." } },
        { "type": "step", "settings": { "title": "Feel the difference", "text": "Within two to four weeks, expect stronger lifts, faster recovery and steadier energy." } }
      ]
    }
  ]
}
{% endschema %}
