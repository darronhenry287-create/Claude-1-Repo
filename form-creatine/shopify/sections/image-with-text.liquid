<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap">
    <div class="split {% if section.settings.reverse %}split--reverse{% endif %}">
      <div class="split__media {% if section.settings.warm %}warm{% endif %} reveal">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}" style="width:100%;height:100%;object-fit:cover">
        {%- elsif section.settings.fallback != blank -%}
          <img src="{{ section.settings.fallback | asset_url }}" alt="{{ section.settings.heading | escape }}" style="width:100%;height:100%;object-fit:cover">
        {%- endif -%}
      </div>
      <div class="split__copy reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div>{{ section.settings.text }}</div>
        <ul class="checklist">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %} {{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn btn-clay btn-lg" style="margin-top:1.8rem">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback", "label": "Fallback image filename (bundled asset)" },
    { "type": "checkbox", "id": "reverse", "label": "Reverse layout", "default": false },
    { "type": "checkbox", "id": "warm", "label": "Warm media background", "default": true },
    { "type": "checkbox", "id": "bg", "label": "Cream section background", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The problem with powder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Creatine works. Powder doesn't fit your life." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Chalky scoops. Clumps at the bottom of the shaker. A tub shoved to the back of the cupboard until you forget it's there. Most people quit creatine not because it stops working — but because the routine is a chore.</p><p>FORM is the same clinical 5g dose, in a gummy you'll actually want to take.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Meet FORM →" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "point", "name": "Checklist point", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Full 5g of creatine monohydrate — no half-doses" } ] }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "point", "settings": { "text": "Full 5g of creatine monohydrate — no half-doses" } },
        { "type": "point", "settings": { "text": "No mixing, no chalk, no shaker to wash" } },
        { "type": "point", "settings": { "text": "Just 2g of sugar, lab-tested every batch" } }
      ]
    }
  ]
}
{% endschema %}
