<section class="section" style="padding-top:1.5rem">
  <div class="wrap">
    <p class="muted" style="font-size:.82rem;margin-bottom:1.5rem">
      <a href="{{ routes.root_url }}">Home</a> / <a href="{{ collection.url | default: routes.all_products_collection_url }}">Shop</a> / {{ product.title }}
    </p>

    <div class="pdp" data-product="{{ product.handle }}">
      <!-- Gallery -->
      <div class="gallery">
        <div class="gallery__main" id="gallery-main">
          {%- if product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | escape }}" width="1200" height="1200">
          {%- else -%}
            <img src="{{ 'jar-berry.svg' | asset_url }}" alt="{{ product.title | escape }}">
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="gallery__thumbs">
            {%- for image in product.images limit: 4 -%}
              <button class="gallery__thumb {% if forloop.first %}active{% endif %}" data-full="{{ image | image_url: width: 1200 }}">
                <img src="{{ image | image_url: width: 240 }}" alt="{{ image.alt | escape }}" width="120" height="120">
              </button>
            {%- endfor -%}
          </div>
        {%- elsif product.featured_image == blank -%}
          <div class="gallery__thumbs">
            {%- assign demo = 'jar-berry.svg,gummies.svg,inside.svg,lifestyle.svg' | split: ',' -%}
            {%- for d in demo -%}
              <button class="gallery__thumb {% if forloop.first %}active{% endif %}" data-full="{{ d | asset_url }}"><img src="{{ d | asset_url }}" alt="" width="120" height="120"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Buy box -->
      <div class="pdp__info" id="buy-anchor">
        <span class="pill pill-clay">{{ product.metafields.custom.badge | default: '★ #1 Bestseller' }}</span>
        <h1>{{ product.title }}</h1>
        <div class="pdp__rating"><span class="star">★★★★★</span> <span>4.9 · <a href="#reviews" style="text-decoration:underline">9,000 reviews</a></span></div>

        <div class="pdp__price">
          <span class="now" id="pdp-price-now">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="was" id="pdp-price-was">{{ product.compare_at_price | money }}</span>
            <span class="pill pill-clay save">Save {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
          {%- endif -%}
        </div>

        <div class="pdp__desc">{{ product.description | default: '<p>The full 5g clinical dose of creatine monohydrate, in a daily gummy you will actually look forward to. No chalk, no shaker, no clumps — just chew four a day and let your muscles do the rest.</p>' }}</div>

        {%- form 'product', product, id: 'product-form' -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="opt-group">
                <span class="opt-label">{{ option.name }}</span>
                <div class="opt-row" data-option-index="{{ forloop.index0 }}">
                  {%- for value in option.values -%}
                    <button type="button" class="opt {% if option.selected_value == value %}active{% endif %}" data-variant="{{ value | escape }}">{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <select name="id" id="variant-id" hidden>
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>
            {%- endfor -%}
          </select>

          <div class="pdp__buy">
            <div class="qty">
              <button type="button" data-step="-">−</button>
              <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
              <button type="button" data-step="+">+</button>
            </div>
            <button type="submit" class="btn btn-clay btn-lg btn-block" data-add
              data-id="{{ product.handle }}" data-name="{{ product.title | escape }}"
              data-price="{{ product.price | money_without_currency }}"
              {% unless product.available %}disabled{% endunless %}>
              {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
            </button>
          </div>
          {{ form | payment_button }}
        {%- endform -%}

        <div class="pdp__trust">
          <div>{% render 'icon', name: 'shield' %}Third-party tested</div>
          <div>{% render 'icon', name: 'truck' %}Free shipping over $35</div>
          <div>{% render 'icon', name: 'trial' %}30-day guarantee</div>
        </div>

        <div class="acc">
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              <div class="acc__item {% if forloop.first %}open{% endif %}" {{ block.shopify_attributes }}>
                <button class="acc__head">{{ block.settings.title }} {% render 'icon', name: 'plus' %}</button>
                <div class="acc__body" {% if forloop.first %}style="max-height:400px"{% endif %}><div class="acc__body-inner">{{ block.settings.content }}</div></div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Sticky add bar -->
<div class="sticky-bar" id="sticky-bar" data-product="{{ product.handle }}">
  <div class="sticky-bar__inner">
    <div class="sticky-bar__info">
      <div class="sticky-bar__thumb">{%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 96 }}" alt="" width="48" height="48">{%- else -%}<img src="{{ 'jar-berry.svg' | asset_url }}" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:10px">{%- endif -%}</div>
      <div><div class="sticky-bar__name">{{ product.title }}</div><div class="sticky-bar__price" id="sticky-price">{{ product.price | money }}</div></div>
    </div>
    <button class="btn btn-clay" data-add data-id="{{ product.handle }}" data-name="{{ product.title | escape }}" data-price="{{ product.price | money_without_currency }}" onclick="document.getElementById('product-form').requestSubmit()">{{ 'products.product.add_to_cart' | t }}</button>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "How to take" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Take 4 gummies daily for your full 5g dose. Any time of day, with or without food.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "accordion", "settings": { "title": "How to take", "content": "<p>Take 4 gummies daily for your full 5g dose of creatine monohydrate. Any time of day, with or without food. Consistency is what counts — let your muscles saturate over 3–4 weeks.</p>" } },
        { "type": "accordion", "settings": { "title": "Ingredients & nutrition", "content": "<p>Creatine monohydrate (5g per 4 gummies), organic tapioca syrup, cane sugar, pectin, citric acid, natural flavor, fruit &amp; vegetable juice (color). 2g sugar per serving. Vegan · gluten-free · no artificial dyes.</p>" } },
        { "type": "accordion", "settings": { "title": "Shipping & returns", "content": "<p>Free shipping over $35, ships within 24 hours. Subscribe &amp; save 20% — skip, pause or cancel anytime. Not feeling it? 30-day money-back guarantee, and you keep the jar.</p>" } }
      ]
    }
  ]
}
{% endschema %}
