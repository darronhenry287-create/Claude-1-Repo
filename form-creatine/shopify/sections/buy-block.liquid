{%- assign product = all_products[section.settings.product] -%}
<section class="section {{ section.settings.bg }}" id="buy">
  <div class="wrap buy">
    <div class="buy__media reveal">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}">
      {%- else -%}
        <img src="{{ 'jar-berry.svg' | asset_url }}" alt="FORM Daily Creatine Gummies">
      {%- endif -%}
    </div>
    <div class="buy__panel reveal d1" data-product="{{ product.handle | default: 'daily-creatine' }}">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <div class="rating" style="margin:.6rem 0 1.2rem"><span class="star">★★★★★</span> <span class="muted">{{ section.settings.rating_text }}</span></div>

      {%- form 'product', product, id: 'buy-form' -%}
        {%- if product != blank and product.has_only_default_variant == false -%}
          {%- assign opt = product.options_with_values | first -%}
          <span class="opt-label">{{ opt.name }}</span>
          <div class="opt-row" style="margin-bottom:1.4rem">
            {%- for value in opt.values -%}
              <button type="button" class="opt {% if opt.selected_value == value %}active{% endif %}" data-variant="{{ value | escape }}">{{ value }}</button>
            {%- endfor -%}
          </div>
        {%- else -%}
          <span class="opt-label">Flavor</span>
          <div class="opt-row" style="margin-bottom:1.4rem">
            <button type="button" class="opt active" data-variant="Wild Berry">Wild Berry</button>
            <button type="button" class="opt" data-variant="Peach">Peach</button>
            <button type="button" class="opt" data-variant="Citrus">Citrus</button>
          </div>
        {%- endif -%}

        <select name="id" id="variant-id" hidden>
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }}</option>
          {%- endfor -%}
        </select>

        <div class="plans">
          {%- for block in section.blocks -%}
            <div class="plan tier {% if block.settings.featured %}active{% endif %}" data-label="{{ block.settings.title | escape }}" data-qty="{{ block.settings.qty }}" data-price="{{ block.settings.price }}" {% if block.settings.compare != blank %}data-compare="{{ block.settings.compare }}"{% endif %} {{ block.shopify_attributes }}>
              {%- if block.settings.flag != blank -%}<span class="plan__flag">{{ block.settings.flag }}</span>{%- endif -%}
              <div class="plan__radio"></div>
              <div class="plan__body"><div class="plan__title">{{ block.settings.title }}</div><div class="plan__sub">{{ block.settings.sub }}</div></div>
              <div class="plan__price"><div class="p">${{ block.settings.price }}</div><div class="u">{{ block.settings.unit }}</div></div>
            </div>
          {%- endfor -%}
        </div>

        <div class="price"><span class="now" id="pdp-price-now">{{ product.price | money | default: '$31.00' }}</span><span class="was" id="pdp-price-was">{{ section.settings.compare_price }}</span></div>
        <button type="submit" class="btn btn-coral btn-lg btn-block" data-add data-id="{{ product.handle | default: 'daily-creatine' }}" data-name="{{ product.title | escape | default: 'FORM Daily Creatine' }}" data-price="{{ product.price | money_without_currency | default: '39' }}">{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}</button>
      {%- endform -%}

      <div class="buy__assure">
        <span>{% render 'icon', name: 'trial' %} 30-day guarantee</span>
        <span>{% render 'icon', name: 'truck' %} Free shipping over $35</span>
        <span>{% render 'icon', name: 'shield' %} Lab-tested</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Buy block",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" } ], "default": "" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Daily Creatine Gummies" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start the ritual." },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9 · 9,000+ reviews" },
    { "type": "text", "id": "compare_price", "label": "Compare-at price (display)", "default": "$39.00" }
  ],
  "blocks": [
    { "type": "plan", "name": "Plan", "settings": [
      { "type": "checkbox", "id": "featured", "label": "Selected by default", "default": false },
      { "type": "text", "id": "flag", "label": "Flag (optional)" },
      { "type": "text", "id": "title", "label": "Title", "default": "One-time purchase" },
      { "type": "text", "id": "sub", "label": "Subtext", "default": "One jar · 30-day supply" },
      { "type": "text", "id": "price", "label": "Price (number)", "default": "39" },
      { "type": "text", "id": "qty", "label": "Quantity", "default": "1" },
      { "type": "text", "id": "compare", "label": "Compare price (number, optional)" },
      { "type": "text", "id": "unit", "label": "Unit label", "default": "per jar" }
    ] }
  ],
  "presets": [
    { "name": "Buy block", "blocks": [
      { "type": "plan", "settings": { "title": "One-time purchase", "sub": "One jar · 30-day supply", "price": "39", "qty": "1", "unit": "per jar" } },
      { "type": "plan", "settings": { "featured": true, "flag": "Save 20%", "title": "Subscribe & Save", "sub": "Monthly · skip or cancel anytime", "price": "31", "qty": "1", "compare": "39", "unit": "per month" } },
      { "type": "plan", "settings": { "flag": "Best value", "title": "3-Month Supply", "sub": "Three jars · free shipping", "price": "33", "qty": "3", "compare": "39", "unit": "per jar" } }
    ] }
  ]
}
{% endschema %}
