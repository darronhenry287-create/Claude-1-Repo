<section class="section {{ section.settings.bg }} center">
  <div class="wrap wrap--tight">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="margin:1rem 0">{{ section.settings.heading }}</h2>
    <p class="lede">{{ section.settings.text }}</p>
    {%- if section.settings.cta_text != blank -%}<a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn-coral btn-lg" style="margin-top:1.6rem">{{ section.settings.cta_text }}</a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Promise band",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "bg-ink", "label": "Navy" }, { "value": "bg-cream", "label": "Cream" } ], "default": "bg-ink" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Love it, or it's on us." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Give FORM 30 days. If you're not recovering faster, lifting stronger and enjoying your daily creatine, we'll refund you — and you keep the jar." },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Promise band" } ]
}
{% endschema %}
