<section class="section">
  <div class="wrap" style="max-width:840px">
    <h1 style="margin-bottom:2rem">{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post">
        {%- for item in cart.items -%}
          <div class="drawer__item" style="border-color:var(--line)">
            <div class="drawer__thumb" style="width:96px;height:96px">{%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}">{%- endif -%}</div>
            <div class="drawer__item-info">
              <h4 style="font-size:1.15rem"><a href="{{ item.url }}">{{ item.product.title }}</a></h4>
              <div class="v">{{ item.variant.title | remove: 'Default Title' }}</div>
              <div class="drawer__item-foot">
                <span>Qty: {{ item.quantity }}</span>
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
              <a class="drawer__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
            </div>
          </div>
        {%- endfor -%}
        <div class="drawer__subtotal" style="margin-top:2rem;font-size:1.3rem"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        <p class="drawer__note" style="text-align:left;margin:.5rem 0 1.5rem">{{ 'cart.taxes_note' | t }}</p>
        <button type="submit" name="checkout" class="btn btn-primary btn-lg">{{ 'cart.checkout' | t }}</button>
      </form>
    {%- else -%}
      <div class="drawer__empty"><p>{{ 'cart.empty' | t }}</p><a href="{{ routes.all_products_collection_url }}" class="btn btn-clay btn-lg" style="margin-top:1.5rem">Shop all</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
