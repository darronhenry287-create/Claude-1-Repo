<section class="section" id="reviews">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 style="margin-top:.8rem">{{ section.settings.heading }}</h2>
      <div style="margin-top:1rem"><span class="star" style="font-size:1.2rem">★★★★★</span> <strong>{{ section.settings.avg }}</strong> average rating</div>
    </div>
    <div class="grid reviews">
      {%- for block in section.blocks -%}
        <div class="review reveal" {{ block.shopify_attributes }}>
          <span class="star">★★★★★</span>
          <p>"{{ block.settings.quote }}"</p>
          <div class="review__author">
            <div class="review__avatar">{{ block.settings.name | slice: 0, 1 }}{{ block.settings.name | split: ' ' | last | slice: 0, 1 }}</div>
            <div><div class="review__name">{{ block.settings.name }}</div><div class="review__meta">{{ block.settings.meta }}</div></div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "9,000+ five-star reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "People don't just take it. They stick with it." },
    { "type": "text", "id": "avg", "label": "Average", "default": "4.9" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "I've started and quit creatine powder three times. These I actually look forward to." },
      { "type": "text", "id": "name", "label": "Name", "default": "Maya R." },
      { "type": "text", "id": "meta", "label": "Meta", "default": "Verified · Taking daily for 4 months" }
    ] }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "I've started and quit creatine powder three times. These I actually look forward to — the jar lives on my desk and I never miss a day.", "name": "Maya R.", "meta": "Verified · Taking daily for 4 months" } },
        { "type": "review", "settings": { "quote": "No bloat, no chalky shake to choke down. My lifts are up and recovery is noticeably faster.", "name": "Daniel K.", "meta": "Verified · Wild Berry" } },
        { "type": "review", "settings": { "quote": "Wild Berry is genuinely delicious. My wife and I both take them now — it's part of our morning.", "name": "Tom & Priya", "meta": "Verified · Subscribers" } }
      ]
    }
  ]
}
{% endschema %}
