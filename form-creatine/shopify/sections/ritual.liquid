<section class="section {{ section.settings.bg }}" id="how">
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow eyebrow--plain">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="ritual">
      {%- for block in section.blocks -%}
        <div class="rstep reveal" {{ block.shopify_attributes }}>
          <div class="rstep__num">{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ritual steps",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }, { "value": "bg-sky", "label": "Sky" } ], "default": "" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stronger in three easy steps." }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Take four a day" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Any time — with coffee, post-workout, whenever. No mixing, no mess." }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Ritual steps", "blocks": [
      { "type": "step", "settings": { "title": "Take four a day", "text": "Any time — with coffee, post-workout, whenever. No mixing, no mess." } },
      { "type": "step", "settings": { "title": "Stay consistent", "text": "Creatine works by saturating your muscles. The magic is the daily habit." } },
      { "type": "step", "settings": { "title": "Feel the difference", "text": "In two to four weeks: stronger lifts, faster recovery, steadier energy." } }
    ] }
  ]
}
{% endschema %}
