{%- comment -%} Slide-out cart drawer + overlay + mobile menu containers {%- endcomment -%}
<div class="overlay" id="overlay"></div>

<aside class="drawer" id="cart-drawer" aria-label="{{ 'accessibility.cart' | t }}">
  <div class="drawer__head">
    <h3>{{ 'cart.title' | t }}</h3>
    <button class="icon-btn" data-action="close-cart" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
  </div>

  <div class="drawer__body" id="cart-body">
    {%- if cart.item_count > 0 -%}
      {%- for item in cart.items -%}
        <div class="drawer__item">
          <div class="drawer__thumb">
            {%- if item.image -%}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80">{%- endif -%}
          </div>
          <div class="drawer__item-info">
            <h4>{{ item.product.title }}</h4>
            <div class="v">{{ item.variant.title | remove: 'Default Title' }}</div>
            <div class="drawer__item-foot">
              <span class="drawer__qty">{{ item.quantity }} ×</span>
              <strong>{{ item.final_line_price | money }}</strong>
            </div>
            <a class="drawer__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="drawer__empty"><p>{{ 'cart.empty' | t }}</p></div>
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="drawer__foot" id="cart-foot">
      <div class="free-ship" id="free-ship"
        data-threshold="{{ settings.free_ship_threshold }}"
        data-total="{{ cart.total_price | divided_by: 100.0 }}"></div>
      <div class="drawer__subtotal"><span>{{ 'cart.subtotal' | t }}</span><span id="cart-subtotal">{{ cart.total_price | money }}</span></div>
      <p class="drawer__note">{{ 'cart.taxes_note' | t }}</p>
      <a href="{{ routes.cart_url }}" class="btn btn-primary btn-block btn-lg">{{ 'cart.checkout' | t }}</a>
    </div>
  {%- endif -%}
</aside>
