{%- comment -%} Usage: {% render 'product-card', product: product %} {%- endcomment -%}
<article class="card reveal" data-product="{{ product.handle }}">
  <div class="card__media">
    {%- if product.compare_at_price > product.price -%}
      <span class="pill pill-clay card__badge">Save {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
    {%- elsif product.tags contains 'new' -%}
      <span class="pill card__badge">New</span>
    {%- endif -%}
    <div class="card__quick">
      <form method="post" action="{{ routes.cart_add_url }}" data-product="{{ product.handle }}">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="btn btn-primary btn-block" data-add
          data-id="{{ product.handle }}"
          data-name="{{ product.title | escape }}"
          data-price="{{ product.price | money_without_currency }}"
          {% unless product.available %}disabled{% endunless %}>
          {%- if product.available -%}Quick add · {{ product.price | money }}{%- else -%}Sold out{%- endif -%}
        </button>
      </form>
    </div>
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="600" height="600">
    {%- else -%}
      <img src="{{ 'somna-pdp-1.jpg' | asset_url }}" alt="{{ product.title | escape }}" loading="lazy">
    {%- endif -%}
  </div>
  <a href="{{ product.url }}"><h3 class="card__title">{{ product.title }}</h3></a>
  {%- if product.metafields.reviews.rating -%}
    <div class="card__reviews"><span class="star">★★★★★</span> {{ product.metafields.reviews.rating_count }} reviews</div>
  {%- endif -%}
  <div class="card__row">
    <span class="card__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="was">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
      {{ product.price | money }}
    </span>
  </div>
</article>
