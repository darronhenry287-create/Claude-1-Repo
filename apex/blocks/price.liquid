<div class="apex-tb-price" style="text-align:{{ block.settings.align }}" {{ block.shopify_attributes }}>
  {%- if block.settings.product != blank -%}
    {%- render 'price', product: block.settings.product -%}
  {%- else -%}
    {%- render 'price', price: block.settings.price, compare_at: block.settings.compare_at -%}
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Price",
  "settings": [
    { "type": "product", "id": "product", "label": "Product (optional)" },
    { "type": "number", "id": "price", "label": "Price (pence/cents, fallback)", "default": 2999 },
    { "type": "number", "id": "compare_at", "label": "Compare-at price (fallback)", "default": 4999 },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] }
  ],
  "presets": [ { "name": "Price" } ]
}
{% endschema %}
