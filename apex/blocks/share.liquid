{%- liquid
  assign page_url = shop.url | append: request.path
  assign page_title = page_title | default: shop.name
  assign encoded_url = page_url | url_encode
  assign encoded_title = page_title | url_encode
-%}
<div class="apex-tb-share" {{ block.shopify_attributes }}>
  {%- if block.settings.label != blank -%}
    <span class="apex-tb-share__label muted">{{ block.settings.label | escape }}</span>
  {%- endif -%}
  <div class="apex-tb-share__buttons cluster">
    {%- if block.settings.show_x -%}
      <a
        href="https://twitter.com/intent/tweet?url={{ encoded_url }}&text={{ encoded_title }}"
        target="_blank"
        rel="noopener noreferrer"
        class="apex-tb-share__btn"
        aria-label="Share on X (Twitter)"
        title="Share on X"
      >{%- render 'icon', icon: 'x' -%}</a>
    {%- endif -%}
    {%- if block.settings.show_facebook -%}
      <a
        href="https://www.facebook.com/sharer/sharer.php?u={{ encoded_url }}"
        target="_blank"
        rel="noopener noreferrer"
        class="apex-tb-share__btn"
        aria-label="Share on Facebook"
        title="Share on Facebook"
      >{%- render 'icon', icon: 'facebook' -%}</a>
    {%- endif -%}
    {%- if block.settings.show_pinterest -%}
      <a
        href="https://pinterest.com/pin/create/button/?url={{ encoded_url }}&description={{ encoded_title }}"
        target="_blank"
        rel="noopener noreferrer"
        class="apex-tb-share__btn"
        aria-label="Share on Pinterest"
        title="Share on Pinterest"
      ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.78-.17-1.98.04-2.83.18-.77 1.24-5.25 1.24-5.25s-.32-.63-.32-1.57c0-1.47.86-2.57 1.92-2.57.91 0 1.35.68 1.35 1.5 0 .91-.58 2.28-.88 3.55-.25 1.06.53 1.92 1.57 1.92 1.88 0 3.14-2.4 3.14-5.24 0-2.16-1.46-3.77-4.1-3.77-2.99 0-4.85 2.24-4.85 4.74 0 .86.24 1.46.62 1.93.17.21.2.29.14.52-.04.17-.15.58-.19.74-.06.23-.24.32-.45.23-1.32-.54-1.93-1.99-1.93-3.62 0-2.68 2.25-5.88 6.73-5.88 3.6 0 5.97 2.61 5.97 5.41 0 3.7-2.06 6.47-5.1 6.47-1.02 0-1.98-.55-2.31-1.18l-.63 2.47c-.23.87-.84 1.96-1.25 2.62.94.29 1.94.45 2.97.45 5.52 0 10-4.48 10-10S17.52 2 12 2Z"/></svg></a>
    {%- endif -%}
    {%- if block.settings.show_whatsapp -%}
      <a
        href="https://wa.me/?text={{ encoded_title }}%20{{ encoded_url }}"
        target="_blank"
        rel="noopener noreferrer"
        class="apex-tb-share__btn"
        aria-label="Share on WhatsApp"
        title="Share on WhatsApp"
      ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.52 14.17c-.23.64-1.34 1.22-1.84 1.3-.5.07-1.12.1-1.81-.11-.42-.13-.96-.3-1.64-.59-2.87-1.24-4.74-4.14-4.88-4.33-.14-.2-1.13-1.51-1.13-2.88 0-1.37.72-2.04 1-2.33.27-.3.59-.37.78-.37.2 0 .4.01.57.01.18.01.43-.07.67.51.25.59.85 2.07.93 2.22.07.15.12.32.02.52-.1.2-.15.33-.3.51-.14.18-.3.4-.43.54-.14.15-.3.3-.13.59.17.3.77 1.27 1.65 2.06 1.13 1.01 2.09 1.32 2.39 1.47.3.14.47.12.65-.07.18-.2.76-.89.96-1.19.2-.3.4-.25.67-.15.27.1 1.72.81 2.01.96.3.14.5.21.57.33.07.12.07.72-.16 1.36z"/></svg></a>
    {%- endif -%}
    {%- if block.settings.show_email -%}
      <a
        href="mailto:?subject={{ encoded_title }}&body={{ encoded_url }}"
        class="apex-tb-share__btn"
        aria-label="Share by email"
        title="Share by email"
      ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg></a>
    {%- endif -%}
  </div>
</div>
{% stylesheet %}
.apex-tb-share { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; }
.apex-tb-share__label { font-size: .9rem; }
.apex-tb-share__buttons { display: flex; flex-wrap: wrap; gap: .4rem; }
.apex-tb-share__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.2rem;
  height: 2.2rem;
  border-radius: var(--radius-pill);
  background: var(--bg-alt);
  color: var(--text-muted);
  text-decoration: none;
  transition: background .18s, color .18s;
}
.apex-tb-share__btn:hover { background: var(--accent); color: var(--accent-text); }
.apex-tb-share__btn svg { width: 1rem; height: 1rem; }
{% endstylesheet %}
{% schema %}
{
  "name": "Share buttons",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label (optional)",
      "default": "Share:"
    },
    {
      "type": "checkbox",
      "id": "show_x",
      "label": "X (Twitter)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Facebook",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pinterest",
      "label": "Pinterest",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "WhatsApp",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Email",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Share buttons"
    }
  ]
}
{% endschema %}
