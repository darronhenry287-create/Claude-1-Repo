{%- liquid
  assign img = block.settings.image
  assign ratio_class = 'media--' | append: block.settings.ratio
  assign reverse = block.settings.image_position
-%}
<div class="apex-tb-image-text{% if reverse %} apex-tb-image-text--reverse{% endif %}" {{ block.shopify_attributes }}>
  <div class="apex-tb-image-text__media media {{ ratio_class }}">
    {%- if img != blank -%}
      {%- assign alt = img.alt -%}
      {{ img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(max-width:989px) 100vw, 50vw', alt: alt }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="apex-tb-image-text__body stack">
    {%- if block.settings.heading != blank -%}
      <p class="{{ block.settings.heading_size }}" style="font-family:var(--font-heading);font-weight:var(--font-heading-weight)">{{ block.settings.heading | escape }}</p>
    {%- endif -%}
    {%- if block.settings.text != blank -%}
      <div class="rte muted">{{ block.settings.text }}</div>
    {%- endif -%}
  </div>
</div>
{% stylesheet %}
.apex-tb-image-text {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(1.2rem, 3vw, 2.4rem);
  align-items: center;
}
.apex-tb-image-text--reverse { direction: rtl; }
.apex-tb-image-text--reverse > * { direction: ltr; }
@media (max-width: 749px) {
  .apex-tb-image-text { grid-template-columns: 1fr; direction: ltr; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Image + text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        },
        {
          "value": "wide",
          "label": "Wide (16:9)"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "image_position",
      "label": "Image on right",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bold claim goes here"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h3",
      "options": [
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h4",
          "label": "Small"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Pair an image with supporting copy to highlight a product feature, brand story, or key benefit.</p>"
    }
  ],
  "presets": [
    {
      "name": "Image + text"
    }
  ]
}
{% endschema %}
