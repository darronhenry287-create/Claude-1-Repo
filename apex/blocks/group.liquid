{%- liquid
  assign g_gap = block.settings.gap
  assign g_align = block.settings.align
  assign g_card = block.settings.card
  assign g_pad = block.settings.padding
  assign g_mw = block.settings.max_width
  assign g_center = block.settings.center
  assign g_mx = 'auto'
  unless g_center
    assign g_mx = '0'
  endunless
-%}
<div class="apex-tb-group stack{% if g_card %} card{% endif %}" style="gap:{{ g_gap }}px;text-align:{{ g_align }};{% if g_card %}padding:{{ g_pad }}px;{% endif %}{% if g_mw > 0 %}max-width:{{ g_mw }}px;margin-inline:{{ g_mx }};{% endif %}" {{ block.shopify_attributes }}>
  {%- for b in block.blocks -%}
    {%- render b -%}
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "Group",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Gap between children",
      "default": 16
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "card",
      "label": "Card background + border",
      "default": false
    },
    {
      "type": "range",
      "id": "padding",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Card padding (when enabled)",
      "default": 32
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 1200,
      "step": 40,
      "unit": "px",
      "label": "Max width (0 = full)",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Center when max width is set",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Group",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}
