<div class="apex-tb-announcement" {{ block.shopify_attributes }}>
  {%- liquid
    assign has_link = false
    if block.settings.link != blank
      assign has_link = true
    endif
  -%}
  {%- if has_link -%}
    <a href="{{ block.settings.link }}" class="apex-tb-announcement__inner cluster">
  {%- else -%}
    <div class="apex-tb-announcement__inner cluster">
  {%- endif -%}
      {%- if block.settings.icon != blank -%}
        <span class="apex-tb-announcement__icon" aria-hidden="true">{%- render 'icon', icon: block.settings.icon -%}</span>
      {%- endif -%}
      {%- if block.settings.text != blank -%}
        <span class="apex-tb-announcement__text">{{ block.settings.text | escape }}</span>
      {%- endif -%}
      {%- if has_link and block.settings.link_label != blank -%}
        <span class="apex-tb-announcement__cta" aria-hidden="true">{{ block.settings.link_label | escape }} →</span>
      {%- endif -%}
  {%- if has_link -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</div>
{% stylesheet %}
.apex-tb-announcement {
  display: inline-flex;
  max-width: 100%;
}
.apex-tb-announcement__inner {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  padding: .45rem 1rem;
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  border: var(--border-width) solid color-mix(in srgb, var(--accent) 30%, transparent);
  border-radius: var(--radius-pill);
  font-size: .9rem;
  font-weight: 500;
  color: var(--accent);
  text-decoration: none;
  transition: background .18s, border-color .18s;
}
a.apex-tb-announcement__inner:hover {
  background: color-mix(in srgb, var(--accent) 20%, transparent);
  border-color: var(--accent);
}
.apex-tb-announcement__icon {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  width: 1rem;
  height: 1rem;
}
.apex-tb-announcement__icon svg { width: 100%; height: 100%; }
.apex-tb-announcement__cta { font-weight: 600; white-space: nowrap; }
{% endstylesheet %}
{% schema %}
{
  "name": "Announcement pill",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "default": "star",
      "options": [
        {
          "value": "",
          "label": "None"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "check",
          "label": "Check"
        },
        {
          "value": "truck",
          "label": "Truck"
        },
        {
          "value": "shield",
          "label": "Shield"
        },
        {
          "value": "leaf",
          "label": "Leaf"
        },
        {
          "value": "return",
          "label": "Return"
        },
        {
          "value": "arrow-right",
          "label": "Arrow right"
        },
        {
          "value": "plus",
          "label": "Plus"
        }
      ]
    },
    {
      "type": "text",
      "id": "text",
      "label": "Callout text",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Learn more"
    }
  ],
  "presets": [
    {
      "name": "Announcement pill"
    }
  ]
}
{% endschema %}
