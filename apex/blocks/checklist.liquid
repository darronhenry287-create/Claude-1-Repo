{%- liquid
  assign items = block.settings.items | newline_to_br | split: '<br />'
-%}
<div class="apex-tb-checklist stack" style="gap:{{ block.settings.gap }}px;text-align:{{ block.settings.align }}" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <p class="{{ block.settings.heading_size }}" style="font-family:var(--font-heading);font-weight:var(--font-heading-weight)">{{ block.settings.heading | escape }}</p>
  {%- endif -%}
  <ul class="apex-tb-checklist__list stack" style="gap:{{ block.settings.item_gap }}px;list-style:none;padding:0">
    {%- for item in items -%}
      {%- assign trimmed = item | strip -%}
      {%- if trimmed != blank -%}
        <li class="apex-tb-checklist__item">
          <span class="apex-tb-checklist__icon" aria-hidden="true" style="color:var(--accent)">
            {%- render 'icon', icon: 'check' -%}
          </span>
          <span>{{ trimmed | strip_html | escape }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>
{% stylesheet %}
.apex-tb-checklist__list { list-style: none; padding: 0; }
.apex-tb-checklist__item { display: flex; align-items: flex-start; gap: .65em; line-height: 1.5; }
.apex-tb-checklist__icon { flex: none; width: 1.2em; height: 1.2em; margin-top: .15em; display: inline-flex; }
.apex-tb-checklist__icon svg { width: 100%; height: 100%; }
{% endstylesheet %}
{% schema %}
{
  "name": "Checklist",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)", "default": "What's included" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "h4", "options": [{"value":"h3","label":"Large"},{"value":"h4","label":"Medium"},{"value":"h5","label":"Small"}] },
    { "type": "textarea", "id": "items", "label": "Items (one per line)", "default": "Free shipping on all orders\n30-day money-back guarantee\nLifetime customer support\nEco-friendly packaging" },
    { "type": "range", "id": "gap", "min": 4, "max": 32, "step": 4, "unit": "px", "label": "Heading gap", "default": 12 },
    { "type": "range", "id": "item_gap", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Item gap", "default": 10 },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"}] }
  ],
  "presets": [ { "name": "Checklist" } ]
}
{% endschema %}
