<div class="apex-tb-social-icons cluster" style="justify-content:{{ block.settings.align }};gap:{{ block.settings.gap }}px" {{ block.shopify_attributes }}>
  {%- if block.settings.instagram != blank -%}
    <a href="{{ block.settings.instagram | escape }}" class="apex-tb-social-icons__link icon-btn" target="_blank" rel="noopener noreferrer" aria-label="Instagram" style="width:{{ block.settings.size }}px;height:{{ block.settings.size }}px">
      {%- render 'icon', icon: 'instagram' -%}
    </a>
  {%- endif -%}
  {%- if block.settings.tiktok != blank -%}
    <a href="{{ block.settings.tiktok | escape }}" class="apex-tb-social-icons__link icon-btn" target="_blank" rel="noopener noreferrer" aria-label="TikTok" style="width:{{ block.settings.size }}px;height:{{ block.settings.size }}px">
      {%- render 'icon', icon: 'tiktok' -%}
    </a>
  {%- endif -%}
  {%- if block.settings.facebook != blank -%}
    <a href="{{ block.settings.facebook | escape }}" class="apex-tb-social-icons__link icon-btn" target="_blank" rel="noopener noreferrer" aria-label="Facebook" style="width:{{ block.settings.size }}px;height:{{ block.settings.size }}px">
      {%- render 'icon', icon: 'facebook' -%}
    </a>
  {%- endif -%}
  {%- if block.settings.youtube != blank -%}
    <a href="{{ block.settings.youtube | escape }}" class="apex-tb-social-icons__link icon-btn" target="_blank" rel="noopener noreferrer" aria-label="YouTube" style="width:{{ block.settings.size }}px;height:{{ block.settings.size }}px">
      {%- render 'icon', icon: 'youtube' -%}
    </a>
  {%- endif -%}
  {%- if block.settings.x != blank -%}
    <a href="{{ block.settings.x | escape }}" class="apex-tb-social-icons__link icon-btn" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" style="width:{{ block.settings.size }}px;height:{{ block.settings.size }}px">
      {%- render 'icon', icon: 'x' -%}
    </a>
  {%- endif -%}
</div>
{% stylesheet %}
.apex-tb-social-icons__link svg { width: 55%; height: 55%; }
{% endstylesheet %}
{% schema %}
{
  "name": "Social icons",
  "settings": [
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "text",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "text",
      "id": "facebook",
      "label": "Facebook URL"
    },
    {
      "type": "text",
      "id": "youtube",
      "label": "YouTube URL"
    },
    {
      "type": "text",
      "id": "x",
      "label": "X (Twitter) URL"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "size",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 40
    },
    {
      "type": "range",
      "id": "gap",
      "min": 4,
      "max": 32,
      "step": 4,
      "unit": "px",
      "label": "Gap",
      "default": 8
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "flex-start",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social icons"
    }
  ]
}
{% endschema %}
