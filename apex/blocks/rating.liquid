<div class="apex-tb-rating" style="text-align:{{ block.settings.align }}" {{ block.shopify_attributes }}>
  {%- render 'rating', value: block.settings.value, count: block.settings.count -%}
</div>
{% schema %}
{
  "name": "Rating",
  "settings": [
    { "type": "range", "id": "value", "min": 0, "max": 5, "step": 0.1, "label": "Rating value", "default": 4.8 },
    { "type": "number", "id": "count", "label": "Review count", "default": 120 },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] }
  ],
  "presets": [ { "name": "Rating" } ]
}
{% endschema %}
