<ul class="apex-tb-icon-list stack" {{ block.shopify_attributes }}>
  {%- if block.settings.item_1 != blank -%}
    <li class="apex-tb-icon-list__row">
      <span class="apex-tb-icon-list__icon" aria-hidden="true">{%- render 'icon', icon: block.settings.icon_1 -%}</span>
      <span>{{ block.settings.item_1 | escape }}</span>
    </li>
  {%- endif -%}
  {%- if block.settings.item_2 != blank -%}
    <li class="apex-tb-icon-list__row">
      <span class="apex-tb-icon-list__icon" aria-hidden="true">{%- render 'icon', icon: block.settings.icon_2 -%}</span>
      <span>{{ block.settings.item_2 | escape }}</span>
    </li>
  {%- endif -%}
  {%- if block.settings.item_3 != blank -%}
    <li class="apex-tb-icon-list__row">
      <span class="apex-tb-icon-list__icon" aria-hidden="true">{%- render 'icon', icon: block.settings.icon_3 -%}</span>
      <span>{{ block.settings.item_3 | escape }}</span>
    </li>
  {%- endif -%}
  {%- if block.settings.item_4 != blank -%}
    <li class="apex-tb-icon-list__row">
      <span class="apex-tb-icon-list__icon" aria-hidden="true">{%- render 'icon', icon: block.settings.icon_4 -%}</span>
      <span>{{ block.settings.item_4 | escape }}</span>
    </li>
  {%- endif -%}
  {%- if block.settings.item_5 != blank -%}
    <li class="apex-tb-icon-list__row">
      <span class="apex-tb-icon-list__icon" aria-hidden="true">{%- render 'icon', icon: block.settings.icon_5 -%}</span>
      <span>{{ block.settings.item_5 | escape }}</span>
    </li>
  {%- endif -%}
  {%- if block.settings.item_6 != blank -%}
    <li class="apex-tb-icon-list__row">
      <span class="apex-tb-icon-list__icon" aria-hidden="true">{%- render 'icon', icon: block.settings.icon_6 -%}</span>
      <span>{{ block.settings.item_6 | escape }}</span>
    </li>
  {%- endif -%}
</ul>
{% stylesheet %}
.apex-tb-icon-list { padding: 0; }
.apex-tb-icon-list__row {
  display: flex;
  align-items: center;
  gap: .75rem;
  font-size: .97rem;
}
.apex-tb-icon-list__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 1.4rem;
  height: 1.4rem;
  color: var(--accent);
}
.apex-tb-icon-list__icon svg { width: 100%; height: 100%; }
{% endstylesheet %}
