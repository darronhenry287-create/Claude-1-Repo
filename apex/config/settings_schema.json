[
  {
    "name": "theme_info",
    "theme_name": "Apex",
    "theme_version": "1.0.0",
    "theme_author": "Apex",
    "theme_documentation_url": "https://example.com/apex/docs",
    "theme_support_url": "https://example.com/apex/support"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 320,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 150
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (32×32)"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "header",
            "content": "Surfaces"
          },
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#ffffff"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background gradient"
          },
          {
            "type": "color",
            "id": "bg_alt",
            "label": "Alt surface",
            "default": "#f5f7fb"
          },
          {
            "type": "color",
            "id": "card",
            "label": "Card",
            "default": "#ffffff"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Border",
            "default": "#e5e9f0"
          },
          {
            "type": "header",
            "content": "Text"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#111827"
          },
          {
            "type": "header",
            "content": "Accent & buttons"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent",
            "default": "#2f5bff"
          },
          {
            "type": "color",
            "id": "on_accent",
            "label": "Text on accent",
            "default": "#ffffff"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Primary button",
            "default": "#2f5bff"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Primary button text",
            "default": "#ffffff"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "Secondary button text",
            "default": "#111827"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "Shadow",
            "default": "#0b1220"
          }
        ],
        "role": {
          "background": {
            "solid": "background",
