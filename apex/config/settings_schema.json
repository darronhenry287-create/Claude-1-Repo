  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n7"
      },
      {
        "type": "range",
        "id": "heading_weight",
        "min": 500,
        "max": 900,
        "step": 100,
        "label": "Heading weight",
        "default": 800
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "min": -50,
        "max": 50,
        "step": 5,
        "unit": "/1000em",
        "label": "Heading letter spacing",
        "default": -20
      },
      {
        "type": "range",
        "id": "heading_line_height",
        "min": 90,
        "max": 160,
        "step": 2,
        "unit": "%",
        "label": "Heading line height",
        "default": 108
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_font_size",
        "min": 90,
        "max": 120,
        "step": 1,
        "unit": "%",
        "label": "Base text size",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_line_height",
        "min": 140,
        "max": 200,
        "step": 5,
        "unit": "%",
        "label": "Body line height",
        "default": 165
      },
      {
        "type": "range",
        "id": "type_scale",
        "min": 110,
        "max": 140,
        "step": 2,
        "unit": "%",
        "label": "Heading scale ratio",
        "default": 122
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1280
      },
      {
        "type": "range",
        "id": "gutter_desktop",
        "min": 16,
        "max": 64,
        "step": 2,
        "unit": "px",
        "label": "Desktop side padding",
        "default": 40
      },
      {
        "type": "range",
        "id": "gutter_mobile",
        "min": 12,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Mobile side padding",
        "default": 16
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 24,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Section spacing",
        "default": 72
      }
    ]
  },
  {
    "name": "Shape & style",
    "settings": [
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "Button radius",
        "default": 10
      },
      {
        "type": "checkbox",
        "id": "button_uppercase",
        "label": "Uppercase buttons",
        "default": false
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "label": "Card radius",
        "default": 16
      },
      {
        "type": "range",
        "id": "input_radius",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "label": "Input radius",
        "default": 10
      },
      {
        "type": "range",
        "id": "border_width",
        "min": 1,
        "max": 3,
        "step": 1,
        "unit": "px",
        "label": "Border width",
        "default": 1
      },
      {
        "type": "range",
        "id": "shadow_opacity",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "%",
        "label": "Shadow strength",
        "default": 8
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          {
            "value": "adapt",
            "label": "Adapt to image"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          }
        ],
        "default": "square"
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show rating",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_secondary_image",
        "label": "Show 2nd image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Enable quick add",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Show colour swatches",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          },
          {
            "value": "notification",
            "label": "Popup notification"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_free_shipping_bar",
        "label": "Show free-shipping progress bar",
        "default": true
      },
      {
        "type": "range",
        "id": "cart_free_shipping_threshold",
        "min": 0,
        "max": 500,
        "step": 5,
        "unit": "$",
        "label": "Free-shipping threshold",
        "default": 50
      },
      {
        "type": "checkbox",
        "id": "cart_note",
        "label": "Enable cart note",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_upsell",
        "label": "Show cart upsell",
        "default": true
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "Reveal sections on scroll",
        "default": true
      },
      {
        "type": "range",
        "id": "anim_duration",
        "min": 200,
        "max": 1000,
        "step": 50,
        "unit": "ms",
        "label": "Animation duration",
        "default": 500
      },
      {
        "type": "range",
        "id": "anim_distance",
        "min": 0,
        "max": 60,
        "step": 4,
        "unit": "px",
        "label": "Reveal travel distance",
        "default": 24
      },
      {
        "type": "checkbox",
        "id": "hover_lift",
        "label": "Lift cards on hover",
        "default": true
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search",
        "label": "Enable predictive search",
        "default": true
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "social_x",
        "label": "X / Twitter URL"
      }
    ]
  }
]
