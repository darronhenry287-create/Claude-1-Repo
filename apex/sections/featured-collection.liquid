{%- liquid
  assign s = section.settings
  assign feat_collection = collections[s.collection]
  assign col_class = 'grid--4'
  if s.columns == 2
    assign col_class = 'grid--2'
  elsif s.columns == 3
    assign col_class = 'grid--3'
  endif
-%}
<section class="apex-featured-collection color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px">
  <div class="page-width">

    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="section-head{% if s.heading_align == 'center' %} section-head--center{% endif %} reveal">
        {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.description != blank -%}<p class="subtitle">{{ s.description }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- assign products_to_show = feat_collection.products | default: feat_collection -%}
    <div class="grid {{ col_class }}">
      {%- if feat_collection != blank -%}
        {%- for product in feat_collection.products limit: s.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.limit) -%}
          {% render 'product-card', product: nil %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if s.button_label != blank -%}
      <div class="apex-featured-collection__cta center reveal" style="margin-top:clamp(1.6rem,1rem + 2vw,2.6rem)">
        {%- assign cta_url = feat_collection.url | default: s.button_url | default: routes.collections_url -%}
        <a class="btn btn--secondary btn--lg" href="{{ cta_url }}">
          {{ s.button_label }}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>
{% stylesheet %}
.apex-featured-collection__cta { margin-top: clamp(1.6rem, 1rem + 2vw, 2.6rem); }
{% endstylesheet %}
{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Shop now" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our bestsellers" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    },
    { "type": "text", "id": "button_label", "label": "View-all button label", "default": "Shop all" },
    { "type": "url", "id": "button_url", "label": "View-all link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "settings": {
        "heading": "Our bestsellers",
        "subheading": "Shop now",
        "limit": 4,
        "columns": 4,
        "button_label": "Shop all"
      }
    }
  ]
}
{% endschema %}
