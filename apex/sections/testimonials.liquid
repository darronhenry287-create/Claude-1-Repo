{%- liquid
  assign s = section.settings
  assign block_count = section.blocks | size
-%}
<section class="apex-testimonials color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="testimonials-{{ section.id }}">
  <div class="page-width">
    <div class="reveal">
      {%- if s.heading != blank or s.subheading != blank -%}
        <div class="section-head{% if s.center_header %} section-head--center{% endif %}">
          {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.text != blank -%}<p class="subtitle balance">{{ s.text }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="apex-testimonials__outer">
        <div class="slider apex-testimonials__slider" data-slider id="slider-{{ section.id }}" role="list"
          aria-label="{{ s.heading | default: 'Testimonials' | escape }}">
          {%- for block in section.blocks -%}
            {%- assign stars = block.settings.rating | plus: 0 -%}
            <div class="apex-testimonials__slide card" role="listitem" {{ block.shopify_attributes }}>
              <div class="apex-testimonials__stars" aria-label="{{ stars }} out of 5 stars">
                {%- for i in (1..5) -%}
                  <span class="apex-testimonials__star{% if i > stars %} apex-testimonials__star--empty{% endif %}" aria-hidden="true">
                    {% render 'icon', icon: 'star' %}
                  </span>
                {%- endfor -%}
              </div>
              <blockquote class="apex-testimonials__quote">
                <p>{{ block.settings.quote }}</p>
              </blockquote>
              <footer class="apex-testimonials__footer">
                {%- if block.settings.avatar != blank -%}
                  <div class="apex-testimonials__avatar media media--round media--square">
                    {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', alt: block.settings.author | escape }}
                  </div>
                {%- else -%}
                  <div class="apex-testimonials__avatar apex-testimonials__avatar--placeholder">
                    {%- assign initials = block.settings.author | truncate: 1, '' -%}
                    <span aria-hidden="true">{{ initials }}</span>
                  </div>
                {%- endif -%}
                <div class="apex-testimonials__meta">
                  <cite class="apex-testimonials__author">{{ block.settings.author | default: 'Happy Customer' }}</cite>
                  {%- if block.settings.location != blank -%}
                    <span class="apex-testimonials__location muted">{{ block.settings.location }}</span>
                  {%- endif -%}
                  {%- if block.settings.verified -%}
                    <span class="badge">{% render 'icon', icon: 'check' %} Verified</span>
                  {%- endif -%}
                </div>
              </footer>
            </div>
          {%- endfor -%}
        </div>

        {%- if block_count > 1 -%}
          <div class="apex-testimonials__nav cluster" style="justify-content:center;margin-top:1.8rem">
            <div class="slider-nav">
              <button data-slider-prev="{{ section.id }}" aria-label="Previous testimonial">
                {% render 'icon', icon: 'arrow-left' %}
              </button>
              <button data-slider-next="{{ section.id }}" aria-label="Next testimonial">
                {% render 'icon', icon: 'arrow-right' %}
              </button>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.apex-testimonials__outer { position: relative; }
.apex-testimonials__slider { gap: var(--gutter); padding-bottom: .5rem; align-items: stretch; }
.apex-testimonials__slide {
  padding: 1.8rem;
  width: min(440px, 80vw);
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}
.apex-testimonials__stars { display: flex; gap: .25rem; }
.apex-testimonials__star { color: var(--star); width: 1.1rem; height: 1.1rem; }
.apex-testimonials__star--empty { color: var(--border); }
.apex-testimonials__star svg { width: 100%; height: 100%; }
.apex-testimonials__quote { flex: 1; font-size: 1.04rem; line-height: 1.65; color: var(--text); font-style: italic; }
.apex-testimonials__quote p::before { content: '\201C'; }
.apex-testimonials__quote p::after { content: '\201D'; }
.apex-testimonials__footer { display: flex; align-items: center; gap: .9rem; margin-top: auto; }
.apex-testimonials__avatar { width: 3rem; height: 3rem; flex: none; border-radius: var(--radius-pill); overflow: hidden; background: var(--bg-alt); }
.apex-testimonials__avatar--placeholder { display: grid; place-items: center; background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--accent); font-weight: 700; font-size: 1.1rem; border-radius: var(--radius-pill); }
.apex-testimonials__meta { display: flex; flex-direction: column; gap: .2rem; }
.apex-testimonials__author { font-style: normal; font-weight: 700; font-size: .95rem; }
.apex-testimonials__location { font-size: var(--text-xs); }
@media (max-width: 600px) { .apex-testimonials__slide { width: min(340px, 88vw); padding: 1.4rem; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "What people say" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by thousands" },
    { "type": "text", "id": "text", "label": "Subtext", "default": "Real reviews from real customers." },
    { "type": "checkbox", "id": "center_header", "label": "Center header", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Star rating", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "This product completely changed my routine. The quality is outstanding and the results speak for themselves." },
        { "type": "text", "id": "author", "label": "Author name", "default": "Alex M." },
        { "type": "text", "id": "location", "label": "Location", "default": "New York, USA" },
        { "type": "image_picker", "id": "avatar", "label": "Avatar image" },
        { "type": "checkbox", "id": "verified", "label": "Show verified badge", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Absolutely incredible. I was skeptical at first, but after just two weeks I saw a real difference. Highly recommend to everyone.", "author": "Jamie R.", "location": "Austin, TX", "rating": 5, "verified": true } },
        { "type": "testimonial", "settings": { "quote": "Fast shipping, great packaging, and the product itself exceeded my expectations. This is my new go-to.", "author": "Priya S.", "location": "London, UK", "rating": 5, "verified": true } },
        { "type": "testimonial", "settings": { "quote": "Five stars without hesitation. The customer support team was also super helpful when I had a question.", "author": "Marcus T.", "location": "Chicago, IL", "rating": 5, "verified": true } }
      ]
    }
  ]
}
{% endschema %}
