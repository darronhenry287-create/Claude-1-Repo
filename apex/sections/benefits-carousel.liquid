{%- liquid
  assign s = section.settings
-%}
<section class="apex-benefits-carousel color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="benefits-carousel-{{ section.id }}">
  <div class="page-width">

    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="section-head section-head--center reveal">
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--pill">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="subtitle balance muted">{{ s.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="apex-bc__outer reveal">
      <div class="apex-bc__slider slider" data-slider aria-label="{{ s.heading | escape | default: 'Benefits' }}">
        {%- for block in section.blocks -%}
          <div class="apex-bc__slide" role="group" aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}" {{ block.shopify_attributes }}>
            <div class="apex-bc__card card">
              {%- if block.settings.icon != blank -%}
                <div class="apex-bc__icon">
                  {% render 'icon', icon: block.settings.icon %}
                </div>
              {%- else -%}
                <div class="apex-bc__icon">
                  {% render 'icon', icon: 'star' %}
                </div>
              {%- endif -%}
              <div class="apex-bc__body stack">
                {%- if block.settings.heading != blank -%}
                  <h3 class="h4">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte muted">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="apex-bc__controls">
        <button class="apex-bc__arrow btn btn--ghost btn--sm" data-slider-prev aria-label="Previous">
          {% render 'icon', icon: 'arrow-left' %}
        </button>
        <div class="apex-bc__dots" aria-label="Carousel pagination">
          {%- for block in section.blocks -%}
            <button class="apex-bc__dot{% if forloop.first %} is-active{% endif %}" aria-label="Go to slide {{ forloop.index }}" data-dot="{{ forloop.index0 }}"></button>
          {%- endfor -%}
        </div>
        <button class="apex-bc__arrow btn btn--ghost btn--sm" data-slider-next aria-label="Next">
          {% render 'icon', icon: 'arrow-right' %}
        </button>
      </div>

    </div>

  </div>
</section>
{% stylesheet %}
.apex-bc__outer { position: relative; }
.apex-bc__slider {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  gap: var(--gutter);
  -ms-overflow-style: none;
  scrollbar-width: none;
  padding-bottom: .25rem;
}
.apex-bc__slider::-webkit-scrollbar { display: none; }
.apex-bc__slide {
  flex: 0 0 calc((100% - var(--gutter) * (var(--bc-cols, 3) - 1)) / var(--bc-cols, 3));
  scroll-snap-align: start;
}
.apex-bc__card {
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  padding: clamp(1.4rem, 1.2rem + 2vw, 2.25rem);
  border-radius: var(--radius-card);
  background: var(--card);
  box-shadow: var(--shadow-card);
  border: var(--border-width) solid var(--border);
  transition: box-shadow .25s var(--ease), transform .25s var(--ease);
}
.apex-bc__card:hover {
  box-shadow: var(--shadow-pop);
  transform: translateY(-3px);
}
.apex-bc__icon {
  width: 3.25rem;
  height: 3.25rem;
  display: grid;
  place-items: center;
  border-radius: var(--radius);
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  color: var(--accent);
  flex: none;
}
.apex-bc__icon svg { width: 1.5rem; height: 1.5rem; }
.apex-bc__body { gap: .5rem; }
.apex-bc__controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-top: 1.75rem;
}
.apex-bc__arrow {
  width: 2.5rem;
  height: 2.5rem;
  display: grid;
  place-items: center;
  border-radius: 50%;
  border: var(--border-width) solid var(--border);
  color: var(--text);
  transition: background .2s, border-color .2s;
  padding: 0;
}
.apex-bc__arrow:hover { background: var(--bg-alt); border-color: var(--accent); }
.apex-bc__arrow svg { width: 1.1rem; height: 1.1rem; }
.apex-bc__dots { display: flex; gap: .4rem; align-items: center; }
.apex-bc__dot {
  width: .5rem;
  height: .5rem;
  border-radius: 50%;
  background: var(--border);
  border: none;
  transition: background .2s, transform .2s;
  padding: 0;
  cursor: pointer;
}
.apex-bc__dot.is-active, .apex-bc__dot:hover {
  background: var(--accent);
  transform: scale(1.3);
}
@media (min-width: 990px) {
  .apex-bc__slider { --bc-cols: 3; }
}
@media (min-width: 600px) and (max-width: 989px) {
  .apex-bc__slider { --bc-cols: 2; }
}
@media (max-width: 599px) {
  .apex-bc__slider { --bc-cols: 1; }
}
{% endstylesheet %}
{% javascript %}
(function(){
  document.querySelectorAll('#benefits-carousel-{{ section.id }} [data-slider]').forEach(function(track){
    var outer = track.closest('.apex-bc__outer');
    var dots = outer ? outer.querySelectorAll('.apex-bc__dot') : [];
    function getActiveIndex(){
      var slides = track.querySelectorAll('.apex-bc__slide');
      var trackLeft = track.getBoundingClientRect().left;
      var closest = 0;
      var minDist = Infinity;
      slides.forEach(function(slide, i){
        var dist = Math.abs(slide.getBoundingClientRect().left - trackLeft);
        if(dist < minDist){ minDist = dist; closest = i; }
      });
      return closest;
    }
    function updateDots(){
      var idx = getActiveIndex();
      dots.forEach(function(d, i){ d.classList.toggle('is-active', i === idx); });
    }
    track.addEventListener('scroll', updateDots, { passive: true });
    dots.forEach(function(dot, i){
      dot.addEventListener('click', function(){
        var slides = track.querySelectorAll('.apex-bc__slide');
        if(slides[i]){ slides[i].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' }); }
      });
    });
  });
})();
{% endjavascript %}
{% schema %}
{
  "name": "Benefits carousel",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Why choose us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "star",
          "options": [
            { "value": "star",    "label": "Star" },
            { "value": "truck",   "label": "Truck" },
            { "value": "shield",  "label": "Shield" },
            { "value": "leaf",    "label": "Leaf" },
            { "value": "return",  "label": "Return" },
            { "value": "check",   "label": "Check" },
            { "value": "bag",     "label": "Bag" },
            { "value": "user",    "label": "User" },
            { "value": "search",  "label": "Search" }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Benefit heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Describe this benefit clearly and concisely so customers immediately understand the value you offer.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits carousel",
      "settings": {
        "heading": "Everything you need"
      },
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "truck",
            "heading": "Free & fast shipping",
            "text": "<p>Orders over $50 ship free. Express options available at checkout, with tracking from dispatch to door.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "heading": "Quality you can trust",
            "text": "<p>Every product passes rigorous quality checks before leaving our facility. We stand behind what we make.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "return",
            "heading": "Hassle-free returns",
            "text": "<p>Not quite right? Return any item within 60 days for a full refund — no questions asked.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "heading": "Sustainably made",
            "text": "<p>From responsible sourcing to carbon-neutral shipping, we take the long view on our impact.</p>"
          }
        },
        {
          "type": "benefit",
