{%- liquid
  assign s = section.settings
  assign per_row = s.tiles_per_row | default: 3
-%}
<section class="apex-featured-links color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="featured-links-{{ section.id }}">
  <div class="page-width">

    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="section-head section-head--center reveal">
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--pill">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="subtitle balance">{{ s.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="apex-fl__grid reveal" style="--per-row:{{ per_row }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_ratio = s.image_ratio | default: 'portrait'
          assign has_link = false
          if block.settings.link_url != blank
            assign has_link = true
          endif
        -%}
        <div class="apex-fl__tile" {{ block.shopify_attributes }}>
          <div class="apex-fl__media media media--{{ tile_ratio }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', sizes: '(min-width:990px) 33vw, 100vw', alt: block.settings.image.alt }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <div class="apex-fl__overlay">
              {%- if block.settings.eyebrow != blank -%}
                <p class="apex-fl__eyebrow eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <p class="apex-fl__heading">{{ block.settings.heading }}</p>
              {%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <span class="btn btn--accent btn--sm">{{ block.settings.link_label }}</span>
              {%- endif -%}
            </div>
          </div>
          {%- if has_link -%}
            <a class="apex-fl__link" href="{{ block.settings.link_url }}" aria-label="{{ block.settings.heading | escape }}"></a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>
{% stylesheet %}
.apex-fl__grid {
  display: grid;
  grid-template-columns: repeat(var(--per-row, 3), 1fr);
  gap: var(--gutter);
}
.apex-fl__tile {
  position: relative;
  border-radius: var(--radius-card);
  overflow: hidden;
}
.apex-fl__tile:hover .apex-fl__media img { transform: scale(1.05); }
.apex-fl__media { display: block; border-radius: 0; }
.apex-fl__media img {
  transition: transform .6s var(--ease);
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.apex-fl__overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: clamp(1rem, 1rem + 1.5vw, 2rem);
  background: linear-gradient(to top, rgba(0,0,0,.65) 0%, rgba(0,0,0,.1) 60%, transparent 100%);
  color: #fff;
  gap: .5rem;
  transition: background .3s var(--ease);
}
.apex-fl__tile:hover .apex-fl__overlay { background: linear-gradient(to top, rgba(0,0,0,.75) 0%, rgba(0,0,0,.15) 60%, transparent 100%); }
.apex-fl__eyebrow { font-size: var(--text-xs); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; opacity: .85; color: #fff; }
.apex-fl__heading { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(1.1rem, .9rem + 1.2vw, 1.8rem); line-height: 1.15; letter-spacing: var(--heading-letter-spacing); }
.apex-fl__link { position: absolute; inset: 0; z-index: 3; }
@media (max-width: 990px) {
  .apex-fl__grid { grid-template-columns: repeat(min(var(--per-row, 3), 2), 1fr); }
}
@media (max-width: 600px) {
  .apex-fl__grid { grid-template-columns: 1fr; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Featured links",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "tiles_per_row",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Tiles per row",
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Tile image ratio",
      "default": "portrait",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "wide", "label": "Wide (16:9)" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Promo tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop the collection"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured links",
      "blocks": [
        {
          "type": "tile",
          "settings": { "eyebrow": "New in", "heading": "Bestsellers", "link_label": "Shop now" }
        },
        {
          "type": "tile",
          "settings": { "eyebrow": "Limited run", "heading": "Summer edit", "link_label": "Explore" }
        },
        {
          "type": "tile",
          "settings": { "eyebrow": "Just dropped", "heading": "Gift sets", "link_label": "Discover" }
        }
      ]
    }
  ]
}
{% endschema %}
