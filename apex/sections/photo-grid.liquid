{%- liquid
  assign s = section.settings
-%}
<section class="apex-photo-grid color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="photo-grid-{{ section.id }}">
  <div class="page-width{% if s.full_width %} page-width--full{% endif %}">

    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="section-head{% if s.center_header %} section-head--center{% endif %} reveal"
        style="{% if s.full_width %}padding-inline:var(--gutter);{% endif %}">
        {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="apex-photo-grid__grid reveal"
      style="--pg-cols:{{ s.columns }};--pg-gap:{{ s.gap }}px">
      {%- for block in section.blocks -%}
        {%- liquid
          assign pg_span = block.settings.double_width
        -%}
        <div class="apex-photo-grid__item{% if pg_span %} apex-photo-grid__item--wide{% endif %}"
          {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="apex-photo-grid__anchor"
              aria-label="{{ block.settings.caption | default: 'View image' | escape }}"
              {%- if block.settings.lightbox %} data-lightbox{% endif %}>
          {%- else -%}
            <div class="apex-photo-grid__anchor">
          {%- endif -%}
            <div class="apex-photo-grid__media media{% if s.aspect_ratio == 'square' %} media--square{% elsif s.aspect_ratio == 'portrait' %} media--portrait{% elsif s.aspect_ratio == 'landscape' %} media--landscape{% else %} apex-photo-grid__media--auto{% endif %}">
              {%- if block.settings.image != blank -%}
                {%- assign pg_alt = block.settings.caption | default: '' -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag:
                    loading: 'lazy',
                    widths: '400,600,800,1200',
                    sizes: '(min-width:990px) calc(var(--page-width) / var(--pg-cols)), 50vw',
                    alt: pg_alt }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <div class="apex-photo-grid__caption-overlay" aria-hidden="true">
                  <p class="apex-photo-grid__caption-text">{{ block.settings.caption }}</p>
                </div>
              {%- endif -%}
            </div>
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>
{% stylesheet %}
.apex-photo-grid__grid {
  display: grid;
  grid-template-columns: repeat(var(--pg-cols, 3), 1fr);
  gap: var(--pg-gap, 12px);
}
.apex-photo-grid__item--wide { grid-column: span 2; }
.apex-photo-grid__anchor { display: block; overflow: hidden; border-radius: var(--radius-card); position: relative; }
.apex-photo-grid__anchor img { transition: transform .6s var(--ease); }
.apex-photo-grid__anchor:hover img { transform: scale(1.05); }
.apex-photo-grid__media--auto { aspect-ratio: auto; }
.apex-photo-grid__media--auto img { width: 100%; height: auto; }
.apex-photo-grid__caption-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.55) 0%, transparent 55%);
  display: flex; align-items: flex-end; padding: 1rem;
  opacity: 0; transition: opacity .3s var(--ease);
}
.apex-photo-grid__anchor:hover .apex-photo-grid__caption-overlay { opacity: 1; }
.apex-photo-grid__caption-text { color: #fff; font-size: var(--text-sm); font-weight: 600; line-height: 1.3; }
@media (max-width: 749px) {
  .apex-photo-grid__grid { grid-template-columns: repeat(2, 1fr) !important; }
  .apex-photo-grid__item--wide { grid-column: span 2; }
}
@media (max-width: 480px) {
  .apex-photo-grid__grid { grid-template-columns: 1fr !important; }
  .apex-photo-grid__item--wide { grid-column: span 1; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Photo grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The collection"
    },
    {
      "type": "checkbox",
      "id": "center_header",
      "label": "Center header",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between images",
      "default": 8
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "default": "square",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "auto", "label": "Natural (no crop)" }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (shown on hover)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "double_width",
          "label": "Double width (spans 2 columns)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Photo grid",
      "blocks": [
        { "type": "photo", "settings": { "caption": "The everyday essential." } },
        { "type": "photo", "settings": { "caption": "Clean by design." } },
        { "type": "photo", "settings": { "caption": "Made to last.", "double_width": true } },
        { "type": "photo", "settings": { "caption": "Details matter." } },
        { "type": "photo", "settings": { "caption": "Built different." } }
      ]
    }
  ]
}
{% endschema %}
