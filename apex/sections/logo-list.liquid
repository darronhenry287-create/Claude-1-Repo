{%- liquid
  assign s = section.settings
  assign use_marquee = s.marquee
-%}
<section class="apex-logo-list color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="logo-list-{{ section.id }}">
  <div class="page-width">

    {%- if s.heading != blank -%}
      <div class="section-head section-head--center reveal">
        <p class="eyebrow">{{ s.heading }}</p>
      </div>
    {%- endif -%}

    {%- if use_marquee -%}
      <div class="reveal marquee apex-logo-list__marquee" aria-hidden="true" style="--marquee-speed:{{ s.marquee_speed }}s">
        <div class="marquee__track apex-logo-list__track">
          {%- for i in (1..3) -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'logo' -%}
                <div class="apex-logo-list__item{% if s.grayscale %} apex-logo-list__item--gray{% endif %}" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" tabindex="-1">{%- endif -%}
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '120,200,300,400', sizes: '120px', alt: block.settings.image.alt, class: 'apex-logo-list__logo' }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg apex-logo-list__logo' }}
                  {%- endif -%}
                  {%- if block.settings.link != blank -%}</a>{%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="visually-hidden">
        {%- for block in section.blocks -%}{{ block.settings.image.alt | default: 'Brand logo' }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}
      </div>
    {%- else -%}
      <div class="apex-logo-list__grid reveal">
        {%- for block in section.blocks -%}
          {%- if block.type == 'logo' -%}
            <div class="apex-logo-list__item{% if s.grayscale %} apex-logo-list__item--gray{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '120,200,300,400', sizes: '(min-width:990px) 160px, 120px', alt: block.settings.image.alt, class: 'apex-logo-list__logo' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg apex-logo-list__logo' }}
              {%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>
{% stylesheet %}
.apex-logo-list__grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
}
.apex-logo-list__marquee { overflow: hidden; }
.apex-logo-list__track {
  display: inline-flex;
  align-items: center;
  gap: clamp(2rem, 1.5rem + 3vw, 4rem);
}
.apex-logo-list__item {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  transition: opacity .2s;
}
.apex-logo-list__item a {
  display: block;
}
.apex-logo-list__item a:hover { opacity: .7; }
.apex-logo-list__logo {
  display: block;
  height: clamp(1.8rem, 1.4rem + 1.5vw, 3rem);
  width: auto;
  max-width: 160px;
  object-fit: contain;
}
.placeholder-svg.apex-logo-list__logo {
  width: 100px;
  height: 2.4rem;
  opacity: .3;
}
.apex-logo-list__item--gray .apex-logo-list__logo {
  filter: grayscale(100%);
  opacity: .55;
}
.apex-logo-list__item--gray:hover .apex-logo-list__logo {
  filter: none;
  opacity: 1;
}
{% endstylesheet %}
{% schema %}
{
  "name": "Logo list",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As seen in"
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Grayscale logos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "marquee",
      "label": "Scroll as marquee",
      "default": false
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Marquee speed",
      "default": 25
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
