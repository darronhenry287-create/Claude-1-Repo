{%- liquid
  assign s = section.settings
  assign product = s.product
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'content-sidebar-form-' | append: section.id
-%}
<section class="apex-content-sidebar color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="content-sidebar-{{ section.id }}">
  <div class="page-width">
    <div class="apex-content-sidebar__layout">

      {%- comment -%} -------- left: long-form content blocks -------- {%- endcomment -%}
      <div class="apex-content-sidebar__content reveal stack">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'heading' -%}
              <h2 class="apex-content-sidebar__block-heading balance" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>

            {%- when 'paragraph' -%}
              <div class="rte apex-content-sidebar__block-para" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'image' -%}
              {%- if block.settings.image != blank -%}
                <div class="media media--{{ block.settings.ratio }} media--round apex-content-sidebar__block-img" {{ block.shopify_attributes }}>
                  {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', sizes: '(min-width:990px) 55vw, 100vw', alt: block.settings.image.alt }}
                </div>
              {%- else -%}
                <div class="media media--landscape media--round apex-content-sidebar__block-img" {{ block.shopify_attributes }}>
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}

            {%- when 'checklist' -%}
              <div class="apex-content-sidebar__block-checklist" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <p class="apex-content-sidebar__checklist-label">{{ block.settings.heading }}</p>
                {%- endif -%}
                <ul class="apex-content-sidebar__checklist stack" role="list">
                  {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
                  {%- for item in items -%}
                    {%- assign item_clean = item | strip -%}
                    {%- if item_clean != blank -%}
                      <li class="apex-content-sidebar__checklist-item">
                        <span class="apex-content-sidebar__check-icon" aria-hidden="true">{% render 'icon', icon: 'check' %}</span>
                        <span>{{ item_clean }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>

            {%- when 'quote' -%}
              <blockquote class="apex-content-sidebar__block-quote" {{ block.shopify_attributes }}>
                <p>{{ block.settings.text }}</p>
                {%- if block.settings.attribution != blank -%}
                  <footer><cite>{{ block.settings.attribution }}</cite></footer>
                {%- endif -%}
              </blockquote>

            {%- when 'callout' -%}
              <div class="apex-content-sidebar__block-callout card" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <span class="apex-content-sidebar__callout-icon" aria-hidden="true">{% render 'icon', icon: block.settings.icon %}</span>
                {%- endif -%}
                <div class="stack">
                  {%- if block.settings.heading != blank -%}
                    <p class="apex-content-sidebar__callout-heading">{{ block.settings.heading }}</p>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="muted">{{ block.settings.text }}</p>
                  {%- endif -%}
                </div>
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- comment -%} -------- right: sticky buy card -------- {%- endcomment -%}
      <aside class="apex-content-sidebar__sticky-wrap" aria-label="{{ 'products.product.buy' | t | default: 'Purchase' }}">
        <div class="apex-content-sidebar__buy-card card reveal">

          {%- comment -%} product image (compact) {%- endcomment -%}
          {%- if product != blank and product.featured_media -%}
            <div class="apex-content-sidebar__card-media media media--landscape media--round">
              {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,400,600', sizes: '(min-width:990px) 25vw, 50vw', alt: product.featured_media.alt }}
            </div>
          {%- elsif product == blank -%}
            <div class="apex-content-sidebar__card-media media media--landscape media--round">
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          <div class="stack apex-content-sidebar__card-body">

            {%- if product != blank -%}
              <h3 class="apex-content-sidebar__card-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
            {%- else -%}
              <h3 class="apex-content-sidebar__card-title">Example Product</h3>
            {%- endif -%}

            {%- if s.show_rating -%}
              {% render 'rating', product: product %}
            {%- endif -%}

            <div class="apex-content-sidebar__card-price" data-price>
              {% render 'price', product: product %}
            </div>

            {%- if product != blank -%}
              <apex-product-form class="apex-content-sidebar__form stack">
                <script type="application/json" data-variants>
                  [
                    {%- for v in product.variants -%}
                      {
                        "id": {{ v.id | json }},
                        "price": {{ v.price | json }},
                        "compare_at_price": {{ v.compare_at_price | default: 0 | json }},
                        "available": {{ v.available | json }},
                        "options": [{{ v.option1 | json }}{% if product.options.size > 1 %}, {{ v.option2 | json }}{% endif %}{% if product.options.size > 2 %}, {{ v.option3 | json }}{% endif %}]
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                </script>

                {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">

                  {%- unless product.has_only_default_variant -%}
                    <div class="apex-content-sidebar__options stack">
                      {%- for option in product.options_with_values -%}
                        {%- assign opt_index = forloop.index0 -%}
                        <fieldset class="apex-featured-product__option">
                          <legend class="apex-featured-product__option-label">{{ option.name }}</legend>
                          <div class="apex-featured-product__swatches">
                            {%- for value in option.values -%}
                              {%- assign input_id = section.id | append: '-opt-' | append: opt_index | append: '-' | append: forloop.index0 -%}
                              <input type="radio"
                                class="apex-product__radio visually-hidden"
                                id="{{ input_id }}"
                                name="option-{{ section.id }}-{{ opt_index }}"
                                value="{{ value | escape }}"
                                data-option-index="{{ opt_index }}"
                                {% if option.selected_value == value %}checked{% endif %}>
                              <label for="{{ input_id }}" class="apex-product__chip" title="{{ value | escape }}">{{ value }}</label>
                            {%- endfor -%}
                          </div>
                        </fieldset>
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}

                  <div class="apex-content-sidebar__buy-row" data-atc-anchor>
                    {%- if s.show_quantity -%}
                      <div class="qty">
                        <button type="button" data-dir="down" aria-label="{{ 'products.product.decrease' | t | default: 'Decrease quantity' }}">{% render 'icon', icon: 'minus' %}</button>
                        <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'products.product.quantity' | t | default: 'Quantity' }}">
                        <button type="button" data-dir="up" aria-label="{{ 'products.product.increase' | t | default: 'Increase quantity' }}">{% render 'icon', icon: 'plus' %}</button>
                      </div>
                    {%- endif -%}
                    <button type="submit" name="add"
                      class="btn btn--accent btn--lg btn--block apex-content-sidebar__atc"
                      data-atc
                      data-label="{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}"
                      {% unless current_variant.available %}disabled{% endunless %}>
                      <span data-atc-label>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}{% else %}{{ 'products.product.sold_out' | t | default: 'Sold out' }}{% endif %}</span>
                    </button>
                  </div>

                  {%- if s.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
                {%- endform -%}
              </apex-product-form>
            {%- endif -%}

            {%- comment -%} trust bullets {%- endcomment -%}
            {%- if s.trust_bullets != blank -%}
              <ul class="apex-content-sidebar__trust stack" role="list">
                {%- assign bullets = s.trust_bullets | newline_to_br | split: '<br />' -%}
                {%- for bullet in bullets -%}
                  {%- assign bullet_clean = bullet | strip -%}
                  {%- if bullet_clean != blank -%}
                    <li class="apex-content-sidebar__trust-item">
                      <span class="apex-content-sidebar__trust-icon" aria-hidden="true">{% render 'icon', icon: 'check' %}</span>
                      <span>{{ bullet_clean }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if s.show_link and product != blank -%}
              <a class="link apex-content-sidebar__view-link" href="{{ product.url }}">{{ 'products.product.view_full_details' | t | default: 'View full details' }} {% render 'icon', icon: 'arrow-right' %}</a>
            {%- endif -%}

          </div>
        </div>
      </aside>

    </div>
  </div>
</section>
{% stylesheet %}
.apex-content-sidebar__layout {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: clamp(2rem, 1.5rem + 3vw, 4rem);
  align-items: start;
}
.apex-content-sidebar__content { gap: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
.apex-content-sidebar__sticky-wrap { position: sticky; top: calc(var(--header-height, 80px) + 1.5rem); }
.apex-content-sidebar__buy-card { padding: clamp(1.2rem, 1rem + 1.5vw, 2rem); gap: 1.2rem; display: flex; flex-direction: column; }
.apex-content-sidebar__card-media { margin: -clamp(1.2rem, 1rem + 1.5vw, 2rem) -clamp(1.2rem, 1rem + 1.5vw, 2rem) 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; border-radius: var(--radius-card) var(--radius-card) 0 0; }
.apex-content-sidebar__card-title { font-size: 1.15rem; font-weight: 700; line-height: 1.25; }
.apex-content-sidebar__card-title a { color: inherit; text-decoration: none; }
.apex-content-sidebar__card-price { font-size: 1.3rem; }
.apex-content-sidebar__form { gap: 1rem; }
.apex-content-sidebar__options { gap: .75rem; }
.apex-content-sidebar__buy-row { display: flex; gap: .6rem; align-items: stretch; flex-wrap: wrap; }
.apex-content-sidebar__buy-row .qty { flex: none; }
.apex-content-sidebar__atc { flex: 1; min-width: 10rem; }
.apex-content-sidebar__form .shopify-payment-button { margin-top: .1rem; }
.apex-content-sidebar__trust { gap: .45rem; border-top: var(--border-width) solid var(--border); padding-top: 1rem; }
.apex-content-sidebar__trust-item { display: flex; align-items: flex-start; gap: .5rem; font-size: var(--text-sm); color: var(--text-muted); }
.apex-content-sidebar__trust-icon { color: var(--success); flex: none; width: 1rem; height: 1rem; margin-top: .15rem; }
.apex-content-sidebar__trust-icon svg { width: 100%; height: 100%; }
.apex-content-sidebar__view-link { display: inline-flex; align-items: center; gap: .3rem; font-size: var(--text-sm); }
.apex-content-sidebar__view-link svg { width: .85rem; height: .85rem; }
/* content block styles */
.apex-content-sidebar__block-heading { font-size: var(--h3); }
.apex-content-sidebar__block-para { line-height: 1.75; }
.apex-content-sidebar__block-img { border-radius: var(--radius-card); overflow: hidden; }
.apex-content-sidebar__checklist-label { font-weight: 700; font-size: .95rem; margin-bottom: .5rem; }
.apex-content-sidebar__checklist { gap: .55rem; list-style: none; padding: 0; }
.apex-content-sidebar__checklist-item { display: flex; align-items: flex-start; gap: .6rem; line-height: 1.5; }
.apex-content-sidebar__check-icon { color: var(--success); flex: none; width: 1.1rem; height: 1.1rem; margin-top: .2rem; }
.apex-content-sidebar__check-icon svg { width: 100%; height: 100%; }
.apex-content-sidebar__block-quote { border-left: 4px solid var(--accent); padding: 1rem 1.5rem; background: color-mix(in srgb, var(--accent) 6%, var(--bg-alt)); border-radius: 0 var(--radius) var(--radius) 0; font-style: italic; font-size: 1.08rem; line-height: 1.65; }
.apex-content-sidebar__block-quote footer { margin-top: .6rem; font-style: normal; font-size: var(--text-sm); color: var(--text-muted); }
.apex-content-sidebar__block-quote footer::before { content: '— '; }
.apex-content-sidebar__block-callout { display: flex; align-items: flex-start; gap: 1rem; padding: 1.2rem 1.4rem; background: color-mix(in srgb, var(--accent) 7%, var(--bg-alt)); border: var(--border-width) solid color-mix(in srgb, var(--accent) 20%, transparent); }
.apex-content-sidebar__callout-icon { color: var(--accent); flex: none; width: 1.5rem; height: 1.5rem; margin-top: .1rem; }
.apex-content-sidebar__callout-icon svg { width: 100%; height: 100%; }
.apex-content-sidebar__callout-heading { font-weight: 700; font-size: .95rem; }
@media (max-width: 990px) {
  .apex-content-sidebar__layout {
    grid-template-columns: 1fr;
  }
  .apex-content-sidebar__sticky-wrap {
    order: -1;
    position: static;
  }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Content + sidebar",
  "tag": "section",
  "class": "shopify-section--content-sidebar",
  "settings": [
    {
      "type": "header",
      "content": "Sticky buy card"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Show 'view full details' link",
      "default": false
    },
    {
      "type": "textarea",
      "id": "trust_bullets",
      "label": "Trust bullets (one per line)",
      "default": "30-day money-back guarantee\nFree shipping on orders over $50\nSecure checkout — SSL encrypted"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Heading",
          "default": "Why this product works"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share detailed information about the product, its benefits, and how it fits into your customers' lives. Long-form content builds trust and converts at a higher rate than short copy alone.</p>"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "Image ratio",
          "default": "landscape",
          "options": [
            {
              "value": "square",
              "label": "Square"
            },
            {
              "value": "landscape",
              "label": "Landscape"
            },
            {
              "value": "portrait",
              "label": "Portrait"
            }
          ]
        }
      ]
    },
    {
      "type": "checklist",
      "name": "Checklist",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "List heading",
          "default": "What you get"
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Items (one per line)",
          "default": "Clinically tested formula\nVisible results in 14 days\nDermatologist approved\nVegan and cruelty-free"
        }
      ]
    },
    {
      "type": "quote",
      "name": "Pull quote",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Quote text",
          "default": "The details are not the details. They make the design."
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "Attribution",
          "default": "Charles Eames"
        }
      ]
    },
    {
      "type": "callout",
      "name": "Callout box",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "return",
              "label": "Return"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Our guarantee"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Not satisfied? We'll refund every penny — no questions asked, within 30 days of purchase."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Content + sidebar",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "text": "The complete guide to better sleep"
          }
        },
        {
          "type": "paragraph",
          "settings": {
            "text": "<p>Sleep deprivation affects millions of people worldwide, impacting everything from cognitive performance to immune function. Our formula was developed alongside sleep researchers to address the root causes — not just the symptoms.</p>"
          }
        },
        {
          "type": "checklist",
          "settings": {
            "heading": "Backed by science",
            "items": "Reduces time to fall asleep by 37%\nImproves deep sleep duration\nNon-habit forming ingredients\nNo next-day grogginess"
          }
        },
        {
          "type": "quote",
          "settings": {
            "text": "After three nights I felt the difference. By week two I was sleeping through the entire night for the first time in years.",
            "attribution": "Jordan T., verified customer"
          }
        },
        {
          "type": "callout",
          "settings": {
            "icon": "shield",
            "heading": "30-day money-back guarantee",
            "text": "Try it completely risk-free. If you don't sleep better, we'll refund you in full."
          }
        }
      ]
    }
  ]
}
{% endschema %}
