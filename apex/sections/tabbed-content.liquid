{%- liquid
  assign s = section.settings
-%}
<section class="apex-tabbed color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="tabbed-content-{{ section.id }}">
  <div class="page-width">
    <div class="reveal">
      {%- if s.heading != blank or s.subheading != blank -%}
        <div class="section-head{% if s.center_header %} section-head--center{% endif %}">
          {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
        </div>
      {%- endif -%}

      <div data-tabs class="apex-tabbed__widget">
        {%- comment -%} Tab nav {%- endcomment -%}
        <div class="tabs__nav" role="tablist" aria-label="{{ s.heading | default: 'Content tabs' | escape }}">
          {%- for block in section.blocks -%}
            <button
              class="tabs__tab"
              role="tab"
              id="tab-{{ section.id }}-{{ block.id }}"
              aria-controls="panel-{{ section.id }}-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}>
              {{ block.settings.title | default: 'Tab' }}
            </button>
          {%- endfor -%}
        </div>

        {%- comment -%} Tab panels {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          <div
            class="apex-tabbed__panel"
            role="tabpanel"
            id="panel-{{ section.id }}-{{ block.id }}"
            aria-labelledby="tab-{{ section.id }}-{{ block.id }}"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}>

            {%- if bs.image != blank -%}
              <div class="apex-tabbed__panel-layout apex-tabbed__panel-layout--with-image">
                <div class="apex-tabbed__panel-media media media--landscape media--round">
                  {{ bs.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width:990px) 50vw, 100vw', alt: bs.title | escape }}
                </div>
                <div class="apex-tabbed__panel-body rte">
                  {{ bs.content }}
                </div>
              </div>
            {%- else -%}
              <div class="apex-tabbed__panel-body rte">
                {{ bs.content }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.apex-tabbed__widget { border: var(--border-width) solid var(--border); border-radius: var(--radius-card); overflow: hidden; }
.tabs__nav { padding: 0 1.6rem; background: var(--bg-alt); }
.apex-tabbed__panel { padding: 2rem 2rem; }
.apex-tabbed__panel-layout { display: grid; gap: var(--gutter); }
.apex-tabbed__panel-layout--with-image { grid-template-columns: 1fr 1fr; align-items: start; }
.apex-tabbed__panel-media { overflow: hidden; border-radius: var(--radius-card); }
@media (max-width: 768px) {
  .apex-tabbed__panel-layout--with-image { grid-template-columns: 1fr; }
  .apex-tabbed__panel { padding: 1.4rem 1.2rem; }
  .tabs__nav { padding: 0 1rem; overflow-x: auto; scrollbar-width: none; }
  .tabs__nav::-webkit-scrollbar { display: none; }
  .tabs__tab { white-space: nowrap; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Tabbed content",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Learn more"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you need to know"
    },
    {
      "type": "checkbox",
      "id": "center_header",
      "label": "Center header",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab title",
          "default": "Our story"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab content",
          "default": "<p>Share your brand story, product details, sustainability mission, or anything your customers want to know. This tab keeps things organised and easy to navigate.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tab image (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed content",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "title": "Our story",
            "content": "<p>We started with a simple idea: make the best possible product and stand behind it completely. Every item we sell reflects that commitment.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Materials",
            "content": "<p>We source only the finest sustainable materials, rigorously tested to meet our standards for quality, durability, and environmental responsibility.</p>"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Shipping & returns",
            "content": "<p>Free shipping on orders over $50. We ship within 24 hours on business days. If you're not satisfied, returns are easy within 30 days.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
