{%- liquid
  assign s = section.settings
-%}
<section class="apex-trust-bar color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="trust-bar-{{ section.id }}">
  <div class="page-width">
    <div class="apex-trust-bar__inner reveal">

      {%- if section.blocks.size > 0 -%}
        <ul class="apex-trust-bar__items" role="list">
          {%- for block in section.blocks -%}
            <li class="apex-trust-bar__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="apex-trust-bar__icon" aria-hidden="true">{% render 'icon', icon: block.settings.icon %}</span>
              {%- endif -%}
              <div class="apex-trust-bar__text">
                {%- if block.settings.title != blank -%}
                  <span class="apex-trust-bar__title">{{ block.settings.title }}</span>
                {%- endif -%}
                {%- if block.settings.subtitle != blank -%}
                  <span class="apex-trust-bar__subtitle">{{ block.settings.subtitle }}</span>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.show_payment_icons -%}
        <div class="apex-trust-bar__payments" aria-label="{{ 'payment.methods' | t | default: 'Accepted payment methods' }}">
          {{ shop.enabled_payment_types | payment_type_svg_tag }}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>
{% stylesheet %}
.apex-trust-bar__inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: clamp(1.2rem, .8rem + 2vw, 2.2rem);
}
.apex-trust-bar__items {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: clamp(.8rem, .5rem + 2vw, 2rem);
  padding: 0;
  list-style: none;
}
.apex-trust-bar__item {
  display: flex;
  align-items: center;
  gap: .6rem;
}
/* visual separator between items */
.apex-trust-bar__item + .apex-trust-bar__item {
  padding-left: clamp(.8rem, .5rem + 2vw, 2rem);
  border-left: var(--border-width) solid var(--border);
}
.apex-trust-bar__icon {
  color: var(--accent);
  flex: none;
  width: 1.4rem;
  height: 1.4rem;
  display: grid;
  place-items: center;
}
.apex-trust-bar__icon svg { width: 100%; height: 100%; }
.apex-trust-bar__text {
  display: flex;
  flex-direction: column;
  gap: .1rem;
}
.apex-trust-bar__title {
  font-weight: 700;
  font-size: .92rem;
  line-height: 1.2;
  color: var(--text);
}
.apex-trust-bar__subtitle {
  font-size: var(--text-xs);
  color: var(--text-muted);
  line-height: 1.3;
}
.apex-trust-bar__payments {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: .4rem;
}
.apex-trust-bar__payments svg {
  height: 1.5rem;
  width: auto;
  border-radius: 4px;
  opacity: .75;
  filter: grayscale(20%);
}
@media (max-width: 600px) {
  .apex-trust-bar__inner { flex-direction: column; gap: 1.2rem; }
  .apex-trust-bar__item + .apex-trust-bar__item { padding-left: 0; border-left: none; }
  .apex-trust-bar__items { flex-direction: column; align-items: flex-start; gap: .8rem; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "shopify-section--trust-bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment method icons",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "return",
              "label": "Return"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "bag",
              "label": "Bag"
            },
            {
              "value": "user",
              "label": "User"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Money-back guarantee"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "60-day no-questions return policy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Free shipping",
            "subtitle": "On all orders over $50"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "shield",
            "title": "Money-back guarantee",
            "subtitle": "60 days, no questions asked"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "Easy returns",
            "subtitle": "Free return label included"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "star",
            "title": "4.9 star rating",
            "subtitle": "From 12,000+ verified reviews"
          }
        }
      ]
    }
  ]
}
{% endschema %}
