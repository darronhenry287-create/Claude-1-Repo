{%- liquid
  assign s = section.settings
  assign v_align = s.vertical_align | default: 'center'
  assign col_gap = s.column_gap | default: 'md'
-%}
<section class="apex-two-col color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="two-col-{{ section.id }}">
  <div class="page-width">

    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="section-head section-head--center reveal">
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--pill">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="subtitle balance">{{ s.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="apex-two-col__grid apex-two-col__valign--{{ v_align }} apex-two-col__gap--{{ col_gap }} reveal">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col_type = block.settings.col_type | default: 'richtext'
          assign col_ratio = block.settings.image_ratio | default: 'landscape'
        -%}
        <div class="apex-two-col__col" {{ block.shopify_attributes }}>

          {%- if col_type == 'image' -%}
            <div class="media media--{{ col_ratio }} media--round">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', sizes: '(min-width:990px) 50vw, 100vw', alt: block.settings.image.alt }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

          {%- elsif col_type == 'video' -%}
            <div class="media media--{{ col_ratio }} media--round">
              {%- if block.settings.video_url != blank -%}
                <video autoplay muted loop playsinline>
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
                </video>
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

          {%- else -%}
            <div class="apex-two-col__text stack">
              {%- if block.settings.eyebrow != blank -%}
                <p class="eyebrow eyebrow--pill">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="balance">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte subtitle">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <div class="cluster">
                  <a class="btn btn--accent" href="{{ block.settings.button_url }}">{{ block.settings.button_label }}</a>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>
{% stylesheet %}
.apex-two-col__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
}
.apex-two-col__gap--sm { gap: clamp(1.2rem, 1rem + 2vw, 2.5rem); }
.apex-two-col__gap--md { gap: clamp(2rem, 1.5rem + 4vw, 5rem); }
.apex-two-col__gap--lg { gap: clamp(3rem, 2rem + 5vw, 7rem); }
.apex-two-col__valign--start { align-items: start; }
.apex-two-col__valign--center { align-items: center; }
.apex-two-col__valign--end { align-items: end; }
.apex-two-col__valign--stretch { align-items: stretch; }
.apex-two-col__text { gap: 1.4rem; }
@media (max-width: 749px) {
  .apex-two-col__grid { grid-template-columns: 1fr; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Two-column content",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical alignment",
      "default": "center",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "end", "label": "Bottom" },
        { "value": "stretch", "label": "Stretch" }
      ]
    },
    {
      "type": "select",
      "id": "column_gap",
      "label": "Column gap",
      "default": "md",
      "options": [
        { "value": "sm", "label": "Tight" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Wide" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "col_type",
          "label": "Column type",
          "default": "richtext",
          "options": [
            { "value": "richtext", "label": "Rich text" },
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ]
        },
        {
          "type": "header",
          "content": "Image / Video"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (when type = Image)"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL — MP4 (when type = Video)"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Media ratio",
          "default": "landscape",
          "options": [
            { "value": "square", "label": "Square (1:1)" },
            { "value": "portrait", "label": "Portrait (3:4)" },
            { "value": "landscape", "label": "Landscape (4:3)" },
            { "value": "wide", "label": "Wide (16:9)" }
          ]
        },
        {
          "type": "header",
          "content": "Rich text"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body text",
          "default": "<p>Use this column to highlight a key message, feature, or story. Mix and match column types across your page for visual variety.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Two-column content",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "col_type": "image",
            "image_ratio": "landscape"
          }
        },
        {
          "type": "column",
          "settings": {
            "col_type": "richtext",
            "heading": "Two columns, endless flexibility",
            "text": "<p>Combine an image, video, or rich text block in each column to craft the layout your story needs.</p>",
            "button_label": "Discover more"
          }
        }
      ]
    }
  ]
}
{% endschema %}
