{%- liquid
  assign s = section.settings
  assign modal_id = 'size-guide-modal-' | append: section.id
-%}
<section class="apex-size-guide color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="size-guide-{{ section.id }}">
  <div class="page-width">
    <div class="apex-size-guide__trigger-wrap reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--pill">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<p class="apex-size-guide__heading h5">{{ s.heading }}</p>{%- endif -%}
      <button class="btn{% if s.button_style == 'ghost' %} btn--ghost{% elsif s.button_style == 'secondary' %} btn--secondary{% else %} btn--accent{% endif %}" type="button" data-open="{{ modal_id }}" aria-haspopup="dialog">
        {%- if s.button_icon != blank -%}{% render 'icon', icon: s.button_icon %}{%- endif -%}
        {{ s.button_label | default: 'Size guide' }}
      </button>
    </div>
  </div>
</section>

<div id="{{ modal_id }}" class="modal apex-size-guide__modal" role="dialog" aria-modal="true" aria-labelledby="sg-title-{{ section.id }}" hidden>
  <div class="apex-size-guide__modal-inner">
    <div class="apex-size-guide__modal-head">
      <h2 class="h4" id="sg-title-{{ section.id }}">{{ s.modal_heading | default: 'Size guide' }}</h2>
      <button class="apex-size-guide__close btn btn--ghost btn--sm" type="button" data-close="{{ modal_id }}" aria-label="Close size guide">{% render 'icon', icon: 'close' %}</button>
    </div>

    {%- if s.fit_notes != blank -%}
      <div class="apex-size-guide__fit-notes rte">{{ s.fit_notes }}</div>
    {%- endif -%}

    {%- assign row_blocks = section.blocks | where: 'type', 'row' -%}
    {%- assign header_blocks = section.blocks | where: 'type', 'header' -%}

    {%- if header_blocks.size > 0 or row_blocks.size > 0 -%}
      <div class="apex-size-guide__table-wrap">
        <table class="apex-size-guide__table" role="table">
          {%- if header_blocks.size > 0 -%}
            <thead>
              {%- for block in header_blocks -%}
                <tr>
                  <th class="apex-size-guide__th" scope="col">{{ block.settings.col_1 }}</th>
                  {%- if block.settings.col_2 != blank -%}<th class="apex-size-guide__th" scope="col">{{ block.settings.col_2 }}</th>{%- endif -%}
                  {%- if block.settings.col_3 != blank -%}<th class="apex-size-guide__th" scope="col">{{ block.settings.col_3 }}</th>{%- endif -%}
                  {%- if block.settings.col_4 != blank -%}<th class="apex-size-guide__th" scope="col">{{ block.settings.col_4 }}</th>{%- endif -%}
                  {%- if block.settings.col_5 != blank -%}<th class="apex-size-guide__th" scope="col">{{ block.settings.col_5 }}</th>{%- endif -%}
                </tr>
              {%- endfor -%}
            </thead>
          {%- endif -%}
          <tbody>
            {%- for block in row_blocks -%}
              <tr class="apex-size-guide__tr" {{ block.shopify_attributes }}>
                <td class="apex-size-guide__td apex-size-guide__td--label">{{ block.settings.col_1 }}</td>
                {%- if block.settings.col_2 != blank -%}<td class="apex-size-guide__td">{{ block.settings.col_2 }}</td>{%- endif -%}
                {%- if block.settings.col_3 != blank -%}<td class="apex-size-guide__td">{{ block.settings.col_3 }}</td>{%- endif -%}
                {%- if block.settings.col_4 != blank -%}<td class="apex-size-guide__td">{{ block.settings.col_4 }}</td>{%- endif -%}
                {%- if block.settings.col_5 != blank -%}<td class="apex-size-guide__td">{{ block.settings.col_5 }}</td>{%- endif -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}

    {%- if s.model_note != blank -%}
      <p class="apex-size-guide__model-note muted">{{ s.model_note }}</p>
    {%- endif -%}
  </div>
</div>
<div class="overlay" data-close="{{ modal_id }}" hidden></div>

{% stylesheet %}
/* trigger */
.apex-size-guide__trigger-wrap {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
}
/* modal overlay */
.apex-size-guide__modal {
  position: fixed;
  inset: 0;
  z-index: 400;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: none;
}
.apex-size-guide__modal:not([hidden]) { pointer-events: auto; }
.apex-size-guide__modal-inner {
  background: var(--bg);
  color: var(--text);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  width: 100%;
  max-width: 680px;
  max-height: 90svh;
  overflow-y: auto;
  padding: clamp(1.4rem,2vw,2.4rem);
  display: grid;
  gap: 1.4rem;
  box-shadow: var(--shadow-pop);
  transform: translateY(100%);
  transition: transform .38s var(--ease);
}
.apex-size-guide__modal:not([hidden]) .apex-size-guide__modal-inner { transform: translateY(0); }
@media (min-width: 600px) {
  .apex-size-guide__modal { align-items: center; }
  .apex-size-guide__modal-inner { border-radius: var(--radius-lg); transform: translateY(20px) scale(.97); opacity: 0; }
  .apex-size-guide__modal:not([hidden]) .apex-size-guide__modal-inner { transform: translateY(0) scale(1); opacity: 1; }
}
.apex-size-guide__modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}
.apex-size-guide__close { flex: none; }
.apex-size-guide__fit-notes { font-size: .94rem; }
/* table */
.apex-size-guide__table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border: var(--border-width) solid var(--border);
  border-radius: var(--radius-card);
}
.apex-size-guide__table {
  width: 100%;
  min-width: 360px;
  border-collapse: collapse;
}
.apex-size-guide__th {
  padding: .8rem 1.1rem;
  font-size: var(--text-sm);
  font-weight: 700;
  text-align: left;
  background: var(--bg-alt);
  border-bottom: 2px solid var(--border);
  white-space: nowrap;
}
.apex-size-guide__tr:nth-child(even) .apex-size-guide__td {
  background: color-mix(in srgb, var(--text) 3%, transparent);
}
.apex-size-guide__tr:last-child .apex-size-guide__td { border-bottom: none; }
.apex-size-guide__td {
  padding: .75rem 1.1rem;
  font-size: .92rem;
  border-bottom: var(--border-width) solid var(--border);
  vertical-align: middle;
}
.apex-size-guide__td--label {
  font-weight: 700;
  white-space: nowrap;
  color: var(--accent);
}
.apex-size-guide__model-note {
  font-size: var(--text-sm);
  border-top: var(--border-width) solid var(--border);
  padding-top: 1rem;
}
{% endstylesheet %}
