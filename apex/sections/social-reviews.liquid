{%- liquid
  assign s = section.settings
  assign block_count = section.blocks | size
-%}
<section class="apex-social-reviews color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="social-reviews-{{ section.id }}">
  <div class="page-width">

    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="section-head{% if s.center_header %} section-head--center{% endif %} reveal">
        {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p class="subtitle balance">{{ s.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if s.layout == 'carousel' -%}
      <div class="apex-social-reviews__outer reveal">
        <div class="slider apex-social-reviews__slider" data-slider id="sr-track-{{ section.id }}"
          role="list" aria-label="{{ s.heading | default: 'Reviews' | escape }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign stars = block.settings.rating | plus: 0
              assign src = block.settings.source | default: 'other'
            -%}
            <div class="apex-social-reviews__card card card--hover apex-social-reviews__card--{{ src }}"
              role="listitem" {{ block.shopify_attributes }}>
              <div class="apex-social-reviews__source-row">
                <span class="apex-social-reviews__source-badge apex-social-reviews__source-badge--{{ src }}"
                  aria-label="{{ src | capitalize }} review">
                  {%- case src -%}
                    {%- when 'amazon' -%}Amazon
                    {%- when 'google' -%}Google
                    {%- when 'facebook' -%}Facebook
                    {%- when 'trustpilot' -%}Trustpilot
                    {%- else -%}{{ src | capitalize }}
                  {%- endcase -%}
                </span>
                <div class="apex-social-reviews__stars" aria-label="{{ stars }} out of 5">
                  {%- for i in (1..5) -%}
                    <span class="apex-social-reviews__star{% if i > stars %} apex-social-reviews__star--empty{% endif %}" aria-hidden="true">{% render 'icon', icon: 'star' %}</span>
                  {%- endfor -%}
                </div>
              </div>
              {%- if block.settings.title != blank -%}
                <p class="apex-social-reviews__title">{{ block.settings.title }}</p>
              {%- endif -%}
              <blockquote class="apex-social-reviews__body"><p>{{ block.settings.body }}</p></blockquote>
              <footer class="apex-social-reviews__footer">
                <cite class="apex-social-reviews__author">{{ block.settings.author | default: 'Verified customer' }}</cite>
                {%- if block.settings.verified -%}
                  <span class="badge">{% render 'icon', icon: 'check' %} Verified</span>
                {%- endif -%}
              </footer>
            </div>
          {%- endfor -%}
        </div>
        {%- if block_count > 1 -%}
          <div class="cluster" style="justify-content:center;margin-top:1.8rem">
            <div class="slider-nav">
              <button data-slider-prev="{{ section.id }}" aria-label="Previous review">{% render 'icon', icon: 'arrow-left' %}</button>
              <button data-slider-next="{{ section.id }}" aria-label="Next review">{% render 'icon', icon: 'arrow-right' %}</button>
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="apex-social-reviews__grid grid grid--{{ s.columns }} reveal">
        {%- for block in section.blocks -%}
          {%- liquid
            assign stars = block.settings.rating | plus: 0
            assign src = block.settings.source | default: 'other'
          -%}
          <div class="apex-social-reviews__card card card--hover apex-social-reviews__card--{{ src }}"
            {{ block.shopify_attributes }}>
            <div class="apex-social-reviews__source-row">
              <span class="apex-social-reviews__source-badge apex-social-reviews__source-badge--{{ src }}"
                aria-label="{{ src | capitalize }} review">
                {%- case src -%}
                  {%- when 'amazon' -%}Amazon
                  {%- when 'google' -%}Google
                  {%- when 'facebook' -%}Facebook
                  {%- when 'trustpilot' -%}Trustpilot
                  {%- else -%}{{ src | capitalize }}
                {%- endcase -%}
              </span>
              <div class="apex-social-reviews__stars" aria-label="{{ stars }} out of 5">
                {%- for i in (1..5) -%}
                  <span class="apex-social-reviews__star{% if i > stars %} apex-social-reviews__star--empty{% endif %}" aria-hidden="true">{% render 'icon', icon: 'star' %}</span>
                {%- endfor -%}
              </div>
            </div>
            {%- if block.settings.title != blank -%}
              <p class="apex-social-reviews__title">{{ block.settings.title }}</p>
            {%- endif -%}
            <blockquote class="apex-social-reviews__body"><p>{{ block.settings.body }}</p></blockquote>
            <footer class="apex-social-reviews__footer">
              <cite class="apex-social-reviews__author">{{ block.settings.author | default: 'Verified customer' }}</cite>
              {%- if block.settings.verified -%}
                <span class="badge">{% render 'icon', icon: 'check' %} Verified</span>
              {%- endif -%}
            </footer>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>
{% stylesheet %}
.apex-social-reviews__slider { gap: var(--gutter); padding-bottom: .5rem; align-items: stretch; }
.apex-social-reviews__slider .apex-social-reviews__card { width: min(360px, 80vw); flex: none; }
.apex-social-reviews__card { padding: 1.6rem; display: flex; flex-direction: column; gap: .9rem; }
.apex-social-reviews__source-row { display: flex; align-items: center; justify-content: space-between; gap: .6rem; flex-wrap: wrap; }
.apex-social-reviews__source-badge { display: inline-flex; align-items: center; font-size: var(--text-xs); font-weight: 800; letter-spacing: .02em; padding: .3em .7em; border-radius: var(--radius-pill); }
.apex-social-reviews__source-badge--amazon { background: #ff9900; color: #111; }
.apex-social-reviews__source-badge--google { background: #4285f4; color: #fff; }
.apex-social-reviews__source-badge--facebook { background: #1877f2; color: #fff; }
.apex-social-reviews__source-badge--trustpilot { background: #00b67a; color: #fff; }
.apex-social-reviews__source-badge--other { background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); }
.apex-social-reviews__stars { display: flex; gap: .2rem; }
.apex-social-reviews__star { color: var(--star); width: 1rem; height: 1rem; }
.apex-social-reviews__star--empty { color: var(--border); }
.apex-social-reviews__star svg { width: 100%; height: 100%; }
.apex-social-reviews__title { font-weight: 700; font-size: .98rem; }
.apex-social-reviews__body { flex: 1; font-size: .95rem; line-height: 1.65; color: var(--text); font-style: italic; }
.apex-social-reviews__body p::before { content: '\201C'; }
.apex-social-reviews__body p::after { content: '\201D'; }
.apex-social-reviews__footer { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-top: auto; }
.apex-social-reviews__author { font-style: normal; font-weight: 600; font-size: .88rem; color: var(--text-muted); }
{% endstylesheet %}
{% schema %}
{
  "name": "Social reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Across every platform"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "5 stars everywhere we go"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subtext"
    },
    {
      "type": "checkbox",
      "id": "center_header",
      "label": "Center header",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ]
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Grid columns",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Review source",
          "default": "google",
          "options": [
            { "value": "amazon", "label": "Amazon" },
            { "value": "google", "label": "Google" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "trustpilot", "label": "Trustpilot" },
            { "value": "other", "label": "Other" }
          ]
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Best purchase I've made all year"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review body",
          "default": "I've tried a lot of products in this space and nothing comes close. The quality speaks for itself and the results are undeniable."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sam W."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "source": "google",
            "rating": 5,
            "title": "Can't recommend highly enough",
            "body": "Found this brand through a friend and I'm so glad I did. Every product I've tried has been exceptional.",
            "author": "Taylor B.",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "source": "amazon",
            "rating": 5,
            "title": "Exceeded my expectations",
            "body": "Ordered on a whim and it arrived in two days. The packaging is gorgeous and the product itself is phenomenal.",
            "author": "Chris M.",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "source": "trustpilot",
            "rating": 5,
            "title": "A brand I trust completely",
            "body": "I've been a loyal customer for over a year now. Quality never drops and their customer service is second to none.",
            "author": "Avery L.",
            "verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
