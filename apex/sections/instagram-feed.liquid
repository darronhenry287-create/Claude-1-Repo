{%- liquid
  assign s = section.settings
-%}
<section class="apex-instagram-feed color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="instagram-feed-{{ section.id }}">
  <div class="page-width">

    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="section-head{% if s.center_header %} section-head--center{% endif %} reveal">
        {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.handle != blank -%}
          <p class="apex-instagram-feed__handle muted">
            {% render 'icon', icon: 'instagram' %}
            <span>@{{ s.handle }}</span>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="apex-instagram-feed__grid reveal" style="--ig-cols:{{ s.columns }}">
      {%- for block in section.blocks -%}
        <div class="apex-instagram-feed__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="apex-instagram-feed__link"
              aria-label="{{ block.settings.caption | default: 'View post' | escape }}">
          {%- else -%}
            <div class="apex-instagram-feed__link apex-instagram-feed__link--no-href">
          {%- endif -%}
            <div class="apex-instagram-feed__media media media--square">
              {%- if block.settings.image != blank -%}
                {%- assign ig_alt = block.settings.caption | default: '' -%}
                {{ block.settings.image | image_url: width: 600 | image_tag:
                    loading: 'lazy',
                    widths: '300,400,600',
                    sizes: '(min-width:990px) calc((var(--page-width) - var(--gutter) * (var(--ig-cols) - 1)) / var(--ig-cols)), 50vw',
                    alt: ig_alt }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              <div class="apex-instagram-feed__overlay" aria-hidden="true">
                <span class="apex-instagram-feed__overlay-icon">{% render 'icon', icon: 'instagram' %}</span>
                {%- if block.settings.caption != blank -%}
                  <p class="apex-instagram-feed__caption">{{ block.settings.caption }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if s.cta_label != blank and s.cta_url != blank -%}
      <div class="center reveal" style="margin-top:2rem">
        <a href="{{ s.cta_url }}" class="btn btn--secondary">{{ s.cta_label }}</a>
      </div>
    {%- endif -%}

  </div>
</section>
{% stylesheet %}
.apex-instagram-feed__handle { display: inline-flex; align-items: center; gap: .4em; margin-top: .6rem; font-size: var(--text-sm); font-weight: 600; }
.apex-instagram-feed__handle svg { width: 1.1em; height: 1.1em; }
.apex-instagram-feed__grid {
  display: grid;
  grid-template-columns: repeat(var(--ig-cols, 4), 1fr);
  gap: var(--ig-gap, .5rem);
}
.apex-instagram-feed__item { position: relative; }
.apex-instagram-feed__link { display: block; position: relative; overflow: hidden; border-radius: var(--radius-sm); }
.apex-instagram-feed__link--no-href { cursor: default; }
.apex-instagram-feed__media { border-radius: 0; }
.apex-instagram-feed__link img { transition: transform .55s var(--ease); }
.apex-instagram-feed__link:not(.apex-instagram-feed__link--no-href):hover img { transform: scale(1.07); }
.apex-instagram-feed__overlay {
  position: absolute; inset: 0;
  background: rgba(0,0,0,.45);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .6rem;
  color: #fff; padding: .8rem;
  opacity: 0; transition: opacity .3s var(--ease);
}
.apex-instagram-feed__link:not(.apex-instagram-feed__link--no-href):hover .apex-instagram-feed__overlay { opacity: 1; }
.apex-instagram-feed__overlay-icon svg { width: 1.8rem; height: 1.8rem; }
.apex-instagram-feed__caption { font-size: var(--text-xs); line-height: 1.4; text-align: center; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
@media (max-width: 749px) { .apex-instagram-feed__grid { grid-template-columns: repeat(2, 1fr) !important; } }
@media (max-width: 480px) { .apex-instagram-feed__grid { grid-template-columns: repeat(2, 1fr) !important; gap: .3rem; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Instagram feed",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Follow along"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop our feed"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram handle (without @)",
      "default": "yourbrand"
    },
    {
      "type": "checkbox",
      "id": "center_header",
      "label": "Center header",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Follow us on Instagram"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (shown on hover)",
          "default": "New drop — tap to shop."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product or page link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram feed",
      "blocks": [
        {
          "type": "post",
          "settings": {
            "caption": "Morning ritual sorted."
          }
        },
        {
          "type": "post",
          "settings": {
            "caption": "The one you've been waiting for."
          }
        },
        {
          "type": "post",
          "settings": {
            "caption": "Clean ingredients, real results."
          }
        },
        {
          "type": "post",
          "settings": {
            "caption": "Community favourite."
          }
        },
        {
          "type": "post",
          "settings": {
            "caption": "Behind the scenes."
          }
        },
        {
          "type": "post",
          "settings": {
            "caption": "This week's bestseller."
          }
        },
        {
          "type": "post",
          "settings": {
            "caption": "Zero compromise on quality."
          }
        },
        {
          "type": "post",
          "settings": {
            "caption": "Made for your lifestyle."
          }
        }
      ]
    }
  ]
}
{% endschema %}
