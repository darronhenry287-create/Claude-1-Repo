{%- liquid
  assign s = section.settings
  assign block_count = section.blocks | size
-%}
<section class="apex-video-testimonials color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="video-testimonials-{{ section.id }}">
  <div class="page-width">
    <div class="reveal">
      {%- if s.heading != blank or s.subheading != blank -%}
        <div class="section-head section-head--center">
          {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.text != blank -%}<p class="subtitle balance">{{ s.text }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.layout == 'carousel' -%}
        <div class="apex-video-testimonials__outer">
          <div class="slider apex-video-testimonials__slider" data-slider id="slider-{{ section.id }}" role="list"
            aria-label="{{ s.heading | default: 'Video testimonials' | escape }}">
            {%- for block in section.blocks -%}
              {%- liquid
                assign modal_id = 'vt-modal-' | append: section.id | append: '-' | append: forloop.index
                assign vurl = block.settings.video_url
                assign vtype = 'mp4'
                if vurl contains 'youtube.com' or vurl contains 'youtu.be'
                  assign vtype = 'youtube'
                  assign yt_id = vurl | split: 'v=' | last | split: '&' | first
                  if vurl contains 'youtu.be/'
                    assign yt_id = vurl | split: 'youtu.be/' | last | split: '?' | first
                  endif
                elsif vurl contains 'vimeo.com'
                  assign vtype = 'vimeo'
                  assign vim_id = vurl | split: 'vimeo.com/' | last | split: '?' | first
                endif
                assign stars = block.settings.rating | plus: 0
              -%}
              {%- render 'apex-vt-card',
                block: block,
                modal_id: modal_id,
                vurl: vurl,
                vtype: vtype,
                yt_id: yt_id,
                vim_id: vim_id,
                stars: stars,
                role: 'listitem'
              -%}
            {%- endfor -%}
          </div>
          {%- if block_count > 1 -%}
            <div class="apex-video-testimonials__nav">
              <button class="apex-video-testimonials__btn" data-slider-prev="{{ section.id }}" aria-label="Previous review">
                {% render 'icon', icon: 'arrow-left' %}
              </button>
              <button class="apex-video-testimonials__btn" data-slider-next="{{ section.id }}" aria-label="Next review">
                {% render 'icon', icon: 'arrow-right' %}
              </button>
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="apex-video-testimonials__grid grid grid--{{ s.columns }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign modal_id = 'vt-modal-' | append: section.id | append: '-' | append: forloop.index
              assign vurl = block.settings.video_url
              assign vtype = 'mp4'
              if vurl contains 'youtube.com' or vurl contains 'youtu.be'
                assign vtype = 'youtube'
                assign yt_id = vurl | split: 'v=' | last | split: '&' | first
                if vurl contains 'youtu.be/'
                  assign yt_id = vurl | split: 'youtu.be/' | last | split: '?' | first
                endif
              elsif vurl contains 'vimeo.com'
                assign vtype = 'vimeo'
                assign vim_id = vurl | split: 'vimeo.com/' | last | split: '?' | first
              endif
              assign stars = block.settings.rating | plus: 0
            -%}

            <div class="apex-video-testimonials__card card" {{ block.shopify_attributes }}>
              {%- if vurl != blank -%}
                <button class="apex-video-testimonials__trigger"
                  data-open="{{ modal_id }}"
                  aria-label="Play review by {{ block.settings.author | default: 'customer' | escape }}">
              {%- else -%}
                <div class="apex-video-testimonials__trigger apex-video-testimonials__trigger--static">
              {%- endif -%}
                  <div class="media media--portrait apex-video-testimonials__cover">
                    {%- if block.settings.cover != blank -%}
                      {{ block.settings.cover | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,400,600', sizes: '(min-width:990px) 280px, 50vw', alt: block.settings.cover.alt }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                    {%- if vurl != blank -%}
                      <span class="apex-video-testimonials__play" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24" aria-hidden="true"><path d="M8 5.1v13.8L19 12Z"/></svg>
                      </span>
                    {%- endif -%}
                  </div>
              {%- if vurl != blank -%}
                </button>
              {%- else -%}
                </div>
              {%- endif -%}

              <div class="apex-video-testimonials__body">
                <div class="apex-video-testimonials__stars" aria-label="{{ stars }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    <span class="apex-video-testimonials__star{% if i > stars %} apex-video-testimonials__star--empty{% endif %}" aria-hidden="true">
                      {% render 'icon', icon: 'star' %}
                    </span>
                  {%- endfor -%}
                </div>
                {%- if block.settings.quote != blank -%}
                  <blockquote class="apex-video-testimonials__quote"><p>{{ block.settings.quote }}</p></blockquote>
                {%- endif -%}
                <footer class="apex-video-testimonials__footer">
                  <cite class="apex-video-testimonials__author">{{ block.settings.author | default: 'Happy Customer' }}</cite>
                  {%- if block.settings.verified -%}
                    <span class="badge">{% render 'icon', icon: 'check' %} Verified</span>
                  {%- endif -%}
                </footer>
              </div>

              {%- if vurl != blank -%}
                <div class="overlay" id="{{ modal_id }}-overlay" data-close="{{ modal_id }}"></div>
                <div class="modal" id="{{ modal_id }}" role="dialog" aria-modal="true" aria-label="{{ block.settings.author | default: 'Video review' | escape }}">
                  <div class="modal__box apex-video-testimonials__modal-box">
                    <button class="apex-video-testimonials__close icon-btn" data-close="{{ modal_id }}" aria-label="Close video">
                      {% render 'icon', icon: 'close' %}
                    </button>
                    <div class="apex-video-testimonials__embed media media--portrait">
                      {%- if vtype == 'youtube' -%}
                        <iframe src="https://www.youtube.com/embed/{{ yt_id }}?autoplay=1&rel=0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen title="{{ block.settings.author | default: 'Video review' | escape }}" loading="lazy"></iframe>
                      {%- elsif vtype == 'vimeo' -%}
                        <iframe src="https://player.vimeo.com/video/{{ vim_id }}?autoplay=1" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen title="{{ block.settings.author | default: 'Video review' | escape }}" loading="lazy"></iframe>
                      {%- else -%}
                        <video controls autoplay playsinline{%- if block.settings.cover != blank %} poster="{{ block.settings.cover | image_url: width: 800 }}"{% endif %}>
                          <source src="{{ vurl }}" type="video/mp4">
                        </video>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.author != blank or block.settings.quote != blank -%}
                      <div class="apex-video-testimonials__modal-meta">
                        {%- if block.settings.quote != blank -%}<p class="apex-video-testimonials__modal-quote">{{ block.settings.quote }}</p>{%- endif -%}
                        <cite class="apex-video-testimonials__author">{{ block.settings.author | default: 'Happy Customer' }}</cite>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% stylesheet %}
.apex-video-testimonials__outer { position: relative; }
.apex-video-testimonials__slider { gap: var(--gutter); padding-bottom: .5rem; align-items: stretch; }
.apex-video-testimonials__grid { gap: var(--gutter); }
.apex-video-testimonials__card {
  border-radius: var(--radius-card);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.apex-video-testimonials__slider .apex-video-testimonials__card {
  width: min(300px, 78vw);
  flex: none;
}
.apex-video-testimonials__trigger {
  display: block;
  width: 100%;
  padding: 0;
  border: none;
  background: none;
  cursor: pointer;
  position: relative;
}
.apex-video-testimonials__trigger--static { cursor: default; }
.apex-video-testimonials__cover { border-radius: 0; overflow: hidden; }
.apex-video-testimonials__cover img { transition: transform .5s var(--ease); }
.apex-video-testimonials__trigger:not(.apex-video-testimonials__trigger--static):hover .apex-video-testimonials__cover img { transform: scale(1.04); }
.apex-video-testimonials__play {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 3.5rem; height: 3.5rem;
  background: rgba(255,255,255,.2);
  border: 2px solid rgba(255,255,255,.75);
  border-radius: var(--radius-pill);
  display: grid; place-items: center;
  color: #fff;
  backdrop-filter: blur(6px);
  transition: background .25s, transform .25s var(--ease);
}
.apex-video-testimonials__trigger:hover .apex-video-testimonials__play { background: rgba(255,255,255,.35); transform: translate(-50%,-50%) scale(1.08); }
.apex-video-testimonials__play svg { width: 1.3rem; height: 1.3rem; margin-left: .15em; }
.apex-video-testimonials__body { padding: 1.2rem; display: flex; flex-direction: column; gap: .8rem; flex: 1; }
.apex-video-testimonials__stars { display: flex; gap: .2rem; }
.apex-video-testimonials__star { color: var(--star); width: 1rem; height: 1rem; }
.apex-video-testimonials__star--empty { color: var(--border); }
.apex-video-testimonials__star svg { width: 100%; height: 100%; }
.apex-video-testimonials__quote { font-size: .95rem; line-height: 1.6; font-style: italic; color: var(--text); }
.apex-video-testimonials__quote p::before { content: '\201C'; }
.apex-video-testimonials__quote p::after { content: '\201D'; }
.apex-video-testimonials__footer { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-top: auto; }
.apex-video-testimonials__author { font-style: normal; font-weight: 700; font-size: .9rem; }
.apex-video-testimonials__nav { display: flex; gap: .6rem; justify-content: center; margin-top: 1.6rem; }
.apex-video-testimonials__btn { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border: var(--border-width) solid var(--border); border-radius: var(--radius-pill); background: var(--card); color: var(--text); transition: background .2s, border-color .2s; }
.apex-video-testimonials__btn:hover { background: var(--accent); border-color: var(--accent); color: var(--accent-text); }
.apex-video-testimonials__btn svg { width: 1.2rem; height: 1.2rem; }
.apex-video-testimonials__modal-box { max-width: min(520px, 94vw); background: var(--card); border-radius: var(--radius-card); overflow: hidden; position: relative; padding: 0; display: flex; flex-direction: column; }
.apex-video-testimonials__close { position: absolute; top: .8rem; right: .8rem; z-index: 2; background: rgba(0,0,0,.5); color: #fff; border-radius: var(--radius-pill); padding: .4rem; display: grid; place-items: center; }
.apex-video-testimonials__close:hover { background: rgba(0,0,0,.8); }
.apex-video-testimonials__close svg { width: 1.1rem; height: 1.1rem; }
.apex-video-testimonials__embed { width: 100%; background: #000; }
.apex-video-testimonials__embed iframe,
.apex-video-testimonials__embed video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
.apex-video-testimonials__modal-meta { padding: 1.2rem 1.4rem; background: var(--card); }
.apex-video-testimonials__modal-quote { font-style: italic; font-size: .95rem; margin-bottom: .5rem; color: var(--text); }
{% endstylesheet %}
{% schema %}
{
  "name": "Video testimonials",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Customer stories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real people, real results"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subtext"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Grid columns",
      "default": "3",
      "info": "Used in grid layout only.",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Video review",
      "settings": [
        {
          "type": "image_picker",
          "id": "cover",
          "label": "Cover image (thumbnail)"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (YouTube, Vimeo or MP4)"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Short quote",
          "default": "This changed everything for me. I saw results within two weeks and I haven't looked back."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Sarah K."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "author": "Morgan T.",
            "rating": 5,
            "quote": "Genuinely life-changing. My skin has never looked better and I get compliments every day.",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Casey L.",
            "rating": 5,
            "quote": "I was sceptical at first but three weeks in I'm a total convert. Worth every penny.",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Jordan P.",
            "rating": 5,
            "quote": "Fast shipping, beautiful packaging, and results that actually deliver. Five stars all day.",
            "verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
