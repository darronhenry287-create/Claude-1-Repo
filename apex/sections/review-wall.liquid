{%- liquid
  assign s = section.settings
  assign total_ratings = 0
  assign total_reviews = section.blocks | size
  for block in section.blocks
    assign total_ratings = total_ratings | plus: block.settings.stars
  endfor
  if total_reviews > 0
    assign avg_score = total_ratings | divided_by: total_reviews | plus: 0.0
    assign avg_score_rounded = avg_score | round: 1
  else
    assign avg_score_rounded = 0
  endif
-%}
<section class="apex-review-wall color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="review-wall-{{ section.id }}">
  <div class="page-width">
    <div class="reveal">
      <div class="section-head{% if s.center_header %} section-head--center{% endif %}">
        {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
        {%- if total_reviews > 0 -%}
          <div class="apex-review-wall__summary cluster" style="{% if s.center_header %}justify-content:center{% endif %}">
            <span class="apex-review-wall__avg-score">{{ avg_score_rounded }}</span>
            <div>
              {% render 'rating', value: avg_score_rounded, count: total_reviews %}
              <p class="muted" style="font-size:var(--text-xs);margin-top:.2rem">Based on {{ total_reviews }} review{% if total_reviews != 1 %}s{% endif %}</p>
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="apex-review-wall__grid" style="--col-count:{{ s.column_count }}">
        {%- for block in section.blocks -%}
          {%- assign stars = block.settings.stars | plus: 0 -%}
          <div class="apex-review-wall__card card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="apex-review-wall__img media media--landscape">
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.author | escape }}
              </div>
            {%- endif -%}
            <div class="apex-review-wall__body">
              <div class="apex-review-wall__stars" aria-label="{{ stars }} out of 5 stars">
                {%- for i in (1..5) -%}
                  <span class="apex-review-wall__star{% if i > stars %} apex-review-wall__star--empty{% endif %}" aria-hidden="true">
                    {% render 'icon', icon: 'star' %}
                  </span>
                {%- endfor -%}
              </div>
              {%- if block.settings.text != blank -%}
                <p class="apex-review-wall__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.author != blank -%}
                <cite class="apex-review-wall__author">&#8212; {{ block.settings.author }}</cite>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.apex-review-wall__summary { margin-top: 1.2rem; gap: .8rem; align-items: center; }
.apex-review-wall__avg-score { font-family: var(--font-heading); font-weight: 800; font-size: 3rem; line-height: 1; color: var(--accent); }
.apex-review-wall__grid {
  columns: var(--col-count, 3) 240px;
  gap: var(--gutter);
}
.apex-review-wall__card {
  break-inside: avoid;
  margin-bottom: var(--gutter);
  overflow: hidden;
  display: block;
}
.apex-review-wall__body { padding: 1.2rem 1.4rem; display: flex; flex-direction: column; gap: .7rem; }
.apex-review-wall__stars { display: flex; gap: .2rem; }
.apex-review-wall__star { color: var(--star); width: 1rem; height: 1rem; }
.apex-review-wall__star--empty { color: var(--border); }
.apex-review-wall__star svg { width: 100%; height: 100%; }
.apex-review-wall__text { font-size: .95rem; line-height: 1.6; color: var(--text); }
.apex-review-wall__author { font-style: normal; font-size: var(--text-sm); font-weight: 600; color: var(--text-muted); }
.apex-review-wall__img { border-radius: 0; }
@media (max-width: 600px) { .apex-review-wall__grid { columns: 1; } }
{% endstylesheet %}
{% schema %}
{
  "name": "Review wall",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Customer reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers are saying" },
    { "type": "checkbox", "id": "center_header", "label": "Center header", "default": true },
    { "type": "range", "id": "column_count", "min": 2, "max": 4, "step": 1, "label": "Column count", "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text", "default": "Exceeded all my expectations. Incredible quality and fast delivery." },
        { "type": "text", "id": "author", "label": "Author", "default": "Sarah K." },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Review wall",
      "blocks": [
        { "type": "review", "settings": { "stars": 5, "text": "Best purchase I've made all year. The attention to detail is remarkable.", "author": "Jordan L." } },
        { "type": "review", "settings": { "stars": 5, "text": "I bought this as a gift and the recipient absolutely loved it. Will definitely be back.", "author": "Nadia F." } },
        { "type": "review", "settings": { "stars": 5, "text": "Top-notch quality. Exactly as described and arrived two days early.", "author": "Chris B." } },
        { "type": "review", "settings": { "stars": 4, "text": "Really happy with this. Solid build quality and does exactly what it says.", "author": "Maya P." } },
        { "type": "review", "settings": { "stars": 5, "text": "Incredible value. I've already recommended this to three friends.", "author": "Devon W." } },
        { "type": "review", "settings": { "stars": 5, "text": "Five stars, no hesitation. This is the real deal.", "author": "Sam T." } }
      ]
    }
  ]
}
{% endschema %}
