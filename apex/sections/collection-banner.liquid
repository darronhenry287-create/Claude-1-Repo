{%- liquid
  assign s = section.settings
  assign coll = s.collection
-%}
<section class="apex-collection-banner color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px;--overlay:{{ s.overlay_opacity | divided_by: 100.0 }}"
  id="collection-banner-{{ section.id }}">

  <div class="apex-cb__wrap apex-cb__wrap--{{ s.height }}">

    <div class="apex-cb__media">
      {%- liquid
        assign banner_image = s.image
        if banner_image == blank and coll != blank and coll.image != blank
          assign banner_image = coll.image
        endif
      -%}
      {%- if banner_image != blank -%}
        {%- assign img_alt = banner_image.alt -%}
        {{ banner_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1600,2000,2400', sizes: '100vw', alt: img_alt, class: 'apex-cb__bg-img' }}
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg apex-cb__bg-img' }}
      {%- endif -%}
    </div>

    <div class="apex-cb__overlay" aria-hidden="true"></div>

    <div class="page-width apex-cb__inner">
      <div class="apex-cb__content reveal stack apex-cb__content--{{ s.text_align }}">

        {%- if s.eyebrow != blank -%}
          <p class="eyebrow eyebrow--pill apex-cb__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}

        {%- liquid
          assign banner_title = s.title
          if banner_title == blank and coll != blank
            assign banner_title = coll.title
          endif
        -%}
        {%- if banner_title != blank -%}
          <h2 class="apex-cb__title balance">{{ banner_title }}</h2>
        {%- endif -%}

        {%- liquid
          assign banner_desc = s.description
          if banner_desc == blank and coll != blank and coll.description != blank
            assign banner_desc = coll.description
          endif
        -%}
        {%- if banner_desc != blank -%}
          <div class="apex-cb__desc rte subtitle">{{ banner_desc }}</div>
        {%- endif -%}

        {%- if s.show_product_count and coll != blank -%}
          <p class="apex-cb__count muted">{{ coll.products_count }} {{ coll.products_count | pluralize: 'product', 'products' }}</p>
        {%- endif -%}

        {%- liquid
          assign cta_label = s.cta_label
          assign cta_url = s.cta_url
          if cta_url == blank and coll != blank
            assign cta_url = coll.url
          endif
          if cta_label == blank
            assign cta_label = 'Shop the collection'
          endif
        -%}
        {%- if cta_url != blank or coll != blank -%}
          <div class="cluster">
            <a class="btn btn--accent btn--lg" href="{{ cta_url }}">{{ cta_label }}</a>
          </div>
        {%- endif -%}

      </div>
    </div>

  </div>

</section>
{% stylesheet %}
.apex-cb__wrap {
  position: relative;
  display: grid;
  align-items: center;
  overflow: hidden;
}
.apex-cb__wrap--sm { min-height: 36vh; }
.apex-cb__wrap--md { min-height: 55vh; }
.apex-cb__wrap--lg { min-height: 72vh; }
.apex-cb__wrap--full { min-height: 100svh; }
.apex-cb__media {
  position: absolute;
  inset: 0;
}
.apex-cb__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.apex-cb__overlay {
  position: absolute;
  inset: 0;
  background: #000;
  opacity: var(--overlay, 0.38);
}
.apex-cb__inner {
  position: relative;
  width: 100%;
}
.apex-cb__content {
  max-width: 42rem;
  gap: 1.2rem;
  color: #fff;
  padding-block: clamp(2.5rem, 2rem + 3vw, 5rem);
}
.apex-cb__content--center { margin-inline: auto; text-align: center; }
.apex-cb__content--center .cluster { justify-content: center; }
.apex-cb__content--right { margin-left: auto; text-align: right; }
.apex-cb__content--right .cluster { justify-content: flex-end; }
.apex-cb__eyebrow { color: rgba(255,255,255,.85); }
.apex-cb__title {
  font-size: clamp(2rem, 1.2rem + 4vw, 4rem);
  line-height: 1.04;
  letter-spacing: var(--heading-letter-spacing);
}
.apex-cb__desc { opacity: .9; }
.apex-cb__count {
  font-size: var(--text-sm);
  font-weight: 600;
  letter-spacing: .06em;
  color: rgba(255,255,255,.7);
}
@media (max-width: 749px) {
  .apex-cb__content { padding-inline: 0; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Banner content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (overrides collection image)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title (overrides collection title)"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description (overrides collection description)"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link (overrides collection URL)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "default": "md",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Content alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Collection banner",
      "settings": {
        "eyebrow": "Shop now",
        "title": "Our collection",
        "cta_label": "Browse all products",
        "height": "md",
        "overlay_opacity": 40
      }
    }
  ]
}
{% endschema %}
