{%- liquid
  assign s = section.settings
  assign tier_count = section.blocks | size
-%}
<section class="apex-pricing color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="pricing-{{ section.id }}">
  <div class="page-width">
    <div class="reveal">
      {%- if s.heading != blank or s.subheading != blank -%}
        <div class="section-head section-head--center">
          {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.text != blank -%}<p class="subtitle balance">{{ s.text }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="apex-pricing__grid" style="--tier-count:{{ tier_count }}">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- assign features = bs.features | newline_to_br | split: '<br />' -%}
          <div class="apex-pricing__tier card{% if bs.highlighted %} apex-pricing__tier--featured{% endif %}" {{ block.shopify_attributes }}>
            {%- if bs.badge != blank -%}
              <span class="badge apex-pricing__badge">{{ bs.badge }}</span>
            {%- endif -%}

            <div class="apex-pricing__head">
              {%- if bs.name != blank -%}<h3 class="apex-pricing__name h4">{{ bs.name }}</h3>{%- endif -%}
              <div class="apex-pricing__price">
                {%- if bs.price != blank -%}
                  <span class="apex-pricing__amount">{{ bs.price }}</span>
                {%- endif -%}
                {%- if bs.period != blank -%}
                  <span class="apex-pricing__period muted">{{ bs.period }}</span>
                {%- endif -%}
              </div>
            </div>

            {%- if features.size > 0 -%}
              <ul class="apex-pricing__features">
                {%- for feature in features -%}
                  {%- assign feat_text = feature | strip -%}
                  {%- if feat_text != blank and feat_text != '<br>' -%}
                    <li class="apex-pricing__feature">
                      <span class="apex-pricing__check" aria-hidden="true">{% render 'icon', icon: 'check' %}</span>
                      {{ feat_text }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if bs.button_label != blank -%}
              <div class="apex-pricing__cta">
                <a class="btn btn--block{% if bs.highlighted %} btn--accent{% else %} btn--secondary{% endif %}"
                   href="{{ bs.button_url | default: '#' }}">
                  {{ bs.button_label }}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.apex-pricing__grid {
  display: grid;
  grid-template-columns: repeat(min(var(--tier-count, 3), 4), 1fr);
  gap: var(--gutter);
  align-items: start;
}
.apex-pricing__tier {
  position: relative;
  padding: 2rem 1.6rem;
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
}
.apex-pricing__tier--featured {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px var(--accent), var(--shadow-pop);
  transform: scale(1.03);
  z-index: 1;
}
.apex-pricing__badge {
  position: absolute;
  top: -0.75rem;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
}
.apex-pricing__head { display: grid; gap: .5rem; }
.apex-pricing__name { margin: 0; }
.apex-pricing__price { display: flex; align-items: baseline; gap: .3rem; flex-wrap: wrap; }
.apex-pricing__amount {
  font-family: var(--font-heading);
  font-weight: 800;
  font-size: clamp(2rem, 3vw, 2.6rem);
  line-height: 1;
  color: var(--text);
}
.apex-pricing__period { font-size: var(--text-sm); }
.apex-pricing__features { display: grid; gap: .65rem; flex: 1; }
.apex-pricing__feature { display: flex; align-items: flex-start; gap: .6rem; font-size: .95rem; line-height: 1.5; }
.apex-pricing__check { flex: none; width: 1.1rem; height: 1.1rem; color: var(--success); margin-top: .15rem; }
.apex-pricing__check svg { width: 100%; height: 100%; }
.apex-pricing__cta { margin-top: auto; }
@media (max-width: 900px) {
  .apex-pricing__grid { grid-template-columns: repeat(2, 1fr); }
  .apex-pricing__tier--featured { transform: none; }
}
@media (max-width: 540px) {
  .apex-pricing__grid { grid-template-columns: 1fr; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Pricing table",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Simple pricing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose the plan that works for you" },
    { "type": "text", "id": "text", "label": "Subtext", "default": "No hidden fees. Cancel any time." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Pricing tier",
      "settings": [
        { "type": "text", "id": "name", "label": "Plan name", "default": "Starter" },
        { "type": "text", "id": "price", "label": "Price (e.g. $29)", "default": "$29" },
        { "type": "text", "id": "period", "label": "Period (e.g. /month)", "default": "/month" },
        { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "Up to 5 products\nBasic analytics\nEmail support\n1 user account" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Get started" },
        { "type": "url", "id": "button_url", "label": "Button link" },
        { "type": "checkbox", "id": "highlighted", "label": "Highlight this plan", "default": false },
        { "type": "text", "id": "badge", "label": "Badge text (e.g. Most popular)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pricing table",
      "blocks": [
        { "type": "tier", "settings": { "name": "Starter", "price": "$19", "period": "/month", "features": "Up to 5 products\nBasic analytics\nEmail support\n1 user account", "button_label": "Get started", "highlighted": false } },
        { "type": "tier", "settings": { "name": "Pro", "price": "$49", "period": "/month", "features": "Unlimited products\nAdvanced analytics\nPriority support\n5 user accounts\nCustom domain", "button_label": "Start free trial", "highlighted": true, "badge": "Most popular" } },
        { "type": "tier", "settings": { "name": "Enterprise", "price": "$99", "period": "/month", "features": "Everything in Pro\nDedicated account manager\nSLA guarantee\nUnlimited users\nWhite-label option", "button_label": "Contact sales", "highlighted": false } }
      ]
    }
  ]
}
{% endschema %}
