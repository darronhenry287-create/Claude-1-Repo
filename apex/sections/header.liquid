{%- liquid
  assign menu = section.settings.menu
  assign sticky = section.settings.sticky
-%}
<header class="header {% if sticky %}header--sticky{% endif %} color-{{ section.settings.color_scheme }}" {% if sticky %}data-header-sticky{% endif %}>
  <div class="page-width">
    <div class="header__bar">
      <button class="icon-btn nav-toggle" data-open="menu-drawer" aria-label="{{ 'sections.header.menu' | t | default: 'Menu' }}">{% render 'icon', icon: 'menu' %}</button>

      {%- if section.settings.layout == 'center' -%}
        <nav class="header__nav" aria-label="Primary">
          {%- for link in menu.links limit: 4 -%}<a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{%- endfor -%}
        </nav>
      {%- endif -%}

      <a href="{{ routes.root_url }}" class="header__logo" style="margin-{% if section.settings.layout == 'center' %}inline:auto{% else %}right:auto{% endif %}">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 600 | image_tag: widths: '150,300,450,600', style: 'width:{{ settings.logo_width }}px', alt: shop.name | escape }}
        {%- else -%}{{ shop.name }}{%- endif -%}
      </a>

      {%- if section.settings.layout != 'center' -%}
        <nav class="header__nav" aria-label="Primary">
          {%- for link in menu.links -%}
            {%- if link.links != blank -%}
              <span class="has-mega" style="position:static">
                <a href="{{ link.url }}">{{ link.title }} {% render 'icon', icon: 'chevron-down', stroke: 2 %}</a>
                <div class="mega"><div class="page-width" style="display:grid;grid-template-columns:repeat({{ link.links.size | at_most: 4 }},1fr);gap:1.5rem;padding-block:1.6rem">
                  {%- for child in link.links -%}
                    <div><a href="{{ child.url }}" style="font-weight:700;display:block;margin-bottom:.5rem">{{ child.title }}</a>
                      {%- for g in child.links -%}<a href="{{ g.url }}" class="muted" style="display:block;padding:.2rem 0">{{ g.title }}</a>{%- endfor -%}
                    </div>
                  {%- endfor -%}
                </div></div>
              </span>
            {%- else -%}
              <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}

      <div class="header__actions">
        {%- if section.settings.show_search -%}<button class="icon-btn" data-open="search-drawer" aria-label="{{ 'general.search' | t | default: 'Search' }}">{% render 'icon', icon: 'search' %}</button>{%- endif -%}
        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}<a class="icon-btn" href="{{ routes.account_url }}" aria-label="{{ 'customer.account' | t | default: 'Account' }}">{% render 'icon', icon: 'user' %}</a>{%- endif -%}
        <button class="icon-btn" data-open="cart-drawer" aria-label="{{ 'sections.cart.title' | t | default: 'Cart' }}">
          {% render 'icon', icon: 'bag' %}
          <span class="count-bubble" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </div>
</header>

{%- comment -%} mobile menu drawer {%- endcomment -%}
<div id="menu-drawer" class="drawer drawer--left color-{{ section.settings.color_scheme }}" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="drawer__head"><span class="header__logo">{{ shop.name }}</span><button class="icon-btn" data-close="menu-drawer" aria-label="Close">{% render 'icon', icon: 'close' %}</button></div>
  <nav class="drawer__body" aria-label="Mobile">
    {%- for link in menu.links -%}
      {%- if link.links != blank -%}
        <details class="accordion__item"><summary class="accordion__head" style="font-size:1.2rem">{{ link.title }} {% render 'icon', icon: 'chevron-down', stroke: 2 %}</summary>
          <div style="padding-bottom:1rem">{%- for child in link.links -%}<a href="{{ child.url }}" style="display:block;padding:.5rem 0" class="muted">{{ child.title }}</a>{%- endfor -%}</div>
        </details>
      {%- else -%}
        <a href="{{ link.url }}" style="display:block;padding:.9rem 0;font-family:var(--font-heading);font-weight:700;font-size:1.3rem;border-bottom:1px solid var(--border)">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
</div>

{%- comment -%} search drawer {%- endcomment -%}
{%- if section.settings.show_search -%}
<apex-search id="search-drawer" class="drawer drawer--right color-{{ section.settings.color_scheme }}" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="drawer__head"><strong>{{ 'general.search' | t | default: 'Search' }}</strong><button class="icon-btn" data-close="search-drawer" aria-label="Close">{% render 'icon', icon: 'close' %}</button></div>
  <div class="drawer__body">
    <form action="{{ routes.search_url }}" method="get" role="search" class="input-group">
      <input type="search" name="q" placeholder="{{ 'general.search_placeholder' | t | default: 'Search products…' }}" autocomplete="off">
      <button class="btn btn--accent" type="submit">{% render 'icon', icon: 'search' %}</button>
    </form>
    <div data-results style="margin-top:1.2rem"></div>
  </div>
</apex-search>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [ {"value":"left","label":"Logo left, nav right"}, {"value":"center","label":"Logo center"} ], "default": "left" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
