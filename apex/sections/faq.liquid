{%- liquid
  assign s = section.settings
-%}
<section class="apex-faq color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="faq-{{ section.id }}">
  <div class="page-width{% if s.two_column == false %} page-width--narrow{% endif %}">
    <div class="reveal">
      {%- if s.heading != blank or s.subheading != blank -%}
        <div class="section-head{% if s.center_header %} section-head--center{% endif %}">
          {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.text != blank -%}<p class="subtitle balance">{{ s.text }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="apex-faq__body{% if s.two_column %} apex-faq__body--two-col{% endif %}">
        <div class="accordion"{% if s.single_open %} data-accordion-single{% endif %}>
          {%- for block in section.blocks -%}
            <details class="accordion__item" {{ block.shopify_attributes }}>
              <summary class="accordion__head">
                <span>{{ block.settings.question }}</span>
                <span class="accordion__icon" aria-hidden="true"></span>
              </summary>
              <div class="accordion__body rte">
                {{ block.settings.answer }}
              </div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.apex-faq__body--two-col .accordion { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 var(--gutter); }
.apex-faq__body--two-col .accordion__item { break-inside: avoid; }
@media (max-width: 768px) { .apex-faq__body--two-col .accordion { grid-template-columns: 1fr; } }
{% endstylesheet %}
{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Got questions?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "text", "id": "text", "label": "Subtext", "default": "Everything you need to know." },
    { "type": "checkbox", "id": "center_header", "label": "Center header", "default": true },
    { "type": "checkbox", "id": "two_column", "label": "Two-column layout", "default": false },
    { "type": "checkbox", "id": "single_open", "label": "Only one item open at a time", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What makes your product different?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Our products are designed with precision and crafted from premium materials. Every detail is considered to ensure you get the best possible experience.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "item", "settings": { "question": "What makes your product different?", "answer": "<p>We obsess over quality at every step — from sourcing materials to final quality control. The result is a product that consistently outperforms the competition.</p>" } },
        { "type": "item", "settings": { "question": "How long does shipping take?", "answer": "<p>Standard shipping takes 3–5 business days. Express options are available at checkout and typically deliver within 1–2 business days.</p>" } },
        { "type": "item", "settings": { "question": "What is your return policy?", "answer": "<p>We offer a 30-day hassle-free return policy. If you're not completely satisfied, contact our support team and we'll make it right.</p>" } },
        { "type": "item", "settings": { "question": "Do you offer international shipping?", "answer": "<p>Yes, we ship to over 50 countries worldwide. International shipping times and rates vary by destination and are calculated at checkout.</p>" } }
      ]
    }
  ]
}
{% endschema %}
