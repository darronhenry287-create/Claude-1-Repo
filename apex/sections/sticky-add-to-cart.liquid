{%- liquid
  assign s = section.settings
  assign current_variant = product.selected_or_first_available_variant
  comment
    Must match the form id emitted by sections/main-product.liquid so the bar
    can submit that form. Both derive it from product.id.
  endcomment
  assign form_id = 'product-form-' | append: product.id
  assign featured = current_variant.featured_media | default: product.featured_media
-%}
{%- if product != blank -%}
  <div class="sticky-atc apex-sticky color-{{ s.color_scheme }}"
    data-sticky-atc=""
    role="region"
    aria-label="{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}">
    <div class="sticky-atc__inner">
      {%- if s.show_image and featured -%}
        <div class="apex-sticky__thumb media media--square">
          {{ featured | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}
        </div>
      {%- endif -%}

      <div class="apex-sticky__info">
        <p class="apex-sticky__title">{{ product.title }}</p>
        <div class="apex-sticky__price" data-price>{% render 'price', product: product %}</div>
      </div>

      {%- comment -%}
        Primary path: submit the PDP form (keeps the shopper's selected variant
        + quantity). base.js intercepts that form's submit for AJAX add. If the
        PDP form is not present (e.g. removed), fall back to a self-contained
        apex-product-form that quick-adds the current variant.
      {%- endcomment -%}
      <apex-product-form class="apex-sticky__form">
        <script type="application/json" data-variants>
          [
            {%- for v in product.variants -%}
              {
                "id": {{ v.id | json }},
                "price": {{ v.price | json }},
                "compare_at_price": {{ v.compare_at_price | default: 0 | json }},
                "available": {{ v.available | json }},
                "options": [{{ v.option1 | json }}{% if product.options.size > 1 %}, {{ v.option2 | json }}{% endif %}{% if product.options.size > 2 %}, {{ v.option3 | json }}{% endif %}]
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>
        <form action="{{ routes.cart_url }}/add" method="post" class="apex-sticky__fallback-form">
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" value="1">
        </form>
        <button type="submit"
          form="{{ form_id }}"
          class="btn btn--accent apex-sticky__atc"
          data-atc
          data-label="{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}"
          {% unless product.available %}disabled{% endunless %}>
          <span data-atc-label>{% if product.available %}{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}{% else %}{{ 'products.product.sold_out' | t | default: 'Sold out' }}{% endif %}</span>
        </button>
      </apex-product-form>
    </div>
  </div>

  {% stylesheet %}
  .apex-sticky .sticky-atc__inner { gap: .8rem; }
  .apex-sticky__thumb { width: 48px; height: 48px; flex: none; border-radius: var(--radius-sm); }
  .apex-sticky__info { min-width: 0; flex: 1; }
  .apex-sticky__title { font-family: var(--font-heading); font-weight: 700; font-size: .98rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .apex-sticky__price { font-size: var(--text-sm); }
  .apex-sticky__price .price { font-size: var(--text-sm); }
  .apex-sticky__form { display: contents; }
  .apex-sticky__fallback-form { display: none; }
  .apex-sticky__atc { flex: none; }
  @media (max-width: 600px) {
    .apex-sticky__title { font-size: .88rem; }
    .apex-sticky__atc { padding-inline: 1.1em; }
  }
  {% endstylesheet %}

  {% javascript %}
  (() => {
    // The bar's button submits the PDP form by id (preferred). If that form is
    // missing, hand the click to this bar's own fallback form so base.js'
    // apex-product-form still runs the AJAX add.
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.apex-sticky__atc');
      if (!btn) return;
      const targetId = btn.getAttribute('form');
      const pdpForm = targetId && document.getElementById(targetId);
      if (pdpForm) return; // native form= submit handles it
      e.preventDefault();
      const fallback = btn.closest('apex-product-form').querySelector('.apex-sticky__fallback-form');
      if (fallback) fallback.requestSubmit ? fallback.requestSubmit() : fallback.submit();
    });

    // Mirror the variant the shopper picked on the PDP: base.js dispatches a
    // bubbling `variant:change`, so update this bar's price, the fallback id,
    // and the button availability to match.
    document.addEventListener('variant:change', (e) => {
      const v = e.detail && e.detail.variant;
      const bar = document.querySelector('.apex-sticky');
      if (!bar) return;
      const fallbackId = bar.querySelector('.apex-sticky__fallback-form [name=id]');
      const priceEl = bar.querySelector('[data-price]');
      const btn = bar.querySelector('.apex-sticky__atc');
      const money = (c) => (window.Shopify && Shopify.formatMoney) ? Shopify.formatMoney(c, window.APEX && window.APEX.moneyFormat) : '$' + (c / 100).toFixed(2);
      if (v && fallbackId) fallbackId.value = v.id;
      if (priceEl && v) {
        priceEl.innerHTML = v.compare_at_price > v.price
          ? '<span class="price price--sale"><span class="price__current">' + money(v.price) + '</span> <s class="price__compare">' + money(v.compare_at_price) + '</s></span>'
          : '<span class="price"><span class="price__current">' + money(v.price) + '</span></span>';
      }
      if (btn) {
        const ok = v && v.available;
        btn.disabled = !ok;
        const lbl = btn.querySelector('[data-atc-label]');
        if (lbl) lbl.textContent = !v ? 'Unavailable' : ok ? (btn.dataset.label || 'Add to cart') : 'Sold out';
      }
    });
  })();
  {% endjavascript %}
{%- endif -%}

{% schema %}
{
  "name": "Sticky add to cart",
  "tag": "section",
  "class": "shopify-section--sticky-atc",
  "settings": [
    {
      "type": "paragraph",
      "content": "Appears on scroll once the main add-to-cart button leaves the viewport. Mirrors the product title, price and add button."
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product image",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Sticky add to cart"
    }
  ]
}
{% endschema %}
