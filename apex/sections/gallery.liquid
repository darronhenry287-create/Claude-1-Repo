{%- liquid
  assign s = section.settings
  assign col_class = 'grid--3'
  if s.columns == 2
    assign col_class = 'grid--2'
  elsif s.columns == 4
    assign col_class = 'grid--4'
  endif
  assign gap_style = 'gap:' | append: s.gap | append: 'px'
-%}
<section class="apex-gallery color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px">
  <div class="page-width">

    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="section-head{% if s.heading_align == 'center' %} section-head--center{% endif %} reveal">
        {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="apex-gallery__grid grid {{ col_class }}" style="{{ gap_style }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign ratio = 'media--square'
            if s.image_ratio == 'portrait'
              assign ratio = 'media--portrait'
            elsif s.image_ratio == 'landscape'
              assign ratio = 'media--landscape'
            elsif s.image_ratio == 'wide'
              assign ratio = 'media--wide'
            endif
          -%}
          <div class="apex-gallery__item reveal{% if forloop.index > 1 %} reveal--delay-{{ forloop.index | modulo: 3 | plus: 1 }}{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="apex-gallery__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.caption | default: 'Gallery image' | escape }}">
            {%- endif -%}

            <div class="apex-gallery__media media {{ ratio }}" style="border-radius:var(--radius-card);overflow:hidden">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag:
                    loading: 'lazy',
                    widths: '400,600,800,1000,1200',
                    sizes: '(min-width:990px) 33vw, (min-width:750px) 50vw, 100vw',
                    alt: block.settings.image.alt }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <div class="apex-gallery__overlay" aria-hidden="true">
                  <span class="apex-gallery__overlay-icon">{% render 'icon', icon: 'plus' %}</span>
                </div>
              {%- endif -%}
            </div>

            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}

            {%- if s.show_captions and block.settings.caption != blank -%}
              <p class="apex-gallery__caption muted">{{ block.settings.caption }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="apex-gallery__grid grid {{ col_class }}" style="{{ gap_style }}">
        {%- for i in (1..6) -%}
          <div class="apex-gallery__item reveal">
            <div class="apex-gallery__media media media--square" style="border-radius:var(--radius-card);overflow:hidden">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>
{% stylesheet %}
.apex-gallery__item { position: relative; }
.apex-gallery__link { display: block; }
.apex-gallery__media img { transition: transform .45s var(--ease); }
.apex-gallery__item:hover .apex-gallery__media img { transform: scale(1.06); }
.apex-gallery__overlay { position: absolute; inset: 0; background: rgba(8,12,20,.4); display: grid; place-items: center; opacity: 0; border-radius: var(--radius-card); transition: opacity .3s var(--ease); }
.apex-gallery__link:hover .apex-gallery__overlay,
.apex-gallery__link:focus .apex-gallery__overlay { opacity: 1; }
.apex-gallery__overlay-icon { width: 3rem; height: 3rem; background: rgba(255,255,255,.15); border: 1.5px solid rgba(255,255,255,.6); border-radius: var(--radius-pill); display: grid; place-items: center; color: #fff; backdrop-filter: blur(4px); }
.apex-gallery__overlay-icon svg { width: 1.3rem; height: 1.3rem; }
.apex-gallery__caption { margin-top: .7rem; font-size: var(--text-sm); text-align: center; }
{% endstylesheet %}
{% schema %}
{
  "name": "Gallery",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Lookbook"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In the wild"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid gap",
      "default": 12
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "landscape",
          "label": "Landscape (4:3)"
        },
        {
          "value": "wide",
          "label": "Wide (16:9)"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_captions",
      "label": "Show captions",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (opens on click)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery",
      "settings": {
        "heading": "In the wild",
        "subheading": "Lookbook",
        "columns": 3,
        "gap": 12,
        "image_ratio": "square"
      },
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
