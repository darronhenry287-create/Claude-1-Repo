{%- liquid
  assign s = section.settings
-%}
<section class="apex-listicle color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="listicle-{{ section.id }}">
  <div class="page-width--narrow">
    <div class="reveal stack apex-listicle__inner">

      {%- if s.intro != blank -%}
        <div class="rte apex-listicle__intro">{{ s.intro }}</div>
      {%- endif -%}

      {%- assign item_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign item_count = item_count | plus: 1
          assign bs = block.settings
          assign display_num = item_count
          if bs.custom_number != blank
            assign display_num = bs.custom_number
          endif
        -%}
        <div class="apex-listicle__item card" {{ block.shopify_attributes }}>
          <div class="apex-listicle__number-col" aria-hidden="true">
            <span class="apex-listicle__num">{{ display_num }}</span>
          </div>
          <div class="apex-listicle__content stack">

            {%- if bs.image != blank -%}
              <div class="media media--landscape apex-listicle__img">
                {{ bs.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width:990px) 640px, 100vw', alt: bs.image.alt }}
              </div>
            {%- else -%}
              <div class="media media--landscape apex-listicle__img">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}

            {%- if bs.heading != blank -%}
              <h2 class="apex-listicle__heading h3">{{ bs.heading }}</h2>
            {%- endif -%}

            {%- if bs.rating_value != blank -%}
              <div class="apex-listicle__rating">
                {% render 'rating', value: bs.rating_value, count: bs.rating_count %}
              </div>
            {%- endif -%}

            {%- if bs.body != blank -%}
              <div class="rte apex-listicle__body">{{ bs.body }}</div>
            {%- endif -%}

            {%- if bs.pros != blank or bs.cons != blank -%}
              <div class="apex-listicle__proscons cluster" style="align-items:flex-start;gap:2rem">
                {%- if bs.pros != blank -%}
                  <ul class="apex-listicle__pros stack" style="gap:.4rem;list-style:none;padding:0;margin:0">
                    {%- assign pros_lines = bs.pros | newline_to_br | split: '<br />' -%}
                    {%- for line in pros_lines -%}
                      {%- assign trimmed = line | strip -%}
                      {%- if trimmed != blank -%}
                        <li class="apex-listicle__pro-item cluster" style="gap:.5rem;align-items:flex-start">
                          <span class="apex-listicle__check" aria-hidden="true">{% render 'icon', icon: 'check' %}</span>
                          <span>{{ trimmed }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
                {%- if bs.cons != blank -%}
                  <ul class="apex-listicle__cons stack" style="gap:.4rem;list-style:none;padding:0;margin:0">
                    {%- assign cons_lines = bs.cons | newline_to_br | split: '<br />' -%}
                    {%- for line in cons_lines -%}
                      {%- assign trimmed = line | strip -%}
                      {%- if trimmed != blank -%}
                        <li class="apex-listicle__con-item cluster" style="gap:.5rem;align-items:flex-start">
                          <span class="apex-listicle__cross" aria-hidden="true">{% render 'icon', icon: 'close' %}</span>
                          <span>{{ trimmed }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if bs.cta_label != blank -%}
              <div>
                <a class="btn btn--accent" href="{{ bs.cta_url | default: '#' }}">{{ bs.cta_label }}</a>
              </div>
            {%- endif -%}

          </div>
        </div>
      {%- endfor -%}

      {%- if s.disclaimer != blank -%}
        <p class="apex-listicle__disclaimer muted">{{ s.disclaimer }}</p>
      {%- endif -%}

    </div>
  </div>
</section>
{% stylesheet %}
.apex-listicle__inner { gap: 2.5rem; }
.apex-listicle__intro { font-size: 1.05rem; }
.apex-listicle__item.card {
  display: grid;
  grid-template-columns: 5rem 1fr;
  gap: 0;
  padding: 0;
  overflow: hidden;
  border-radius: var(--radius-card);
}
.apex-listicle__number-col {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 1.4rem .8rem 0;
  background: var(--accent);
}
.apex-listicle__num {
  font-family: var(--font-heading);
  font-size: 2.6rem;
  font-weight: 800;
  line-height: 1;
  color: var(--accent-text);
  letter-spacing: -.02em;
}
.apex-listicle__content { padding: 1.6rem; gap: 1rem; }
.apex-listicle__img { border-radius: var(--radius); overflow: hidden; }
.apex-listicle__img img,
.apex-listicle__img .placeholder-svg { width: 100%; height: 100%; object-fit: cover; }
.apex-listicle__heading { margin: 0; }
.apex-listicle__check svg { color: var(--success, #16a34a); width: 1rem; height: 1rem; flex: none; margin-top: .15rem; }
.apex-listicle__cross svg { color: var(--sale, #dc2626); width: 1rem; height: 1rem; flex: none; margin-top: .15rem; }
.apex-listicle__pro-item,
.apex-listicle__con-item { font-size: .95rem; }
.apex-listicle__disclaimer { font-size: var(--text-xs); border-top: var(--border-width) solid var(--border); padding-top: 1rem; }
@media (max-width: 600px) {
  .apex-listicle__item.card { grid-template-columns: 3.5rem 1fr; }
  .apex-listicle__num { font-size: 2rem; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Listicle",
  "tag": "section",
  "settings": [
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>We researched, tested, and ranked the top options so you don't have to. Here's what we found.</p>"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "* Results may vary. This article contains sponsored content. We may earn a commission from qualifying purchases."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "List item",
      "settings": [
        {
          "type": "text",
          "id": "custom_number",
          "label": "Custom number/label",
          "info": "Leave blank to auto-number"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Best Overall Pick"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>This option consistently topped our testing categories. Customers who tried it reported noticeably better results within the first week, with improvements continuing over time.</p>"
        },
        {
          "type": "text",
          "id": "rating_value",
          "label": "Rating value (e.g. 4.8)"
        },
        {
          "type": "text",
          "id": "rating_count",
          "label": "Rating count (e.g. 2,400)"
        },
        {
          "type": "textarea",
          "id": "pros",
          "label": "Pros (one per line)"
        },
        {
          "type": "textarea",
          "id": "cons",
          "label": "Cons (one per line)"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Listicle",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "heading": "Best Overall Pick",
            "body": "<p>This option consistently topped our testing categories. Customers reported noticeably better results within the first week.</p>",
            "rating_value": "4.9",
            "rating_count": "3,200+",
            "pros": "Fast-acting formula\nThird-party tested\nFree shipping included",
            "cons": "Premium price point",
            "cta_label": "Shop now"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Best Value",
            "body": "<p>If you're looking for quality without the premium price tag, this is the one. Delivers consistent results at a fraction of the cost.</p>",
            "rating_value": "4.7",
            "rating_count": "1,800+",
            "pros": "Most affordable option\nSatisfaction guarantee\nEasy to use",
            "cons": "Fewer flavour options\nSlightly slower shipping",
            "cta_label": "Shop now"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Best for Beginners",
            "body": "<p>New to this category? This pick makes it simple. A guided starter experience with everything you need included in one package.</p>",
            "rating_value": "4.6",
            "rating_count": "950+",
            "pros": "Beginner-friendly setup\nDetailed instructions included\n30-day trial period",
            "cons": "Not ideal for advanced users",
            "cta_label": "Shop now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
