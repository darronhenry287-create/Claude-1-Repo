{%- liquid
  assign s = section.settings
-%}
<section class="apex-pros-cons color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="pros-cons-{{ section.id }}">
  <div class="page-width">

    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="section-head{% if s.center_header %} section-head--center{% endif %} reveal">
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--pill">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="subtitle balance">{{ s.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="apex-pros-cons__grid reveal">

      {%- comment -%} Pros column {%- endcomment -%}
      <div class="apex-pros-cons__col apex-pros-cons__col--pros card">
        <div class="apex-pros-cons__col-head">
          <span class="apex-pros-cons__col-icon apex-pros-cons__col-icon--pro" aria-hidden="true">{% render 'icon', icon: 'check' %}</span>
          <h3 class="apex-pros-cons__col-title">{{ s.pros_heading | default: 'Pros' }}</h3>
        </div>
        {%- assign pro_items = s.pros | newline_to_br | split: '<br />' -%}
        {%- if pro_items.size > 0 -%}
          <ul class="apex-pros-cons__list stack" role="list">
            {%- for item in pro_items -%}
              {%- assign item_clean = item | strip -%}
              {%- if item_clean != blank -%}
                <li class="apex-pros-cons__item apex-pros-cons__item--pro">
                  <span class="apex-pros-cons__item-icon" aria-hidden="true">{% render 'icon', icon: 'check' %}</span>
                  <span>{{ item_clean }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Cons column {%- endcomment -%}
      <div class="apex-pros-cons__col apex-pros-cons__col--cons card">
        <div class="apex-pros-cons__col-head">
          <span class="apex-pros-cons__col-icon apex-pros-cons__col-icon--con" aria-hidden="true">{% render 'icon', icon: 'close' %}</span>
          <h3 class="apex-pros-cons__col-title">{{ s.cons_heading | default: 'Cons' }}</h3>
        </div>
        {%- assign con_items = s.cons | newline_to_br | split: '<br />' -%}
        {%- if con_items.size > 0 -%}
          <ul class="apex-pros-cons__list stack" role="list">
            {%- for item in con_items -%}
              {%- assign item_clean = item | strip -%}
              {%- if item_clean != blank -%}
                <li class="apex-pros-cons__item apex-pros-cons__item--con">
                  <span class="apex-pros-cons__item-icon" aria-hidden="true">{% render 'icon', icon: 'close' %}</span>
                  <span>{{ item_clean }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

    </div>

    {%- if s.show_verdict and s.verdict != blank -%}
      <div class="apex-pros-cons__verdict reveal">
        {%- if s.score != blank -%}
          <div class="apex-pros-cons__score" aria-label="{{ 'Overall score' }}: {{ s.score }}">
            <span class="apex-pros-cons__score-number">{{ s.score }}</span>
            <span class="apex-pros-cons__score-label">{{ s.score_label | default: 'Overall score' }}</span>
          </div>
        {%- endif -%}
        <div class="apex-pros-cons__verdict-text">
          {%- if s.verdict_label != blank -%}
            <p class="apex-pros-cons__verdict-label eyebrow">{{ s.verdict_label }}</p>
          {%- endif -%}
          <p class="apex-pros-cons__verdict-copy">{{ s.verdict }}</p>
        </div>
      </div>
    {%- endif -%}

  </div>
</section>
{% stylesheet %}
.apex-pros-cons__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--gutter);
}
.apex-pros-cons__col {
  padding: clamp(1.4rem, 1rem + 2vw, 2rem);
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}
.apex-pros-cons__col-head {
  display: flex;
  align-items: center;
  gap: .7rem;
  padding-bottom: 1rem;
  border-bottom: var(--border-width) solid var(--border);
}
.apex-pros-cons__col-icon {
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-pill);
  display: grid;
  place-items: center;
  flex: none;
}
.apex-pros-cons__col-icon svg { width: 1rem; height: 1rem; }
.apex-pros-cons__col-icon--pro {
  background: color-mix(in srgb, var(--success, #16a34a) 14%, transparent);
  color: var(--success, #16a34a);
}
.apex-pros-cons__col-icon--con {
  background: color-mix(in srgb, var(--sale, #e0364f) 14%, transparent);
  color: var(--sale, #e0364f);
}
.apex-pros-cons__col-title { font-size: 1.1rem; font-weight: 700; }
.apex-pros-cons__list { gap: .7rem; list-style: none; padding: 0; }
.apex-pros-cons__item {
  display: flex;
  align-items: flex-start;
  gap: .65rem;
  line-height: 1.5;
  font-size: .95rem;
}
.apex-pros-cons__item-icon {
  flex: none;
  width: 1.1rem;
  height: 1.1rem;
  margin-top: .15rem;
}
.apex-pros-cons__item-icon svg { width: 100%; height: 100%; }
.apex-pros-cons__item--pro .apex-pros-cons__item-icon { color: var(--success, #16a34a); }
.apex-pros-cons__item--con .apex-pros-cons__item-icon { color: var(--sale, #e0364f); }

/* verdict bar */
.apex-pros-cons__verdict {
  margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  display: flex;
  align-items: center;
  gap: 1.8rem;
  padding: 1.4rem 2rem;
  background: color-mix(in srgb, var(--accent) 7%, var(--bg-alt));
  border: var(--border-width) solid color-mix(in srgb, var(--accent) 20%, transparent);
  border-radius: var(--radius-card);
}
.apex-pros-cons__score {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: none;
  gap: .25rem;
}
.apex-pros-cons__score-number {
  font-family: var(--font-heading);
  font-weight: 800;
  font-size: 2.4rem;
  line-height: 1;
  color: var(--accent);
  letter-spacing: var(--heading-letter-spacing);
}
.apex-pros-cons__score-label {
  font-size: var(--text-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: var(--text-muted);
  white-space: nowrap;
}
.apex-pros-cons__verdict-text { flex: 1; }
.apex-pros-cons__verdict-label { font-size: var(--text-xs); margin-bottom: .35rem; }
.apex-pros-cons__verdict-copy { line-height: 1.6; color: var(--text-muted); }

@media (max-width: 600px) {
  .apex-pros-cons__grid { grid-template-columns: 1fr; }
  .apex-pros-cons__verdict { flex-direction: column; align-items: flex-start; gap: 1rem; padding: 1.2rem 1.4rem; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Pros & cons",
  "tag": "section",
  "class": "shopify-section--pros-cons",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The verdict"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Is it worth it?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "center_header",
      "label": "Center header",
      "default": true
    },
    {
      "type": "header",
      "content": "Pros"
    },
    {
      "type": "text",
      "id": "pros_heading",
      "label": "Pros column heading",
      "default": "Pros"
    },
    {
      "type": "textarea",
      "id": "pros",
      "label": "Pros (one per line)",
      "default": "Noticeably improves focus within 30 minutes\nClean, non-jittery energy all day\nTransparent ingredient list\nThird-party tested for purity\nPleasant taste — easy to take daily"
    },
    {
      "type": "header",
      "content": "Cons"
    },
    {
      "type": "text",
      "id": "cons_heading",
      "label": "Cons column heading",
      "default": "Cons"
    },
    {
      "type": "textarea",
      "id": "cons",
      "label": "Cons (one per line)",
      "default": "Premium price point\nResults vary by individual\nRequires consistent daily use"
    },
    {
      "type": "header",
      "content": "Verdict"
    },
    {
      "type": "checkbox",
      "id": "show_verdict",
      "label": "Show verdict bar",
      "default": true
    },
    {
      "type": "text",
      "id": "score",
      "label": "Overall score (e.g. 9.2/10)",
      "default": "9.2/10"
    },
    {
      "type": "text",
      "id": "score_label",
      "label": "Score label",
      "default": "Overall score"
    },
    {
      "type": "text",
      "id": "verdict_label",
      "label": "Verdict label",
      "default": "Our verdict"
    },
    {
      "type": "textarea",
      "id": "verdict",
      "label": "Verdict text",
      "default": "A standout performer in a crowded category. The quality is evident, the results are real, and the value is strong at this price. Highly recommended for anyone serious about their results."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Pros & cons"
    }
  ]
}
{% endschema %}
