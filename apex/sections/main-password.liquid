<section class="apex-password color-{{ section.settings.color_scheme }}" style="min-height:100vh;display:grid;place-content:center;text-align:center;gap:1.4rem;padding:4rem var(--gutter)">
  <div class="page-width page-width--narrow stack" style="gap:1.2rem;justify-items:center">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 600 | image_tag: widths: '200,400,600', class: 'apex-password__logo', alt: shop.name }}
    {%- else -%}
      <div class="header__logo" style="font-size:2rem">{{ shop.name }}</div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}<h1 class="h2 balance">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if shop.password_message != blank -%}<div class="rte subtitle">{{ shop.password_message }}</div>{%- endif -%}

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p style="color:var(--sale)">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>
      {%- endif -%}
      <div class="input-group" style="max-width:420px;margin-inline:auto;width:100%">
        <input type="password" name="password" placeholder="Enter store password" aria-label="Store password" required>
        <button type="submit" class="btn btn--accent">Enter</button>
      </div>
    {%- endform -%}

    <p class="muted" style="font-size:var(--text-sm)">Are you the store owner? <a class="link" href="/admin">Log in here</a></p>
  </div>
</section>
{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
