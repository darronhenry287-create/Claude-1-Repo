<div class="announcement color-{{ section.settings.color_scheme }}" style="border-bottom:var(--border-width) solid var(--border)">
  {%- if section.settings.marquee and section.blocks.size > 0 -%}
    <div class="marquee" style="--marquee-speed:{{ section.settings.speed }}s"><div class="marquee__track">
      {%- for block in section.blocks -%}<span style="display:inline-flex;align-items:center;gap:.6rem;padding:.6rem 1.4rem;font-size:var(--text-sm)" {{ block.shopify_attributes }}>{% if block.settings.icon != 'none' %}<span style="display:inline-flex;width:1.1em">{% render 'icon', icon: block.settings.icon %}</span>{% endif %}{{ block.settings.text }}</span>{%- endfor -%}
    </div></div>
  {%- else -%}
    <div class="page-width" style="display:flex;align-items:center;justify-content:center;gap:1rem;min-height:2.6rem;text-align:center;font-size:var(--text-sm)">
      {%- for block in section.blocks limit: 1 -%}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- else -%}<span>Announce something here</span>{%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "marquee",
      "label": "Scroll messages (marquee)",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "default": 30
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping over $50"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "return",
              "label": "Returns"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message"
        },
        {
          "type": "message",
          "settings": {
            "text": "30-day easy returns",
            "icon": "return"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Rated 4.9 by 10,000+ customers",
            "icon": "star"
          }
        }
      ]
    }
  ]
}
{% endschema %}
