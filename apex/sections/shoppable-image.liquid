{%- liquid
  assign s = section.settings
-%}
<section class="apex-shoppable-image color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="shoppable-image-{{ section.id }}">

  {%- if s.heading != blank or s.subheading != blank -%}
    <div class="page-width">
      <div class="section-head{% if s.center_header %} section-head--center{% endif %} reveal">
        {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="page-width{% if s.full_width %} page-width--full{% endif %}">
    <div class="apex-shoppable-image__stage reveal" id="shi-stage-{{ section.id }}">
      {%- comment -%} Background lifestyle image {%- endcomment -%}
      <div class="apex-shoppable-image__media media media--landscape">
        {%- if s.image != blank -%}
          {%- assign shi_alt = s.image.alt | default: s.heading | default: '' -%}
          {{ s.image | image_url: width: 1600 | image_tag:
              loading: 'lazy',
              widths: '600,900,1200,1600',
              sizes: '(min-width:1280px) 1280px, 100vw',
              alt: shi_alt }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- comment -%} Hotspot pins {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign pin_id = 'shi-pin-' | append: section.id | append: '-' | append: forloop.index0
          assign pop_id = 'shi-pop-' | append: section.id | append: '-' | append: forloop.index0
          assign p = block.settings.product
        -%}
        <div class="apex-shoppable-image__pin"
          style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%"
          {{ block.shopify_attributes }}>
          <button
            class="apex-shoppable-image__dot"
            type="button"
            aria-expanded="false"
            aria-controls="{{ pop_id }}"
            aria-label="{% if p != blank %}{{ p.title | escape }}{% else %}{{ 'Product hotspot' | escape }}{% endif %}"
            id="{{ pin_id }}">
            <span aria-hidden="true"></span>
          </button>

          <div class="apex-shoppable-image__popover"
            id="{{ pop_id }}"
            role="tooltip"
            aria-hidden="true">
            {%- if p != blank -%}
              {%- if p.featured_image != blank -%}
                {%- assign pop_alt = p.featured_image.alt | default: p.title -%}
                <div class="apex-shoppable-image__pop-media media media--square">
                  {{ p.featured_image | image_url: width: 200 | image_tag:
                      loading: 'lazy',
                      widths: '100,200',
                      alt: pop_alt }}
                </div>
              {%- endif -%}
              <div class="apex-shoppable-image__pop-body">
                <p class="apex-shoppable-image__pop-title">{{ p.title }}</p>
                <div class="apex-shoppable-image__pop-price">{% render 'price', product: p %}</div>
                <a href="{{ p.url }}" class="btn btn--accent btn--sm btn--block" tabindex="-1">
                  {{ s.cta_label | default: 'Shop now' }}
                </a>
              </div>
            {%- elsif block.settings.label != blank -%}
              <div class="apex-shoppable-image__pop-body">
                <p class="apex-shoppable-image__pop-title">{{ block.settings.label }}</p>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="btn btn--accent btn--sm btn--block" tabindex="-1">
                    {{ s.cta_label | default: 'Shop now' }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

</section>
{% stylesheet %}
.apex-shoppable-image__stage { position: relative; border-radius: var(--radius-card); overflow: hidden; }
.apex-shoppable-image__media { border-radius: 0; width: 100%; }
.apex-shoppable-image__pin { position: absolute; transform: translate(-50%, -50%); z-index: 5; }
.apex-shoppable-image__dot {
  position: relative;
  width: 2rem; height: 2rem;
  background: #fff;
  border-radius: var(--radius-pill);
  box-shadow: 0 2px 12px rgba(0,0,0,.22);
  display: grid; place-items: center;
  transition: transform .2s var(--ease), background .2s;
  cursor: pointer;
  z-index: 2;
}
.apex-shoppable-image__dot::before {
  content: '';
  position: absolute;
  inset: -6px;
  border: 2px solid rgba(255,255,255,.55);
  border-radius: var(--radius-pill);
  animation: shi-pulse 2s ease infinite;
}
.apex-shoppable-image__dot span {
  width: .55rem; height: .55rem;
  background: var(--accent);
  border-radius: var(--radius-pill);
}
.apex-shoppable-image__dot:hover,
.apex-shoppable-image__dot[aria-expanded="true"] { transform: scale(1.15); background: var(--accent); }
.apex-shoppable-image__dot:hover span,
.apex-shoppable-image__dot[aria-expanded="true"] span { background: #fff; }
@keyframes shi-pulse {
  0%,100% { transform: scale(1); opacity: .7; }
  50% { transform: scale(1.3); opacity: 0; }
}
.apex-shoppable-image__popover {
  position: absolute;
  bottom: calc(100% + .8rem);
  left: 50%;
  transform: translateX(-50%) translateY(6px);
  background: var(--card);
  border: var(--border-width) solid var(--border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-pop);
  width: min(220px, 60vw);
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s var(--ease), transform .2s var(--ease);
  z-index: 10;
}
.apex-shoppable-image__popover[aria-hidden="false"] { opacity: 1; transform: translateX(-50%) translateY(0); pointer-events: auto; }
.apex-shoppable-image__pop-media { width: 100%; border-radius: 0; }
.apex-shoppable-image__pop-body { padding: .8rem; display: flex; flex-direction: column; gap: .5rem; }
.apex-shoppable-image__pop-title { font-weight: 700; font-size: .9rem; line-height: 1.3; }
.apex-shoppable-image__pop-price .price { font-size: .9rem; }
.apex-shoppable-image__pop-body .btn { margin-top: .3rem; }
{% endstylesheet %}
{% javascript %}
(function(){
  function initShoppableImage(stageEl) {
    var pins = stageEl.querySelectorAll('.apex-shoppable-image__dot');
    function closeAll() {
      pins.forEach(function(p) {
        p.setAttribute('aria-expanded', 'false');
        var popId = p.getAttribute('aria-controls');
        var pop = document.getElementById(popId);
        if (pop) pop.setAttribute('aria-hidden', 'true');
      });
    }
    pins.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var isOpen = btn.getAttribute('aria-expanded') === 'true';
        closeAll();
        if (!isOpen) {
          btn.setAttribute('aria-expanded', 'true');
          var popId = btn.getAttribute('aria-controls');
          var pop = document.getElementById(popId);
          if (pop) pop.setAttribute('aria-hidden', 'false');
        }
      });
    });
    document.addEventListener('click', function() { closeAll(); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeAll(); });
  }
  document.querySelectorAll('[id^="shi-stage-"]').forEach(initShoppableImage);
})();
{% endjavascript %}
{% schema %}
{
  "name": "Shoppable image",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop the look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything in this photo is shoppable"
    },
    {
      "type": "checkbox",
      "id": "center_header",
      "label": "Center header",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width image",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Popover button label",
      "default": "Shop now"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (fallback if no product)",
          "default": "Featured product"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (fallback if no product)"
        },
        {
          "type": "range",
          "id": "x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 30
        },
        {
          "type": "range",
          "id": "y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 40
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable image",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "label": "The hero product",
            "x": 28,
            "y": 38
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "label": "Pair it with this",
            "x": 65,
            "y": 55
          }
        }
      ]
    }
  ]
}
{% endschema %}
