{%- liquid
  assign s = section.settings
-%}
<section class="apex-main-page color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px">
  <div class="page-width page-width--narrow">
    <div class="reveal">
      {%- if page.title != blank -%}
        <h1 class="apex-main-page__title{% if s.heading_align == 'center' %} center{% elsif s.heading_align == 'right' %} apex-main-page__title--right{% endif %}">
          {{ page.title }}
        </h1>
      {%- endif -%}
      {%- if page.content != blank -%}
        <div class="rte apex-main-page__body">
          {{ page.content }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% stylesheet %}
.apex-main-page__title { margin-bottom: clamp(1.2rem, .8rem + 1.5vw, 2rem); }
.apex-main-page__title--right { text-align: right; }
.apex-main-page__body { color: var(--text); }
{% endstylesheet %}
{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "presets": [
    { "name": "Page" }
  ]
}
{% endschema %}
