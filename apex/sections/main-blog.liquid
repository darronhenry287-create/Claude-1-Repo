{%- liquid
  assign s = section.settings
  assign col_class = 'grid--3'
  if s.columns == 2
    assign col_class = 'grid--2'
  elsif s.columns == 4
    assign col_class = 'grid--4'
  endif
-%}
<section class="apex-main-blog color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px">
  <div class="page-width">

    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="section-head{% if s.heading_align == 'center' %} section-head--center{% endif %} reveal">
        {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h1 class="balance">{{ s.heading }}</h1>{%- endif -%}
      </div>
    {%- endif -%}

    {%- paginate blog.articles by s.per_page -%}
      <div class="grid {{ col_class }}">
        {%- for article in blog.articles -%}
          <article class="apex-article-card card card--hover reveal{% if forloop.index > 1 %} reveal--delay-{{ forloop.index | modulo: 3 | plus: 1 }}{% endif %}">
            <a class="apex-article-card__media media media--landscape" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    widths: '400,600,800',
                    sizes: '(min-width:990px) 33vw, (min-width:750px) 50vw, 100vw',
                    alt: article.image.alt }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="apex-article-card__body stack">
              {%- if s.show_tags and article.tags.size > 0 -%}
                <div class="cluster">
                  {%- for tag in article.tags limit: 2 -%}
                    <a class="badge" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <h2 class="apex-article-card__title h4 balance">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h2>
              {%- if s.show_excerpt and article.excerpt_or_content != blank -%}
                <p class="muted apex-article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
              {%- endif -%}
              <div class="apex-article-card__meta cluster">
                {%- if s.show_date -%}
                  <span class="muted" style="font-size:var(--text-sm)">
                    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%b %d, %Y' }}</time>
                  </span>
                {%- endif -%}
                {%- if s.show_author -%}
                  <span class="muted" style="font-size:var(--text-sm)">{{ article.author }}</span>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="apex-pagination cluster" aria-label="{{ 'general.pagination.label' | t | default: 'Pagination' }}">
          {%- if paginate.previous -%}
            <a class="btn btn--secondary" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t | default: 'Previous' }}">
              {% render 'icon', icon: 'arrow-left' %}
            </a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a class="btn btn--ghost" href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="btn btn--accent" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="muted">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a class="btn btn--secondary" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t | default: 'Next' }}">
              {% render 'icon', icon: 'arrow-right' %}
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</section>
{% stylesheet %}
.apex-article-card__media { display: block; border-radius: var(--radius-card) var(--radius-card) 0 0; overflow: hidden; }
.apex-article-card__media img { transition: transform .4s var(--ease); }
.apex-article-card:hover .apex-article-card__media img { transform: scale(1.04); }
.apex-article-card__body { padding: 1.4rem 1.4rem 1.6rem; gap: .7rem; flex: 1; }
.apex-article-card__title a { color: inherit; }
.apex-article-card__title a:hover { color: var(--accent); }
.apex-article-card__title a::after { content: ""; position: absolute; inset: 0; }
.apex-article-card { position: relative; }
.apex-article-card__excerpt { font-size: var(--text-sm); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.apex-article-card__meta { gap: .8rem; }
.apex-pagination { justify-content: center; margin-top: clamp(2rem, 1.4rem + 2vw, 3rem); flex-wrap: wrap; }
{% endstylesheet %}
{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest articles"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "Articles per page",
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Blog index"
    }
  ]
}
{% endschema %}
