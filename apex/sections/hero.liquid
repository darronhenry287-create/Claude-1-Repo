{%- liquid
  assign s = section.settings
  assign pos = s.content_position
-%}
<section class="apex-hero color-{{ s.color_scheme }} hero--{{ s.height }}{% if s.image == blank and s.image_mobile == blank %} hero--noimg{% endif %}"
  style="--overlay:{{ s.overlay_opacity | divided_by: 100.0 }};--align:{{ s.text_align }};--pos:{{ pos }}"
  id="hero-{{ section.id }}">
  {%- if s.image != blank or s.video_url != blank -%}
    <div class="apex-hero__media">
      {%- if s.video_url != blank -%}
        <video autoplay muted loop playsinline {% if s.image %}poster="{{ s.image | image_url: width: 1600 }}"{% endif %}><source src="{{ s.video_url }}" type="video/mp4"></video>
      {%- else -%}
        {%- if s.image_mobile != blank -%}<picture><source media="(max-width:749px)" srcset="{{ s.image_mobile | image_url: width: 900 }}"><img src="{{ s.image | image_url: width: 2000 }}" width="{{ s.image.width }}" height="{{ s.image.height }}" alt="{{ s.image.alt | escape }}" loading="eager" fetchpriority="high"></picture>
        {%- else -%}{{ s.image | image_url: width: 2000 | image_tag: sizes: '100vw', widths: '600,900,1200,1600,2000', alt: s.image.alt, fetchpriority: 'high' }}{%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="page-width apex-hero__wrap">
    <div class="apex-hero__content reveal stack">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subheading' -%}<p class="eyebrow eyebrow--pill" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'heading' -%}<h1 class="apex-hero__title balance" style="font-size:clamp(2.2rem,1rem + 5vw,{{ block.settings.size }}rem)" {{ block.shopify_attributes }}>{{ block.settings.text }}</h1>
          {%- when 'text' -%}<div class="subtitle balance" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'rating' -%}<div {{ block.shopify_attributes }}>{% render 'rating', value: block.settings.value, count: block.settings.count %}</div>
          {%- when 'buttons' -%}
            <div class="cluster apex-hero__btns" {{ block.shopify_attributes }}>
              {%- if block.settings.button_1 != blank -%}<a class="btn btn--accent btn--lg" href="{{ block.settings.button_1_url }}">{{ block.settings.button_1 }}</a>{%- endif -%}
              {%- if block.settings.button_2 != blank -%}<a class="btn btn--secondary btn--lg" href="{{ block.settings.button_2_url }}">{{ block.settings.button_2 }}</a>{%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% stylesheet %}
.apex-hero { position: relative; display: grid; align-items: center; overflow: hidden; }
.apex-hero--sm { min-height: 42vh; } .apex-hero--md { min-height: 62vh; } .apex-hero--lg { min-height: 80vh; } .apex-hero--full { min-height: 100svh; }
.apex-hero--noimg { min-height: 0; padding-block: var(--section-gap); }
.apex-hero__media { position: absolute; inset: 0; }
.apex-hero__media img, .apex-hero__media video { width: 100%; height: 100%; object-fit: cover; }
.apex-hero__media::after { content: ""; position: absolute; inset: 0; background: #000; opacity: var(--overlay, 0); }
.apex-hero__wrap { position: relative; width: 100%; }
.apex-hero__content { max-width: 40rem; gap: 1.2rem; text-align: var(--align, left); }
.apex-hero--sm .apex-hero__content, .apex-hero--md .apex-hero__content, .apex-hero--lg .apex-hero__content, .apex-hero--full .apex-hero__content { color: #fff; }
.apex-hero--noimg .apex-hero__content { color: inherit; }
.apex-hero[style*="center"] .apex-hero__content { margin-inline: auto; }
.apex-hero[style*="right"] .apex-hero__content { margin-left: auto; }
.apex-hero__title { line-height: 1.02; }
.apex-hero__content[style] .apex-hero__btns { justify-content: var(--align, flex-start); }
{% endstylesheet %}
{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Background video (MP4 URL)"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "lg",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full screen"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay",
      "default": 30
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New collection"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Heading",
          "default": "Built different."
        },
        {
          "type": "range",
          "id": "size",
          "min": 2,
          "max": 6,
          "step": 0.5,
          "unit": "rem",
          "label": "Max size",
          "default": 4
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>A theme that adapts to any brand. Edit everything from the customizer.</p>"
        }
      ]
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Rating",
          "default": "4.9"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Count",
          "default": "10,000+"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_1",
          "label": "Button 1",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_1_url",
          "label": "Button 1 link"
        },
        {
          "type": "text",
          "id": "button_2",
          "label": "Button 2"
        },
        {
          "type": "url",
          "id": "button_2_url",
          "label": "Button 2 link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "subheading"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}
