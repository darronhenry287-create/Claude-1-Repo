{%- liquid
  assign s = section.settings
-%}
<section class="apex-image-banner color-{{ s.color_scheme }} apex-image-banner--{{ s.height }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px;--overlay:{{ s.overlay_opacity | divided_by: 100.0 }}"
  id="image-banner-{{ section.id }}">

  <div class="apex-image-banner__media">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '600,900,1200,1600,2000,2400', sizes: '100vw', alt: s.image.alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="page-width apex-image-banner__wrap apex-image-banner__wrap--{{ s.content_align }}">
    <div class="apex-image-banner__content reveal stack">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="eyebrow" style="color:rgba(255,255,255,.75);letter-spacing:.14em" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'heading' -%}
            <h2 class="apex-image-banner__heading balance" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
          {%- when 'text' -%}
            <div class="subtitle balance" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'buttons' -%}
            <div class="cluster apex-image-banner__btns" {{ block.shopify_attributes }}>
              {%- if block.settings.button_1 != blank -%}
                <a class="btn btn--accent btn--lg" href="{{ block.settings.button_1_url }}">{{ block.settings.button_1 }}</a>
              {%- endif -%}
              {%- if block.settings.button_2 != blank -%}
                <a class="btn btn--ghost btn--lg" style="color:#fff;border-color:rgba(255,255,255,.45)" href="{{ block.settings.button_2_url }}">{{ block.settings.button_2 }}</a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

</section>
{% stylesheet %}
.apex-image-banner {
  position: relative;
  display: grid;
  align-items: center;
  overflow: hidden;
}
.apex-image-banner--sm { min-height: 40vh; }
.apex-image-banner--md { min-height: 56vh; }
.apex-image-banner--lg { min-height: 72vh; }
.apex-image-banner__media {
  position: absolute;
  inset: 0;
}
.apex-image-banner__media img,
.apex-image-banner__media svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.apex-image-banner__media::after {
  content: "";
  position: absolute;
  inset: 0;
  background: #000;
  opacity: var(--overlay, 0.35);
}
.apex-image-banner__wrap {
  position: relative;
  z-index: 2;
  width: 100%;
  display: grid;
  padding-block: clamp(3rem, 6vw, 6rem);
}
.apex-image-banner__wrap--left { justify-items: start; }
.apex-image-banner__wrap--center { justify-items: center; text-align: center; }
.apex-image-banner__wrap--right { justify-items: end; text-align: right; }
.apex-image-banner__content {
  max-width: 38rem;
  color: #fff;
  gap: 1.2rem;
}
.apex-image-banner__heading {
  font-size: clamp(1.9rem, 1rem + 3.5vw, 3.4rem);
  line-height: 1.05;
}
.apex-image-banner__btns { gap: 1rem; }
.apex-image-banner__wrap--center .apex-image-banner__btns { justify-content: center; }
.apex-image-banner__wrap--right .apex-image-banner__btns { justify-content: flex-end; }
{% endstylesheet %}
{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "default": "md",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay",
      "default": 35
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Limited time offer"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Heading",
          "default": "Up to 30% off this weekend."
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Subtext",
          "default": "Shop the sale before it ends."
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_1",
          "label": "Button 1 label",
          "default": "Shop the sale"
        },
        {
          "type": "url",
          "id": "button_1_url",
          "label": "Button 1 link"
        },
        {
          "type": "text",
          "id": "button_2",
          "label": "Button 2 label"
        },
        {
          "type": "url",
          "id": "button_2_url",
          "label": "Button 2 link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner",
      "blocks": [
        {
          "type": "eyebrow"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}
