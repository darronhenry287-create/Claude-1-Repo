{%- liquid
  assign s = section.settings
  assign cols = s.columns_desktop
  assign cols_m = s.columns_mobile
  assign show_filters = s.show_filters
-%}
<section class="apex-collection color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px;--cols:{{ cols }};--cols-m:{{ cols_m }}"
  id="collection-{{ section.id }}">
  <div class="page-width">
    <header class="section-head{% if s.heading_alignment == 'center' %} section-head--center{% endif %} reveal">
      <h1 class="h2">{{ collection.title | default: 'Collection' }}</h1>
      {%- if s.show_description and collection.description != blank -%}
        <div class="subtitle rte">{{ collection.description }}</div>
      {%- endif -%}
      {%- if s.show_count -%}
        <p class="muted" style="margin-top:.6rem;font-size:var(--text-sm)">{{ 'sections.collection.count' | t: count: collection.products_count | default: collection.products_count }} {{ 'sections.collection.products' | t | default: 'products' }}</p>
      {%- endif -%}
    </header>

    {%- paginate collection.products by s.per_page -%}
      {%- comment -%} Toolbar: mobile filter trigger + sort {%- endcomment -%}
      <div class="apex-collection__toolbar">
        {%- if show_filters != 'off' and collection.filters.size > 0 -%}
          <button class="btn btn--secondary btn--sm apex-collection__filter-toggle" data-open="filter-drawer-{{ section.id }}" aria-haspopup="dialog">
            {% render 'icon', icon: 'menu' %} {{ 'sections.collection.filter' | t | default: 'Filter' }}
          </button>
        {%- endif -%}
        {%- if s.show_sort and collection.sort_options.size > 0 -%}
          <form class="apex-collection__sort" method="get">
            {%- comment -%} Preserve active filter params so sorting does not drop them {%- endcomment -%}
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">
              {%- endfor -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != blank -%}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}">{%- endif -%}
                {%- if filter.max_value.value != blank -%}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}">{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            <label class="visually-hidden" for="sort-by-{{ section.id }}">{{ 'sections.collection.sort_label' | t | default: 'Sort by' }}</label>
            <select name="sort_by" id="sort-by-{{ section.id }}" data-auto-submit aria-label="{{ 'sections.collection.sort_label' | t | default: 'Sort by' }}">
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </form>
        {%- endif -%}
      </div>

      {%- comment -%}
        Storefront filtering. Build the filter <form> once and reuse it in the
        desktop sidebar and the mobile drawer. Submitting the GET form rebuilds
        the URL with `filter.*` + price params; Shopify returns the filtered
        collection.products. The active sort_by + page-reset are preserved via
        hidden inputs so filtering and sorting compose correctly.
      {%- endcomment -%}
      {%- capture filters_form -%}
        <form method="get" data-filter-form>
          {%- if collection.current_sort_by -%}<input type="hidden" name="sort_by" value="{{ collection.current_sort_by }}">{%- endif -%}
          {%- if collection.current_type -%}<input type="hidden" name="q" value="{{ collection.current_type }}"><input type="hidden" name="type" value="t">{%- endif -%}
          {%- if collection.current_vendor -%}<input type="hidden" name="q" value="{{ collection.current_vendor }}"><input type="hidden" name="type" value="v">{%- endif -%}

          {%- for filter in collection.filters -%}
            <details class="apex-filter accordion__item" open>
              <summary class="apex-filter__head">
                <span>{{ filter.label }}</span>
                <span class="accordion__icon" aria-hidden="true"></span>
              </summary>
              <div class="apex-filter__body">
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <div class="apex-filter__price">
                      <div class="field">
                        <label for="{{ filter.min_value.param_name }}-{{ section.id }}">{{ 'sections.collection.price_from' | t | default: 'From' }}</label>
                        <div class="input-group apex-filter__money">
                          <span class="apex-filter__currency">{{ cart.currency.symbol }}</span>
                          <input class="input" type="number" inputmode="decimal" id="{{ filter.min_value.param_name }}-{{ section.id }}" name="{{ filter.min_value.param_name }}" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}" step="1" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}" placeholder="0">
                        </div>
                      </div>
                      <div class="field">
                        <label for="{{ filter.max_value.param_name }}-{{ section.id }}">{{ 'sections.collection.price_to' | t | default: 'To' }}</label>
                        <div class="input-group apex-filter__money">
                          <span class="apex-filter__currency">{{ cart.currency.symbol }}</span>
                          <input class="input" type="number" inputmode="decimal" id="{{ filter.max_value.param_name }}-{{ section.id }}" name="{{ filter.max_value.param_name }}" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}" step="1" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}">
                        </div>
                      </div>
                    </div>
                  {%- else -%}
                    <ul class="apex-filter__list stack" style="gap:.5rem">
                      {%- for value in filter.values -%}
                        <li>
                          <label class="apex-filter__opt{% if value.count == 0 and value.active == false %} apex-filter__opt--disabled{% endif %}">
                            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                            <span>{{ value.label }}</span>
                            <span class="muted apex-filter__count">({{ value.count }})</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}

          <div class="apex-filter__actions cluster">
            <button type="submit" class="btn btn--accent btn--sm btn--block">{{ 'sections.collection.apply' | t | default: 'Apply' }}</button>
            <a href="{{ collection.url }}" class="link apex-filter__clear">{{ 'sections.collection.clear_filters' | t | default: 'Clear all' }}</a>
          </div>
        </form>
      {%- endcapture -%}

      <div class="apex-collection__layout">
        {%- if show_filters != 'off' and collection.filters.size > 0 -%}
          <aside class="apex-collection__sidebar{% if show_filters == 'drawer' %} apex-collection__sidebar--hidden{% endif %}" id="filter-sidebar-{{ section.id }}">
            {{ filters_form }}
          </aside>

          {%- comment -%} Mobile drawer always available so 'sidebar' mode is still usable on phones {%- endcomment -%}
          <aside id="filter-drawer-{{ section.id }}" class="drawer drawer--left color-{{ s.color_scheme }} apex-collection__drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'sections.collection.filter' | t | default: 'Filter' }}">
            <div class="drawer__head">
              <h2 class="h4">{{ 'sections.collection.filter' | t | default: 'Filter' }}</h2>
              <button class="icon-btn" data-close="filter-drawer-{{ section.id }}" aria-label="{{ 'accessibility.close' | t | default: 'Close' }}">{% render 'icon', icon: 'close' %}</button>
            </div>
            <div class="drawer__body">
              {{ filters_form }}
            </div>
          </aside>
        {%- endif -%}

        <div class="apex-collection__main">
          {%- if collection.products.size > 0 -%}
            <div class="apex-collection__grid grid" id="product-grid-{{ section.id }}">
              {%- for product in collection.products -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <nav class="apex-collection__pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t | default: 'Pagination' }}">
                {%- if s.pagination_style == 'load_more' -%}
                  {%- if paginate.next -%}
                    <a class="btn btn--secondary btn--lg" href="{{ paginate.next.url }}" data-load-more>{{ 'general.pagination.load_more' | t | default: 'Load more' }}</a>
                  {%- endif -%}
                {%- else -%}
                  <div class="cluster apex-collection__pages">
                    {%- if paginate.previous -%}<a class="btn btn--ghost btn--sm" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t | default: 'Previous' }}">{% render 'icon', icon: 'arrow-left' %}</a>{%- endif -%}
                    {%- for part in paginate.parts -%}
                      {%- if part.is_link -%}
                        <a class="btn btn--ghost btn--sm" href="{{ part.url }}">{{ part.title }}</a>
                      {%- elsif part.title == paginate.current_page -%}
                        <span class="btn btn--sm" aria-current="page">{{ part.title }}</span>
                      {%- else -%}
                        <span class="apex-collection__gap muted">{{ part.title }}</span>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if paginate.next -%}<a class="btn btn--ghost btn--sm" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t | default: 'Next' }}">{% render 'icon', icon: 'arrow-right' %}</a>{%- endif -%}
                  </div>
                {%- endif -%}
              </nav>
            {%- endif -%}
          {%- else -%}
            <div class="apex-collection__empty center stack" style="justify-items:center">
              <p class="h3">{{ 'sections.collection.empty' | t | default: 'No products found' }}</p>
              <p class="muted">{{ 'sections.collection.empty_detail' | t | default: 'Try removing some filters.' }}</p>
              {%- if collection.current_vendor or collection.current_type or collection.filters.size > 0 -%}
                <a class="btn btn--accent" href="{{ collection.url }}">{{ 'sections.collection.clear_filters' | t | default: 'Clear all filters' }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</section>

{% stylesheet %}
.apex-collection__toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.4rem; }
.apex-collection__sort { margin-left: auto; }
.apex-collection__sort select { width: auto; min-width: 12rem; padding-block: .6em; }
.apex-collection__filter-toggle { display: none; }
.apex-collection__layout { display: grid; grid-template-columns: minmax(0, 16rem) 1fr; gap: var(--gutter); align-items: start; }
.apex-collection__sidebar { position: sticky; top: 1rem; }
.apex-collection__sidebar--hidden { display: none; }
.apex-collection__drawer { display: none; }
.apex-collection__grid { grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr)); }
.apex-collection__pagination { margin-top: clamp(2rem, 4vw, 3rem); display: flex; justify-content: center; }
.apex-collection__pages { justify-content: center; }
.apex-collection__gap { padding-inline: .4rem; }
.apex-collection__empty { padding-block: clamp(3rem, 8vw, 6rem); }
.apex-filter { border-bottom: var(--border-width) solid var(--border); }
.apex-filter__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem .1rem; font-family: var(--font-heading); font-weight: 700; font-size: .98rem; }
.apex-filter[open] .apex-filter__head .accordion__icon::before { transform: scaleY(0); }
.apex-filter__body { padding: 0 .1rem 1.1rem; }
.apex-filter__list { max-height: 16rem; overflow-y: auto; }
.apex-filter__opt { display: flex; align-items: center; gap: .55rem; cursor: pointer; font-size: var(--text-sm); }
.apex-filter__opt input { width: auto; }
.apex-filter__opt--disabled { opacity: .45; cursor: not-allowed; }
.apex-filter__count { margin-left: auto; font-size: var(--text-xs); }
.apex-filter__price { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
.apex-filter__money { position: relative; align-items: center; }
.apex-filter__currency { position: absolute; left: .8em; font-size: var(--text-sm); color: var(--text-muted); pointer-events: none; }
.apex-filter__money .input { padding-left: 1.8em; }
.apex-filter__actions { margin-top: 1.2rem; flex-direction: column; align-items: stretch; }
.apex-filter__clear { justify-content: center; }
@media (max-width: 990px) {
  .apex-collection__layout { grid-template-columns: 1fr; }
  .apex-collection__sidebar { display: none; }
  .apex-collection__drawer { display: flex; }
  .apex-collection__filter-toggle { display: inline-flex; }
  .apex-collection__grid { grid-template-columns: repeat(var(--cols-m, 2), minmax(0, 1fr)); }
}
{% endstylesheet %}

{% javascript %}
(() => {
  // Auto-submit sort + filter forms (no extra JS framework; relies on native GET navigation).
  document.addEventListener('change', (e) => {
    const sel = e.target.closest('[data-auto-submit]');
    if (sel) { const f = sel.closest('form'); if (f) f.submit(); return; }
    const auto = e.target.closest('[data-filter-auto] [data-filter-form] input, [data-filter-auto] [data-filter-form] select');
    if (auto) { const f = auto.closest('form'); if (f) f.submit(); }
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Collection page",
  "tag": "section",
  "class": "shopify-section--main-collection",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "type": "header", "content": "Filtering & sorting" },
    { "type": "select", "id": "show_filters", "label": "Filters", "default": "sidebar", "options": [ { "value": "sidebar", "label": "Sidebar (drawer on mobile)" }, { "value": "drawer", "label": "Drawer only" }, { "value": "off", "label": "Hidden" } ] },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort", "default": true },
    { "type": "header", "content": "Product grid" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 2, "step": 1, "label": "Columns on mobile", "default": 2 },
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 24 },
    { "type": "select", "id": "pagination_style", "label": "Pagination", "default": "numbered", "options": [ { "value": "numbered", "label": "Numbered pages" }, { "value": "load_more", "label": "Load more button" } ] },
    { "type": "header", "content": "Section" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "presets": [ { "name": "Collection page" } ]
}
{% endschema %}
