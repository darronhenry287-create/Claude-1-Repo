{%- liquid
  assign s = section.settings
  assign cols = s.columns | default: 3
  assign card_style = s.card_style
  assign img_ratio = s.image_ratio | default: 'square'
-%}
<section class="apex-multicolumn color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="multicolumn-{{ section.id }}">
  <div class="page-width">

    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="section-head section-head--center reveal">
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--pill">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="subtitle">{{ s.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="apex-multicolumn__grid reveal" style="--cols:{{ cols }}">
      {%- for block in section.blocks -%}
        <div class="apex-multicolumn__col{% if card_style %} card{% endif %}" {{ block.shopify_attributes }}>

          {%- if block.settings.icon != blank -%}
            <div class="apex-multicolumn__icon">
              {% render 'icon', icon: block.settings.icon %}
            </div>
          {%- elsif block.settings.image != blank -%}
            <div class="media media--{{ img_ratio }} media--round apex-multicolumn__img">
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,400,600', sizes: '(min-width:990px) 25vw, 50vw', alt: block.settings.image.alt | escape }}
            </div>
          {%- elsif block.settings.icon == blank and block.settings.image == blank -%}
            <div class="apex-multicolumn__icon">
              {% render 'icon', icon: 'star' %}
            </div>
          {%- endif -%}

          <div class="apex-multicolumn__body stack">
            {%- if block.settings.heading != blank -%}
              <h3 class="h4">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="rte muted">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a class="link" href="{{ block.settings.link_url }}">{{ block.settings.link_label }} {% render 'icon', icon: 'arrow-right' %}</a>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>
{% stylesheet %}
.apex-multicolumn__grid {
  display: grid;
  grid-template-columns: repeat(var(--cols, 3), 1fr);
  gap: var(--gutter);
}
.apex-multicolumn__col {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.apex-multicolumn__col.card { padding: clamp(1.2rem, 1rem + 2vw, 2rem); }
.apex-multicolumn__icon {
  width: 3rem;
  height: 3rem;
  display: grid;
  place-items: center;
  border-radius: var(--radius);
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  color: var(--accent);
  flex: none;
}
.apex-multicolumn__icon svg { width: 1.4rem; height: 1.4rem; }
.apex-multicolumn__img { max-width: 100%; }
.apex-multicolumn__body { gap: .5rem; }
@media (max-width: 990px) {
  .apex-multicolumn__grid { grid-template-columns: repeat(min(var(--cols, 3), 2), 1fr); }
}
@media (max-width: 600px) {
  .apex-multicolumn__grid { grid-template-columns: 1fr; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Why customers love us" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "range",
      "id": "columns",
      "min": 2, "max": 5, "step": 1,
      "label": "Columns per row",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "card_style",
      "label": "Show card background",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "square",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon (if no image)",
          "default": "",
          "options": [
            { "value": "", "label": "None" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "return", "label": "Return" },
            { "value": "check", "label": "Check" },
            { "value": "bag", "label": "Bag" },
            { "value": "user", "label": "User" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Feature heading" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe a key benefit or feature that sets your products apart from the competition.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column", "settings": { "icon": "truck", "heading": "Free shipping", "text": "<p>Free standard shipping on all orders over $50. Express options available at checkout.</p>" } },
        { "type": "column", "settings": { "icon": "shield", "heading": "Quality guarantee", "text": "<p>Every product is rigorously tested. If it doesn't meet your expectations, we'll make it right.</p>" } },
        { "type": "column", "settings": { "icon": "return", "heading": "Easy returns", "text": "<p>Changed your mind? No problem. Return any item within 60 days for a full refund.</p>" } }
      ]
    }
  ]
}
{% endschema %}
