{%- liquid
  assign s = section.settings
  assign block_count = section.blocks | size
-%}
<section class="apex-video-slider color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="video-slider-{{ section.id }}">
  <div class="page-width">
    <div class="reveal">
      {%- if s.heading != blank or s.subheading != blank -%}
        <div class="section-head section-head--center">
          {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="apex-video-slider__outer">
        <div class="slider apex-video-slider__track" data-slider id="slider-{{ section.id }}" role="list"
          aria-label="{{ s.heading | default: 'Videos' | escape }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign modal_id = 'vs-modal-' | append: section.id | append: '-' | append: forloop.index
              assign vurl = block.settings.video_url
              assign vtype = 'mp4'
              if vurl contains 'youtube.com' or vurl contains 'youtu.be'
                assign vtype = 'youtube'
                assign yt_id = vurl | split: 'v=' | last | split: '&' | first
                if vurl contains 'youtu.be/'
                  assign yt_id = vurl | split: 'youtu.be/' | last | split: '?' | first
                endif
              elsif vurl contains 'vimeo.com'
                assign vtype = 'vimeo'
                assign vim_id = vurl | split: 'vimeo.com/' | last | split: '?' | first
              endif
            -%}
            <div class="apex-video-slider__card card card--hover" role="listitem" {{ block.shopify_attributes }}>
              {%- if vurl != blank -%}
                <button class="apex-video-slider__trigger"
                  data-open="{{ modal_id }}"
                  aria-label="Play {{ block.settings.title | default: 'video' | escape }}">
                  <div class="media media--landscape apex-video-slider__cover">
                    {%- if block.settings.cover != blank -%}
                      {{ block.settings.cover | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width:990px) 380px, 80vw', alt: block.settings.cover.alt }}
                    {%- else -%}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                    <span class="apex-video-slider__play" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24" aria-hidden="true"><path d="M8 5.1v13.8L19 12Z"/></svg>
                    </span>
                  </div>
                </button>
              {%- else -%}
                <div class="media media--landscape apex-video-slider__cover">
                  {%- if block.settings.cover != blank -%}
                    {{ block.settings.cover | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width:990px) 380px, 80vw', alt: block.settings.cover.alt }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <div class="apex-video-slider__meta">
                  <p class="apex-video-slider__title">{{ block.settings.title }}</p>
                </div>
              {%- endif -%}
            </div>

            {%- if vurl != blank -%}
              <div class="overlay" id="{{ modal_id }}-overlay" data-close="{{ modal_id }}"></div>
              <div class="modal" id="{{ modal_id }}" role="dialog" aria-modal="true" aria-label="{{ block.settings.title | default: 'Video' | escape }}">
                <div class="modal__box apex-video-slider__modal-box">
                  <button class="apex-video-slider__close icon-btn" data-close="{{ modal_id }}" aria-label="Close video">
                    {% render 'icon', icon: 'close' %}
                  </button>
                  <div class="apex-video-slider__embed media media--wide">
                    {%- if vtype == 'youtube' -%}
                      <iframe
                        src="https://www.youtube.com/embed/{{ yt_id }}?autoplay=1&rel=0"
                        allow="autoplay; fullscreen; picture-in-picture"
                        allowfullscreen
                        title="{{ block.settings.title | default: 'Video' | escape }}"
                        loading="lazy">
                      </iframe>
                    {%- elsif vtype == 'vimeo' -%}
                      <iframe
                        src="https://player.vimeo.com/video/{{ vim_id }}?autoplay=1"
                        allow="autoplay; fullscreen; picture-in-picture"
                        allowfullscreen
                        title="{{ block.settings.title | default: 'Video' | escape }}"
                        loading="lazy">
                      </iframe>
                    {%- else -%}
                      <video controls autoplay playsinline
                        {%- if block.settings.cover != blank %} poster="{{ block.settings.cover | image_url: width: 1200 }}"{% endif %}>
                        <source src="{{ vurl }}" type="video/mp4">
                      </video>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if block_count > 1 -%}
          <div class="apex-video-slider__nav">
            <button class="apex-video-slider__btn" data-slider-prev="{{ section.id }}" aria-label="Previous video">
              {% render 'icon', icon: 'arrow-left' %}
            </button>
            <button class="apex-video-slider__btn" data-slider-next="{{ section.id }}" aria-label="Next video">
              {% render 'icon', icon: 'arrow-right' %}
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.apex-video-slider__outer { position: relative; }
.apex-video-slider__track { gap: var(--gutter); padding-bottom: .5rem; align-items: stretch; }
.apex-video-slider__card {
  width: min(360px, 78vw);
  flex: none;
  border-radius: var(--radius-card);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.apex-video-slider__trigger {
  display: block;
  width: 100%;
  padding: 0;
  border: none;
  background: none;
  cursor: pointer;
  position: relative;
  flex: 1;
}
.apex-video-slider__cover { border-radius: 0; overflow: hidden; }
.apex-video-slider__cover img { transition: transform .5s var(--ease); }
.apex-video-slider__trigger:hover .apex-video-slider__cover img { transform: scale(1.04); }
.apex-video-slider__play {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 4rem; height: 4rem;
  background: rgba(255,255,255,.18);
  border: 2px solid rgba(255,255,255,.7);
  border-radius: var(--radius-pill);
  display: grid;
  place-items: center;
  color: #fff;
  backdrop-filter: blur(6px);
  transition: background .25s, transform .25s var(--ease);
}
.apex-video-slider__trigger:hover .apex-video-slider__play { background: rgba(255,255,255,.3); transform: translate(-50%,-50%) scale(1.08); }
.apex-video-slider__play svg { width: 1.5rem; height: 1.5rem; margin-left: .15em; }
.apex-video-slider__meta { padding: 1rem 1.2rem 1.2rem; }
.apex-video-slider__title { font-weight: 700; font-size: .95rem; }
.apex-video-slider__nav {
  display: flex;
  gap: .6rem;
  justify-content: center;
  margin-top: 1.6rem;
}
.apex-video-slider__btn {
  display: grid; place-items: center;
  width: 2.6rem; height: 2.6rem;
  border: var(--border-width) solid var(--border);
  border-radius: var(--radius-pill);
  background: var(--card);
  color: var(--text);
  transition: background .2s, border-color .2s;
}
.apex-video-slider__btn:hover { background: var(--accent); border-color: var(--accent); color: var(--accent-text); }
.apex-video-slider__btn svg { width: 1.2rem; height: 1.2rem; }
.apex-video-slider__modal-box { max-width: min(900px, 94vw); background: #000; padding: 0; border-radius: var(--radius-card); overflow: hidden; position: relative; }
.apex-video-slider__close { position: absolute; top: .8rem; right: .8rem; z-index: 2; background: rgba(0,0,0,.5); color: #fff; border-radius: var(--radius-pill); padding: .4rem; display: grid; place-items: center; }
.apex-video-slider__close:hover { background: rgba(0,0,0,.8); }
.apex-video-slider__close svg { width: 1.1rem; height: 1.1rem; }
.apex-video-slider__embed { width: 100%; }
.apex-video-slider__embed iframe,
.apex-video-slider__embed video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
{% endstylesheet %}
{% schema %}
{
  "name": "Video slider",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Watch and shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See our products in action"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "How it works"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (YouTube, Vimeo or MP4)",
          "info": "Leave blank to show cover image only."
        },
        {
          "type": "image_picker",
          "id": "cover",
          "label": "Cover image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video slider",
      "blocks": [
        {
          "type": "video",
          "settings": {
            "title": "The origin story"
          }
        },
        {
          "type": "video",
          "settings": {
            "title": "Meet the formula"
          }
        },
        {
          "type": "video",
          "settings": {
            "title": "Real results"
          }
        }
      ]
    }
  ]
}
{% endschema %}
