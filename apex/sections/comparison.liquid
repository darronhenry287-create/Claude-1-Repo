{%- liquid
  assign s = section.settings
-%}
<section class="apex-comparison color-{{ s.color_scheme }}"
  style="padding-top:{{ s.padding_top }}px;padding-bottom:{{ s.padding_bottom }}px"
  id="comparison-{{ section.id }}">
  <div class="page-width">
    <div class="reveal">
      {%- if s.heading != blank or s.subheading != blank -%}
        <div class="section-head{% if s.center_header %} section-head--center{% endif %}">
          {%- if s.subheading != blank -%}<p class="eyebrow eyebrow--pill">{{ s.subheading }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="balance">{{ s.heading }}</h2>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="apex-comparison__scroll-wrap">
        <table class="apex-comparison__table" role="table">
          <thead>
            <tr>
              <th class="apex-comparison__feature-col" scope="col">
                <span class="visually-hidden">Feature</span>
              </th>
              <th class="apex-comparison__brand-col apex-comparison__brand-col--us" scope="col">
                <div class="apex-comparison__brand-head">
                  {%- if s.brand_badge != blank -%}<span class="badge">{{ s.brand_badge }}</span>{%- endif -%}
                  <strong>{{ s.our_brand | default: 'Our Brand' }}</strong>
                </div>
              </th>
              {%- if s.competitor_1 != blank -%}
                <th class="apex-comparison__brand-col" scope="col">{{ s.competitor_1 }}</th>
              {%- endif -%}
              {%- if s.competitor_2 != blank -%}
                <th class="apex-comparison__brand-col" scope="col">{{ s.competitor_2 }}</th>
              {%- endif -%}
              {%- if s.competitor_3 != blank -%}
                <th class="apex-comparison__brand-col" scope="col">{{ s.competitor_3 }}</th>
              {%- endif -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- assign bs = block.settings -%}
              <tr class="apex-comparison__row" {{ block.shopify_attributes }}>
                <td class="apex-comparison__feature-cell">{{ bs.feature }}</td>
                <td class="apex-comparison__cell apex-comparison__cell--us">
                  {%- case bs.us_value -%}
                    {%- when 'yes' -%}<span class="apex-comparison__icon apex-comparison__icon--yes" aria-label="Yes">{% render 'icon', icon: 'check' %}</span>
                    {%- when 'no' -%}<span class="apex-comparison__icon apex-comparison__icon--no" aria-label="No">{% render 'icon', icon: 'close' %}</span>
                    {%- else -%}<span class="apex-comparison__text-val">{{ bs.us_value }}</span>
                  {%- endcase -%}
                </td>
                {%- if s.competitor_1 != blank -%}
                  <td class="apex-comparison__cell">
                    {%- case bs.comp1_value -%}
                      {%- when 'yes' -%}<span class="apex-comparison__icon apex-comparison__icon--yes" aria-label="Yes">{% render 'icon', icon: 'check' %}</span>
                      {%- when 'no' -%}<span class="apex-comparison__icon apex-comparison__icon--no" aria-label="No">{% render 'icon', icon: 'close' %}</span>
                      {%- else -%}<span class="apex-comparison__text-val">{{ bs.comp1_value }}</span>
                    {%- endcase -%}
                  </td>
                {%- endif -%}
                {%- if s.competitor_2 != blank -%}
                  <td class="apex-comparison__cell">
                    {%- case bs.comp2_value -%}
                      {%- when 'yes' -%}<span class="apex-comparison__icon apex-comparison__icon--yes" aria-label="Yes">{% render 'icon', icon: 'check' %}</span>
                      {%- when 'no' -%}<span class="apex-comparison__icon apex-comparison__icon--no" aria-label="No">{% render 'icon', icon: 'close' %}</span>
                      {%- else -%}<span class="apex-comparison__text-val">{{ bs.comp2_value }}</span>
                    {%- endcase -%}
                  </td>
                {%- endif -%}
                {%- if s.competitor_3 != blank -%}
                  <td class="apex-comparison__cell">
                    {%- case bs.comp3_value -%}
                      {%- when 'yes' -%}<span class="apex-comparison__icon apex-comparison__icon--yes" aria-label="Yes">{% render 'icon', icon: 'check' %}</span>
                      {%- when 'no' -%}<span class="apex-comparison__icon apex-comparison__icon--no" aria-label="No">{% render 'icon', icon: 'close' %}</span>
                      {%- else -%}<span class="apex-comparison__text-val">{{ bs.comp3_value }}</span>
                    {%- endcase -%}
                  </td>
                {%- endif -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.apex-comparison__scroll-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
.apex-comparison__table {
  width: 100%;
  min-width: 540px;
  border-collapse: collapse;
  border-spacing: 0;
}
.apex-comparison__table thead th {
  padding: 1rem 1.2rem;
  font-size: var(--text-sm);
  font-weight: 700;
  text-align: center;
  border-bottom: 2px solid var(--border);
}
.apex-comparison__feature-col { text-align: left; min-width: 160px; }
.apex-comparison__brand-col { min-width: 130px; }
.apex-comparison__brand-col--us {
  background: color-mix(in srgb, var(--accent) 8%, var(--card));
  border-top: 3px solid var(--accent);
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
}
.apex-comparison__brand-head { display: flex; flex-direction: column; gap: .4rem; align-items: center; }
.apex-comparison__row td { padding: .9rem 1.2rem; border-bottom: var(--border-width) solid var(--border); vertical-align: middle; }
.apex-comparison__row:last-child td { border-bottom: none; }
.apex-comparison__row:nth-child(even) td { background: color-mix(in srgb, var(--text) 3%, transparent); }
.apex-comparison__feature-cell { font-weight: 600; font-size: .95rem; text-align: left; }
.apex-comparison__cell { text-align: center; }
.apex-comparison__cell--us { background: color-mix(in srgb, var(--accent) 5%, transparent); }
.apex-comparison__icon { display: inline-flex; align-items: center; justify-content: center; width: 1.6rem; height: 1.6rem; border-radius: var(--radius-pill); }
.apex-comparison__icon--yes { background: color-mix(in srgb, var(--success) 15%, transparent); color: var(--success); }
.apex-comparison__icon--no { background: color-mix(in srgb, var(--sale) 12%, transparent); color: var(--sale); }
.apex-comparison__icon svg { width: 1rem; height: 1rem; }
.apex-comparison__text-val { font-size: .92rem; font-weight: 500; }
{% endstylesheet %}
{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "How we compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We outperform the competition" },
    { "type": "checkbox", "id": "center_header", "label": "Center header", "default": true },
    { "type": "text", "id": "our_brand", "label": "Your brand name", "default": "Our Brand" },
    { "type": "text", "id": "brand_badge", "label": "Brand badge text", "default": "Best" },
    { "type": "text", "id": "competitor_1", "label": "Competitor 1 name", "default": "Brand A" },
    { "type": "text", "id": "competitor_2", "label": "Competitor 2 name", "default": "Brand B" },
    { "type": "text", "id": "competitor_3", "label": "Competitor 3 name (optional)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature label", "default": "Premium materials" },
        { "type": "text", "id": "us_value", "label": "Our brand value (yes / no / custom text)", "default": "yes" },
        { "type": "text", "id": "comp1_value", "label": "Competitor 1 value (yes/no/text)", "default": "no" },
        { "type": "text", "id": "comp2_value", "label": "Competitor 2 value (yes/no/text)", "default": "no" },
        { "type": "text", "id": "comp3_value", "label": "Competitor 3 value (yes/no/text)", "default": "no" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "feature", "settings": { "feature": "Premium materials", "us_value": "yes", "comp1_value": "no", "comp2_value": "no", "comp3_value": "no" } },
        { "type": "feature", "settings": { "feature": "30-day money-back guarantee", "us_value": "yes", "comp1_value": "no", "comp2_value": "yes", "comp3_value": "no" } },
        { "type": "feature", "settings": { "feature": "Free shipping", "us_value": "yes", "comp1_value": "no", "comp2_value": "no", "comp3_value": "no" } },
        { "type": "feature", "settings": { "feature": "Lifetime warranty", "us_value": "yes", "comp1_value": "no", "comp2_value": "no", "comp3_value": "no" } },
        { "type": "feature", "settings": { "feature": "24/7 customer support", "us_value": "yes", "comp1_value": "no", "comp2_value": "yes", "comp3_value": "no" } }
      ]
    }
  ]
}
{% endschema %}
