{%- comment -%}
  Address form fields for the customer_address form.
  Usage (inside {% form 'customer_address', address %}):
    {% render 'apex-address-fields', address: address %}
{%- endcomment -%}
<div class="grid grid--2" style="gap:1rem">
  <div class="field"><label>{{ 'customer.addresses.first_name' | t | default: 'First name' }}</label><input type="text" name="address[first_name]" value="{{ address.first_name }}" autocomplete="given-name"></div>
  <div class="field"><label>{{ 'customer.addresses.last_name' | t | default: 'Last name' }}</label><input type="text" name="address[last_name]" value="{{ address.last_name }}" autocomplete="family-name"></div>
</div>
<div class="field"><label>{{ 'customer.addresses.company' | t | default: 'Company' }}</label><input type="text" name="address[company]" value="{{ address.company }}" autocomplete="organization"></div>
<div class="field"><label>{{ 'customer.addresses.address1' | t | default: 'Address' }}</label><input type="text" name="address[address1]" value="{{ address.address1 }}" autocomplete="address-line1"></div>
<div class="field"><label>{{ 'customer.addresses.address2' | t | default: 'Apartment, suite, etc.' }}</label><input type="text" name="address[address2]" value="{{ address.address2 }}" autocomplete="address-line2"></div>
<div class="grid grid--2" style="gap:1rem">
  <div class="field"><label>{{ 'customer.addresses.city' | t | default: 'City' }}</label><input type="text" name="address[city]" value="{{ address.city }}" autocomplete="address-level2"></div>
  <div class="field"><label>{{ 'customer.addresses.zip' | t | default: 'Postal / ZIP code' }}</label><input type="text" name="address[zip]" value="{{ address.zip }}" autocomplete="postal-code"></div>
</div>
<div class="grid grid--2" style="gap:1rem">
  <div class="field"><label>{{ 'customer.addresses.country' | t | default: 'Country / region' }}</label>
    <select name="address[country]" data-default="{{ address.country }}" autocomplete="country">{{ all_country_option_tags }}</select>
  </div>
  <div class="field"><label>{{ 'customer.addresses.province' | t | default: 'State / province' }}</label><input type="text" name="address[province]" value="{{ address.province }}" autocomplete="address-level1"></div>
</div>
<div class="field"><label>{{ 'customer.addresses.phone' | t | default: 'Phone' }}</label><input type="tel" name="address[phone]" value="{{ address.phone }}" autocomplete="tel"></div>
<label style="display:flex;gap:.5rem;align-items:center;margin:.4rem 0 1rem">
  {{ form.set_as_default_checkbox }} {{ 'customer.addresses.set_default' | t | default: 'Set as default address' }}
</label>
