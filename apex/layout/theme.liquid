<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#ffffff">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &ndash; {{ 'general.tags' | t }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

  {{ content_for_header }}

  {{ 'base.css' | asset_url | stylesheet_tag }}
  {% render 'css-variables' %}
  {%- if settings.hover_lift == false -%}<style>.card--hover:hover{transform:none!important}</style>{%- endif -%}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js','js');
    window.APEX = {
      moneyFormat: {{ shop.money_format | json }},
      routes: { root: {{ routes.root_url | json }}, cart: {{ routes.cart_url | json }}, cartAdd: {{ routes.cart_add_url | json }}, cartChange: {{ routes.cart_change_url | json }}, search: {{ routes.search_url | json }}, predictiveSearch: {{ routes.predictive_search_url | json }} },
      strings: { addToCart: {{ 'products.product.add_to_cart' | t | json }}, soldOut: {{ 'products.product.sold_out' | t | json }}, unavailable: {{ 'products.product.unavailable' | t | json }} },
      cartType: {{ settings.cart_type | json }},
      backToTop: {{ settings.back_to_top_style | json }}
    };
  </script>
  <script src="{{ 'base.js' | asset_url }}" defer></script>
</head>

<body class="color-scheme-1 template-{{ request.page_type | handle }} btn-{{ settings.button_style | default: 'solid' }} btnhover-{{ settings.button_hover | default: 'lift' }} card-{{ settings.card_style | default: 'border' }} cardhover-{{ settings.card_hover | default: 'lift' }} shadow-{{ settings.shadow_style | default: 'soft' }} input-{{ settings.input_style | default: 'outline' }} link-{{ settings.link_style | default: 'underline' }} menu-{{ settings.menu_style | default: 'underline' }}{% if settings.button_shadow %} has-btn-shadow{% endif %}{% if settings.header_border == false %} no-header-border{% endif %} focus-{{ settings.focus_style | default: 'ring' }} imgfilter-{{ settings.image_filter | default: 'none' }} sbtn-{{ settings.secondary_button_style | default: 'outline' }} footer-{{ settings.footer_layout | default: 'columns' }} bq-{{ settings.blockquote_style | default: 'bordered' }}{% if settings.gradient_buttons %} grad-btns{% endif %}{% if settings.button_full_mobile %} btn-fullmobile{% endif %}{% if settings.dropcap %} has-dropcap{% endif %}{% if settings.hover_overlay %} hover-overlay{% endif %}{% if settings.sticky_shrink %} header-shrink{% endif %}{% if settings.rounded_images == false %} square-images{% endif %}">
  <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_text' | t | default: 'Skip to content' }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'cart-drawer' %}
  {%- if settings.enable_quick_view -%}{% render 'quick-view-modal' %}{%- endif -%}
  {%- if settings.enable_age_check -%}{% render 'age-gate' %}{%- endif -%}

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t | default: 'Choosing a selection results in a full page refresh.' }}</li>
  </ul>
</body>
</html>
