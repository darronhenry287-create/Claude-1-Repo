<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>{{ 'gift_cards.issued.title' | t: value: gift_card.initial_value | money_without_trailing_zeros, shop: shop.name | default: 'Your gift card' }}</title>
  {{ content_for_header }}
  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
  <style>
    :root { --bg:#fff; --text:#111827; --accent:#2f5bff; --accent-text:#fff; --border:rgba(17,24,39,.12); --radius:12px; --radius-card:16px; }
    body { font-family: Inter, system-ui, sans-serif; background: var(--bg); color: var(--text); margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 2rem 1rem; }
    .gift-card { max-width: 480px; width: 100%; text-align: center; }
    .gift-card__shop { font-weight: 700; font-size: 1.2rem; margin-bottom: 2rem; }
    .gift-card__card { background: linear-gradient(135deg, var(--accent), #0ea5a3); border-radius: var(--radius-card); padding: 2.5rem 2rem; color: #fff; margin-bottom: 2rem; position: relative; overflow: hidden; }
    .gift-card__card::before { content: ""; position: absolute; top: -40px; right: -40px; width: 200px; height: 200px; background: rgba(255,255,255,.08); border-radius: 50%; }
    .gift-card__value { font-size: clamp(2.5rem,8vw,4rem); font-weight: 800; line-height: 1; margin-bottom: .4rem; }
    .gift-card__code-wrap { background: rgba(255,255,255,.18); border: 1.5px solid rgba(255,255,255,.3); border-radius: 8px; padding: 1rem 1.4rem; margin-top: 1.6rem; }
    .gift-card__code { font-family: monospace; font-size: clamp(1rem,3vw,1.4rem); font-weight: 700; letter-spacing: .12em; word-break: break-all; }
    .gift-card__expiry { font-size: .82rem; opacity: .8; margin-top: .5rem; }
    .gift-card__qr { margin: 1.5rem auto; display: block; max-width: 180px; }
    .gift-card__copy { background: var(--accent); color: var(--accent-text); border: none; border-radius: 8px; padding: .75rem 1.5rem; font-weight: 700; cursor: pointer; transition: opacity .2s; margin-top: .5rem; }
    .gift-card__copy:hover { opacity: .9; }
    .gift-card__actions { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem; }
    .gift-card__btn { display: inline-flex; align-items: center; gap: .4em; padding: .8rem 1.5rem; border-radius: 8px; font-weight: 700; font-size: .93rem; border: 1.5px solid var(--border); transition: background .2s, border-color .2s; }
    .gift-card__btn--primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }
    .gift-card__btn--primary:hover { opacity: .9; }
    .gift-card__btn:not(.gift-card__btn--primary):hover { border-color: var(--accent); color: var(--accent); }
  </style>
</head>
<body>
  <div class="gift-card">
    <div class="gift-card__shop">{{ shop.name }}</div>

    <div class="gift-card__card">
      <p style="font-size:.8rem;text-transform:uppercase;letter-spacing:.12em;opacity:.8;margin-bottom:.5rem">Gift card</p>
      <div class="gift-card__value">{{ gift_card.initial_value | money_without_trailing_zeros }}</div>
      {%- if gift_card.balance != gift_card.initial_value -%}
        <p style="font-size:.9rem;opacity:.8">{{ 'gift_cards.issued.remaining_html' | t: balance: gift_card.balance | money | default: 'Balance: ' | append: gift_card.balance | money }}</p>
      {%- endif -%}
      <div class="gift-card__code-wrap">
        <p class="gift-card__code" id="GiftCardCode">{{ gift_card.code | format_code }}</p>
        {%- if gift_card.expires_on -%}
          <p class="gift-card__expiry">{{ 'gift_cards.issued.expiry_date' | t: expiry: gift_card.expires_on | date: '%B %d, %Y' | default: 'Expires' }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if gift_card.pass_url -%}
      <a href="{{ gift_card.pass_url }}" class="gift-card__qr" aria-label="Add to Apple Wallet">
        <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" alt="Add to Apple Wallet" width="120" height="40">
      </a>
    {%- endif -%}

    {{ gift_card.qr_identifier | qr_code: width: 180, height: 180, class: 'gift-card__qr' }}

    <div>
      <button class="gift-card__copy" onclick="copyCode()" aria-label="{{ 'gift_cards.issued.copy_code' | t | default: 'Copy code' }}">
        {{ 'gift_cards.issued.copy_code' | t | default: 'Copy code' }}
      </button>
    </div>

    <div class="gift-card__actions">
      <a class="gift-card__btn gift-card__btn--primary" href="{{ shop.url }}">
        {{ 'gift_cards.issued.shop_link' | t | default: 'Shop now' }}
      </a>
      <a class="gift-card__btn" href="{{ 'gift_cards.issued.print_link' | t | default: '#' }}" onclick="window.print(); return false;">
        {{ 'gift_cards.issued.print_link' | t | default: 'Print gift card' }}
      </a>
    </div>
  </div>

  <script>
    function copyCode() {
      var code = document.getElementById('GiftCardCode').textContent.trim();
      if (navigator.clipboard) {
        navigator.clipboard.writeText(code).then(function() {
          var btn = document.querySelector('.gift-card__copy');
          var orig = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(function() { btn.textContent = orig; }, 2000);
        });
      }
    }
  </script>
</body>
</html>
