<section style="background:var(--cream);padding-block:clamp(2.5rem,5vw,4rem)">
  <div class="wrap center">
    <span class="eyebrow">The collection</span>
    <h1 style="margin-top:.8rem">{{ collection.title | default: 'Daily creatine, made simple.' }}</h1>
    {%- if collection.description != blank -%}<p class="lede" style="max-width:520px;margin:1rem auto 0">{{ collection.description }}</p>{%- endif -%}
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem;flex-wrap:wrap;gap:1rem">
      <p class="muted" style="font-size:.88rem">{{ collection.products_count }} products</p>
    </div>
    <div class="grid products" style="grid-template-columns:repeat(3,1fr)">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>No products found.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div class="center" style="margin-top:3rem">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
