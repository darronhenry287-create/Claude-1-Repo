<section class="section" style="background:var(--cream)">
  <div class="wrap">
    <div class="center" style="margin-bottom:2.5rem">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 style="margin-top:.8rem">{{ section.settings.heading }}</h2>
    </div>
    <div style="overflow-x:auto">
      <table class="compare">
        <thead>
          <tr><th></th><th class="col-us">{{ section.settings.col_us }}</th><th>{{ section.settings.col_a }}</th><th>{{ section.settings.col_b }}</th></tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.feature }}</td>
              <td class="col-us yes">{{ block.settings.us }}</td>
              <td class="no">{{ block.settings.a }}</td>
              <td class="no">{{ block.settings.b }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why SOMNA" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The difference is night and day." },
    { "type": "text", "id": "col_us", "label": "Our column", "default": "SOMNA Cloud" },
    { "type": "text", "id": "col_a", "label": "Column A", "default": "Memory foam" },
    { "type": "text", "id": "col_b", "label": "Column B", "default": "Down pillow" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Cervical alignment" },
      { "type": "text", "id": "us", "label": "Us", "default": "✓" },
      { "type": "text", "id": "a", "label": "Column A", "default": "Partial" },
      { "type": "text", "id": "b", "label": "Column B", "default": "✕" }
    ] }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Cervical alignment", "us": "✓", "a": "Partial", "b": "✕" } },
        { "type": "row", "settings": { "feature": "Stays cool all night", "us": "✓", "a": "✕ traps heat", "b": "Partial" } },
        { "type": "row", "settings": { "feature": "Holds shape 5+ years", "us": "✓", "a": "~1 year", "b": "~6 months" } },
        { "type": "row", "settings": { "feature": "Washable cover", "us": "✓", "a": "✕", "b": "✕" } },
        { "type": "row", "settings": { "feature": "100-night trial", "us": "✓", "a": "Rarely", "b": "Rarely" } }
      ]
    }
  ]
}
{% endschema %}
