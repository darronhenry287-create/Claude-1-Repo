<section class="section {{ section.settings.bg }}" id="faq">
  <div class="wrap faq">
    <div class="section-head center">
      <span class="eyebrow eyebrow--plain">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="acc">
      {%- for block in section.blocks -%}
        <div class="acc__item" {{ block.shopify_attributes }}>
          <button class="acc__head">{{ block.settings.question }} {% render 'icon', name: 'plus' %}</button>
          <div class="acc__body"><div class="acc__body-inner">{{ block.settings.answer }}</div></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "bg-cream", "label": "Cream" }, { "value": "", "label": "White" }, { "value": "bg-sky", "label": "Sky" } ], "default": "bg-cream" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered." }
  ],
  "blocks": [
    { "type": "qa", "name": "Q&A", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How many gummies should I take?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Four gummies a day gives you the full 5g of creatine monohydrate.</p>" }
    ] }
  ],
  "presets": [
    { "name": "FAQ", "blocks": [
      { "type": "qa", "settings": { "question": "How many gummies should I take?", "answer": "<p>Four gummies a day gives you the full 5g of creatine monohydrate. Take them any time, with or without food — consistency is what counts.</p>" } },
      { "type": "qa", "settings": { "question": "Do I need to \"load\" creatine?", "answer": "<p>No loading phase required. Take four daily and your muscles reach full saturation over about three to four weeks. If you'd like to load, double up for the first week.</p>" } },
      { "type": "qa", "settings": { "question": "Is it safe? Will I hold water?", "answer": "<p>Creatine monohydrate is one of the most studied supplements in the world. At the daily 5g dose, most people notice no bloating. Check with your doctor if pregnant, nursing, or managing a condition.</p>" } },
      { "type": "qa", "settings": { "question": "Can I cancel my subscription?", "answer": "<p>Anytime, in one click from your account. Skip a month, swap flavors, or cancel — no fees.</p>" } }
    ] }
  ]
}
{% endschema %}
