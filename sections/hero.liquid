<section class="hero-split">
  <div class="hero-split__copy">
    <div class="hero-split__inner">
      {%- if section.settings.show_rating -%}
        <div class="hero__rating"><span class="star">★★★★★</span><span class="muted" style="font-size:.85rem">{{ section.settings.rating_text }}</span></div>
      {%- endif -%}
      <h1 class="display">{{ section.settings.heading }}</h1>
      <p class="hero__lede lede">{{ section.settings.subheading }}</p>
      <div class="hero__cta">
        {%- if section.settings.cta_text != blank -%}<a href="{{ section.settings.cta_link }}" class="btn btn-primary btn-lg">{{ section.settings.cta_text }}</a>{%- endif -%}
        {%- if section.settings.cta2_text != blank -%}<a href="{{ section.settings.cta2_link }}" class="btn btn-ghost btn-lg">{{ section.settings.cta2_text }}</a>{%- endif -%}
      </div>
      <ul class="hero__trust">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %} {{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
  <div class="hero-split__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.image.alt | escape }}" fetchpriority="high">
    {%- else -%}
      <img src="{{ 'somna-hero.jpg' | asset_url }}" alt="Rest, beautifully" fetchpriority="high">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image (defaults to bundled photo)" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9 · 12,400+ five-star sleepers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sleep, engineered." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The Cloud Pillow adapts to your spine in real time — cradling your neck, cooling your head, and ending the 3am pillow-flip for good." },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Shop The Cloud Pillow" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "How it works" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "trial", "label": "Trial" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }
        ], "default": "trial" },
        { "type": "text", "id": "text", "label": "Text", "default": "100-night trial" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "trust", "settings": { "icon": "trial", "text": "100-night trial" } },
        { "type": "trust", "settings": { "icon": "truck", "text": "Free 2-day shipping" } },
        { "type": "trust", "settings": { "icon": "shield", "text": "5-year warranty" } }
      ]
    }
  ]
}
{% endschema %}
