<section class="section {{ section.settings.bg }}">
  <div class="wrap {% if section.settings.center %}center{% endif %}" style="max-width:{{ section.settings.width }}px">
    {%- if section.settings.kicker != blank -%}<span class="eyebrow eyebrow--plain">{{ section.settings.kicker }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}
      {%- if section.settings.hero -%}
        <h1 class="display" style="margin:.7rem 0 0">{{ section.settings.heading }}</h1>
      {%- else -%}
        <h2 style="margin:.7rem 0 0">{{ section.settings.heading }}</h2>
      {%- endif -%}
    {%- endif -%}
    {%- if section.settings.content != blank -%}
      <div class="rte {% if section.settings.lede %}lede{% endif %}" style="margin-top:1.1rem">{{ section.settings.content }}</div>
    {%- endif -%}
    {%- if section.settings.cta_text != blank -%}
      <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn-coral btn-lg" style="margin-top:1.6rem">{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "", "label": "White" }, { "value": "bg-cream", "label": "Cream" }, { "value": "bg-sky", "label": "Sky" }, { "value": "bg-mint", "label": "Mint" }, { "value": "bg-ink", "label": "Navy" } ], "default": "" },
    { "type": "checkbox", "id": "center", "label": "Center", "default": false },
    { "type": "checkbox", "id": "hero", "label": "Large heading (page title)", "default": false },
    { "type": "checkbox", "id": "lede", "label": "Larger body text", "default": false },
    { "type": "range", "id": "width", "label": "Max width", "min": 600, "max": 1200, "step": 20, "unit": "px", "default": 1200 },
    { "type": "text", "id": "kicker", "label": "Kicker / eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add your text here.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button (optional)" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
