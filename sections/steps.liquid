<section class="section">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 style="margin-top:.8rem">{{ section.settings.heading }}</h2>
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step reveal" {{ block.shopify_attributes }}>
          <div class="step__num">{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Better sleep in three nights." }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Unbox & let it breathe" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Your pillow arrives compressed. Unroll it and it returns to full loft within an hour." }
    ] }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Unbox & let it breathe", "text": "Your pillow arrives compressed. Unroll it and it returns to full loft within an hour." } },
        { "type": "step", "settings": { "title": "Find your height", "text": "Flip between the 4.5\" and 5.5\" sides to match how you sleep." } },
        { "type": "step", "settings": { "title": "Wake up aligned", "text": "The adaptive core holds your neck neutral all night, so you wake without the crick." } }
      ]
    }
  ]
}
{% endschema %}
