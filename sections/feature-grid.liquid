<section class="section">
  <div class="wrap">
    <div class="grid feature-grid">
      {%- for block in section.blocks -%}
        <div class="feature-card reveal" {{ block.shopify_attributes }}>
          <div class="ic">{% render 'icon', name: block.settings.icon %}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature grid",
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "check", "label": "Check" }, { "value": "shield", "label": "Shield" },
          { "value": "trial", "label": "Trial" }, { "value": "truck", "label": "Truck" }
        ], "default": "check" },
        { "type": "text", "id": "title", "label": "Title", "default": "Adaptive Core" },
        { "type": "text", "id": "text", "label": "Text", "default": "Memory-responsive foam contours to your exact sleeping position." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature grid",
      "blocks": [
        { "type": "feature", "settings": { "icon": "check", "title": "Adaptive Core", "text": "Memory-responsive foam contours to your exact position in seconds." } },
        { "type": "feature", "settings": { "icon": "check", "title": "CloudCool™ Gel", "text": "Phase-change surface wicks heat so you never flip to the cold side." } },
        { "type": "feature", "settings": { "icon": "check", "title": "Spinal Alignment", "text": "Contoured cervical ridge keeps your neck neutral all night." } },
        { "type": "feature", "settings": { "icon": "check", "title": "Washable Cover", "text": "Removable Tencel™ cover, breathable and hypoallergenic." } }
      ]
    }
  ]
}
{% endschema %}
