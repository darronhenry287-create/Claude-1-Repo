<section class="section" id="shop">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 style="margin-top:.8rem">{{ section.settings.heading }}</h2>
    </div>
    <div class="grid products">
      {%- assign coll = collections[section.settings.collection] -%}
      {%- if coll.products.size > 0 -%}
        {%- for product in coll.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Bundled demo products until a collection is connected {%- endcomment -%}
        <article class="card reveal"><div class="card__media"><span class="pill pill-clay card__badge">Bestseller</span><img src="{{ 'somna-pdp-1.jpg' | asset_url }}" alt="The Cloud Pillow"></div><h3 class="card__title">The Cloud Pillow</h3><div class="card__reviews"><span class="star">★★★★★</span> 12,400 reviews</div><div class="card__row"><span class="card__price">$89</span></div></article>
        <article class="card reveal"><div class="card__media"><img src="{{ 'somna-duvet.jpg' | asset_url }}" alt="The Weighted Duvet"></div><h3 class="card__title">The Weighted Duvet</h3><div class="card__reviews"><span class="star">★★★★★</span> 3,108 reviews</div><div class="card__row"><span class="card__price">$129</span></div></article>
        <article class="card reveal"><div class="card__media"><img src="{{ 'somna-mask.jpg' | asset_url }}" alt="Silk Sleep Mask"></div><h3 class="card__title">Silk Sleep Mask</h3><div class="card__reviews"><span class="star">★★★★☆</span> 980 reviews</div><div class="card__row"><span class="card__price">$39</span></div></article>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you need for a better night." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 3 }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
