<section class="section" id="shop">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 style="margin-top:.8rem">{{ section.settings.heading }}</h2>
    </div>
    <div class="grid products">
      {%- assign coll = collections[section.settings.collection] -%}
      {%- if coll.products.size > 0 -%}
        {%- for product in coll.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Fallback placeholders for preview/theme editor {%- endcomment -%}
        {%- for i in (1..3) -%}
          <article class="card reveal">
            <div class="card__media">{% render 'pillow-art' %}</div>
            <h3 class="card__title">The Cloud Pillow</h3>
            <div class="card__reviews"><span class="star">★★★★★</span> 12,400 reviews</div>
            <div class="card__row"><span class="card__price">$89</span></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you need for a better night." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 3 }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
