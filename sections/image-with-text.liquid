<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap">
    <div class="split {% if section.settings.reverse %}split--reverse{% endif %}">
      <div class="split__media {% if section.settings.warm %}warm{% endif %} reveal">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}" style="width:100%;height:100%;object-fit:cover">
        {%- endif -%}
      </div>
      <div class="split__copy reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div>{{ section.settings.text }}</div>
        <ul class="checklist">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %} {{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn btn-clay btn-lg" style="margin-top:1.8rem">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "reverse", "label": "Reverse layout", "default": false },
    { "type": "checkbox", "id": "warm", "label": "Warm media background", "default": true },
    { "type": "checkbox", "id": "bg", "label": "Cream section background", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The problem with pillows" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your old pillow is working against you." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Flat by midnight. Too hot by 2am. The average pillow forgets its shape in 6 months — and your neck pays the price.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Meet The Cloud Pillow →" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "point", "name": "Checklist point", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Keeps its loft for 5+ years, guaranteed" } ] }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "point", "settings": { "text": "Keeps its loft for 5+ years, guaranteed" } },
        { "type": "point", "settings": { "text": "Two heights in one — flip to fit your body" } },
        { "type": "point", "settings": { "text": "CertiPUR-US® certified, zero off-gassing" } }
      ]
    }
  ]
}
{% endschema %}
