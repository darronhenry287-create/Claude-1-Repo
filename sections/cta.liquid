<section class="section night center">
  <div class="wrap" style="max-width:620px;position:relative">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 style="margin:1rem 0">{{ section.settings.heading }}</h2>
    <p class="lede">{{ section.settings.text }}</p>
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn-clay btn-lg" style="margin-top:1.5rem">{{ section.settings.button_text }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sleep on it for 100 nights." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "If The Cloud Pillow isn't the best you've ever owned, we'll arrange a free return and a full refund. No risk, no catch." },
    { "type": "text", "id": "button_text", "label": "Button", "default": "How the trial works" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "CTA banner" } ]
}
{% endschema %}
