<section class="section night" id="science">
  <svg class="stars-bg" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice">
    <g fill="#e9e4f2">
      <circle cx="120" cy="90" r="1.5"/><circle cx="320" cy="160" r="1"/><circle cx="540" cy="60" r="2"/>
      <circle cx="760" cy="130" r="1.2"/><circle cx="980" cy="80" r="1.6"/><circle cx="1180" cy="150" r="1"/>
      <circle cx="1320" cy="70" r="1.4"/><circle cx="220" cy="300" r="1"/><circle cx="640" cy="340" r="1.3"/>
      <circle cx="1040" cy="320" r="1.1"/><circle cx="1280" cy="380" r="1.5"/><circle cx="80" cy="420" r="1.2"/>
    </g>
  </svg>
  <div class="wrap" style="position:relative">
    <div class="center" style="max-width:680px;margin-inline:auto">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 style="margin:1rem 0">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.text }}</p>
    </div>
    <div class="stat-row">
      {%- for block in section.blocks -%}
        <div class="stat reveal" {{ block.shopify_attributes }}>
          <div class="num">{{ block.settings.number }}</div>
          <div class="lbl">{{ block.settings.label }}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="center" style="margin-top:2.5rem;font-size:.78rem;opacity:.6">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Stats / Science",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The science of rest" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Deeper sleep isn't a luxury. It's engineering." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Backed by sleep researchers, CloudCool™ keeps your surface temperature in the window shown to speed deep, restorative sleep." },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "*Based on a 2024 independent 6-week sleep study, n=312." }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "37%" },
      { "type": "text", "id": "label", "label": "Label", "default": "faster to fall asleep" }
    ] }
  ],
  "presets": [
    {
      "name": "Stats / Science",
      "blocks": [
        { "type": "stat", "settings": { "number": "37%", "label": "faster to fall asleep" } },
        { "type": "stat", "settings": { "number": "2.1×", "label": "more deep-sleep minutes" } },
        { "type": "stat", "settings": { "number": "94%", "label": "woke with less neck pain" } }
      ]
    }
  ]
}
{% endschema %}
