<section class="section" id="reviews">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 style="margin-top:.8rem">{{ section.settings.heading }}</h2>
      <div style="margin-top:1rem"><span class="star" style="font-size:1.2rem">★★★★★</span> <strong>{{ section.settings.avg }}</strong> average rating</div>
    </div>
    <div class="grid reviews">
      {%- for block in section.blocks -%}
        <div class="review reveal" {{ block.shopify_attributes }}>
          <span class="star">★★★★★</span>
          <p>"{{ block.settings.quote }}"</p>
          <div class="review__author">
            <div class="review__avatar">{{ block.settings.name | slice: 0, 1 }}{{ block.settings.name | split: ' ' | last | slice: 0, 1 }}</div>
            <div><div class="review__name">{{ block.settings.name }}</div><div class="review__meta">{{ block.settings.meta }}</div></div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "12,400+ five-star reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sleepers don't go back." },
    { "type": "text", "id": "avg", "label": "Average", "default": "4.9" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "First morning in years without a neck crick. It genuinely stays cool." },
      { "type": "text", "id": "name", "label": "Name", "default": "Jordan M." },
      { "type": "text", "id": "meta", "label": "Meta", "default": "Verified · Side sleeper" }
    ] }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review", "settings": { "quote": "First morning in years without a neck crick. It genuinely stays cool.", "name": "Jordan M.", "meta": "Verified · Side sleeper" } },
        { "type": "review", "settings": { "quote": "The two-height flip is genius. We both got the pillow we wanted in one box.", "name": "Alex R.", "meta": "Verified · Back sleeper" } },
        { "type": "review", "settings": { "quote": "Four months in and my chiropractor asked what changed.", "name": "Priya T.", "meta": "Verified · Combination sleeper" } }
      ]
    }
  ]
}
{% endschema %}
