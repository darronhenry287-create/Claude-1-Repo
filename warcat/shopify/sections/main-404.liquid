<section class="section center" style="min-height:54vh;display:grid;place-items:center">
  <div class="wrap">
    <span class="eyebrow" style="justify-content:center">Error 404</span>
    <h1 class="h-lg mt-1">{{ 'general.404.title' | t }}</h1>
    <p class="lede mt-1" style="margin-inline:auto;max-width:42ch">{{ 'general.404.subtext' | t }}</p>
    <div class="btn-row mt-3" style="justify-content:center">
      <a href="{{ routes.root_url }}" class="btn btn-primary btn-lg">{{ 'general.404.back' | t }}</a>
      <a href="{% render 'shop-url' %}" class="btn btn-outline btn-lg">Shop WARCAT</a>
    </div>
  </div>
</section>

{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
