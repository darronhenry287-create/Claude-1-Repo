<section class="section{% if section.settings.bg == 'soft' %} bg-soft{% endif %}">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="h-lg">{{ section.settings.heading }}</h2></div>
    <div class="faq">
      <div class="acc">
        {%- for block in section.blocks -%}
          <div class="acc__item{% if forloop.first %} open{% endif %}" {{ block.shopify_attributes }}>
            <button class="acc__head" type="button">{{ block.settings.question }} <span class="pm">+</span></button>
            <div class="acc__body"><div class="acc__body-inner">{{ block.settings.answer }}</div></div>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.link_label != blank -%}<div class="center mt-3"><a href="{{ section.settings.link_url | default: routes.root_url }}" class="tlink">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a></div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Good questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The things cat people ask first."
    },
    {
      "type": "select",
      "id": "bg",
      "label": "Background",
      "options": [
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "soft",
          "label": "Soft"
        }
      ],
      "default": "white"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "A question?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>The answer.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "qa",
          "settings": {
            "question": "Is it really quiet enough for a small apartment?",
            "answer": "<p>Yes. The cleaning cycle runs under 40 dB — quieter than a typical fridge. Most owners can't hear it from the next room, and you can schedule quiet hours so it never runs overnight.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Will it work for multiple cats?",
            "answer": "<p>Absolutely — it's built for it. The 90L globe and large sealed drawer comfortably handle up to four cats, and the app tracks each cat individually by weight.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "What litter does it use?",
            "answer": "<p>Any quality clumping clip litter (clay or tofu/plant-based clumping). No proprietary refills, no subscriptions.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Is it safe for kittens and senior cats?",
            "answer": "<p>It's safe for any cat over 1 kg. Triple sensors stop and reverse the drum instantly if a cat enters mid-cycle, and the low, wide entry suits kittens and older cats.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "How often do I actually empty it?",
            "answer": "<p>For one to two cats, about once a week. The app tells you before the drawer is full, so you're never surprised.</p>"
          }
        }
      ]
    }
  ],
  "default": {
    "settings": {
      "link_label": "See all FAQs"
    },
    "blocks": [
      {
        "type": "qa",
        "settings": {
          "question": "Is it really quiet enough for a small apartment?",
          "answer": "<p>Yes. The cleaning cycle runs under 40 dB — quieter than a typical fridge. Most owners can't hear it from the next room, and you can schedule quiet hours so it never runs overnight.</p>"
        }
