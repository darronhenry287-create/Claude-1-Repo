{%- liquid
  assign wide_img = 'app.webp' | asset_url
-%}
<section class="section{% if section.settings.bg == 'soft' %} bg-soft{% endif %}">
  <div class="wrap wrap-wide">
    <div class="sec-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="h-lg">{{ section.settings.heading }}</h2>
    </div>
    <div class="features">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'feature' -%}
            <div class="feature" {{ block.shopify_attributes }}><span class="ic">{% render 'icon', name: block.settings.icon %}</span><h4>{{ block.settings.title }}</h4><p>{{ block.settings.text }}</p></div>
          {%- when 'wide' -%}
            {%- assign fw = wide_img -%}
            {%- if block.settings.image -%}{%- assign fw = block.settings.image | image_url: width: 900 -%}{%- endif -%}
            <div class="feature feature--wide" {{ block.shopify_attributes }}>
              <div>
                <span class="ic">{% render 'icon', name: block.settings.icon %}</span>
                <h3 class="h-sm">{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
                {%- if block.settings.cta_label != blank -%}<div class="btn-row mt-2"><a href="{{ block.settings.cta_link | default: routes.root_url }}" class="btn btn-primary btn-sm">{{ block.settings.cta_label }}</a></div>{%- endif -%}
              </div>
              <div class="fw-media"><img src="{{ fw }}" alt="{{ block.settings.title | escape }}" width="900" height="900"></div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
