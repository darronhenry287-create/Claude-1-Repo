        }
      },
      {
        "type": "logo",
        "settings": {
          "name": "Mashable"
        }
      },
      {
        "type": "logo",
        "settings": {
          "name": "Modern Cat"
        }
      },
      {
        "type": "logo",
        "settings": {
          "name": "TechRadar"
        }
      }
    ]
