{%- liquid
  assign img = 'kit.webp' | asset_url
  if section.settings.image
    assign img = section.settings.image | image_url: width: 900
  endif
-%}
<section class="section">
  <div class="wrap wrap-wide">
    <div class="offer">
      <div class="offer__media"><img src="{{ img }}" alt="{{ section.settings.heading | escape }}" width="900" height="900"></div>
      <div class="offer__copy">
        {%- if section.settings.tag != blank -%}<span class="tag tag--soft">{{ section.settings.tag }}</span>{%- endif -%}
        <h2 class="h-md mt-2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="includes">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}><span class="ck">{% render 'icon', name: 'check' %}</span> {{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="offer__price"><span class="now tnum">{{ section.settings.price_now }}</span>{%- if section.settings.price_was != blank -%}<span class="was tnum">{{ section.settings.price_was }}</span>{%- endif -%}</div>
        <div class="btn-row">
          <a href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}" class="btn btn-primary btn-lg">{{ section.settings.cta1_label }}</a>
          {%- if section.settings.cta2_label != blank -%}<a href="{{ section.settings.cta2_link | default: routes.root_url }}" class="btn btn-outline btn-lg">{{ section.settings.cta2_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Offer / bundle",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "tag", "label": "Tag", "default": "Best value · save $120" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Complete WARCAT Kit" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Everything to go scoop-free on day one: the WARCAT box, a litter-catching mat, three months of carbon filters and a starter pack of drawer liners." },
    { "type": "text", "id": "price_now", "label": "Price", "default": "$549" },
    { "type": "text", "id": "price_was", "label": "Compare price", "default": "$669" },
    { "type": "text", "id": "cta1_label", "label": "Primary button", "default": "Shop the kit" },
    { "type": "url", "id": "cta1_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Compare bundles" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" }
  ],
  "blocks": [
    { "type": "item", "name": "Includes item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Included item" } ] }
  ],
  "presets": [
    { "name": "Offer / bundle", "blocks": [
      { "type": "item", "settings": { "text": "WARCAT Smart Litter Box (90L)" } },
      { "type": "item", "settings": { "text": "Anti-tracking entry mat" } },
      { "type": "item", "settings": { "text": "3-month carbon filter set" } },
      { "type": "item", "settings": { "text": "30 sealed drawer liners" } }
    ] }
  ]
}
{% endschema %}
