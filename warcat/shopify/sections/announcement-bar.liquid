<div class="topbar">
  <div class="topbar__in">
    {%- for block in section.blocks -%}
      <span {% unless forloop.first %}class="tb-extra"{% endunless %} {{ block.shopify_attributes }}>{% unless forloop.first %}<span class="tb-dot">•</span> {% endunless %}{{ block.settings.text }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping & 2-year warranty" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping & 2-year warranty" } },
        { "type": "message", "settings": { "text": "90-night risk-free home trial" } },
        { "type": "message", "settings": { "text": "Pay over time with Shop Pay" } }
      ]
    }
  ]
}
{% endschema %}
