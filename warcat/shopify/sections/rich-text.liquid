{%- liquid
  assign wide = ''
  if section.settings.width == 'narrow'
    assign wide = 'wrap-narrow'
  elsif section.settings.width == 'wide'
    assign wide = 'wrap-wide'
  endif
-%}
<section class="section{% if section.settings.bg == 'soft' %} bg-soft{% elsif section.settings.bg == 'dark' %} bg-dark{% endif %}">
  <div class="wrap {{ wide }} {% if section.settings.align == 'center' %}center{% endif %}">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow{% if section.settings.bg == 'dark' %} eyebrow--light{% endif %}"{% if section.settings.align == 'center' %} style="justify-content:center"{% endif %}>{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h-lg" style="margin-top:1rem">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="lede" style="margin-top:1rem;max-width:60ch;{% if section.settings.align == 'center' %}margin-inline:auto;{% endif %}">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="btn-row" style="margin-top:1.6rem;{% if section.settings.align == 'center' %}justify-content:center;{% endif %}"><a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-primary btn-lg">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "soft", "label": "Soft grey" }, { "value": "dark", "label": "Dark" } ], "default": "white" },
    { "type": "select", "id": "width", "label": "Width", "options": [ { "value": "default", "label": "Default" }, { "value": "narrow", "label": "Narrow" }, { "value": "wide", "label": "Wide" } ], "default": "default" },
    { "type": "select", "id": "align", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "center" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WARCAT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A headline goes here" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add supporting copy here.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
