<section class="section">
  <div class="wrap wrap-wide">
    <div class="specband">
      <div class="specband__head">
        <span class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</span>
        <h2 class="h-lg">{{ section.settings.heading }}</h2>
        {%- if section.settings.subtitle != blank -%}<p>{{ section.settings.subtitle }}</p>{%- endif -%}
      </div>
      <div class="specgrid">
        {%- for block in section.blocks -%}
          <div class="specstat" {{ block.shopify_attributes }}><div class="n tnum">{{ block.settings.number | escape }}{%- if block.settings.unit != blank -%}<span class="u">{{ block.settings.unit | escape }}</span>{%- endif -%}</div><div class="l">{{ block.settings.label }}</div></div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Spec band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "By the numbers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built like a flagship appliance." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Every WARCAT is the same machine reviewers rate for cats up to 11 kg and homes with up to four of them." }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "90" },
      { "type": "text", "id": "unit", "label": "Unit", "default": "L" },
      { "type": "text", "id": "label", "label": "Label", "default": "Globe capacity" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Spec band", "blocks": [
      { "type": "stat", "settings": { "number": "90", "unit": "L", "label": "Globe capacity" } },
      { "type": "stat", "settings": { "number": "<40", "unit": "dB", "label": "Cleaning noise" } },
      { "type": "stat", "settings": { "number": "4", "unit": "cats", "label": "Comfortable for" } },
      { "type": "stat", "settings": { "number": "7", "unit": "days", "label": "Between empties" } }
    ] }
  ]
}
{% endschema %}
