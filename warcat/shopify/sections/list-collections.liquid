<section class="collhead">
  <div class="wrap wrap-wide">
    <div class="sec-head left" style="max-width:640px">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="h-lg">{{ section.settings.heading | default: page_title }}</h1>
    </div>
  </div>
</section>

<section class="section section--tight" style="padding-top:1rem">
  <div class="wrap wrap-wide">
    <div class="prodgrid">
      {%- for collection in collections -%}
        <a class="pcard" href="{{ collection.url }}">
          <div class="pcard__media">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" width="600" height="600" loading="lazy">
            {%- else -%}
              <div style="display:grid;place-items:center;height:100%"><span class="eyebrow">{{ collection.title }}</span></div>
            {%- endif -%}
          </div>
          <div class="pcard__body"><h3>{{ collection.title }}</h3><p class="muted" style="font-size:.9rem">{{ collection.products_count }} products</p></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "List collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}
