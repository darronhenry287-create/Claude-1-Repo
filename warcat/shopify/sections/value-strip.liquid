<section class="section section--tight{% if section.settings.bg == 'teal' %} bg-teal{% elsif section.settings.bg == 'dark' %} bg-dark{% elsif section.settings.bg == 'soft' %} bg-soft{% endif %}">
  <div class="wrap wrap-wide">
    <div class="valstrip">
      <div class="valprop"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v2M12 19v2M5 12H3M21 12h-2M6 6l-1.5-1.5M18 18l1.5 1.5"/><circle cx="12" cy="12" r="4"/></svg></span><div><b>{{ section.settings.t1 }}</b><p>{{ section.settings.s1 }}</p></div></div>
      <div class="valprop"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M11 5 6 9H3v6h3l5 4zM16 9a4 4 0 0 1 0 6M19.5 7a8 8 0 0 1 0 10"/></svg></span><div><b>{{ section.settings.t2 }}</b><p>{{ section.settings.s2 }}</p></div></div>
      <div class="valprop"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8 12 3l9 5v8l-9 5-9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg></span><div><b>{{ section.settings.t3 }}</b><p>{{ section.settings.s3 }}</p></div></div>
      <div class="valprop"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/></svg></span><div><b>{{ section.settings.t4 }}</b><p>{{ section.settings.s4 }}</p></div></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value strip",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "soft", "label": "Soft" }, { "value": "teal", "label": "Teal" }, { "value": "dark", "label": "Dark" } ], "default": "white" },
    { "type": "text", "id": "t1", "label": "Title 1", "default": "Cleans itself" },
    { "type": "text", "id": "s1", "label": "Text 1", "default": "Every visit, automatically — no scoop, no schedule." },
    { "type": "text", "id": "t2", "label": "Title 2", "default": "Whisper-quiet" },
    { "type": "text", "id": "s2", "label": "Text 2", "default": "Under 40 dB. Cleans without startling a sleeping cat." },
    { "type": "text", "id": "t3", "label": "Title 3", "default": "90L XL capacity" },
    { "type": "text", "id": "s3", "label": "Text 3", "default": "Room for big cats and a week of multi-cat use." },
    { "type": "text", "id": "t4", "label": "Title 4", "default": "Health tracking" },
    { "type": "text", "id": "s4", "label": "Text 4", "default": "Logs each cat's weight & visits, and flags changes." }
  ],
  "presets": [ { "name": "Value strip" } ]
}
{% endschema %}
