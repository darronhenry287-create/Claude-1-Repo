<section class="section bg-dark">
  <div class="wrap wrap-narrow">
    <div class="guarantee">
      <div class="gseal"><div><div class="big">{{ section.settings.seal_number }}</div><small>{{ section.settings.seal_label }}</small></div></div>
      <div>
        <h2 class="h-md">{{ section.settings.heading }}</h2>
        <p class="lede mt-1">{{ section.settings.text }}</p>
        <div class="trustrow mt-3" style="justify-content:flex-start">
          <span class="t">{% render 'icon', name: 'shield' %} {{ section.settings.trust1 }}</span>
          <span class="t">{% render 'icon', name: 'truck' %} {{ section.settings.trust2 }}</span>
          <span class="t">{% render 'icon', name: 'check' %} {{ section.settings.trust3 }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee band",
  "settings": [
    { "type": "text", "id": "seal_number", "label": "Seal number", "default": "90" },
    { "type": "text", "id": "seal_label", "label": "Seal label", "default": "Night Trial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try it for 90 nights. On us." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Set it up, let your cats settle in, and live scoop-free for three months. If WARCAT isn't the best thing in your home, send it back for a full refund — we'll even cover return shipping." },
    { "type": "text", "id": "trust1", "label": "Trust 1", "default": "2-year warranty" },
    { "type": "text", "id": "trust2", "label": "Trust 2", "default": "Free 2-day shipping" },
    { "type": "text", "id": "trust3", "label": "Trust 3", "default": "Lifetime support" }
  ],
  "presets": [ { "name": "Guarantee band" } ]
}
{% endschema %}
