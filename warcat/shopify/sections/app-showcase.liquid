{%- liquid
  assign img = 'app-phone.webp' | asset_url
  if section.settings.image
    assign img = section.settings.image | image_url: width: 900
  endif
-%}
<section class="section">
  <div class="wrap wrap-wide">
    <div class="app">
      <div class="app__phone"><div class="app__glow"></div><img src="{{ img }}" alt="WARCAT app dashboard" width="886" height="1100"></div>
      <div class="app__copy">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="h-lg">{{ section.settings.heading }}</h2>
        {%- if section.settings.subtitle != blank -%}<p class="lede">{{ section.settings.subtitle }}</p>{%- endif -%}
        <ul class="applist">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><span class="ic">{% render 'icon', name: block.settings.icon %}</span><div><b>{{ block.settings.title }}</b><p>{{ block.settings.text }}</p></div></li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "App showcase",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "App image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The WARCAT app" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cat's day, on a dashboard." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Everything WARCAT sees, in one calm screen — so you're the first to know when something's off." }
  ],
  "blocks": [
    { "type": "item", "name": "List item", "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "arrow" },
      { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Short description." }
    ] }
  ],
  "max_blocks": 5,
  "presets": [
    { "name": "App showcase", "blocks": [
      { "type": "item", "settings": { "icon": "arrow", "title": "Clean on demand", "text": "Tap once to run a cycle, or set a daily auto-clean schedule." } },
      { "type": "item", "settings": { "icon": "check", "title": "Per-cat tracking", "text": "Weight and visit charts for each cat, with smart anomaly alerts." } },
      { "type": "item", "settings": { "icon": "shield", "title": "Drawer-full alerts", "text": "A gentle nudge when it's time to empty — never an overflow." } },
      { "type": "item", "settings": { "icon": "user", "title": "Quiet hours", "text": "Pause cleaning overnight so the cycle never disturbs your sleep." } }
    ] }
  ]
}
{% endschema %}
