{%- liquid
  assign img = 'lifestyle.webp' | asset_url
  if section.settings.image
    assign img = section.settings.image | image_url: width: 1280
  endif
-%}
<section class="section{% if section.settings.bg == 'soft' %} bg-soft{% endif %}">
  <div class="wrap wrap-wide">
    <div class="split{% if section.settings.media_position == 'left' %} split--media-left{% endif %}">
      <div class="split__media"><img src="{{ img }}" alt="{{ section.settings.heading | escape }}" width="1280" height="960"></div>
      <div class="split__copy">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="h-lg">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="checklist">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}><span class="ck">{% render 'icon', name: 'check' %}</span><span>{{ block.settings.text }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}<div class="btn-row mt-3"><a href="{{ section.settings.link_url | default: routes.root_url }}" class="tlink">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a></div>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Split feature",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "media_position", "label": "Image side", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "bg", "label": "Background", "options": [ { "value": "white", "label": "White" }, { "value": "soft", "label": "Soft" } ], "default": "soft" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The end of the daily scoop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cat's bathroom, finally handled." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The litter box is the one chore that never ends. WARCAT ends it — sifting waste into a sealed, odor-locked drawer after every single visit, so all that's left for you is emptying a liner about once a week." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See the full cycle" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    { "type": "point", "name": "Checklist point", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "A clear, scannable benefit." } ] }
  ],
  "presets": [
    { "name": "Split feature", "blocks": [
      { "type": "point", "settings": { "text": "No scooping, ever. WARCAT does it within minutes of each use." } },
      { "type": "point", "settings": { "text": "No more litter-box smell. A carbon-sealed drawer traps odor between empties." } },
      { "type": "point", "settings": { "text": "A cleaner bed of litter every time — the way cats actually prefer it." } }
    ] }
  ]
}
{% endschema %}
