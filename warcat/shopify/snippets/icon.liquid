{%- liquid
  assign s = 'width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"'
-%}
{%- case name -%}
  {%- when 'menu' -%}<svg {{ s }}><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  {%- when 'search' -%}<svg {{ s }}><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg>
  {%- when 'user' -%}<svg {{ s }}><circle cx="12" cy="8" r="4"/><path d="M5 21c0-4 3-6.5 7-6.5s7 2.5 7 6.5"/></svg>
  {%- when 'bag' -%}<svg {{ s }}><path d="M6 8h12l1 12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1Z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
  {%- when 'close' -%}<svg {{ s }}><path d="M18 6 6 18M6 6l12 12"/></svg>
  {%- when 'check' -%}<svg {{ s }} stroke-width="2.4"><path d="m5 12 4 4L19 6"/></svg>
  {%- when 'minus' -%}<svg {{ s }}><path d="M5 12h14"/></svg>
  {%- when 'plus' -%}<svg {{ s }}><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'arrow' -%}<svg {{ s }} stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'ig' -%}<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'tiktok' -%}<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M16 3c.3 2.1 1.6 3.8 3.7 4.1v2.7c-1.3.1-2.6-.3-3.7-1v5.9a5.6 5.6 0 1 1-5.6-5.6c.3 0 .6 0 .9.1v2.8a2.8 2.8 0 1 0 2 2.7V3Z"/></svg>
  {%- when 'yt' -%}<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10 9.5 5 2.5-5 2.5Z" fill="currentColor"/></svg>
  {%- when 'shield' -%}<svg {{ s }}><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/></svg>
  {%- when 'truck' -%}<svg {{ s }}><path d="M3 7h13v8H3zM16 10h3l2 2v3h-5z"/><circle cx="7" cy="17" r="1.6"/><circle cx="18" cy="17" r="1.6"/></svg>
  {%- else -%}<svg {{ s }}><circle cx="12" cy="12" r="9"/></svg>
{%- endcase -%}
