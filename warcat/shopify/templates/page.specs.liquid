<section class="pagehead">
  <div class="wrap pagehead__in">
    <span class="eyebrow">Tech specs</span>
    <h1 class="h-lg">{{ page.title | default: "Every detail, on the table." }}</h1>
  </div>
</section>
{%- if page.content != blank -%}
<section class="section"><div class="wrap prose">{{ page.content }}</div></section>
{%- else -%}
<section class="section section--tight">
    <div class="wrap wrap-wide">
      <div class="specband">
        <div class="specgrid">
          <div class="specstat"><div class="n tnum">90<span class="u">L</span></div><div class="l">Globe capacity</div></div>
          <div class="specstat"><div class="n tnum">&lt;40<span class="u">dB</span></div><div class="l">Cleaning noise</div></div>
          <div class="specstat"><div class="n tnum">1–11<span class="u">kg</span></div><div class="l">Cat weight range</div></div>
          <div class="specstat"><div class="n tnum">2.4<span class="u">GHz</span></div><div class="l">Wi-Fi</div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap prose">
      <h2>Dimensions &amp; capacity</h2>
      <ul>
        <li><strong>Footprint</strong> — 26 × 27 in (66 × 68 cm)</li>
        <li><strong>Height</strong> — 29 in (73 cm)</li>
        <li><strong>Globe capacity</strong> — 90 L usable</li>
        <li><strong>Waste drawer</strong> — sealed, ~9 L, holds ~7 days for 1–2 cats</li>
        <li><strong>Weight (empty)</strong> — 26 lb (11.8 kg)</li>
        <li><strong>Entry height</strong> — low 5.5 in step-in (ramp available)</li>
      </ul>

      <h2>Performance &amp; noise</h2>
      <ul>
        <li><strong>Cleaning cycle</strong> — automatic after each visit, ~2–3 minutes</li>
        <li><strong>Noise level</strong> — under 40 dB (gear-damped low-noise motor)</li>
        <li><strong>Cycle trigger</strong> — weight-sensed exit + smart delay timer</li>
        <li><strong>Cats supported</strong> — comfortable for up to 4 cats per box</li>
      </ul>

      <h2>Smart features</h2>
      <ul>
        <li><strong>Per-cat tracking</strong> — identifies cats by weight; logs visits &amp; weight trends</li>
        <li><strong>Health alerts</strong> — flags unusual weight or visit-frequency changes</li>
        <li><strong>App control</strong> — manual clean, scheduling, quiet hours, status &amp; history</li>
        <li><strong>Notifications</strong> — drawer-full, litter-low, cycle complete, error states</li>
        <li><strong>Sensors</strong> — precision weight array, infrared occupancy, anti-pinch</li>
      </ul>

      <h2>Power &amp; connectivity</h2>
      <ul>
        <li><strong>Power</strong> — 24V DC adapter (included); ~3 kWh / month typical</li>
        <li><strong>Connectivity</strong> — 2.4 GHz Wi-Fi; Bluetooth setup</li>
        <li><strong>App</strong> — free WARCAT app for iOS 14+ and Android 9+</li>
      </ul>

      <h2>Litter &amp; compatibility</h2>
      <ul>
        <li><strong>Litter type</strong> — any quality clumping litter (clay or tofu/plant-based)</li>
        <li><strong>Recommended fill</strong> — ~6–9 lb to the fill line</li>
        <li><strong>No proprietary refills</strong> — use the brand your cat already prefers</li>
      </ul>

      <h2>In the box</h2>
      <ul>
        <li>WARCAT base, sifting globe &amp; sealed waste drawer</li>
        <li>Power adapter</li>
        <li>Starter pack of drawer liners</li>
        <li>Quick-start guide</li>
        <li>Free WARCAT app access</li>
      </ul>

      <h2>Coverage</h2>
      <ul>
        <li><strong>Home trial</strong> — 90 nights, full refund, free returns</li>
        <li><strong>Warranty</strong> — 2 years parts &amp; labor</li>
        <li><strong>Support</strong> — lifetime, real humans</li>
      </ul>

      <div class="btn-row mt-3"><a href="{{ settings.shop_product.url | default: routes.all_products_collection_url }}" class="btn btn-primary btn-lg">Shop WARCAT — $499</a><a href="/pages/how-it-works" class="btn btn-outline btn-lg">How it works</a></div>
    </div>
  </section>
{%- endif -%}
