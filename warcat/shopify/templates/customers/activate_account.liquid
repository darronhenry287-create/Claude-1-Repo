<section class="pagehead"><div class="wrap pagehead__in">
  <span class="eyebrow">WARCAT</span>
  <h1 class="h-lg">Activate account</h1>
  <p>Choose a password to finish setting up your account.</p>
</div></section>

<section class="section"><div class="wrap-narrow">
  <div style="background:var(--soft);border:1px solid var(--line);border-radius:18px;padding:1.8rem">
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}<div class="note-ok" style="background:#fdecea;border-color:#d64545;color:#a12a2a">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label>Password</label><input type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label>Confirm password</label><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn-primary btn-block btn-lg">Activate account</button>
      <button type="submit" name="decline" class="btn btn-outline btn-block" style="margin-top:.8rem">Decline invitation</button>
    {%- endform -%}
  </div>
</div></section>
