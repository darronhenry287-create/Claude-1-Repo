<section class="section center" style="min-height:80vh;display:grid;place-items:center"><div class="wrap-narrow">
  <span class="eyebrow">WARCAT</span>
  <h1 class="h-lg" style="margin:.7rem 0 1rem">{{ page_title | default: 'Coming soon' }}</h1>
  <p class="muted" style="margin-bottom:2rem">{{ shop.password_message | default: 'The smart self-cleaning litter box. Opening soon — join the list to be first in.' }}</p>

  <div class="wrap-narrow" style="max-width:480px;margin-inline:auto">
    <div style="background:var(--soft);border:1px solid var(--line);border-radius:18px;padding:1.8rem">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<div class="note-ok" style="background:#fdecea;border-color:#d64545;color:#a12a2a">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label>Store password</label><input type="password" name="password" autocomplete="off" required></div>
        <button class="btn btn-primary btn-block" type="submit">Enter</button>
      {%- endform -%}
    </div>
  </div>

  <p class="muted" style="margin-top:2rem">Store owner? <a href="/admin" style="text-decoration:underline">Log in</a></p>
</div></section>
