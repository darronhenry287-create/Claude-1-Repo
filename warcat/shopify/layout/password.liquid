<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="{{ settings.color_bg | default: '#ffffff' }}">
  <title>{{ page_title }} &middot; {{ shop.name }}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {{ content_for_header }}
  <script>document.documentElement.classList.add('js');</script>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>:root{--bg:{{ settings.color_bg | default:'#ffffff' }};--ink:{{ settings.color_ink | default:'#0e1a26' }};--brand:{{ settings.color_brand | default:'#0fb5a6' }};--dark:{{ settings.color_dark | default:'#0e1a26' }};}</style>
</head>
<body class="template-password">
  {{ content_for_layout }}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
