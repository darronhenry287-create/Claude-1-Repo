<section class="section">
  <div class="wrap wrap--wide">
    <div class="shead reveal">
      <div class="kicker">{{ section.settings.kicker }}</div>
      <h2 style="margin-top:1rem">{{ section.settings.heading }}</h2>
    </div>
    <div class="benefits reveal" style="margin-top:2rem">
      {%- for block in section.blocks -%}
        <div class="benefit" {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'bolt' -%}
              <svg class="benefit__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/></svg>
            {%- when 'sun' -%}
              <svg class="benefit__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l3 3M16 16l3 3M19 5l-3 3M8 16l-3 3"/><circle cx="12" cy="12" r="3"/></svg>
            {%- when 'helix' -%}
              <svg class="benefit__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4c4 0 4 16 8 16s4-16 8-16"/><path d="M4 20c4 0 4-16 8-16s4 16 8 16"/></svg>
            {%- when 'clock' -%}
              <svg class="benefit__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          {%- endcase -%}
          <span class="tag">{{ block.settings.tag }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Benefits",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "// 04 — Why NAD⁺ matters" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What your cells do with it." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "bolt", "label": "Bolt (energy)" },
            { "value": "sun", "label": "Sun (aging)" },
            { "value": "helix", "label": "Helix (DNA)" },
            { "value": "clock", "label": "Clock (metabolism)" }
          ],
          "default": "bolt"
        },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Mitochondria" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cellular energy" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "NAD⁺ is essential to turn food into ATP — the fuel that runs every cell.†" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "bolt", "tag": "Mitochondria", "title": "Cellular energy", "text": "NAD⁺ is essential to turn food into ATP — the fuel that runs every cell.†" } },
        { "type": "benefit", "settings": { "icon": "sun", "tag": "Sirtuins", "title": "Healthy aging", "text": "NAD⁺ activates sirtuins — longevity proteins tied to how cells age.†" } },
        { "type": "benefit", "settings": { "icon": "helix", "tag": "PARPs", "title": "DNA repair", "text": "Repair enzymes consume NAD⁺ to fix daily damage to your genome.†" } },
        { "type": "benefit", "settings": { "icon": "clock", "tag": "Metabolism", "title": "Metabolic balance", "text": "NAD⁺ supports the metabolic pathways that keep cells efficient.†" } }
      ]
    }
  ]
}
{% endschema %}
