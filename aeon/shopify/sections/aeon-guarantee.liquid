<section class="section section--tight">
  <div class="wrap wrap--wide reveal">
    <div class="panel guarantee">
      <img class="guarantee__seal" src="{{ 'aeon-seal.svg' | asset_url }}" alt="">
      <div class="guarantee__body">
        <div class="kicker">{{ section.settings.kicker }}</div>
        <h2 style="margin:.8rem 0 .6rem">{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
      </div>
      <a href="{{ section.settings.cta_url }}" class="btn btn-mint btn-lg">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Guarantee",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "60-night guarantee" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Feel it, or it's free." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Take AEON every day for 60 nights. If you don't feel the difference, email us for a full refund — keep the bottle. The protocol only works if you actually start." },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Start your protocol" }
  ],
  "presets": [
    { "name": "Guarantee" }
  ]
}
{% endschema %}
