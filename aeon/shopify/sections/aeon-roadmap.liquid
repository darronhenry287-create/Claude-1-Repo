<section class="section decline">
  <div class="wrap wrap--wide">
    <div class="shead reveal">
      <div class="kicker">{{ section.settings.kicker }}</div>
      <h2 style="margin-top:1rem">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.lede }}</p>
    </div>
    <div class="timeline reveal">
      {%- for block in section.blocks -%}
        <div class="phase" {{ block.shopify_attributes }}>
          <div class="phase__bar"></div>
          <div class="phase__day">{{ block.settings.day }}</div>
          <h4>{{ block.settings.title }}</h4>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Roadmap / Timeline",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "What to expect" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your first 90 days." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Longevity is a long game. Here's a realistic timeline — consistency is the active ingredient." }
  ],
  "blocks": [
    {
      "type": "phase",
      "name": "Phase",
      "settings": [
        { "type": "text", "id": "day", "label": "Day / period label", "default": "Days 1–7" },
        { "type": "text", "id": "title", "label": "Title", "default": "Establish the habit" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Two capsules each morning. Set a cue — your protocol starts here." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Roadmap / Timeline",
      "blocks": [
        { "type": "phase", "settings": { "day": "Days 1–7", "title": "Establish the habit", "text": "Two capsules each morning. Set a cue — your protocol starts here." } },
        { "type": "phase", "settings": { "day": "Weeks 2–4", "title": "NAD⁺ rebuilding", "text": "Blood NAD⁺ rises as your cells restock the coenzyme they were missing.†" } },
        { "type": "phase", "settings": { "day": "Weeks 5–8", "title": "Steady state", "text": "Many report smoother daily energy and focus as levels stabilize.†" } },
        { "type": "phase", "settings": { "day": "Days 60–90", "title": "The long game", "text": "The point where the cellular benefits of consistent NAD⁺ support compound.†" } }
      ]
    }
  ]
}
{% endschema %}
