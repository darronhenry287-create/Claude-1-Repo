<section class="section">
  <div class="wrap" style="max-width:760px">
    {%- if page.title != blank and section.settings.show_title -%}
      <h1 style="margin-bottom:1.6rem">{{ page.title }}</h1>
    {%- endif -%}
    <div class="prose">{{ page.content }}</div>
  </div>
</section>
{% schema %}
{
  "name": "Page content",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": false,
      "info": "Use the Page head section for the title instead."
    }
  ],
  "presets": [
    { "name": "Page content" }
  ]
}
{% endschema %}
