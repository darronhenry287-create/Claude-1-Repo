<section class="section">
  <div class="wrap wrap--wide">
    <div class="shead reveal">
      <div class="kicker">{{ section.settings.kicker }}</div>
      <h2 style="margin-top:1rem">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.lede }}</p>
    </div>
    <div class="pathway__track reveal">
      {%- for block in section.blocks -%}
        {%- assign is_last = false -%}
        {%- if forloop.last -%}{%- assign is_last = true -%}{%- endif -%}
        <div class="node" {{ block.shopify_attributes }}>
          <div class="node__n">{{ block.settings.step_label }}</div>
          {%- if block.settings.molecule == 'capsule' -%}
            <img class="node__mol" src="{{ 'aeon-capsule.svg' | asset_url }}" alt="">
          {%- else -%}
            <img class="node__mol" src="{{ 'aeon-molecule.svg' | asset_url }}" alt="">
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- unless is_last -%}
            <div class="node__arrow"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
          {%- endunless -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Pathway",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "// 02 — How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One molecule upstream of everything." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "NMN is the direct precursor your body converts into NAD⁺ — which fuels the machinery of healthy aging." }
  ],
  "blocks": [
    {
      "type": "node",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "step_label", "label": "Step label", "default": "STEP 01" },
        {
          "type": "select", "id": "molecule", "label": "Molecule image",
          "options": [
            { "value": "molecule", "label": "Molecule" },
            { "value": "capsule", "label": "Capsule" }
          ],
          "default": "molecule"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "You take NMN" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "1000 mg of stabilized β-Nicotinamide Mononucleotide is absorbed and enters your cells." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Pathway",
      "blocks": [
        { "type": "node", "settings": { "step_label": "STEP 01", "molecule": "molecule", "title": "You take NMN", "text": "1000 mg of stabilized β-Nicotinamide Mononucleotide is absorbed and enters your cells." } },
        { "type": "node", "settings": { "step_label": "STEP 02", "molecule": "molecule", "title": "It becomes NAD⁺", "text": "Enzymes convert NMN into NAD⁺ — the coenzyme your mitochondria and repair systems depend on." } },
        { "type": "node", "settings": { "step_label": "STEP 03", "molecule": "capsule", "title": "Cells get to work", "text": "NAD⁺ powers energy production, activates sirtuins, and supports DNA repair — the hallmarks of cellular youth.†" } }
      ]
    }
  ]
}
{% endschema %}
