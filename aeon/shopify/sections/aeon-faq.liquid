<section class="section">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="shead shead--center reveal" style="margin-bottom:2rem">
        {%- if section.settings.kicker != blank -%}
          <div class="kicker k--plain" style="justify-content:center">{{ section.settings.kicker }}</div>
        {%- endif -%}
        <h2 style="margin-top:1rem">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="acc reveal">
      {%- for block in section.blocks -%}
        <div class="acc__item" {{ block.shopify_attributes }}>
          <button class="acc__head">{{ block.settings.question }}<span class="acc__icon"></span></button>
          <div class="acc__body"><p>{{ block.settings.answer }}</p></div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.footer_link != blank -%}
      <div class="center" style="margin-top:2rem">
        <a href="{{ section.settings.footer_link }}" class="btn btn-ghost">{{ section.settings.footer_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "// FAQ" },
    { "type": "text", "id": "heading", "label": "Heading (blank to hide)", "default": "Common questions." },
    { "type": "url", "id": "footer_link", "label": "Footer CTA link (blank to hide)" },
    { "type": "text", "id": "footer_label", "label": "Footer CTA label", "default": "All questions →" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Q&A",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What exactly is NMN?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "NMN (β-Nicotinamide Mononucleotide) is a molecule your body uses as the direct precursor to NAD⁺ — a coenzyme essential for cellular energy and DNA repair. NAD⁺ declines with age; supplementing NMN is a researched way to support it." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "What exactly is NMN?", "answer": "NMN (β-Nicotinamide Mononucleotide) is a molecule your body uses as the direct precursor to NAD⁺ — a coenzyme essential for cellular energy and DNA repair. NAD⁺ declines with age; supplementing NMN is a researched way to support it." } },
        { "type": "qa", "settings": { "question": "How much should I take?", "answer": "Our serving is 2 capsules (1000 mg) once daily, ideally in the morning, with or without food. Consistency matters more than timing." } },
        { "type": "qa", "settings": { "question": "When will I feel something?", "answer": "NAD⁺ support is cumulative. Some notice steadier energy in 2–4 weeks; the cellular benefits compound over 60–90 days of daily use.†" } },
        { "type": "qa", "settings": { "question": "Is it third-party tested?", "answer": "Yes — every batch is tested by an ISO 17025-accredited lab for purity (≥99%), identity, heavy metals and microbials. Scan the QR on your bottle to see your lot's certificate." } }
      ]
    }
  ]
}
{% endschema %}
