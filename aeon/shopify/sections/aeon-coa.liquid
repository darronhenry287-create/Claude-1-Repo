<section class="section section--hair">
  <div class="wrap wrap--wide">
    <div class="lab__grid">
      <div class="coa reveal">
        <div class="coa__head">
          <span class="lab-id">{{ section.settings.lab_id }}</span>
          <span class="pass">{{ section.settings.pass_label }}</span>
        </div>
        <div class="coa__body">
          {%- for block in section.blocks -%}
            <div class="assay" {{ block.shopify_attributes }}>
              <span class="name">{{ block.settings.name }}</span>
              <span class="res">{{ block.settings.result }}</span>
              <span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="reveal">
        <div class="kicker">{{ section.settings.kicker }}</div>
        <h2 style="margin:1rem 0 1rem">{{ section.settings.heading }}</h2>
        <p class="lede" style="margin-bottom:1.5rem">{{ section.settings.lede }}</p>
        <button class="btn btn-ghost" data-action="open-coa">{{ section.settings.cta_label }}</button>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Lab / COA",
  "settings": [
    { "type": "text", "id": "lab_id", "label": "Lab ID / cert label", "default": "CERT. OF ANALYSIS · LOT AE-2026-0418" },
    { "type": "text", "id": "pass_label", "label": "Pass badge label", "default": "PASS" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "// 05 — Tested, not trusted" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every batch, independently verified." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "NMN is notoriously inconsistent across the industry. We test every lot at an ISO 17025-accredited lab for purity, identity, heavy metals and microbials — and publish the results." },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "View certificate of analysis" }
  ],
  "blocks": [
    {
      "type": "assay",
      "name": "Assay row",
      "settings": [
        { "type": "text", "id": "name", "label": "Test name", "default": "NMN purity (HPLC)" },
        { "type": "text", "id": "result", "label": "Result", "default": "99.6%" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Lab / COA",
      "blocks": [
        { "type": "assay", "settings": { "name": "NMN purity (HPLC)", "result": "99.6%" } },
        { "type": "assay", "settings": { "name": "Heavy metals", "result": "< limits" } },
        { "type": "assay", "settings": { "name": "Microbial", "result": "Pass" } },
        { "type": "assay", "settings": { "name": "Identity", "result": "Conforms" } }
      ]
    }
  ]
}
{% endschema %}
