<section class="section section--hair">
  <div class="wrap wrap--wide">
    <div class="shead reveal">
      <div class="kicker">{{ section.settings.benefits_kicker }}</div>
      <h2 style="margin-top:1rem">{{ section.settings.benefits_heading }}</h2>
    </div>
    <div class="benefits reveal" style="margin-top:2rem">
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          <div class="benefit" {{ block.shopify_attributes }}>
            {%- case block.settings.icon -%}
              {%- when 'bolt' -%}
                <svg class="benefit__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/></svg>
              {%- when 'dose' -%}
                <svg class="benefit__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 7l10 5 10-5"/></svg>
              {%- when 'check' -%}
                <svg class="benefit__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              {%- when 'plus' -%}
                <svg class="benefit__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>
              {%- when 'sun' -%}
                <svg class="benefit__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l3 3M16 16l3 3M19 5l-3 3M8 16l-3 3"/><circle cx="12" cy="12" r="3"/></svg>
            {%- endcase -%}
            <span class="tag">{{ block.settings.tag }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="prose reveal" style="margin-inline:auto">
      {%- for block in section.blocks -%}
        {%- if block.type == 'prose' -%}
          <div {{ block.shopify_attributes }}>
            {%- if block.settings.kicker != blank -%}
              <div class="kicker">{{ block.settings.kicker }}</div>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 style="margin:1rem 0 1rem">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {{ block.settings.content }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Standards",
  "settings": [
    { "type": "text", "id": "benefits_kicker", "label": "Benefits kicker", "default": "// What we stand for" },
    { "type": "text", "id": "benefits_heading", "label": "Benefits heading", "default": "Three non-negotiables." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "dose", "label": "Dose (stack)" },
            { "value": "check", "label": "Check (verified)" },
            { "value": "plus", "label": "Plus (circle)" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "sun", "label": "Sun" }
          ],
          "default": "dose"
        },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Dose" },
        { "type": "text", "id": "title", "label": "Title", "default": "Clinically meaningful" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "1000 mg per serving — not the 125–250 mg that lets others hit a price point." }
      ]
    },
    {
      "type": "prose",
      "name": "Prose block",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "// The standard" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "From raw material to your door." },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>We source pharmaceutical-grade β-NMN and verify identity and purity before anything is encapsulated. Manufacturing happens in a cGMP-certified facility. Then every finished lot goes back out to an ISO 17025-accredited lab — a separate set of eyes — to confirm what's on the label is what's in the bottle.</p><p>Heavy metals, microbials, residual solvents, assay purity: all checked, all documented. The QR code on your bottle pulls up that exact lot's certificate. No \"proprietary blend\" hand-waving, no trust-me-bro.</p><h3>Why it matters</h3><ul><li>NMN is fragile and easy to adulterate — testing is the only real safeguard.</li><li>Underdosing is the industry's quiet default; the full dose is the whole point.</li><li>Transparency should be the floor, not a premium feature.</li></ul><p>That's the entire company, really: do the boring, expensive things right, and show our work.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Standards",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "dose", "tag": "Dose", "title": "Clinically meaningful", "text": "1000 mg per serving — not the 125–250 mg that lets others hit a price point." } },
        { "type": "benefit", "settings": { "icon": "check", "tag": "Proof", "title": "Tested & published", "text": "Independent COA for every lot. If we can't show it, we don't claim it." } },
        { "type": "benefit", "settings": { "icon": "plus", "tag": "Purity", "title": "Nothing you don't need", "text": "Just NMN and a vegetable capsule. No fillers, flow agents or marketing dust." } },
        { "type": "prose", "settings": { "kicker": "// The standard", "heading": "From raw material to your door.", "content": "<p>We source pharmaceutical-grade β-NMN and verify identity and purity before anything is encapsulated. Manufacturing happens in a cGMP-certified facility. Then every finished lot goes back out to an ISO 17025-accredited lab — a separate set of eyes — to confirm what's on the label is what's in the bottle.</p><p>Heavy metals, microbials, residual solvents, assay purity: all checked, all documented. The QR code on your bottle pulls up that exact lot's certificate. No \"proprietary blend\" hand-waving, no trust-me-bro.</p><h3>Why it matters</h3><ul><li>NMN is fragile and easy to adulterate — testing is the only real safeguard.</li><li>Underdosing is the industry's quiet default; the full dose is the whole point.</li><li>Transparency should be the floor, not a premium feature.</li></ul><p>That's the entire company, really: do the boring, expensive things right, and show our work.</p>" } }
      ]
    }
  ]
}
{% endschema %}
