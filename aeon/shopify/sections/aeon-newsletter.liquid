<section class="section section--tight">
  <div class="wrap reveal">
    <div class="cta-band">
      {%- if section.settings.kicker != blank -%}
        <div class="kicker k--plain" style="justify-content:center">{{ section.settings.kicker }}</div>
      {%- endif -%}
      <h2 style="margin:1rem 0 .6rem">{{ section.settings.heading }}</h2>
      <p class="lede" style="margin-inline:auto;max-width:42ch">{{ section.settings.text }}</p>
      {%- form 'customer', class: 'signup' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" aria-label="Email" required>
        <button class="btn btn-mint" type="submit">{{ section.settings.button_label }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The protocol" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Longevity, in your inbox." },
    { "type": "textarea", "id": "text", "label": "Subtext", "default": "The science of NAD⁺, dosing protocols, and early access. Plus 10% off your first order." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "you@email.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get 10% off" }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
