{%- comment -%}
  AEON — List of all collections. Grid of collection cards (.prodgrid / .pcard).
{%- endcomment -%}

<section class="pagehead">
  <div class="wrap wrap--wide">
    <div class="kicker">{{ section.settings.kicker | default: '// Collections' }}</div>
    <h1>{{ section.settings.heading | default: 'Browse the range.' }}</h1>
    {%- if section.settings.subtext != blank -%}
      <p class="lede" style="max-width:54ch">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>
</section>

<section class="section" style="padding-top:2rem">
  <div class="wrap wrap--wide">
    {%- if collections.size > 0 -%}
      <div class="prodgrid reveal">
        {%- for collection in collections -%}
          <a href="{{ collection.url }}" class="pcard" style="text-decoration:none;color:inherit">
            <div class="pcard__img">
              {%- if collection.featured_image -%}
                <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="600" height="600">
              {%- elsif collection.products.first.featured_media -%}
                <img src="{{ collection.products.first.featured_media | image_url: width: 600 }}" alt="{{ collection.title | escape }}" loading="lazy" width="600" height="600">
              {%- else -%}
                <img src="{{ 'aeon-seal.svg' | asset_url }}" alt="{{ collection.title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="pcard__body">
              <h3>{{ collection.title }}</h3>
              {%- if collection.description != blank -%}
                <p class="sub">{{ collection.description | strip_html | truncate: 70 }}</p>
              {%- endif -%}
              <div class="pcard__foot">
                <span class="muted" style="font-size:.8rem">{{ collection.all_products_count }} products</span>
                <span class="btn btn-mint btn-sm">View</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="panel" style="padding:3rem;text-align:center">
        <p class="lede" style="margin-bottom:.4rem">No collections yet.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-mint btn-lg" style="margin-top:.6rem">Shop all</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "List collections",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "// Collections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Browse the range." },
    { "type": "textarea", "id": "subtext", "label": "Subtext / lede" }
  ],
  "presets": [
    { "name": "List collections" }
  ]
}
{% endschema %}
