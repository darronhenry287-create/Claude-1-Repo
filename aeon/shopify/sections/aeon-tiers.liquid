<section class="section section--hair">
  <div class="wrap wrap--wide">
    <div class="shead shead--center reveal" style="margin-bottom:2.5rem">
      <div class="kicker k--plain" style="justify-content:center">{{ section.settings.kicker }}</div>
      <h2 style="margin-top:1rem">{{ section.settings.heading }}</h2>
      <p class="lede" style="margin-inline:auto">{{ section.settings.lede }}</p>
    </div>
    <div class="tiers reveal">
      {%- for block in section.blocks -%}
        <div class="tiercard{% if block.settings.best %} best{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.best -%}
            <span class="tiercard__flag">{{ block.settings.badge }}</span>
          {%- endif -%}
          <span class="supply">{{ block.settings.supply }}</span>
          <h3>
            {{ block.settings.name }}
            {%- if block.settings.save_label != blank -%}
              <span class="save-pill">{{ block.settings.save_label }}</span>
            {%- endif -%}
          </h3>
          <div class="price">
            <span class="now">{{ block.settings.price }}</span>
            {%- if block.settings.compare != blank -%}
              <span class="was">{{ block.settings.compare }}</span>
            {%- endif -%}
          </div>
          <p class="per">{{ block.settings.per }}</p>
          <ul>
            {%- assign feature_lines = block.settings.features | newline_to_br | split: '<br />' -%}
            {%- for line in feature_lines -%}
              {%- assign feat = line | strip -%}
              {%- if feat != blank -%}
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  {{ feat }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if block.settings.product != blank -%}
            <a href="{{ block.settings.product.url }}" class="btn{% if block.settings.best %} btn-mint{% else %} btn-ghost{% endif %} btn-block">{{ block.settings.cta_label }}</a>
          {%- else -%}
            <a href="/products" class="btn{% if block.settings.best %} btn-mint{% else %} btn-ghost{% endif %} btn-block">{{ block.settings.cta_label }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Supply tiers",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "// 09 — Choose your supply" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Commit to the protocol, save more." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Subscribe and save up to 25%. Skip, pause or cancel anytime." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product (for CTA link)" },
        { "type": "text", "id": "supply", "label": "Supply label", "default": "1-month" },
        { "type": "text", "id": "name", "label": "Plan name", "default": "Starter" },
        { "type": "text", "id": "save_label", "label": "Save pill (blank to hide)", "default": "" },
        { "type": "text", "id": "price", "label": "Price", "default": "$68" },
        { "type": "text", "id": "compare", "label": "Compare-at price (blank to hide)", "default": "" },
        { "type": "text", "id": "per", "label": "Per / billing note", "default": "$1.13 / serving · one-time" },
        { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "120 capsules · 60 servings\nBatch COA included\n60-night guarantee" },
        { "type": "checkbox", "id": "best", "label": "Mark as best / featured", "default": false },
        { "type": "text", "id": "badge", "label": "Badge label (when best)", "default": "Most popular" },
        { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Add — $68" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Supply tiers",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "supply": "1-month",
            "name": "Starter",
            "save_label": "",
            "price": "$68",
            "compare": "",
            "per": "$1.13 / serving · one-time",
            "features": "120 capsules · 60 servings\nBatch COA included\n60-night guarantee",
            "best": false,
            "badge": "Most popular",
            "cta_label": "Add — $68"
          }
        },
        {
          "type": "tier",
          "settings": {
            "supply": "3-month",
            "name": "Protocol",
            "save_label": "Save 25%",
            "price": "$153",
            "compare": "$204",
            "per": "$0.85 / serving · subscription",
            "features": "3 bottles · ships every 90 days\nFree priority shipping\nSkip / cancel anytime",
            "best": true,
            "badge": "Most popular",
            "cta_label": "Subscribe — $153"
          }
        },
        {
          "type": "tier",
          "settings": {
            "supply": "6-month",
            "name": "Longevity",
            "save_label": "Save 30%",
            "price": "$286",
            "compare": "$408",
            "per": "$0.79 / serving · subscription",
            "features": "6 bottles · best value\nFree priority shipping\nLock today's price",
            "best": false,
            "badge": "Most popular",
            "cta_label": "Subscribe — $286"
          }
        }
      ]
    }
  ]
}
{% endschema %}
