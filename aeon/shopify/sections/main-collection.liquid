{%- comment -%}
  AEON — Collection page. Mirrors aeon/src/collection.html .pagehead + .prodgrid.
  Renders product-card snippet over collection.products with pagination.
{%- endcomment -%}

<section class="pagehead">
  <div class="wrap wrap--wide">
    <div class="kicker">{{ section.settings.kicker | default: 'Shop' }}</div>
    <h1>{{ collection.title | default: 'The longevity stack.' }}</h1>
    {%- if collection.description != blank -%}
      <div class="lede rte" style="max-width:54ch">{{ collection.description }}</div>
    {%- elsif section.settings.subtext != blank -%}
      <p class="lede" style="max-width:54ch">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>
</section>

<section class="section" style="padding-top:2rem" data-product>
  <div class="wrap wrap--wide">
    {%- if collection.products.size > 0 -%}
      <p class="muted" style="font-weight:600;margin-bottom:1.5rem">{{ collection.products_count }} products</p>
      {%- paginate collection.products by 12 -%}
        <div class="prodgrid reveal">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div class="center" style="margin-top:3rem">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="panel" style="padding:3rem;text-align:center">
        <p class="lede" style="margin-bottom:.4rem">Nothing here yet.</p>
        <p class="muted" style="margin-bottom:1.5rem">In the theme editor, assign a collection to this section — or start with the foundation.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-mint btn-lg">Shop AEON NMN</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Shop" },
    { "type": "textarea", "id": "subtext", "label": "Fallback lede (used when collection has no description)" }
  ],
  "presets": [
    { "name": "Collection" }
  ]
}
{% endschema %}
