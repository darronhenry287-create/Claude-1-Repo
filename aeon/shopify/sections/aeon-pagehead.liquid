<section class="pagehead">
  <div class="wrap wrap--wide">
    {%- if section.settings.kicker != blank -%}
      <div class="kicker">{{ section.settings.kicker }}</div>
    {%- endif -%}
    <h1>{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.subtext != blank -%}
      <p class="lede">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AEON Page header",
  "class": "aeon-pagehead",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "AEON" },
    { "type": "text", "id": "heading", "label": "Heading (leave blank to use page title)" },
    { "type": "textarea", "id": "subtext", "label": "Subtext / lede" }
  ],
  "presets": [
    { "name": "AEON Page header", "settings": { "kicker": "AEON" } }
  ]
}
{% endschema %}
