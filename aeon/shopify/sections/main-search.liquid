{%- comment -%}
  AEON — Search page. Search form (GET to routes.search_url) + product-card grid.
  Filters results to products; handles empty / no-results states.
{%- endcomment -%}

<section class="pagehead">
  <div class="wrap wrap--wide">
    <div class="kicker">// Search</div>
    <h1>{{ section.settings.heading | default: 'Search.' }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="signup" style="margin-top:1.4rem">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products…" aria-label="{{ 'general.search' | t }}">
      <button class="btn btn-mint" type="submit">{{ 'general.search' | t }}</button>
    </form>
  </div>
</section>

<section class="section" style="padding-top:2rem" data-product>
  <div class="wrap wrap--wide">
    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="muted" style="margin-bottom:1.5rem">{{ search.results_count }} results for &ldquo;{{ search.terms | escape }}&rdquo;</p>
        {%- paginate search.results by 12 -%}
          <div class="prodgrid reveal">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <div class="center" style="margin-top:3rem">{{ paginate | default_pagination }}</div>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="panel" style="padding:3rem;text-align:center">
          <p class="lede" style="margin-bottom:.4rem">No results for &ldquo;{{ search.terms | escape }}&rdquo;.</p>
          <p class="muted" style="margin-bottom:1.5rem">Try another term, or start with the foundation.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn-mint btn-lg">Shop AEON NMN</a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search." }
  ],
  "presets": [
    { "name": "Search" }
  ]
}
{% endschema %}
