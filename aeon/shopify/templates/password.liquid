{% layout 'password' %}

<section style="text-align:center;padding:clamp(2rem,6vw,4rem) var(--pad)">
  <div style="margin-bottom:2.5rem">
    <span class="logo" style="font-size:1.6rem;letter-spacing:.2em">AEON</span>
    <div class="kicker" style="justify-content:center;margin-top:.8rem">// Cellular Longevity</div>
  </div>

  <h1 style="font-size:clamp(1.6rem,4vw,2.6rem);margin-bottom:1rem;color:var(--text)">
    {{ page_title | default: 'Opening soon' }}
  </h1>
  <p class="lede" style="max-width:38ch;margin:0 auto 2rem">
    {{ shop.password_message | default: 'Precision NMN for NAD⁺ restoration — launching shortly. Enter the password to preview, or join the list for early access.' }}
  </p>

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <div class="note-ok" style="background:rgba(255,122,107,0.08);border-color:rgba(255,122,107,0.4);color:var(--ember);max-width:380px;margin:0 auto 1.2rem">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}
    <div class="signup" style="justify-content:center">
      <input type="password" name="password" placeholder="Store password" autocomplete="current-password" required>
      <button class="btn btn-mint" type="submit">Enter</button>
    </div>
  {%- endform -%}

  <p style="margin-top:2.5rem;color:var(--muted);font-size:.9rem">
    Store owner? <a href="/admin" class="mint" style="text-decoration:underline;text-underline-offset:3px">Log in here</a>
  </p>
</section>
