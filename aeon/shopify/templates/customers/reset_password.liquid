<section class="section" style="min-height:70vh;display:grid;place-items:center">
  <div class="wrap" style="max-width:480px;width:100%">
    <div class="center" style="margin-bottom:2rem">
      <div class="kicker" style="justify-content:center;margin-bottom:.8rem">// AEON</div>
      <h1>Reset password</h1>
      <p class="lede" style="margin-top:.7rem;font-size:1rem">Enter your new password below.</p>
    </div>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="note-ok" style="background:rgba(255,122,107,0.08);border-color:rgba(255,122,107,0.4);color:var(--ember);margin-bottom:1.2rem">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div class="panel" style="padding:1.8rem">
        <div class="field">
          <label for="reset-password">New password</label>
          <input id="reset-password" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label for="reset-confirm">Confirm new password</label>
          <input id="reset-confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn-mint btn-block btn-lg">Reset password</button>
      </div>
    {%- endform -%}
  </div>
</section>
