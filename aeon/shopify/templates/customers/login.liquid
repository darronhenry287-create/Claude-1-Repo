<section class="section" style="min-height:70vh;display:grid;place-items:center">
  <div class="wrap" style="max-width:480px;width:100%">
    <div class="center" style="margin-bottom:2rem">
      <div class="kicker" style="justify-content:center;margin-bottom:.8rem">// AEON</div>
      <h1>Sign in</h1>
    </div>

    <div id="login-wrap">
      {%- form 'customer_login' -%}
        {%- if form.errors -%}
          <div class="note-ok" style="background:rgba(255,122,107,0.08);border-color:rgba(255,122,107,0.4);color:var(--ember);margin-bottom:1.2rem">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
        <div class="panel" style="padding:1.8rem">
          <div class="field">
            <label for="login-email">Email</label>
            <input id="login-email" type="email" name="customer[email]" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="login-password">Password</label>
            <input id="login-password" type="password" name="customer[password]" autocomplete="current-password" required>
          </div>
          <button type="submit" class="btn btn-mint btn-block btn-lg">Sign in</button>
        </div>
      {%- endform -%}
      <p class="center muted" style="margin-top:1rem;font-size:.9rem">
        <a href="#recover" onclick="document.getElementById('recover-wrap').style.display='block';document.getElementById('login-wrap').style.display='none';return false;" class="mint" style="text-decoration:underline;text-underline-offset:3px">Forgot your password?</a>
      </p>
      <p class="center muted" style="margin-top:1.2rem;font-size:.9rem">
        New here? <a href="{{ routes.account_register_url }}" class="mint" style="text-decoration:underline;text-underline-offset:3px">Create an account</a>
      </p>
    </div>

    <div id="recover-wrap" style="display:none">
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <div class="note-ok" style="margin-bottom:1.2rem">We've sent a reset link to your email.</div>
        {%- endif -%}
        <div class="panel" style="padding:1.8rem">
          <h3 style="font-size:1.1rem;margin-bottom:1.2rem">Reset your password</h3>
          <div class="field">
            <label for="recover-email">Email</label>
            <input id="recover-email" type="email" name="email" autocomplete="email" required>
          </div>
          <button type="submit" class="btn btn-mint btn-block">Send reset link</button>
        </div>
      {%- endform -%}
      <p class="center muted" style="margin-top:1rem;font-size:.9rem">
        <a href="#login" onclick="document.getElementById('recover-wrap').style.display='none';document.getElementById('login-wrap').style.display='block';return false;" class="mint" style="text-decoration:underline;text-underline-offset:3px">← Back to sign in</a>
      </p>
    </div>
  </div>
</section>
