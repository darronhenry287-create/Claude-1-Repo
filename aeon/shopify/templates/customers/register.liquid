<section class="section" style="min-height:70vh;display:grid;place-items:center">
  <div class="wrap" style="max-width:480px;width:100%">
    <div class="center" style="margin-bottom:2rem">
      <div class="kicker" style="justify-content:center;margin-bottom:.8rem">// AEON</div>
      <h1>Create account</h1>
      <p class="lede" style="margin-top:.7rem;font-size:1rem">Join AEON — track your protocol and manage your orders.</p>
    </div>
    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <div class="note-ok" style="background:rgba(255,122,107,0.08);border-color:rgba(255,122,107,0.4);color:var(--ember);margin-bottom:1.2rem">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div class="panel" style="padding:1.8rem">
        <div class="field">
          <label for="reg-first">First name</label>
          <input id="reg-first" type="text" name="customer[first_name]" autocomplete="given-name">
        </div>
        <div class="field">
          <label for="reg-last">Last name</label>
          <input id="reg-last" type="text" name="customer[last_name]" autocomplete="family-name">
        </div>
        <div class="field">
          <label for="reg-email">Email</label>
          <input id="reg-email" type="email" name="customer[email]" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="reg-password">Password</label>
          <input id="reg-password" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn-mint btn-block btn-lg">Create account</button>
      </div>
    {%- endform -%}
    <p class="center muted" style="margin-top:1.2rem;font-size:.9rem">
      Already have an account? <a href="{{ routes.account_login_url }}" class="mint" style="text-decoration:underline;text-underline-offset:3px">Sign in</a>
    </p>
  </div>
</section>
