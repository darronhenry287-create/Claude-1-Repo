<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title>{{ shop.name }} — Gift Card</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-gift-card" style="min-height:100vh;display:grid;place-items:center;padding:2rem var(--pad)">

  <div style="max-width:480px;width:100%;text-align:center">
    <div style="margin-bottom:2rem">
      <span class="logo" style="font-size:1.5rem;letter-spacing:.2em">AEON</span>
      <div class="kicker" style="justify-content:center;margin-top:.7rem">// Gift Card</div>
    </div>

    <div class="panel" style="padding:2.5rem 2rem;margin-bottom:1.5rem;position:relative;overflow:hidden">
      <div style="position:absolute;inset:0;background:radial-gradient(60% 80% at 50% 0%,rgba(43,240,196,0.10),transparent 70%);pointer-events:none"></div>
      <div style="position:relative">
        <img src="{{ 'aeon-seal.svg' | asset_url }}" alt="AEON seal" width="80" height="80" style="margin:0 auto 1.5rem">
        <h1 style="font-size:clamp(2.5rem,8vw,4rem);line-height:1;margin-bottom:.4rem;color:var(--mint)">
          {{ gift_card.balance | money }}
        </h1>
        <p class="muted" style="font-size:.9rem;margin-bottom:1.8rem">remaining balance</p>
        <div style="background:var(--bg);display:inline-block;padding:1rem;border-radius:var(--r-lg);border:1px solid var(--line);margin-bottom:1.5rem">
          <img src="{{ gift_card | qr_url }}" alt="Gift card QR code" width="130" height="130">
        </div>
        <p class="muted" style="font-size:.78rem;letter-spacing:.04em;text-transform:uppercase;font-family:var(--mono);margin-bottom:.5rem">Gift card code</p>
        <div style="display:inline-block;background:rgba(43,240,196,0.06);border:1px solid rgba(43,240,196,0.3);border-radius:var(--r);padding:.75rem 1.4rem;font-family:var(--mono);font-weight:700;font-size:1.05rem;letter-spacing:.14em;color:var(--mint);word-break:break-all;margin-bottom:1.6rem">
          {{ gift_card.code | format_code }}
        </div>
        {%- if gift_card.expires_on -%}
          <p class="muted" style="font-size:.82rem">Expires {{ gift_card.expires_on | date: '%B %-d, %Y' }}</p>
        {%- endif -%}
      </div>
    </div>

    <a href="{{ shop.url }}" class="btn btn-mint btn-lg" style="width:100%;justify-content:center">
      Shop AEON
    </a>

    <p class="muted" style="margin-top:1.5rem;font-size:.82rem;line-height:1.6">
      Redeemable at {{ shop.url }} · Non-refundable · Does not expire{%- if gift_card.expires_on -%} until {{ gift_card.expires_on | date: '%B %-d, %Y' }}{%- endif -%}
    </p>
  </div>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
