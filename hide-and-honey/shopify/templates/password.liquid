<section class="section dark center" style="min-height:100vh;display:grid;place-items:center"><div class="wrap" style="max-width:520px">
  <span class="logo" style="color:var(--cream);font-size:1.8rem">{{ settings.logo_text | default: shop.name }}</span>
  <h1 style="color:var(--white);margin:1.5rem 0 1rem">{{ page_title | default: 'Coming soon' }}</h1>
  <p class="lede" style="margin-bottom:2rem">{{ shop.password_message | default: 'Four honest ingredients. Opening soon — join the list to be first in.' }}</p>
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}<div class="note-ok" style="background:#f3dcd2;border-color:var(--rust);color:var(--rust)">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="signup"><input type="password" name="password" placeholder="Store password" required><button class="btn btn-honey" type="submit">Enter</button></div>
  {%- endform -%}
  <p style="margin-top:2rem;color:rgba(246,239,221,.7)">Store owner? <a href="/admin" style="color:var(--honey)">Log in</a></p>
</div></section>
