<section class="section"><div class="wrap" style="max-width:840px">
  <div class="center" style="margin-bottom:2rem"><span class="kicker">Order {{ order.name }}</span><h1 style="margin-top:.6rem">Order details</h1><p class="muted" style="margin-top:.6rem">Placed {{ order.created_at | date: '%B %-d, %Y' }}</p></div>
  {%- for line_item in order.line_items -%}<div class="cline" style="grid-template-columns:1fr auto auto"><div>{{ line_item.title }}</div><div class="muted">×{{ line_item.quantity }}</div><div class="cline__price">{{ line_item.final_line_price | money }}</div></div>{%- endfor -%}
  <div class="csum__total" style="margin-top:1.5rem"><span>Total</span><span>{{ order.total_price | money }}</span></div>
  <div class="split" style="margin-top:2.5rem"><div><h3 style="margin-bottom:.8rem">Shipping</h3><p class="muted" style="line-height:1.8">{{ order.shipping_address | format_address }}</p></div><div><h3 style="margin-bottom:.8rem">Billing</h3><p class="muted" style="line-height:1.8">{{ order.billing_address | format_address }}</p></div></div>
  <p style="margin-top:2.5rem"><a href="{{ routes.account_url }}" class="muted" style="font-weight:700">← Back to account</a></p>
</div></section>
