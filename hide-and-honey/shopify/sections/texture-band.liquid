<section class="section texture">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="texture__grid">
      {%- for block in section.blocks -%}
        <div class="t reveal" {{ block.shopify_attributes }}><span class="hand">{{ block.settings.word }}</span><p>{{ block.settings.text }}</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Texture band",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The feel" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Whipped, not greasy." }
  ],
  "blocks": [ { "type": "feel", "name": "Descriptor", "settings": [ { "type": "text", "id": "word", "label": "Word", "default": "cloud-soft" }, { "type": "textarea", "id": "text", "label": "Text", "default": "Whipped to a buttery balm that melts the second it touches warm skin." } ] } ],
  "max_blocks": 4,
  "presets": [ { "name": "Texture band", "blocks": [
    { "type": "feel", "settings": { "word": "cloud-soft", "text": "Whipped to a buttery balm that melts the second it touches warm skin." } },
    { "type": "feel", "settings": { "word": "sinks right in", "text": "Absorbs to a soft, breathable finish — never sticky or heavy." } },
    { "type": "feel", "settings": { "word": "barely there", "text": "Unscented and clean. A pea-sized scoop is all your whole face needs." } }
  ] } ]
}
{% endschema %}
