<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="rmasonry">
      {%- for block in section.blocks -%}
        <div class="chip reveal" {{ block.shopify_attributes }}><span class="stars">★★★★★</span><p>"{{ block.settings.quote }}"</p><span class="who">{{ block.settings.who }}</span></div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_text != blank -%}<div class="center" style="margin-top:3rem"><a href="{{ section.settings.button_link | default: '/products/the-tallow-balm' }}" class="btn btn-honey btn-lg">{{ section.settings.button_text }}</a></div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Reviews masonry",
  "settings": [
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": true },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Straight from the jar owners" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "8,200 and counting." },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Shop the Balm · $24" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [ { "type": "review", "name": "Review", "settings": [ { "type": "textarea", "id": "quote", "label": "Quote", "default": "My eczema patches calmed down in four days." }, { "type": "text", "id": "who", "label": "Who", "default": "Rachel K. · Dry skin" } ] } ],
  "max_blocks": 16,
  "presets": [ { "name": "Reviews masonry", "blocks": [
    { "type": "review", "settings": { "quote": "My eczema patches calmed down in four days. This $24 jar beat prescription creams.", "who": "Rachel K. · Dry skin" } },
    { "type": "review", "settings": { "quote": "Now it's the only thing I use. One jar lasts months and a little goes so far.", "who": "Daniel M. · Normal" } },
    { "type": "review", "settings": { "quote": "Replaced my lip balm, hand cream and night moisturizer with one little jar.", "who": "Sofia T. · Combination" } },
    { "type": "review", "settings": { "quote": "Winter wrecks my hands every year. Two weeks of this and the cracks are gone.", "who": "Jonas B. · Very dry" } },
    { "type": "review", "settings": { "quote": "The unscented really is scentless. Melts right in.", "who": "Amara L. · Sensitive" } },
    { "type": "review", "settings": { "quote": "My teenage son uses it without complaining. His skin cleared up too.", "who": "Priya H. · Acne-prone" } }
  ] } ]
}
{% endschema %}
