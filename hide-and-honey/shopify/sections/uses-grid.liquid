<section class="section">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="uses__grid">
      {%- for block in section.blocks -%}
        <div class="use reveal" {{ block.shopify_attributes }}><span class="em">{% render 'icon', name: 'check' %}</span>{{ block.settings.text }}</div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Uses grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "One jar replaces a shelf" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A dozen uses, zero clutter." }
  ],
  "blocks": [ { "type": "use", "name": "Use", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Dry face" } ] } ],
  "max_blocks": 12,
  "presets": [
    { "name": "Uses grid", "blocks": [
      { "type": "use", "settings": { "text": "Dry face" } }, { "type": "use", "settings": { "text": "Chapped lips" } },
      { "type": "use", "settings": { "text": "Cracked hands" } }, { "type": "use", "settings": { "text": "Rough elbows" } },
      { "type": "use", "settings": { "text": "Faded scars" } }, { "type": "use", "settings": { "text": "Eczema patches" } },
      { "type": "use", "settings": { "text": "Baby-soft skin" } }, { "type": "use", "settings": { "text": "After shaving" } }
    ] }
  ]
}
{% endschema %}
