<section class="seals">
  <div class="wrap seals__row">
    {%- for block in section.blocks -%}
      <div class="badge2" {{ block.shopify_attributes }}>
        <span class="ring">{% render 'icon', name: 'check' %}</span>
        <span>{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Seal row",
  "blocks": [ { "type": "seal", "name": "Seal", "settings": [ { "type": "text", "id": "text", "label": "Label", "default": "100% Natural" } ] } ],
  "max_blocks": 8,
  "presets": [
    { "name": "Seal row", "blocks": [
      { "type": "seal", "settings": { "text": "100% Natural" } },
      { "type": "seal", "settings": { "text": "Gluten-Free" } },
      { "type": "seal", "settings": { "text": "Additive-Free" } },
      { "type": "seal", "settings": { "text": "BPA-Free" } },
      { "type": "seal", "settings": { "text": "Paraben-Free" } },
      { "type": "seal", "settings": { "text": "Cruelty-Free" } }
    ] }
  ]
}
{% endschema %}
