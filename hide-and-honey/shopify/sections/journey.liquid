<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap">
    <div class="center" style="margin-bottom:3.5rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <ol class="journey__line">
      {%- assign arts = 'hh-cow.svg,hh-honeycomb.svg,hh-bee.svg,hh-olive.svg,hh-jar.svg' | split: ',' -%}
      {%- for block in section.blocks -%}
        <li class="jstep reveal" {{ block.shopify_attributes }}>
          <div class="jstep__ic"><img src="{{ arts[block.settings.art_index] | asset_url }}" alt=""></div>
          <h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{
  "name": "Journey timeline",
  "settings": [
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": true },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "From farm to face" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How a jar comes to be." }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "range", "id": "art_index", "label": "Illustration (0 cow,1 honey,2 bee,3 olive,4 jar)", "min": 0, "max": 4, "step": 1, "default": 0 },
      { "type": "text", "id": "title", "label": "Title", "default": "Pastured" },
      { "type": "text", "id": "text", "label": "Text", "default": "Grass-fed cattle on regenerative farms." }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Journey timeline", "blocks": [
      { "type": "step", "settings": { "art_index": 0, "title": "Pastured", "text": "Grass-fed cattle on regenerative farms." } },
      { "type": "step", "settings": { "art_index": 1, "title": "Gathered", "text": "Raw honey from small independent apiaries." } },
      { "type": "step", "settings": { "art_index": 2, "title": "Whipped", "text": "Slow-rendered & whipped in small batches." } },
      { "type": "step", "settings": { "art_index": 4, "title": "Jarred", "text": "Hand-filled and sent straight to your door." } }
    ] }
  ]
}
{% endschema %}
