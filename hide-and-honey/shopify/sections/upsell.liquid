<section class="section">
  <div class="wrap">
    <div class="upsell reveal">
      <div><span class="kicker" style="color:var(--honey)">{{ section.settings.kicker }}</span><h3 style="margin-top:.5rem">{{ section.settings.heading }}</h3><p>{{ section.settings.text }}</p></div>
      <a href="{{ section.settings.button_link | default: '/pages/bundles' }}" class="btn btn-honey btn-lg">{{ section.settings.button_text }}</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Bundle upsell",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Stock up & save" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Add a second jar, save 25%." },
    { "type": "text", "id": "text", "label": "Text", "default": "One for the bathroom, one for your bag. Free shipping kicks in too." },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Get 3 jars · $54" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Bundle upsell" } ]
}
{% endschema %}
