<section class="section">
  <div class="wrap">
    {%- assign up_product = section.settings.product | default: product -%}
    {%- assign up_qty = section.settings.quantity | default: 3 -%}
    {%- if section.settings.button_link != blank -%}
      {%- assign up_href = section.settings.button_link -%}
    {%- elsif up_product != blank and up_product.selected_or_first_available_variant -%}
      {%- capture up_href -%}{{ routes.cart_url }}/{{ up_product.selected_or_first_available_variant.id }}:{{ up_qty }}{% if section.settings.discount_code != blank %}?discount={{ section.settings.discount_code | url_encode }}{% endif %}{%- endcapture -%}
    {%- else -%}
      {%- assign up_href = routes.all_products_collection_url -%}
    {%- endif -%}
    <div class="upsell reveal">
      <div><span class="kicker" style="color:var(--honey)">{{ section.settings.kicker }}</span><h3 style="margin-top:.5rem">{{ section.settings.heading }}</h3><p>{{ section.settings.text }}</p></div>
      <a href="{{ up_href }}" class="btn btn-honey btn-lg">{{ section.settings.button_text }}</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Bundle upsell",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Stock up & save" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Add a second jar, save 25%." },
    { "type": "text", "id": "text", "label": "Text", "default": "One for the bathroom, one for your bag. Free shipping kicks in too." },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Get 3 jars · $54" },
    { "type": "product", "id": "product", "label": "Bundle product", "info": "Which product the button adds. Defaults to the current product page." },
    { "type": "number", "id": "quantity", "label": "Quantity to add", "default": 3 },
    { "type": "text", "id": "discount_code", "label": "Discount code", "info": "Optional — auto-applied at the cart. Create the matching code under Discounts (e.g. a 25% off / 3-jar code)." },
    { "type": "url", "id": "button_link", "label": "Custom button link", "info": "Leave blank to add to cart. Set a URL to override that behaviour." }
  ],
  "presets": [ { "name": "Bundle upsell" } ]
}
{% endschema %}
