<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %} id="reviews">
  <div class="wrap">
    <div class="wall">
      <div class="wall__score reveal">
        <div class="big">{{ section.settings.score }}</div>
        <div class="stars">★★★★★</div>
        <p>{{ section.settings.count_text }}</p>
      </div>
      <div class="wall__chips">
        {%- for block in section.blocks -%}
          <div class="chip reveal" {{ block.shopify_attributes }}><span class="stars">★★★★★</span><p>"{{ block.settings.quote }}"</p><span class="who">{{ block.settings.name }}</span></div>
        {%- endfor -%}
      </div>
    </div>
    {%- if section.settings.button_text != blank -%}<div class="center" style="margin-top:2.5rem"><a href="{{ section.settings.button_link | default: '/pages/reviews' }}" class="btn btn-outline btn-lg">{{ section.settings.button_text }}</a></div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Reviews wall",
  "settings": [
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": true },
    { "type": "text", "id": "score", "label": "Average score", "default": "4.9" },
    { "type": "text", "id": "count_text", "label": "Count text", "default": "8,200 verified reviews" },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Read all 8,200 reviews" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "My eczema calmed down in four days." },
      { "type": "text", "id": "name", "label": "Name", "default": "Rachel K." }
    ] }
  ],
  "presets": [
    { "name": "Reviews wall", "blocks": [
      { "type": "review", "settings": { "quote": "My eczema calmed down in four days. Beat every prescription cream I've tried.", "name": "Rachel K." } },
      { "type": "review", "settings": { "quote": "Skeptical about beef fat on my face — now it's the only thing I use.", "name": "Daniel M." } },
      { "type": "review", "settings": { "quote": "Replaced my lip balm, hand cream and night moisturizer with one jar.", "name": "Sofia T." } },
      { "type": "review", "settings": { "quote": "Winter wrecks my hands. Two weeks of this and the cracks are gone.", "name": "Jonas B." } }
    ] }
  ]
}
{% endschema %}
