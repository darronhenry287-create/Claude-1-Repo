<section class="section" style="padding-top:1.4rem">
  <div class="wrap">
    <p class="muted" style="font-size:.82rem;font-weight:600;margin-bottom:1.4rem"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ collection.url | default: routes.all_products_collection_url }}">Shop</a> / {{ product.title }}</p>
    <div class="pdp" data-product="{{ product.handle }}">
      <div class="pgallery">
        <div class="pgallery__main{% if product.featured_image %} has-photo{% endif %}" id="pg-main">
          {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | escape }}">
          {%- else -%}<img src="{{ 'hh-jar.svg' | asset_url }}" alt="{{ product.title | escape }}">{%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="pgallery__thumbs has-photo">
            {%- for image in product.images -%}
              <button class="pthumb has-photo {% if image == product.featured_image %}active{% endif %}"><img src="{{ image | image_url: width: 300 }}" data-full="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | escape }}"></button>
            {%- endfor -%}
          </div>
        {%- elsif product.featured_image == blank -%}
          <div class="pgallery__thumbs">
            {%- assign demo = 'hh-jar.svg,hh-honeycomb.svg,hh-cow.svg,hh-olive.svg' | split: ',' -%}
            {%- for d in demo -%}<button class="pthumb {% if forloop.first %}active{% endif %}"><img src="{{ d | asset_url }}" data-full="{{ d | asset_url }}" alt=""></button>{%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pinfo" id="buy-anchor">
        {%- if product.metafields.custom.badge -%}<span class="tag tag-honey">{{ product.metafields.custom.badge }}</span>{%- else -%}<span class="tag tag-honey">★ Bestseller</span>{%- endif -%}
        <h1>{{ product.title }}</h1>
        <div class="pinfo__rate"><span class="stars">★★★★★</span> 4.9 · <a href="#reviews" style="text-decoration:underline">8,200 reviews</a></div>
        <div class="pinfo__price">
          <span class="now" id="p-now">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}<span class="was" id="p-was">{{ product.compare_at_price | money }}</span><span class="tag tag-outline">Save {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>{%- endif -%}
        </div>
        <div class="pinfo__desc rte">{{ product.description | default: 'Whipped grass-fed beef tallow and raw honey — bioidentical skin food. Four ingredients. Nothing else.' }}</div>

        {%- form 'product', product, id: 'product-form' -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div><span class="opt-label">{{ option.name }}</span><div class="opt-row" data-option-index="{{ forloop.index0 }}">
                {%- for value in option.values -%}<button type="button" class="opt {% if option.selected_value == value %}active{% endif %}" data-variant="{{ value | escape }}">{{ value }}</button>{%- endfor -%}
              </div></div>
            {%- endfor -%}
          {%- endunless -%}
          <select name="id" id="variant-id" hidden>
            {%- for v in product.variants -%}<option value="{{ v.id }}" {% if v == product.selected_or_first_available_variant %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title }}</option>{%- endfor -%}
          </select>

          <div class="qtyrow">
            <div class="qty"><button type="button" data-step="-">−</button><input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}"><button type="button" data-step="+">+</button></div>
            <button type="submit" class="btn btn-honey btn-lg btn-block" {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>
          </div>
        {%- endform -%}

        <div class="ptrust">
          <div><span class="ck">{% render 'icon', name: 'check' %}</span>90-day guarantee</div>
          <div><span class="ck">{% render 'icon', name: 'check' %}</span>Free shipping $35+</div>
          <div><span class="ck">{% render 'icon', name: 'check' %}</span>Small-batch made</div>
        </div>

        <div class="acc">
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              <div class="acc__item {% if forloop.first %}open{% endif %}" {{ block.shopify_attributes }}>
                <button class="acc__head">{{ block.settings.title }} <span class="pm">+</span></button>
                <div class="acc__body" {% if forloop.first %}style="max-height:340px"{% endif %}><div class="acc__body-inner">{{ block.settings.content }}</div></div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<div class="stickybar" id="stickybar" data-product="{{ product.handle }}">
  <div class="stickybar__in">
    <div class="stickybar__info"><div class="stickybar__thumb">{%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 96 }}" alt="" style="width:100%;height:100%;object-fit:cover">{%- else -%}<img src="{{ 'hh-jar.svg' | asset_url }}" alt="" style="width:100%;height:100%;object-fit:cover">{%- endif -%}</div><div><div class="stickybar__name">{{ product.title }}</div><div class="stickybar__price" id="sticky-price">{{ product.price | money }}</div></div></div>
    <button class="btn btn-honey" onclick="document.getElementById('product-form').requestSubmit()">{{ 'products.product.add_to_cart' | t }}</button>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "blocks": [
    { "type": "accordion", "name": "Accordion row", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "The full ingredient list" },
      { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Grass-fed beef tallow, raw wildflower honey, golden beeswax, cold-pressed olive oil. That's the entire list.</p>" }
    ] }
  ],
  "presets": [
    { "name": "Product", "blocks": [
      { "type": "accordion", "settings": { "title": "The full ingredient list" } },
      { "type": "accordion", "settings": { "title": "How to use", "content": "<p>Warm a pea-sized amount and press into damp skin — face, lips, hands, elbows. Morning and night.</p>" } },
      { "type": "accordion", "settings": { "title": "Shipping & returns", "content": "<p>Free shipping over $35, ships in 1–2 days. 90-day money-back guarantee — keep the jar.</p>" } }
    ] }
  ]
}
{% endschema %}
