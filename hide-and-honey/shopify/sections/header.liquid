<header class="header header--center">
  <div class="header__inner">
    <div class="nav--left">
      <button class="iconbtn burger" data-action="open-menu" aria-label="{{ 'accessibility.menu' | t }}">{% render 'icon', name: 'menu' %}</button>
      <nav class="nav">
        {%- if section.settings.menu_left != blank and linklists[section.settings.menu_left].links.size > 0 -%}
          {%- for link in linklists[section.settings.menu_left].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}">Shop</a>
          <a href="/pages/ingredients">Ingredients</a>
        {%- endif -%}
      </nav>
    </div>

    <a href="{{ routes.root_url }}" class="logo">
      {%- if settings.logo != blank -%}<img src="{{ settings.logo | image_url: width: 220 }}" alt="{{ shop.name }}" height="30">
      {%- else -%}{% render 'icon', name: 'drop' %} {{ settings.logo_text | default: 'HIDE & HONEY' }}{%- endif -%}
    </a>

    <div class="header__right">
      <nav class="nav nav--right">
        {%- if section.settings.menu_right != blank and linklists[section.settings.menu_right].links.size > 0 -%}
          {%- for link in linklists[section.settings.menu_right].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        {%- else -%}
          <a href="/pages/our-story">Our Story</a>
          <a href="/pages/reviews">Reviews</a>
        {%- endif -%}
      </nav>
      <a href="{{ routes.search_url }}" class="iconbtn desk" aria-label="{{ 'accessibility.search' | t }}">{% render 'icon', name: 'search' %}</a>
      <a href="{{ routes.account_url }}" class="iconbtn desk" aria-label="Account">{% render 'icon', name: 'user' %}</a>
      <button class="iconbtn" data-action="open-cart" aria-label="{{ 'accessibility.cart' | t }}">{% render 'icon', name: 'bag' %}<span class="cartnum {% if cart.item_count > 0 %}show{% endif %}">{{ cart.item_count }}</span></button>
    </div>
  </div>
</header>

<div class="mobile" id="menu">
  <div class="mobile__head"><span class="logo">{% render 'icon', name: 'drop' %} {{ settings.logo_text | default: 'HIDE & HONEY' }}</span><button class="iconbtn" data-action="close-menu" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button></div>
  <nav>
    <a href="{{ routes.all_products_collection_url }}">Shop</a>
    <a href="/pages/ingredients">Ingredients</a>
    <a href="/pages/our-story">Our Story</a>
    <a href="/pages/reviews">Reviews</a>
    <a href="/pages/faq">FAQ</a>
    <a href="/pages/contact">Contact</a>
  </nav>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "header", "content": "Split nav around a centered logo. Leave menus empty to use built-in defaults." },
    { "type": "link_list", "id": "menu_left", "label": "Left menu" },
    { "type": "link_list", "id": "menu_right", "label": "Right menu" }
  ]
}
{% endschema %}
