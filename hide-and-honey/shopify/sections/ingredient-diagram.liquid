<section class="section">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="diagram__grid">
      {%- assign arts = 'hh-cow.svg,hh-honeycomb.svg,hh-bee.svg,hh-olive.svg' | split: ',' -%}
      <div class="diagram__jar reveal">
        {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 600 }}" alt="">{%- else -%}<img src="{{ 'hh-jar.svg' | asset_url }}" alt="">{%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- assign art = arts[block.settings.art_index] -%}
        <div class="node n{{ block.settings.slot }} reveal" {{ block.shopify_attributes }}>
          <h4>
            {%- if block.settings.slot == 3 or block.settings.slot == 4 -%}
              {{ block.settings.name }} <span class="pct">{{ block.settings.pct }}</span><img src="{{ art | asset_url }}" alt="">
            {%- else -%}
              <img src="{{ art | asset_url }}" alt="">{{ block.settings.name }} <span class="pct">{{ block.settings.pct }}</span>
            {%- endif -%}
          </h4>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredient diagram",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Center image (defaults to bundled jar)" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Open the jar" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You can read every word." }
  ],
  "blocks": [
    { "type": "node", "name": "Ingredient", "settings": [
      { "type": "range", "id": "slot", "label": "Position (1=top-left, 2=bottom-left, 3=top-right, 4=bottom-right)", "min": 1, "max": 4, "step": 1, "default": 1 },
      { "type": "range", "id": "art_index", "label": "Illustration (0 cow, 1 honey, 2 bee, 3 olive)", "min": 0, "max": 3, "step": 1, "default": 0 },
      { "type": "text", "id": "name", "label": "Name", "default": "Beef Tallow" },
      { "type": "text", "id": "pct", "label": "Percentage", "default": "50%" },
      { "type": "text", "id": "text", "label": "Text", "default": "Grass-fed & bioidentical — nourishes deeply." }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Ingredient diagram", "blocks": [
      { "type": "node", "settings": { "slot": 1, "art_index": 0, "name": "Beef Tallow", "pct": "50%", "text": "Grass-fed & bioidentical — nourishes deeply." } },
      { "type": "node", "settings": { "slot": 2, "art_index": 1, "name": "Raw Honey", "pct": "25%", "text": "A humectant that locks moisture in." } },
      { "type": "node", "settings": { "slot": 3, "art_index": 2, "name": "Beeswax", "pct": "15%", "text": "A breathable, protective seal." } },
      { "type": "node", "settings": { "slot": 4, "art_index": 3, "name": "Olive Oil", "pct": "10%", "text": "Cold-pressed, vitamin-rich glow." } }
    ] }
  ]
}
{% endschema %}
