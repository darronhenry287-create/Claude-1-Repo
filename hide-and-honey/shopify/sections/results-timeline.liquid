<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="expect">
      {%- for block in section.blocks -%}
        <div class="ecard reveal" {{ block.shopify_attributes }}><span class="when">{{ block.settings.when }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Results timeline",
  "settings": [
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": false },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "What to expect" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real skin takes a few nights." }
  ],
  "blocks": [
    { "type": "stage", "name": "Stage", "settings": [
      { "type": "text", "id": "when", "label": "When", "default": "Night 1" },
      { "type": "text", "id": "title", "label": "Title", "default": "Instantly softer" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Skin drinks it in. Tightness eases and that just-moisturized feel lasts till morning." }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Results timeline", "blocks": [
      { "type": "stage", "settings": { "when": "Night 1", "title": "Instantly softer", "text": "Skin drinks it in. Tightness eases and that just-moisturized feel lasts till morning." } },
      { "type": "stage", "settings": { "when": "Week 2", "title": "Calmer & smoother", "text": "Redness and flaky patches settle. Lips, knuckles and elbows stop cracking." } },
      { "type": "stage", "settings": { "when": "Week 6", "title": "A new baseline", "text": "Your barrier feels resilient and balanced — skin that needs less, not more." } }
    ] }
  ]
}
{% endschema %}
