<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="shelf">
      <div class="shelf__old">
        {%- assign olds = section.settings.replaces | split: ',' -%}
        {%- for o in olds -%}<span class="it">{{ o | strip }}</span>{%- endfor -%}
      </div>
      <div class="shelf__arrow">→</div>
      <div class="shelf__new">
        {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 400 }}" alt="">{%- else -%}<img src="{{ 'hh-jar.svg' | asset_url }}" alt="">{%- endif -%}
        <b>{{ section.settings.new_label }}</b><p class="muted" style="font-size:.9rem">{{ section.settings.new_sub }}</p>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shelf simplified",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": true },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "One jar replaces a shelf" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your bathroom shelf, simplified." },
    { "type": "text", "id": "replaces", "label": "Replaced products (comma separated)", "default": "Day moisturizer, Night cream, Lip balm, Hand cream, Cuticle oil, Body butter, Scar gel" },
    { "type": "text", "id": "new_label", "label": "New label", "default": "One honest jar." },
    { "type": "text", "id": "new_sub", "label": "New sub", "default": "$24 · lasts months" }
  ],
  "presets": [ { "name": "Shelf simplified" } ]
}
{% endschema %}
