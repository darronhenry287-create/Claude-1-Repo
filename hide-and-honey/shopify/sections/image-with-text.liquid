<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap">
    <div class="split {% if section.settings.reverse %}split--rev{% endif %}">
      <div class="split__media reveal">
        {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}">
        {%- else -%}<img src="{{ section.settings.fallback | default: 'hh-jar.svg' | asset_url }}" alt="" style="object-fit:contain;padding:2rem">{%- endif -%}
      </div>
      <div class="split__copy reveal">
        {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 style="margin:.6rem 0 1rem">{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.blocks.size > 0 -%}<ul class="checks">{%- for b in section.blocks -%}<li {{ b.shopify_attributes }}><span class="ck">{% render 'icon', name: 'check' %}</span>{{ b.settings.text }}</li>{%- endfor -%}</ul>{%- endif -%}
        {%- if section.settings.button_text != blank -%}<a href="{{ section.settings.button_link }}" class="btn btn-ink btn-lg" style="margin-top:1.8rem">{{ section.settings.button_text }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback", "label": "Fallback bundled asset", "default": "hh-jar.svg" },
    { "type": "checkbox", "id": "reverse", "label": "Reverse", "default": false },
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": false },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "No water. No synthetics." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your moisturizer is mostly water." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Flip over a typical cream and the first ingredient is water. Ours is pure, concentrated nourishment that actually stays.</p>" },
    { "type": "text", "id": "button_text", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [ { "type": "check", "name": "Checklist item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Bioidentical to your skin's own sebum" } ] } ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
