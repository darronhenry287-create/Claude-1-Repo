<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap faq">
    <div class="center" style="margin-bottom:2.5rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="acc">
      {%- for block in section.blocks -%}
        <div class="acc__item" {{ block.shopify_attributes }}>
          <button class="acc__head">{{ block.settings.q }} <span class="pm">+</span></button>
          <div class="acc__body"><div class="acc__body-inner">{{ block.settings.a }}</div></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": false },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered." }
  ],
  "blocks": [
    { "type": "qa", "name": "Q&A", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "Does it smell like beef?" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>Not at all. Our tallow is triple-rendered and purified, so the Unscented balm is virtually scentless.</p>" }
    ] }
  ],
  "presets": [
    { "name": "FAQ", "blocks": [
      { "type": "qa", "settings": { "q": "Does it smell like beef?", "a": "<p>Not at all. Our tallow is triple-rendered and purified, so the Unscented balm is virtually scentless — just a faint note of honey.</p>" } },
      { "type": "qa", "settings": { "q": "Will it clog my pores?", "a": "<p>Tallow is bioidentical to your skin's own oils, so most people — even oily and acne-prone — find it balancing. Patch-test and start small.</p>" } },
      { "type": "qa", "settings": { "q": "Is the sourcing ethical?", "a": "<p>Our tallow comes from grass-fed, pasture-raised cattle as a byproduct of regenerative farms, and our honey from small apiaries.</p>" } },
      { "type": "qa", "settings": { "q": "What if it doesn't work for me?", "a": "<p>Use it for 90 nights. If your skin isn't happier, email us for a full refund — keep the jar.</p>" } }
    ] }
  ]
}
{% endschema %}
