<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap faq">
    <div class="center" style="margin-bottom:2.5rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="acc">
      {%- for block in section.blocks -%}
        <div class="acc__item" {{ block.shopify_attributes }}>
          <button class="acc__head">{{ block.settings.q }} <span class="pm">+</span></button>
          <div class="acc__body"><div class="acc__body-inner">{{ block.settings.a }}</div></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": false },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered." }
  ],
  "blocks": [
    { "type": "qa", "name": "Q&A", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "Does it have a fragrance?" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>No. LISSE is completely fragrance-free — just a soft, barely-there warmth from the plant actives themselves.</p>" }
    ] }
  ],
  "presets": [
    { "name": "FAQ", "blocks": [
      { "type": "qa", "settings": { "q": "Does it have a fragrance?", "a": "<p>No. LISSE is completely fragrance-free — no synthetic perfume, just a soft, barely-there warmth from the plant actives.</p>" } },
      { "type": "qa", "settings": { "q": "Will it feel greasy?", "a": "<p>Not at all. Weightless squalane and jojoba absorb in seconds, leaving a dry-touch, satin finish — get dressed straight away.</p>" } },
      { "type": "qa", "settings": { "q": "Is it safe during pregnancy?", "a": "<p>LISSE is fragrance-free, non-comedogenic and made for daily use. As with any product during pregnancy, we'd suggest a quick check with your doctor first.</p>" } },
      { "type": "qa", "settings": { "q": "What if it doesn't work for me?", "a": "<p>Use it daily for 90 days. If your skin doesn't look and feel firmer, email us for a full refund — and keep the bottle.</p>" } }
    ] }
  ]
}
{% endschema %}
