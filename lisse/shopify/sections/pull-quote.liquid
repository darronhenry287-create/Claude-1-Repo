<section class="section">
  <div class="wrap pullquote">
    <div class="rte" style="font-family:var(--slab);font-weight:800;font-size:clamp(1.6rem,4vw,2.6rem);line-height:1.2">{{ section.settings.quote }}</div>
    {%- if section.settings.by != blank -%}<div class="by">{{ section.settings.by }}</div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Pull quote",
  "settings": [
    { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>\"I wanted a firming oil I'd actually reach for every morning — clean, fast-absorbing, and honest about what it can do.\"</p>" },
    { "type": "text", "id": "by", "label": "Attribution", "default": "— Camille, founder" }
  ],
  "presets": [ { "name": "Pull quote" } ]
}
{% endschema %}
