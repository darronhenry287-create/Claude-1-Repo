<section class="section">
  <div class="wrap">
    {%- if section.settings.kicker != blank -%}<div class="center" style="margin-bottom:2.5rem"><span class="kicker">{{ section.settings.kicker }}</span></div>{%- endif -%}
    <div class="note__paper reveal">
      <div class="rte">{{ section.settings.body }}</div>
      <span class="note__sig hand">{{ section.settings.signature }}</span>
      <div class="note__role">{{ section.settings.role }}</div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Founder note",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "A note from our founder" },
    { "type": "richtext", "id": "body", "label": "Note", "default": "<p>I tried every firming cream on the shelf. They were either tacky, heavily perfumed, or made of promises and silicone. Nothing I actually wanted to use every day.</p><p>So we made the opposite: a clean, dry-touch oil with real caffeine-rich actives, no synthetic fragrance, and a texture that disappears. Something simple enough to become a daily habit — because consistency is what actually changes how skin looks.</p><p>One bottle. One minute. I hope it becomes your favourite part of the morning.</p>" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Camille" },
    { "type": "text", "id": "role", "label": "Role", "default": "Founder, LISSE" }
  ],
  "presets": [ { "name": "Founder note" } ]
}
{% endschema %}
