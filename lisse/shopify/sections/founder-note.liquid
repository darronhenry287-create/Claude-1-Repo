<section class="section">
  <div class="wrap">
    {%- if section.settings.kicker != blank -%}<div class="center" style="margin-bottom:2.5rem"><span class="kicker">{{ section.settings.kicker }}</span></div>{%- endif -%}
    <div class="note__paper reveal">
      <div class="rte">{{ section.settings.body }}</div>
      <span class="note__sig hand">{{ section.settings.signature }}</span>
      <div class="note__role">{{ section.settings.role }}</div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Founder note",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "A note from our kitchen" },
    { "type": "richtext", "id": "body", "label": "Note", "default": "<p>When I was a kid, my grandmother kept a tin of rendered tallow by the sink. Chapped hands, wind-burned cheeks, scraped knees — it fixed everything.</p><p>Years later I was staring at a shelf full of $60 creams I couldn't pronounce. So I went back to her recipe and never looked back.</p><p>Four ingredients. Nothing else.</p>" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Jess" },
    { "type": "text", "id": "role", "label": "Role", "default": "Founder, Prairie Fat Co." }
  ],
  "presets": [ { "name": "Founder note" } ]
}
{% endschema %}
