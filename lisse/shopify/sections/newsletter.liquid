<section class="section dark cta-band">
  <div class="wrap">
    <span class="kicker">{{ section.settings.kicker }}</span>
    <h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2>
    <p class="lede" style="max-width:460px;margin:.8rem auto 0">{{ section.settings.text }}</p>
    {%- form 'customer', class: 'signup' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="your@email.com" required aria-label="Email">
      <button class="btn btn-honey" type="submit">{{ section.settings.button }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pull up a chair" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first jar." },
    { "type": "text", "id": "text", "label": "Text", "default": "Plus simple skin tips and first dibs on new small batches." },
    { "type": "text", "id": "button", "label": "Button", "default": "Get 10% off" }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
