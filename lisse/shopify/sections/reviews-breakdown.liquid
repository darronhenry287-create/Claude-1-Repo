<section style="background:var(--cream);padding-block:clamp(2.5rem,5vw,4rem)">
  <div class="wrap">
    <div class="rhead">
      <div class="rhead__score"><div class="big">{{ section.settings.score }}</div><div class="stars">★★★★★</div><p class="muted" style="font-weight:700;margin-top:.4rem">{{ section.settings.count }}</p></div>
      <div>
        <div class="rbar"><span>5★</span><div class="rbar__track"><div class="rbar__fill" style="width:{{ section.settings.p5 }}%"></div></div><span>{{ section.settings.p5 }}%</span></div>
        <div class="rbar"><span>4★</span><div class="rbar__track"><div class="rbar__fill" style="width:{{ section.settings.p4 }}%"></div></div><span>{{ section.settings.p4 }}%</span></div>
        <div class="rbar"><span>3★</span><div class="rbar__track"><div class="rbar__fill" style="width:{{ section.settings.p3 }}%"></div></div><span>{{ section.settings.p3 }}%</span></div>
        <div class="rbar"><span>2★</span><div class="rbar__track"><div class="rbar__fill" style="width:{{ section.settings.p2 }}%"></div></div><span>{{ section.settings.p2 }}%</span></div>
        <div class="rbar"><span>1★</span><div class="rbar__track"><div class="rbar__fill" style="width:{{ section.settings.p1 }}%"></div></div><span>{{ section.settings.p1 }}%</span></div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Reviews breakdown",
  "settings": [
    { "type": "text", "id": "score", "label": "Score", "default": "4.9" },
    { "type": "text", "id": "count", "label": "Count", "default": "8,200 reviews" },
    { "type": "range", "id": "p5", "label": "5★ %", "min": 0, "max": 100, "step": 1, "default": 91 },
    { "type": "range", "id": "p4", "label": "4★ %", "min": 0, "max": 100, "step": 1, "default": 6 },
    { "type": "range", "id": "p3", "label": "3★ %", "min": 0, "max": 100, "step": 1, "default": 2 },
    { "type": "range", "id": "p2", "label": "2★ %", "min": 0, "max": 100, "step": 1, "default": 1 },
    { "type": "range", "id": "p1", "label": "1★ %", "min": 0, "max": 100, "step": 1, "default": 0 }
  ],
  "presets": [ { "name": "Reviews breakdown" } ]
}
{% endschema %}
