<section style="background:var(--cream);padding-block:clamp(2.5rem,5vw,4rem)" class="center">
  <div class="wrap"><span class="kicker">Shop all</span><h1 style="margin-top:.7rem">{{ collection.title | default: 'The daily firming ritual.' }}</h1>{%- if collection.description != blank -%}<p class="lede" style="max-width:480px;margin:1rem auto 0">{{ collection.description }}</p>{%- endif -%}</div>
</section>
<section class="section">
  <div class="wrap">
    {%- if collection != blank and collection.products_count > 0 -%}
      <p class="muted" style="font-weight:600;margin-bottom:1.5rem">{{ collection.products_count }} products</p>
      {%- paginate collection.products by 12 -%}
      <div class="grid products" style="grid-template-columns:repeat(3,1fr)">
        {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="center" style="margin-top:3rem">{{ paginate | default_pagination }}</div>{%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <p class="muted center" style="padding-block:1rem">No products to show here yet. In the theme editor, assign a collection to this section to display its products.</p>
    {%- endif -%}
  </div>
</section>
{% schema %}{ "name": "Collection", "settings": [] }{% endschema %}
