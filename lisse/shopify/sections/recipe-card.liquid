<section class="section">
  <div class="wrap">
    <div class="recipe__card reveal">
      <h3>{{ section.settings.title }}</h3>
      <p class="recipe__sub">{{ section.settings.sub }}</p>
      <div class="recipe__cols">
        <div><h4>Actives</h4><ul>
          {%- assign ing = section.settings.ingredients | newline_to_br | strip_newlines | split: '<br />' -%}
          {%- for i in ing -%}{%- if i != blank -%}<li>{{ i | strip }}</li>{%- endif -%}{%- endfor -%}
        </ul></div>
        <div><h4>Base &amp; carriers</h4><ol>
          {%- assign met = section.settings.method | newline_to_br | strip_newlines | split: '<br />' -%}
          {%- for m in met -%}{%- if m != blank -%}<li>{{ m | strip }}</li>{%- endif -%}{%- endfor -%}
        </ol></div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Recipe card",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Inside every bottle" },
    { "type": "text", "id": "sub", "label": "Subtitle", "default": "Fragrance-free · 96% naturally derived" },
    { "type": "textarea", "id": "ingredients", "label": "Actives (one per line)", "default": "Green Coffee\nGuarana\nBitter Orange\nIvy Leaf" },
    { "type": "textarea", "id": "method", "label": "Base & carriers (one per line)", "default": "Squalane\nJojoba\nCaprylic/Capric Triglyceride\nVitamin E" }
  ],
  "presets": [ { "name": "Recipe card" } ]
}
{% endschema %}
