<section class="section">
  <div class="wrap">
    <div class="recipe__card reveal">
      <h3>{{ section.settings.title }}</h3>
      <p class="recipe__sub">{{ section.settings.sub }}</p>
      <div class="recipe__cols">
        <div><h4>Ingredients</h4><ul>
          {%- assign ing = section.settings.ingredients | newline_to_br | strip_newlines | split: '<br />' -%}
          {%- for i in ing -%}{%- if i != blank -%}<li>{{ i | strip }}</li>{%- endif -%}{%- endfor -%}
        </ul></div>
        <div><h4>Method</h4><ol>
          {%- assign met = section.settings.method | newline_to_br | strip_newlines | split: '<br />' -%}
          {%- for m in met -%}{%- if m != blank -%}<li>{{ m | strip }}</li>{%- endif -%}{%- endfor -%}
        </ol></div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Recipe card",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "The Recipe" },
    { "type": "text", "id": "sub", "label": "Subtitle", "default": "Small batch · makes one 60g jar" },
    { "type": "textarea", "id": "ingredients", "label": "Ingredients (one per line)", "default": "30g grass-fed beef tallow\n15g raw wildflower honey\n9g golden beeswax\n6g cold-pressed olive oil" },
    { "type": "textarea", "id": "method", "label": "Method (one per line)", "default": "Gently melt the tallow & beeswax.\nStir in honey & olive oil.\nWhip until cloud-soft & cooled.\nHand-fill, cap, and ship to you." }
  ],
  "presets": [ { "name": "Recipe card" } ]
}
{% endschema %}
