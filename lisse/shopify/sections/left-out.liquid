<section class="section leftout center">
  <div class="wrap">
    <span class="kicker">{{ section.settings.kicker }}</span>
    <h2 style="margin:.8rem 0 0">{{ section.settings.heading }}</h2>
    <ul class="nasties">
      {%- assign items = section.settings.nasties | newline_to_br | strip_newlines | split: '<br />' -%}
      {%- for it in items -%}{%- if it != blank -%}<li>{{ it | strip }}</li>{%- endif -%}{%- endfor -%}
    </ul>
    <p class="lede" style="max-width:520px;margin:0 auto 1rem">{{ section.settings.text }}</p>
    <div class="kept">
      {%- assign kept = section.settings.kept | split: ',' -%}
      {%- for k in kept -%}<span>{{ k | strip }}</span>{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "What we left out",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The honest part" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's not in the bottle." },
    { "type": "textarea", "id": "nasties", "label": "Crossed-out list (one per line)", "default": "Silicones\nMineral oil\nParabens\nSynthetic fragrance\nDrying alcohol\nPhthalates\nDyes\nPEGs\nSulfates\nMicroplastics\nAnimal testing\nEmpty \"firming\" claims" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Just skin-loving botanicals and carrier oils your body actually recognises." },
    { "type": "text", "id": "kept", "label": "Kept ingredients (comma separated)", "default": "Green Coffee, Guarana, Squalane, Jojoba" }
  ],
  "presets": [ { "name": "What we left out" } ]
}
{% endschema %}
