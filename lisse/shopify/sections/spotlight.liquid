<section class="section">
  <div class="wrap">
    <div class="spotlight reveal">
      <div class="stars">★★★★★</div>
      <div class="rte" style="font-family:var(--slab);font-weight:700;font-size:clamp(1.3rem,3vw,1.9rem);line-height:1.3;color:var(--charcoal)">{{ section.settings.quote }}</div>
      <div class="by">{{ section.settings.by }}</div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Review spotlight",
  "settings": [
    { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>\"Eight weeks of one minute a day and my thighs genuinely look smoother and firmer. It absorbs instantly and smells like nothing — I finally have a body oil I actually keep using.\"</p>" },
    { "type": "text", "id": "by", "label": "Attribution", "default": "— Marina L., verified buyer" }
  ],
  "presets": [ { "name": "Review spotlight" } ]
}
{% endschema %}
