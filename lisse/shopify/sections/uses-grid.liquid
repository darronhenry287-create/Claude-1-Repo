<section class="section">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="uses__grid">
      {%- for block in section.blocks -%}
        <div class="use reveal" {{ block.shopify_attributes }}><span class="em">{% render 'icon', name: 'check' %}</span>{{ block.settings.text }}</div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Uses grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Top to toe" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Firm from head to toe." }
  ],
  "blocks": [ { "type": "use", "name": "Use", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Thighs" } ] } ],
  "max_blocks": 12,
  "presets": [
    { "name": "Uses grid", "blocks": [
      { "type": "use", "settings": { "text": "Thighs" } }, { "type": "use", "settings": { "text": "Tummy" } },
      { "type": "use", "settings": { "text": "Upper arms" } }, { "type": "use", "settings": { "text": "Décolleté" } },
      { "type": "use", "settings": { "text": "Post-shower" } }, { "type": "use", "settings": { "text": "After workout" } },
      { "type": "use", "settings": { "text": "Bump-safe" } }, { "type": "use", "settings": { "text": "Everywhere" } }
    ] }
  ]
}
{% endschema %}
