<section class="section">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="diagram__grid">
      <div class="diagram__jar reveal">
        {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="" width="2528" height="1696">{%- else -%}<img src="{{ 'botanicals.png' | asset_url }}" alt="The botanical actives inside LISSE" width="2528" height="1696">{%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        <div class="node n{{ block.settings.slot }} reveal" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.name }} <span class="pct">{{ block.settings.pct }}</span></h4>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredient diagram",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Center image (defaults to bundled botanicals)" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "What's inside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four plant actives that pull their weight." }
  ],
  "blocks": [
    { "type": "node", "name": "Ingredient", "settings": [
      { "type": "range", "id": "slot", "label": "Position (1=top-left, 2=bottom-left, 3=top-right, 4=bottom-right)", "min": 1, "max": 4, "step": 1, "default": 1 },
      { "type": "range", "id": "art_index", "label": "Illustration index (unused)", "min": 0, "max": 3, "step": 1, "default": 0 },
      { "type": "text", "id": "name", "label": "Name", "default": "Green Coffee" },
      { "type": "text", "id": "pct", "label": "Tag", "default": "caffeine" },
      { "type": "text", "id": "text", "label": "Text", "default": "Energises and visibly firms the look of skin." }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Ingredient diagram", "blocks": [
      { "type": "node", "settings": { "slot": 1, "art_index": 0, "name": "Green Coffee", "pct": "caffeine", "text": "Energises and visibly firms the look of skin." } },
      { "type": "node", "settings": { "slot": 2, "art_index": 1, "name": "Guarana", "pct": "+ tone", "text": "A natural caffeine boost to support microcirculation." } },
      { "type": "node", "settings": { "slot": 3, "art_index": 2, "name": "Bitter Orange", "pct": "smooth", "text": "Helps refine and even the look of skin texture." } },
      { "type": "node", "settings": { "slot": 4, "art_index": 3, "name": "Ivy Leaf", "pct": "de-puff", "text": "A classic botanical for a smoother, tighter look." } }
    ] }
  ]
}
{% endschema %}
