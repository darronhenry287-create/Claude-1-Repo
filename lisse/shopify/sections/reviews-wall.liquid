<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %} id="reviews">
  <div class="wrap">
    <div class="wall">
      <div class="wall__score reveal">
        <div class="big">{{ section.settings.score }}</div>
        <div class="stars">★★★★★</div>
        <p>{{ section.settings.count_text }}</p>
      </div>
      <div class="wall__chips">
        {%- for block in section.blocks -%}
          <div class="chip reveal" {{ block.shopify_attributes }}><span class="stars">★★★★★</span><p>"{{ block.settings.quote }}"</p><span class="who">{{ block.settings.name }}</span></div>
        {%- endfor -%}
      </div>
    </div>
    {%- if section.settings.button_text != blank -%}<div class="center" style="margin-top:2.5rem"><a href="{{ section.settings.button_link | default: '/pages/reviews' }}" class="btn btn-outline btn-lg">{{ section.settings.button_text }}</a></div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Reviews wall",
  "settings": [
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": true },
    { "type": "text", "id": "score", "label": "Average score", "default": "4.9" },
    { "type": "text", "id": "count_text", "label": "Count text", "default": "6,400 verified reviews" },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Read all 6,400 reviews" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "Eight weeks in and my thighs genuinely look smoother and firmer." },
      { "type": "text", "id": "name", "label": "Name", "default": "Marina L." }
    ] }
  ],
  "presets": [
    { "name": "Reviews wall", "blocks": [
      { "type": "review", "settings": { "quote": "Eight weeks in and my thighs genuinely look smoother and firmer. And it smells like nothing — I love that.", "name": "Marina L." } },
      { "type": "review", "settings": { "quote": "It actually absorbs. I get dressed straight away — no greasy sheets.", "name": "Priya S." } },
      { "type": "review", "settings": { "quote": "Used it through my whole pregnancy. Skin stayed soft, stretch marks far less visible.", "name": "Hannah W." } },
      { "type": "review", "settings": { "quote": "The one-minute ritual is the only self-care I keep up with.", "name": "Dani R." } }
    ] }
  ]
}
{% endschema %}
