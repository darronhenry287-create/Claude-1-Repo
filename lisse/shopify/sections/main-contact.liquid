<section style="background:var(--cream);padding-block:clamp(2.5rem,5vw,4rem)" class="center"><div class="wrap"><span class="kicker">{{ section.settings.kicker }}</span><h1 style="margin-top:.7rem">{{ page.title | default: 'Talk to a real human.' }}</h1>{%- if section.settings.subtext != blank -%}<p class="lede" style="max-width:480px;margin:1rem auto 0">{{ section.settings.subtext }}</p>{%- endif -%}</div></section>
<section class="section"><div class="wrap form">
  {%- form 'contact' -%}
    {%- if form.posted_successfully? -%}<div class="note-ok">Thanks — we'll write back within one business day.</div>{%- endif -%}
    {%- if form.errors -%}<div class="note-ok" style="background:#f3dcd2;border-color:var(--rust);color:var(--rust)">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label>Name</label><input type="text" name="contact[name]" required></div>
    <div class="field"><label>Email</label><input type="email" name="contact[email]" required></div>
    <div class="field"><label>Message</label><textarea name="contact[body]" required></textarea></div>
    <button class="btn btn-honey btn-lg btn-block" type="submit">Send message</button>
  {%- endform -%}
  {%- if page.content != blank -%}<div class="rte" style="margin-top:2.5rem">{{ page.content }}</div>{%- endif -%}
</div></section>
{% schema %}
{ "name": "Contact form", "settings": [ { "type": "text", "id": "kicker", "label": "Kicker", "default": "Contact" }, { "type": "text", "id": "subtext", "label": "Subtext", "default": "Questions about your skin or your order? We reply within one business day." } ] }
{% endschema %}
