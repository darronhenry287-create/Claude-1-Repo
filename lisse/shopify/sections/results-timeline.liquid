<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="expect">
      {%- for block in section.blocks -%}
        <div class="ecard reveal" {{ block.shopify_attributes }}><span class="when">{{ block.settings.when }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Results timeline",
  "settings": [
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": false },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "What to expect" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Firmer skin is a habit, not a miracle." }
  ],
  "blocks": [
    { "type": "stage", "name": "Stage", "settings": [
      { "type": "text", "id": "when", "label": "When", "default": "Week 1" },
      { "type": "text", "id": "title", "label": "Title", "default": "Softer & hydrated" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Skin feels instantly nourished and looks healthier. The dry-touch finish wins you over fast." }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Results timeline", "blocks": [
      { "type": "stage", "settings": { "when": "Week 1", "title": "Softer & hydrated", "text": "Skin feels instantly nourished and looks healthier. The dry-touch finish wins you over fast." } },
      { "type": "stage", "settings": { "when": "Week 4", "title": "Smoother to the touch", "text": "With daily massage, skin looks more even and the appearance of dimpling begins to soften." } },
      { "type": "stage", "settings": { "when": "Week 8", "title": "Visibly firmer", "text": "The look of tone and bounce is clearer — the result of one minute, done consistently." } }
    ] }
  ]
}
{% endschema %}
