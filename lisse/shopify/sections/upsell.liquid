<section class="section">
  <div class="wrap">
    {%- assign up_product = section.settings.product | default: product -%}
    {%- assign up_qty = section.settings.quantity | default: 3 -%}
    {%- assign up_variant = up_product.selected_or_first_available_variant -%}
    <div class="upsell reveal">
      <div><span class="kicker" style="color:var(--honey)">{{ section.settings.kicker }}</span><h3 style="margin-top:.5rem">{{ section.settings.heading }}</h3><p>{{ section.settings.text }}</p></div>
      {%- if section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn-honey btn-lg">{{ section.settings.button_text }}</a>
      {%- elsif up_variant -%}
        <a href="{{ routes.cart_url }}" class="btn btn-honey btn-lg" data-bundle-add="{{ up_variant.id }}" data-bundle-qty="{{ up_qty }}"{% if section.settings.discount_code != blank %} data-bundle-discount="{{ section.settings.discount_code | escape }}"{% endif %}>{{ section.settings.button_text }}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-honey btn-lg">{{ section.settings.button_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Bundle upsell",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Stock up & save" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make it a 3-bottle ritual, save 20%." },
    { "type": "text", "id": "text", "label": "Text", "default": "One for the bathroom, one for your bag, one to gift. Free shipping included." },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Get 3 bottles · $120" },
    { "type": "product", "id": "product", "label": "Bundle product", "info": "Which product the button adds. Defaults to the current product page." },
    { "type": "number", "id": "quantity", "label": "Quantity to add", "default": 3 },
    { "type": "text", "id": "discount_code", "label": "Discount code", "info": "Optional — auto-applied at the cart. Create the matching code under Discounts (e.g. a 20% off / 3-bottle code)." },
    { "type": "url", "id": "button_link", "label": "Custom button link", "info": "Leave blank to add to cart. Set a URL to override that behaviour." }
  ],
  "presets": [ { "name": "Bundle upsell" } ]
}
{% endschema %}
