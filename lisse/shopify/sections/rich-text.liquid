<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap" style="max-width:{{ section.settings.width }}px">
    {%- if section.settings.kicker != blank -%}<div class="{% if section.settings.center %}center{% endif %}" style="margin-bottom:1.4rem"><span class="kicker">{{ section.settings.kicker }}</span></div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="{% if section.settings.center %}center{% endif %}" style="margin-bottom:1.2rem">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte {% if section.settings.lede %}lede{% endif %}">{{ section.settings.content }}</div>
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": false },
    { "type": "checkbox", "id": "center", "label": "Center headings", "default": false },
    { "type": "checkbox", "id": "lede", "label": "Large text", "default": false },
    { "type": "range", "id": "width", "label": "Max width", "min": 560, "max": 1000, "step": 20, "unit": "px", "default": 760 },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add your content here.</p>" }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
