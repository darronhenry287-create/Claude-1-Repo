<section class="section texture">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="texture__grid">
      {%- for block in section.blocks -%}
        <div class="t reveal" {{ block.shopify_attributes }}><span class="hand">{{ block.settings.word }}</span><p>{{ block.settings.text }}</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Texture band",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The feel" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dry-touch, never greasy." }
  ],
  "blocks": [ { "type": "feel", "name": "Descriptor", "settings": [ { "type": "text", "id": "word", "label": "Word", "default": "Silky" }, { "type": "textarea", "id": "text", "label": "Text", "default": "A weightless oil that glides on and melts into skin the moment it touches." } ] } ],
  "max_blocks": 4,
  "presets": [ { "name": "Texture band", "blocks": [
    { "type": "feel", "settings": { "word": "Silky", "text": "A weightless oil that glides on and melts into skin the moment it touches." } },
    { "type": "feel", "settings": { "word": "Fast", "text": "Squalane & jojoba absorb in seconds — dress straight away, no greasy film." } },
    { "type": "feel", "settings": { "word": "Clean", "text": "Fragrance-free and non-comedogenic. Just a soft, barely-there warmth." } }
  ] } ]
}
{% endschema %}
