<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="rmasonry">
      {%- for block in section.blocks -%}
        <div class="chip reveal" {{ block.shopify_attributes }}><span class="stars">★★★★★</span><p>"{{ block.settings.quote }}"</p><span class="who">{{ block.settings.who }}</span></div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_text != blank -%}<div class="center" style="margin-top:3rem"><a href="{{ section.settings.button_link | default: '/products/firming-body-oil' }}" class="btn btn-honey btn-lg">{{ section.settings.button_text }}</a></div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Reviews masonry",
  "settings": [
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": true },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Straight from the bottle owners" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "6,400 and counting." },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Shop the Oil · $48" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [ { "type": "review", "name": "Review", "settings": [ { "type": "textarea", "id": "quote", "label": "Quote", "default": "Eight weeks in and my thighs look smoother and firmer." }, { "type": "text", "id": "who", "label": "Who", "default": "Marina L. · Thighs" } ] } ],
  "max_blocks": 16,
  "presets": [ { "name": "Reviews masonry", "blocks": [
    { "type": "review", "settings": { "quote": "Eight weeks in and my thighs genuinely look smoother and firmer. And it smells like nothing — I love that.", "who": "Marina L. · Thighs" } },
    { "type": "review", "settings": { "quote": "It actually absorbs. I get dressed straight away — no greasy sheets, no waiting around.", "who": "Priya S. · Post-workout" } },
    { "type": "review", "settings": { "quote": "Used it through my whole pregnancy. Skin stayed soft and my stretch marks are far less visible.", "who": "Hannah W. · Post-partum" } },
    { "type": "review", "settings": { "quote": "The one-minute ritual is the only self-care I keep up with. My skin has never looked better.", "who": "Dani R. · Daily" } },
    { "type": "review", "settings": { "quote": "Fragrance-free and it sinks right in. A little goes a long way — one bottle lasts weeks.", "who": "Amara L. · Sensitive" } },
    { "type": "review", "settings": { "quote": "My tummy looks noticeably firmer and more even. So glad I stuck with it daily.", "who": "Sofia T. · Tummy" } }
  ] } ]
}
{% endschema %}
