<section class="section">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="timeline">
      {%- for block in section.blocks -%}
        <div class="tline reveal" {{ block.shopify_attributes }}><div class="yr">{{ block.settings.year }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Story timeline",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How we got here" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A slow, honest road." }
  ],
  "blocks": [ { "type": "milestone", "name": "Milestone", "settings": [
    { "type": "text", "id": "year", "label": "Year", "default": "The itch" },
    { "type": "text", "id": "title", "label": "Title", "default": "A shelf of empty promises" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Camille tried every firming cream going. They were tacky, heavily perfumed, or made of silicone — never something to use daily." }
  ] } ],
  "max_blocks": 6,
  "presets": [ { "name": "Story timeline", "blocks": [
    { "type": "milestone", "settings": { "year": "The itch", "title": "A shelf of empty promises", "text": "Camille tried every firming cream going. They were tacky, heavily perfumed, or made of silicone — never something to use daily." } },
    { "type": "milestone", "settings": { "year": "The formula", "title": "Caffeine that pulls its weight", "text": "We paired green coffee and guarana with squalane and jojoba — real actives in a dry-touch base, no synthetic fragrance." } },
    { "type": "milestone", "settings": { "year": "The texture", "title": "An oil that disappears", "text": "Batch after batch we chased one feel: weightless, fast-absorbing, satin-soft — never a greasy film." } },
    { "type": "milestone", "settings": { "year": "Today", "title": "6,400 firmer mornings", "text": "One bottle, one minute, every day — and a lot more people who actually keep up their ritual." } }
  ] } ]
}
{% endschema %}
