<section class="section">
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="timeline">
      {%- for block in section.blocks -%}
        <div class="tline reveal" {{ block.shopify_attributes }}><div class="yr">{{ block.settings.year }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Story timeline",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How we got here" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A slow, honest road." }
  ],
  "blocks": [ { "type": "milestone", "name": "Milestone", "settings": [
    { "type": "text", "id": "year", "label": "Year", "default": "'94" },
    { "type": "text", "id": "title", "label": "Title", "default": "The tin by the sink" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Grandma kept rendered tallow by the kitchen sink — for chapped hands and wind-burned cheeks. It fixed everything." }
  ] } ],
  "max_blocks": 6,
  "presets": [ { "name": "Story timeline", "blocks": [
    { "type": "milestone", "settings": { "year": "'94", "title": "The tin by the sink", "text": "Grandma kept rendered tallow by the kitchen sink — for chapped hands, wind-burned cheeks, scraped knees." } },
    { "type": "milestone", "settings": { "year": "2021", "title": "47 messy batches", "text": "Staring at a shelf of $60 creams we couldn't pronounce, we went back to her recipe and whipped it 47 times." } },
    { "type": "milestone", "settings": { "year": "2022", "title": "The first 100 jars", "text": "We hand-filled a hundred jars at the kitchen table and gave them to friends. They came back for more." } },
    { "type": "milestone", "settings": { "year": "Today", "title": "8,200 happy faces", "text": "Same four ingredients. Same small batches. Just a lot more sinks with a jar beside them." } }
  ] } ]
}
{% endschema %}
