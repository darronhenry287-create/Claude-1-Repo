<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap">
    <div class="center" style="margin-bottom:3.5rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <ol class="journey__line">
      {%- for block in section.blocks -%}
        <li class="jstep reveal" {{ block.shopify_attributes }}>
          <div class="jstep__ic"><span class="n" style="font-family:var(--slab);font-style:italic;font-size:1.7rem;color:var(--honey-deep)">{{ forloop.index }}</span></div>
          <h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{
  "name": "Journey timeline",
  "settings": [
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": false },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Sixty seconds" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your 60-second ritual" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "range", "id": "art_index", "label": "Step number is shown automatically", "min": 0, "max": 4, "step": 1, "default": 0 },
      { "type": "text", "id": "title", "label": "Title", "default": "Warm" },
      { "type": "text", "id": "text", "label": "Text", "default": "Press 4–6 drops between your palms." }
    ] }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Journey timeline", "blocks": [
      { "type": "step", "settings": { "art_index": 0, "title": "Warm", "text": "Press 4–6 drops between your palms." } },
      { "type": "step", "settings": { "art_index": 1, "title": "Massage", "text": "Sweep upward over thighs, tummy & arms." } },
      { "type": "step", "settings": { "art_index": 2, "title": "Absorb", "text": "It sinks in fast — dress straight away." } },
      { "type": "step", "settings": { "art_index": 3, "title": "Glow", "text": "Repeat daily for a firmer-looking finish." } }
    ] }
  ]
}
{% endschema %}
