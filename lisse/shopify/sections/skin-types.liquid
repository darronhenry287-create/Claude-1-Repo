<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap center">
    <span class="kicker">{{ section.settings.kicker }}</span>
    <h2 style="margin:.7rem 0 2rem">{{ section.settings.heading }}</h2>
    <div class="skintypes">
      {%- assign types = section.settings.types | split: ',' -%}
      {%- for t in types -%}<span class="skintype"><span class="ck">{% render 'icon', name: 'check' %}</span>{{ t | strip }}</span>{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Skin types",
  "settings": [
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": true },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Made for every body" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every skin tone, every stage." },
    { "type": "text", "id": "types", "label": "Types (comma separated)", "default": "Dry & dehydrated, Post-partum, Mature, Sensitive, All tones" }
  ],
  "presets": [ { "name": "Skin types" } ]
}
{% endschema %}
