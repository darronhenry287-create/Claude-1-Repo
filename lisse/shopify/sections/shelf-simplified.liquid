<section class="section" {% if section.settings.bg %}style="background:var(--cream)"{% endif %}>
  <div class="wrap">
    <div class="center" style="margin-bottom:3rem"><span class="kicker">{{ section.settings.kicker }}</span><h2 style="margin-top:.7rem">{{ section.settings.heading }}</h2></div>
    <div class="shelf">
      <div class="shelf__old">
        {%- assign olds = section.settings.replaces | split: ',' -%}
        {%- for o in olds -%}<span class="it">{{ o | strip }}</span>{%- endfor -%}
      </div>
      <div class="shelf__arrow">→</div>
      <div class="shelf__new">
        {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 400 }}" alt="" width="1856" height="2304">{%- else -%}<img src="{{ 'product-hero.png' | asset_url }}" alt="LISSE Firming Body Oil" width="1856" height="2304">{%- endif -%}
        <b>{{ section.settings.new_label }}</b><p class="muted" style="font-size:.9rem">{{ section.settings.new_sub }}</p>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shelf simplified",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "checkbox", "id": "bg", "label": "Cream background", "default": true },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "One bottle, every step" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Replaces the whole firming shelf." },
    { "type": "text", "id": "replaces", "label": "Replaced products (comma separated)", "default": "Firming cream, Body lotion, Tightening serum, Stretch-mark oil, Cellulite gel, Bust cream" },
    { "type": "text", "id": "new_label", "label": "New label", "default": "One clean oil." },
    { "type": "text", "id": "new_sub", "label": "New sub", "default": "$48 · lasts 4–6 weeks" }
  ],
  "presets": [ { "name": "Shelf simplified" } ]
}
{% endschema %}
