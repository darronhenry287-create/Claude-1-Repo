<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0,maximum-scale=1.0"><title>{{ shop.name }} — Gift Card</title>{{ 'theme.css' | asset_url | stylesheet_tag }}<style>:root{--paper:{{ settings.color_paper }};--honey:{{ settings.color_honey }};--ink:{{ settings.color_ink }};--charcoal:{{ settings.color_charcoal }};}</style></head>
<body class="template-gift-card"><section class="section center"><div class="wrap" style="max-width:480px">
  <span class="logo">{{ settings.logo_text | default: shop.name }}</span>
  <span class="kicker" style="display:block;margin-top:1.5rem">Gift card</span>
  <h1 style="margin:.6rem 0 1.5rem">{{ gift_card.balance | money }}</h1>
  <div style="background:var(--charcoal);border-radius:var(--r-lg);padding:2.5rem 1.5rem;color:var(--cream)">
    <p class="hand" style="font-size:1.6rem;color:var(--honey)">A little bottle of firmer skin.</p>
    <div style="background:#fff;display:inline-block;padding:1rem;border-radius:12px;margin-top:1.5rem"><img src="{{ gift_card | qr_url }}" alt="QR" width="120" height="120"></div>
  </div>
  <p class="muted" style="margin-top:1.5rem;font-weight:700">Gift card code</p>
  <div class="tag tag-honey" style="font-size:1rem;letter-spacing:.1em;margin:.6rem 0 1.5rem">{{ gift_card.code | format_code }}</div>
  <p><a href="{{ shop.url }}" class="btn btn-honey btn-lg">Shop LISSE</a></p>
</div></section><script src="{{ 'theme.js' | asset_url }}" defer></script></body></html>
