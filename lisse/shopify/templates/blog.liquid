<section style="background:var(--cream);padding-block:clamp(2.5rem,5vw,4rem)" class="center"><div class="wrap"><span class="kicker">The Journal</span><h1 style="margin-top:.7rem">{{ blog.title }}</h1></div></section>
<section class="section"><div class="wrap">{%- paginate blog.articles by 12 -%}<div class="grid products" style="grid-template-columns:repeat(3,1fr)">
  {%- for article in blog.articles -%}
    <a href="{{ article.url }}" class="card reveal"><div class="card__media">{%- if article.image -%}<img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" width="600" height="600">{%- else -%}<img src="{{ 'hh-honeycomb.svg' | asset_url }}" alt="" width="600" height="600">{%- endif -%}</div><div class="card__body"><h3 class="card__title">{{ article.title }}</h3><div class="card__rev">{{ article.published_at | date: '%B %-d, %Y' }}</div></div></a>
  {%- else -%}<p>No posts yet.</p>{%- endfor -%}
</div>{%- if paginate.pages > 1 -%}<div class="center" style="margin-top:3rem">{{ paginate | default_pagination }}</div>{%- endif -%}{%- endpaginate -%}</div></section>
