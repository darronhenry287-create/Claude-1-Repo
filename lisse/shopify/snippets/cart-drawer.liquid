<div class="overlay" id="overlay"></div>
<aside class="drawer" id="drawer" aria-label="{{ 'accessibility.cart' | t }}">
  <div class="drawer__head"><h3>{{ 'cart.title' | t }}</h3><button class="iconbtn" data-action="close-cart" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button></div>
  <div class="drawer__body" id="cart-body">
    {%- if cart.item_count > 0 -%}
      {%- for item in cart.items -%}
        <div class="ditem">
          <div class="ditem__thumb">{%- if item.image -%}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" style="width:100%;height:100%;object-fit:cover">{%- endif -%}</div>
          <div class="ditem__info">
            <h4>{{ item.product.title }}</h4>
            <div class="v">{{ item.variant.title | remove: 'Default Title' }}</div>
            <div class="ditem__foot"><span class="dqty">{{ item.quantity }} ×</span><strong>{{ item.final_line_price | money }}</strong></div>
            <a class="drm" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="dempty"><p>{{ 'cart.empty' | t }}</p><p style="margin-top:.4rem">Your firming ritual starts here.</p></div>
    {%- endif -%}
  </div>
  {%- if cart.item_count > 0 -%}
    <div class="drawer__foot" id="cart-foot">
      <div class="freebar" id="freebar" data-threshold="{{ settings.free_ship_threshold }}" data-total="{{ cart.total_price | divided_by: 100.0 }}"></div>
      <div class="dsub"><span>{{ 'cart.subtotal' | t }}</span><span id="cart-sub">{{ cart.total_price | money }}</span></div>
      <p class="dnote">{{ 'cart.taxes_note' | t }}</p>
      <a href="{{ routes.cart_url }}" class="btn btn-honey btn-block btn-lg">{{ 'cart.checkout' | t }}</a>
    </div>
  {%- endif -%}
</aside>
