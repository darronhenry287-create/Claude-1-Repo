<section class="section night center" style="min-height:100vh;display:grid;place-items:center">
  <div class="wrap" style="max-width:520px;position:relative">
    <span class="logo" style="font-size:2rem;letter-spacing:.2em;color:var(--white)">{{ settings.logo_text | default: shop.name }}</span>
    <h1 style="margin:1.5rem 0 1rem;color:var(--white)">{{ page_title | default: 'Coming soon' }}</h1>
    <p class="lede" style="margin-bottom:2rem">{{ shop.password_message | default: 'Sleep, engineered. Our store is opening soon — join the list to be the first in.' }}</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="signup">
        <input type="password" name="password" placeholder="Enter store password" aria-label="Store password" required>
        <button type="submit" class="btn btn-clay">Enter</button>
      </div>
    {%- endform -%}

    <p class="form__note" style="margin-top:2rem;color:rgba(233,228,242,.7)">Are you the store owner? <a href="/admin" style="color:var(--clay)">Log in here</a>.</p>
  </div>
</section>
