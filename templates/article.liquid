<article class="section">
  <div class="wrap" style="max-width:760px">
    <div class="center" style="margin-bottom:2.5rem">
      <span class="eyebrow">{{ article.published_at | date: '%B %-d, %Y' }}</span>
      <h1 style="margin-top:.8rem">{{ article.title }}</h1>
      {%- if article.author != blank -%}<p class="muted" style="margin-top:.6rem">By {{ article.author }}</p>{%- endif -%}
    </div>

    {%- if article.image -%}
      <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" style="border-radius:var(--radius-lg);margin-bottom:2.5rem">
    {%- endif -%}

    <div class="rte lede">{{ article.content }}</div>

    {%- if blog.comments_enabled? -%}
      <div style="margin-top:3rem">
        <h3 style="margin-bottom:1.5rem">{{ article.comments_count }} comments</h3>
        {%- for comment in article.comments -%}
          <div style="border-bottom:1px solid var(--line);padding-bottom:1.2rem;margin-bottom:1.2rem">
            <p>{{ comment.content }}</p>
            <p class="muted" style="font-size:.82rem;margin-top:.5rem">— {{ comment.author }}, {{ comment.created_at | date: '%b %-d, %Y' }}</p>
          </div>
        {%- endfor -%}

        {%- form 'new_comment', article -%}
          {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
          {%- if form.posted_successfully? -%}<div class="note-success">Thanks — your comment is awaiting moderation.</div>{%- endif -%}
          <div class="form" style="max-width:none">
            <div class="field"><label>Name</label><input type="text" name="comment[author]" required></div>
            <div class="field"><label>Email</label><input type="email" name="comment[email]" required></div>
            <div class="field"><label>Comment</label><textarea name="comment[body]" required></textarea></div>
            <button type="submit" class="btn btn-clay">Post comment</button>
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}

    <p style="margin-top:3rem"><a href="{{ blog.url }}" class="form__note">← Back to the Journal</a></p>
  </div>
</article>
