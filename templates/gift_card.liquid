<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title>{{ shop.name }} — Gift Card</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>:root{--bone:{{ settings.color_bg }};--ink:{{ settings.color_text }};--clay:{{ settings.color_accent }};}</style>
</head>
<body class="template-gift-card">
  <section class="section center">
    <div class="wrap" style="max-width:480px">
      <span class="logo" style="font-size:1.6rem;letter-spacing:.2em">{{ settings.logo_text | default: shop.name }}</span>
      <span class="eyebrow" style="display:block;margin-top:1.5rem">Gift card</span>
      <h1 style="margin:.6rem 0 1.5rem">{{ gift_card.balance | money }}</h1>

      <div style="background:linear-gradient(160deg,var(--twilight-2),var(--twilight-1));border-radius:var(--radius-lg);padding:2.5rem 1.5rem;color:var(--moon);margin-bottom:1.5rem">
        <p style="font-family:var(--serif);font-size:1.4rem">Strength, on us.</p>
        <div style="background:#fff;display:inline-block;padding:1rem;border-radius:12px;margin-top:1.5rem">
          {{ gift_card.qr_identifier }}
          <img src="{{ gift_card | qr_url }}" alt="QR code" width="120" height="120">
        </div>
      </div>

      <p class="form__note">Gift card code</p>
      <div class="pill" style="font-size:1rem;letter-spacing:.1em;margin:.6rem 0 1.5rem">{{ gift_card.code | format_code }}</div>

      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="btn btn-ghost">Add to Apple Wallet</a>
      {%- endif -%}
      <p style="margin-top:1.5rem"><a href="{{ shop.url }}" class="btn btn-clay btn-lg">Shop CREO</a></p>
    </div>
  </section>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
