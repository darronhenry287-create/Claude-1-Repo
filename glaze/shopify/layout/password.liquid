<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-password">
  <main id="main" class="section center">
    <div class="wrap wrap--narrow">
      <span class="logo" style="font-size:2.4rem">GLAZE</span>
      <h1 style="margin-top:1rem">Coming soon.</h1>
      <p class="lede" style="margin-top:.6rem">The glazed-skin shop is almost ready.</p>
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <div class="signup" style="margin-top:1.6rem">
          <input type="password" name="password" placeholder="Enter password" aria-label="Password">
          <button class="btn btn-pink" type="submit">Enter</button>
        </div>
      {% endform %}
    </div>
  </main>
</body>
</html>
