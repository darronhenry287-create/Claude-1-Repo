<section class="hero">
    <div class="hero__inner">
      <div class="hero__copy">
        <span class="kicker">New · the pink glow balm</span>
        <h1>{{ section.settings.heading }}</h1>
        <p class="hero__lede lede">Meet the <strong>Pink Collagen Glow Balm</strong> — salmon-DNA PDRN, collagen and plumping peptides in a mess-free stick that leaves skin plump, dewy and glazed anywhere you swipe it.</p>
        <div class="hero__cta">
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-pink btn-lg">{{ section.settings.button_label }}</a>
          <a href="/pages/how-to" class="btn btn-outline btn-lg">See how it works</a>
        </div>
        <div class="hero__meta"><span class="stars">★★★★★</span> <b>4.9</b>/5 from early reviewers · <b>from $18</b></div>
        <div class="hero__pills"><span>Salmon PDRN</span><span>Collagen + peptides</span><span>Glides on, no mess</span><span>Cruelty-free</span></div>
      </div>
      <div class="hero__visual">
        <div class="hero__frame has-photo"><img src="{{ 'model-hero.jpg' | asset_url }}" alt="Model with glazed glowing skin holding the Pink Collagen Glow Balm" width="1080" height="1350"></div>
      </div>
    </div>
  </section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Glazed skin,<br>in one <em>swipe</em>." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the balm" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
