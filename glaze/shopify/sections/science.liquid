<section class="science section">
    <div class="wrap">
      <div class="science__grid">
        <div class="science__visual has-photo reveal"><img src="{{ 'flatlay.jpg' | asset_url }}" alt="The balm with its key ingredients" width="1024" height="1024"></div>
        <div>
          <div class="sec-head" style="margin-bottom:1.6rem">
            <span class="kicker">The pink science</span>
            <h2>{{ section.settings.heading }}</h2>
            <p class="lede">It's PDRN — fragments of salmon DNA that are remarkably compatible with skin — teamed with collagen and plumping peptides for that glazed, cushioned look.</p>
          </div>
          <div class="actives">
            <div class="active"><span class="active__name">Salmon PDRN <small>DNA fragments that support a stronger, more resilient barrier</small></span><span class="active__role">Repair</span></div>
            <div class="active"><span class="active__name">Collagen + Peptides <small>Help skin look visibly plumper and more cushioned</small></span><span class="active__role">Plump</span></div>
            <div class="active"><span class="active__name">Hyaluronic Acid <small>Draws in water for a dewy, bouncy finish</small></span><span class="active__role">Hydrate</span></div>
            <div class="active"><span class="active__name">Caffeine + Vitamin E <small>Brighten the look of tired, puffy under-eyes</small></span><span class="active__role">Brighten</span></div>
          </div>
          {% render 'navlink', handle: 'ingredients', label: 'See the full ingredient list', classes: 'tlink', styles: 'margin-top:1.6rem;display:inline-block' %}
        </div>
      </div>
    </div>
  </section>
{% schema %}
{
  "name": "Science",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why the pink?" }
  ],
  "presets": [ { "name": "Science" } ]
}
{% endschema %}
