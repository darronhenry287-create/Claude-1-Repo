<section class="section">
    <div class="wrap">
      <div class="sec-head center">
        <span class="kicker" style="justify-content:center">How to glaze</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="grid steps__grid">
        <div class="step reveal"><div class="n">1</div><h3>Swipe</h3><p>Glide the balm directly onto clean skin or right over makeup.</p><div class="when">Anytime</div></div>
        <div class="step reveal"><div class="n">2</div><h3>Pat</h3><p>Tap in with a fingertip wherever you want extra plump and glow.</p><div class="when">AM · PM</div></div>
        <div class="step reveal"><div class="n">3</div><h3>Glow</h3><p>Watch it melt in to a dewy, glazed, never-greasy finish.</p><div class="when">Instantly</div></div>
      </div>
      {%- if section.settings.button_link != blank -%}
        <div class="center" style="margin-top:2.5rem"><a href="{{ section.settings.button_link }}" class="btn btn-soft">{{ section.settings.button_label }}</a></div>
      {%- elsif pages['how-to'] != blank -%}
        <div class="center" style="margin-top:2.5rem"><a href="{{ pages['how-to'].url }}" class="btn btn-soft">{{ section.settings.button_label }}</a></div>
      {%- endif -%}
    </div>
  </section>
{% schema %}
{
  "name": "Steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps. Five seconds." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Full how-to guide" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Steps" } ]
}
{% endschema %}
