<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <span class="logo">{% render 'brandlogo' %}</span>
        <p>{{ section.settings.blurb }}</p>
        {%- if section.settings.show_social -%}
        <div style="display:flex;gap:1rem;margin-top:1rem">
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" class="tlink" style="color:var(--pink-soft);border:none">TikTok</a>{%- endif -%}
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" class="tlink" style="color:var(--pink-soft);border:none">Instagram</a>{%- endif -%}
        </div>
        {%- endif -%}
      </div>
      <div class="footer__col"><h4>Shop</h4>
        <a href="{{ routes.all_products_collection_url }}">The Glow Balm</a>
        <a href="{{ routes.all_products_collection_url }}">Multipacks &amp; Save</a>
        {% render 'navlink', handle: 'how-to', label: 'How to Use' %}
      </div>
      <div class="footer__col"><h4>Learn</h4>
        {% render 'navlink', handle: 'ingredients', label: 'Ingredients' %}
        {% render 'navlink', handle: 'reviews', label: 'Reviews' %}
        {% render 'navlink', handle: 'about', label: 'About' %}
        {% render 'navlink', handle: 'faq', label: 'FAQ' %}
      </div>
      <div class="footer__col"><h4>Help</h4>
        {% render 'navlink', handle: 'contact', label: 'Contact' %}
        {% render 'navlink', handle: 'shipping-returns', label: 'Shipping & Returns' %}
        {% render 'navlink', handle: 'refund-policy', label: 'Refund Policy' %}
      </div>
    </div>
    <div class="footer__bot">
      <p>© {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: 'GLAZE' }}. All rights reserved. Made for glazed skin.</p>
      <div class="footer__legal">
        {% render 'navlink', handle: 'privacy-policy', label: 'Privacy' %}
        {% render 'navlink', handle: 'terms-of-service', label: 'Terms' %}
        {% render 'navlink', handle: 'refund-policy', label: 'Refund' %}
        {% render 'navlink', handle: 'shipping-returns', label: 'Shipping' %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "blurb", "label": "Brand blurb", "default": "The glazed-skin shop. One viral-worthy hero: our PDRN Pink Collagen Glow Balm — plump, dewy, glazed skin in a single swipe." },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true }
  ]
}
{% endschema %}
