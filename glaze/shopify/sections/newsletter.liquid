<section class="section news" style="background:linear-gradient(135deg,var(--pink),var(--pink-deep));color:#fff">
    <div class="wrap wrap--narrow">
      <span class="kicker" style="justify-content:center;color:#fff">10% off your first glow</span>
      <h2 style="color:#fff;margin-top:1rem">{{ section.settings.heading }}</h2>
      <p class="lede" style="color:rgba(255,255,255,0.85);max-width:460px;margin:1rem auto 0">Restock alerts, glow tips and the next viral find — straight to your inbox.</p>
      <form class="signup"><input type="email" placeholder="you@email.com" required aria-label="Email"><button class="btn btn-ink" type="submit">{{ section.settings.button_label }}</button></form>
      <p class="news__fine" style="color:rgba(255,255,255,0.7)">By subscribing you agree to our privacy policy. Unsubscribe anytime.</p>
    </div>
  </section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the glazed list." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get 10% off" }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
