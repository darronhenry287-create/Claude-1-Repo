<section class="section" style="background:var(--petal);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="sec-head center">
        <span class="kicker" style="justify-content:center">{{ section.settings.kicker }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="why">
        <div class="why__row why__head"><div>&nbsp;</div><div class="c us">{{ section.settings.col_brand }}</div><div class="c">{{ section.settings.col_other }}</div></div>
        {%- if section.settings.row1_label != blank -%}<div class="why__row"><div>{{ section.settings.row1_label }}</div><div class="c yes">✓</div><div class="c no">✗</div></div>{%- endif -%}
        {%- if section.settings.row2_label != blank -%}<div class="why__row"><div>{{ section.settings.row2_label }}</div><div class="c yes">✓</div><div class="c no">—</div></div>{%- endif -%}
        {%- if section.settings.row3_label != blank -%}<div class="why__row"><div>{{ section.settings.row3_label }}</div><div class="c yes">✓</div><div class="c no">✗</div></div>{%- endif -%}
        {%- if section.settings.row4_label != blank -%}<div class="why__row"><div>{{ section.settings.row4_label }}</div><div class="c yes">✓</div><div class="c no">✗</div></div>{%- endif -%}
        {%- if section.settings.row5_label != blank -%}<div class="why__row"><div>{{ section.settings.row5_label }}</div><div class="c yes">✓</div><div class="c no">—</div></div>{%- endif -%}
      </div>
    </div>
  </section>
{% schema %}
{
  "name": "Why GLAZE",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why GLAZE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not your average balm." },
    { "type": "text", "id": "col_brand", "label": "Brand column header", "default": "GLAZE" },
    { "type": "text", "id": "col_other", "label": "Comparison column header", "default": "Ordinary balms" },
    { "type": "text", "id": "row1_label", "label": "Row 1 label", "default": "PDRN + collagen + peptides" },
    { "type": "text", "id": "row2_label", "label": "Row 2 label", "default": "Plumps & glazes instantly" },
    { "type": "text", "id": "row3_label", "label": "Row 3 label", "default": "Mess-free multi-use stick" },
    { "type": "text", "id": "row4_label", "label": "Row 4 label", "default": "Works over makeup" },
    { "type": "text", "id": "row5_label", "label": "Row 5 label", "default": "No greasy residue" }
  ],
  "presets": [ { "name": "Why GLAZE" } ]
}
{% endschema %}
