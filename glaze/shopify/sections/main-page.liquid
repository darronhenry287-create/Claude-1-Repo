<section class="section">
  <div class="rte wrap">
    {%- if page.content != blank -%}
      {{ page.content }}
    {%- elsif section.settings.body != blank -%}
      {{ section.settings.body }}
    {%- else -%}
      <p>Add this page's content in this section's <strong>Body content</strong> field (theme editor), or in the page editor under Online Store &rarr; Pages.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "settings": [
    { "type": "richtext", "id": "body", "label": "Body content" }
  ]
}
{% endschema %}
