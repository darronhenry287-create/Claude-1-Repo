<section class="showcase">
    <img class="showcase__bg" src="{{ 'model-glow.jpg' | asset_url }}" alt="Model with glazed glowing skin" width="1080" height="1440">
    <div class="showcase__veil"></div>
    <div class="showcase__in">
      <span class="kicker">Your glow, on demand</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>It's one swipe of pink collagen balm — at your desk, in the car, before a night out.</p>
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-pink btn-lg">{{ section.settings.button_label }}</a>
    </div>
  </section>
{% schema %}
{
  "name": "Showcase",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Glazed skin isn't a filter." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get the glow" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Showcase" } ]
}
{% endschema %}
