<section class="showcase">
    {%- if section.settings.image != blank -%}<img class="showcase__bg" src="{{ section.settings.image | image_url: width: 1080 }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" alt="{{ section.settings.image_alt | escape }}">{%- else -%}<img class="showcase__bg" src="{{ 'model-glow.jpg' | asset_url }}" width="1080" height="1440" alt="{{ section.settings.image_alt | escape }}">{%- endif -%}
    <div class="showcase__veil"></div>
    <div class="showcase__in">
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-pink btn-lg">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </section>
{% schema %}
{
  "name": "Showcase",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Your glow, on demand" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Glazed skin isn't a filter." },
    { "type": "text", "id": "body", "label": "Body line", "default": "It's one swipe of pink collagen balm — at your desk, in the car, before a night out." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get the glow" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Model with glazed glowing skin" }
  ],
  "presets": [ { "name": "Showcase" } ]
}
{% endschema %}
