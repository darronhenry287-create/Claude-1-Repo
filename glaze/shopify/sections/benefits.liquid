<section class="section">
    <div class="wrap">
      <div class="sec-head center">
        <span class="kicker" style="justify-content:center">{{ section.settings.kicker }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p class="lede">{{ section.settings.lede }}</p>
      </div>
      <div class="grid benefits__grid">
        {%- if section.settings.card1_title != blank -%}
        <div class="benefit reveal"><div class="benefit__ic">{%- if section.settings.card1_icon != blank -%}<img src="{{ section.settings.card1_icon | image_url: width: 56 }}" alt="" width="{{ section.settings.card1_icon.width }}" height="{{ section.settings.card1_icon.height }}">{%- else -%}<img src="{{ 'heart.svg' | asset_url }}" alt="" width="28" height="28">{%- endif -%}</div><h3>{{ section.settings.card1_title }}</h3><p>{{ section.settings.card1_text }}</p></div>
        {%- endif -%}
        {%- if section.settings.card2_title != blank -%}
        <div class="benefit reveal"><div class="benefit__ic">{%- if section.settings.card2_icon != blank -%}<img src="{{ section.settings.card2_icon | image_url: width: 56 }}" alt="" width="{{ section.settings.card2_icon.width }}" height="{{ section.settings.card2_icon.height }}">{%- else -%}<img src="{{ 'sparkle.svg' | asset_url }}" alt="" width="28" height="28">{%- endif -%}</div><h3>{{ section.settings.card2_title }}</h3><p>{{ section.settings.card2_text }}</p></div>
        {%- endif -%}
        {%- if section.settings.card3_title != blank -%}
        <div class="benefit reveal"><div class="benefit__ic">{%- if section.settings.card3_icon != blank -%}<img src="{{ section.settings.card3_icon | image_url: width: 56 }}" alt="" width="{{ section.settings.card3_icon.width }}" height="{{ section.settings.card3_icon.height }}">{%- else -%}<img src="{{ 'droplet.svg' | asset_url }}" alt="" width="28" height="28">{%- endif -%}</div><h3>{{ section.settings.card3_title }}</h3><p>{{ section.settings.card3_text }}</p></div>
        {%- endif -%}
        {%- if section.settings.card4_title != blank -%}
        <div class="benefit reveal"><div class="benefit__ic">{%- if section.settings.card4_icon != blank -%}<img src="{{ section.settings.card4_icon | image_url: width: 56 }}" alt="" width="{{ section.settings.card4_icon.width }}" height="{{ section.settings.card4_icon.height }}">{%- else -%}<img src="{{ 'clock.svg' | asset_url }}" alt="" width="28" height="28">{%- endif -%}</div><h3>{{ section.settings.card4_title }}</h3><p>{{ section.settings.card4_text }}</p></div>
        {%- endif -%}
      </div>
    </div>
  </section>
{% schema %}
{
  "name": "Benefits",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why you'll love it" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One little stick. A lot of glow." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "A melting balm that sinks in fast and leaves skin plump, dewy and glazed — never greasy." },
    { "type": "paragraph", "content": "Card 1" },
    { "type": "image_picker", "id": "card1_icon", "label": "Card 1 icon" },
    { "type": "text", "id": "card1_title", "label": "Card 1 title", "default": "Plump & bounce" },
    { "type": "text", "id": "card1_text", "label": "Card 1 text", "default": "PDRN + plumping peptides help skin look firmer and more cushioned." },
    { "type": "paragraph", "content": "Card 2" },
    { "type": "image_picker", "id": "card2_icon", "label": "Card 2 icon" },
    { "type": "text", "id": "card2_title", "label": "Card 2 title", "default": "Glazed glow" },
    { "type": "text", "id": "card2_text", "label": "Card 2 text", "default": "That lit-from-within, glass-skin finish in a single swipe." },
    { "type": "paragraph", "content": "Card 3" },
    { "type": "image_picker", "id": "card3_icon", "label": "Card 3 icon" },
    { "type": "text", "id": "card3_title", "label": "Card 3 title", "default": "Soften fine lines" },
    { "type": "text", "id": "card3_text", "label": "Card 3 text", "default": "Smooths the look of smile lines, forehead and crow's feet." },
    { "type": "paragraph", "content": "Card 4" },
    { "type": "image_picker", "id": "card4_icon", "label": "Card 4 icon" },
    { "type": "text", "id": "card4_title", "label": "Card 4 title", "default": "5-second routine" },
    { "type": "text", "id": "card4_text", "label": "Card 4 text", "default": "Swipe over or under makeup, anywhere, anytime — no fuss." }
  ],
  "presets": [ { "name": "Benefits" } ]
}
{% endschema %}
