<section class="section">
    <div class="wrap">
      <div class="sec-head center">
        <span class="kicker" style="justify-content:center">Why you'll love it</span>
        <h2>{{ section.settings.heading }}</h2>
        <p class="lede">A melting balm that sinks in fast and leaves skin plump, dewy and glazed — never greasy.</p>
      </div>
      <div class="grid benefits__grid">
        <div class="benefit reveal"><div class="benefit__ic"><img src="{{ 'heart.svg' | asset_url }}" alt="" width="28" height="28"></div><h3>Plump &amp; bounce</h3><p>PDRN + plumping peptides help skin look firmer and more cushioned.</p></div>
        <div class="benefit reveal"><div class="benefit__ic"><img src="{{ 'sparkle.svg' | asset_url }}" alt="" width="28" height="28"></div><h3>Glazed glow</h3><p>That lit-from-within, glass-skin finish in a single swipe.</p></div>
        <div class="benefit reveal"><div class="benefit__ic"><img src="{{ 'droplet.svg' | asset_url }}" alt="" width="28" height="28"></div><h3>Soften fine lines</h3><p>Smooths the look of smile lines, forehead and crow's feet.</p></div>
        <div class="benefit reveal"><div class="benefit__ic"><img src="{{ 'clock.svg' | asset_url }}" alt="" width="28" height="28"></div><h3>5-second routine</h3><p>Swipe over or under makeup, anywhere, anytime — no fuss.</p></div>
      </div>
    </div>
  </section>
{% schema %}
{
  "name": "Benefits",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "One little stick. A lot of glow." }
  ],
  "presets": [ { "name": "Benefits" } ]
}
{% endschema %}
