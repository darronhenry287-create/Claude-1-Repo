<section class="section proof" style="background:var(--petal);border-block:1px solid var(--line)">
    <div class="wrap">
      <span class="kicker" style="justify-content:center">Glazed-skin status</span>
      <div class="proof__row">
        <div class="pstat reveal"><div class="num">4.9<sup>★</sup></div><div class="lbl">average rating from early reviewers</div></div>
        <div class="pstat reveal"><div class="num">10k+</div><div class="lbl">glow chasers on the GLAZE list</div></div>
        <div class="pstat reveal"><div class="num">1</div><div class="lbl">mess-free stick for six-plus zones</div></div>
      </div>
      <p class="proof__note">Early-reviewer figures shown for illustration — replace with your own once live.</p>
    </div>
  </section>
{% schema %}
{
  "name": "Proof",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kicker", "default": "Glazed-skin status" }
  ],
  "presets": [ { "name": "Proof" } ]
}
{% endschema %}
