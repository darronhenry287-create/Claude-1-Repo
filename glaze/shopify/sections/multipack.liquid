<section class="section">
    <div class="wrap">
      <div class="sec-head center">
        <span class="kicker" style="justify-content:center">{{ section.settings.kicker }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p class="lede">{{ section.settings.lede }}</p>
      </div>
      <div class="grid packs__grid">
        <div class="pack reveal">
          {%- if section.settings.pack1_badge != blank -%}<span class="pack__flag tag">{{ section.settings.pack1_badge }}</span>{%- endif -%}
          <div class="pack__media"><img src="{{ 'hero-product.jpg' | asset_url }}" alt="One balm" width="1080" height="1340" style="border-radius:var(--r);max-height:120px;width:auto"></div>
          <div class="pack__name">{{ section.settings.pack1_name }}</div><div class="pack__sub">{{ section.settings.pack1_sub }}</div>
          <div class="pack__price"><span class="now">{{ section.settings.pack1_price }}</span>{%- if section.settings.pack1_was != blank -%}<span class="was">{{ section.settings.pack1_was }}</span>{%- endif -%}</div>
          <div class="pack__save">{% if section.settings.pack1_save != blank %}{{ section.settings.pack1_save }}{% else %}&nbsp;{% endif %}</div>
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-outline btn-block">Shop single</a>
        </div>
        <div class="pack pack--feature reveal">
          {%- if section.settings.pack2_badge != blank -%}<span class="pack__flag tag">{{ section.settings.pack2_badge }}</span>{%- endif -%}
          <div class="pack__media"><img src="{{ 'pack-trio.jpg' | asset_url }}" alt="Two balms" width="1024" height="1024" style="border-radius:var(--r);max-height:120px;width:auto"></div>
          <div class="pack__name">{{ section.settings.pack2_name }}</div><div class="pack__sub">{{ section.settings.pack2_sub }}</div>
          <div class="pack__price"><span class="now">{{ section.settings.pack2_price }}</span>{%- if section.settings.pack2_was != blank -%}<span class="was">{{ section.settings.pack2_was }}</span>{%- endif -%}</div>
          <div class="pack__save">{% if section.settings.pack2_save != blank %}{{ section.settings.pack2_save }}{% else %}&nbsp;{% endif %}</div>
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-pink btn-block">Shop duo</a>
        </div>
        <div class="pack reveal">
          {%- if section.settings.pack3_badge != blank -%}<span class="pack__flag tag tag-cream">{{ section.settings.pack3_badge }}</span>{%- endif -%}
          <div class="pack__media"><img src="{{ 'pack-trio.jpg' | asset_url }}" alt="Three balms" width="1024" height="1024" style="border-radius:var(--r);max-height:120px;width:auto"></div>
          <div class="pack__name">{{ section.settings.pack3_name }}</div><div class="pack__sub">{{ section.settings.pack3_sub }}</div>
          <div class="pack__price"><span class="now">{{ section.settings.pack3_price }}</span>{%- if section.settings.pack3_was != blank -%}<span class="was">{{ section.settings.pack3_was }}</span>{%- endif -%}</div>
          <div class="pack__save">{% if section.settings.pack3_save != blank %}{{ section.settings.pack3_save }}{% else %}&nbsp;{% endif %}</div>
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-outline btn-block">Shop trio</a>
        </div>
      </div>
    </div>
  </section>
{% schema %}
{
  "name": "Multipack",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Stock up & glow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The more you glaze, the more you save." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Keep one in every bag. Buy three and shipping's on us." },
    { "type": "url", "id": "button_link", "label": "Shop button link (all three packs)" },
    { "type": "paragraph", "content": "Pack 1" },
    { "type": "text", "id": "pack1_name", "label": "Name", "default": "Single" },
    { "type": "text", "id": "pack1_sub", "label": "Sub", "default": "1 balm · try the hype" },
    { "type": "text", "id": "pack1_price", "label": "Price", "default": "$18" },
    { "type": "text", "id": "pack1_was", "label": "Compare / was price" },
    { "type": "text", "id": "pack1_save", "label": "Save text" },
    { "type": "text", "id": "pack1_badge", "label": "Badge" },
    { "type": "paragraph", "content": "Pack 2" },
    { "type": "text", "id": "pack2_name", "label": "Name", "default": "Duo" },
    { "type": "text", "id": "pack2_sub", "label": "Sub", "default": "2 balms · one to share" },
    { "type": "text", "id": "pack2_price", "label": "Price", "default": "$32" },
    { "type": "text", "id": "pack2_was", "label": "Compare / was price", "default": "$36" },
    { "type": "text", "id": "pack2_save", "label": "Save text", "default": "Save $4" },
    { "type": "text", "id": "pack2_badge", "label": "Badge", "default": "Most popular" },
    { "type": "paragraph", "content": "Pack 3" },
    { "type": "text", "id": "pack3_name", "label": "Name", "default": "Trio" },
    { "type": "text", "id": "pack3_sub", "label": "Sub", "default": "3 balms · free shipping" },
    { "type": "text", "id": "pack3_price", "label": "Price", "default": "$45" },
    { "type": "text", "id": "pack3_was", "label": "Compare / was price", "default": "$54" },
    { "type": "text", "id": "pack3_save", "label": "Save text", "default": "Save $9 · 17% off" },
    { "type": "text", "id": "pack3_badge", "label": "Badge", "default": "Best value" }
  ],
  "presets": [ { "name": "Multipack" } ]
}
{% endschema %}
