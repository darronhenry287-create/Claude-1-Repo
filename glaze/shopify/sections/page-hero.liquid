<section class="page-head">
  <div class="wrap wrap--narrow">
    {%- if section.settings.kicker != blank -%}<span class="kicker" style="justify-content:center">{{ section.settings.kicker }}</span>{%- endif -%}
    <h1>{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="lede" style="max-width:560px;margin:1rem auto 0">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (defaults to the page title)" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
