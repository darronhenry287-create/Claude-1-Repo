<section class="section" style="background:var(--paper);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="sec-head center">
        <span class="kicker" style="justify-content:center">{{ section.settings.kicker }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>

      {%- if section.settings.show_stat -%}
      <div class="rstat">
        <div class="rstat__score">{{ section.settings.stat_score }}</div>
        <div class="rstat__meta">
          <div class="stars">{{ section.settings.stat_stars }}</div>
          <div class="rstat__count">{{ section.settings.stat_count }}</div>
        </div>
      </div>
      {%- endif -%}

      <div class="grid voices__grid" id="reviews-grid">
        {%- assign shown = 0 -%}
        {%- for i in (1..8) -%}
          {%- assign qk = 'review' | append: i | append: '_quote' -%}
          {%- assign quote = section.settings[qk] -%}
          {%- if quote != blank -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign sk = 'review' | append: i | append: '_stars' -%}
            {%- assign nk = 'review' | append: i | append: '_name' -%}
            {%- assign mk = 'review' | append: i | append: '_meta' -%}
            {%- assign nameval = section.settings[nk] -%}
            <div class="voice{% if shown <= section.settings.visible_count %} reveal{% else %} is-hidden{% endif %}">
              <div class="stars">{{ section.settings[sk] }}</div>
              <p>{{ quote }}</p>
              <div class="who"><span class="av">{{ nameval | slice: 0 }}</span><div>{{ nameval }}<div class="vmeta">{{ section.settings[mk] }}</div></div></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="center reviews-actions" style="margin-top:2.2rem">
        <button type="button" class="btn btn-outline" data-reviews-more>{{ section.settings.more_label | default: 'See more reviews' }}</button>
        {%- if section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn-soft">{{ section.settings.button_label }}</a>
        {%- elsif pages['reviews'] != blank -%}
          <a href="{{ pages['reviews'].url }}" class="btn btn-soft">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The reviews are in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Glazed and obsessed." },
    { "type": "paragraph", "content": "Rating headline" },
    { "type": "checkbox", "id": "show_stat", "label": "Show rating headline", "default": true },
    { "type": "text", "id": "stat_score", "label": "Average score", "default": "4.9" },
    { "type": "text", "id": "stat_stars", "label": "Stars", "default": "★★★★★" },
    { "type": "text", "id": "stat_count", "label": "Count line", "default": "Based on 12,000+ verified reviews" },
    { "type": "paragraph", "content": "How many cards to show before \"See more\"" },
    { "type": "range", "id": "visible_count", "label": "Reviews shown before expanding", "min": 1, "max": 8, "step": 1, "default": 3 },
    { "type": "text", "id": "more_label", "label": "Expand button label", "default": "See more reviews" },
    { "type": "text", "id": "button_label", "label": "Secondary button label", "default": "Read all reviews" },
    { "type": "url", "id": "button_link", "label": "Secondary button link (defaults to your reviews page)" },
    { "type": "paragraph", "content": "Review 1" },
    { "type": "text", "id": "review1_stars", "label": "Stars", "default": "★★★★★" },
    { "type": "textarea", "id": "review1_quote", "label": "Quote", "default": "\"My under-eyes look so plump and bright. I keep one in my bag and swipe it all day.\"" },
