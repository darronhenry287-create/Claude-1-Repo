<section class="zones section">
    <div class="wrap">
      <div class="zones__grid">
        <div class="zones__visual has-photo reveal">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 1080 }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" alt="{{ section.settings.image_alt | escape }}">
          {%- else -%}
            <img src="{{ 'model-apply.jpg' | asset_url }}" width="1080" height="1350" alt="{{ section.settings.image_alt | escape }}">
          {%- endif -%}
        </div>
        <div>
          <div class="sec-head" style="margin-bottom:1.6rem">
            <span class="kicker">{{ section.settings.kicker }}</span>
            <h2>{{ section.settings.heading }}</h2>
            <p class="lede">{{ section.settings.lede }}</p>
          </div>
          <div class="zonelist">
            {%- assign zone_items = section.settings.zones | split: ',' -%}
            {%- for zone in zone_items -%}
              {%- assign zone_label = zone | strip -%}
              {%- if zone_label != blank -%}
                <div class="zone"><span class="dot"></span>{{ zone_label }}</div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </section>
{% schema %}
{
  "name": "Zones",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "One balm, head to toe" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Swipe it anywhere it's dry, dull or creasing." },
    { "type": "textarea", "id": "lede", "label": "Lede paragraph", "default": "The mess-free stick means you can glaze on the go — desk, gym bag, plane, purse." },
    { "type": "textarea", "id": "zones", "label": "Zone tags (comma-separated)", "default": "Under-eyes, Smile lines, Forehead, Neck, Lips, Dry patches" },
    { "type": "image_picker", "id": "image", "label": "Model image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Applying the Pink Collagen Glow Balm" }
  ],
  "presets": [ { "name": "Zones" } ]
}
{% endschema %}
