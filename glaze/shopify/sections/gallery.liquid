<section class="section" style="background:var(--paper);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="sec-head center">
        <span class="kicker" style="justify-content:center">#glazedskin</span>
        <h2>{{ section.settings.heading }}</h2>
        <p class="lede">Real glow, real swipes. Tag <strong>#glazedskin</strong> to be featured.</p>
      </div>
      <div class="gallery__grid">
        <div class="gtile reveal"><img src="{{ 'model-apply.jpg' | asset_url }}" alt="Applying the balm" width="1080" height="1350"></div>
        <div class="gtile reveal"><img src="{{ 'texture.jpg' | asset_url }}" alt="Balm texture" width="1024" height="1024"></div>
        <div class="gtile reveal"><img src="{{ 'model-glow.jpg' | asset_url }}" alt="Glazed glowing skin" width="1080" height="1350"></div>
        <div class="gtile reveal"><img src="{{ 'flatlay.jpg' | asset_url }}" alt="The balm and its ingredients" width="1024" height="1024"></div>
        <div class="gtile reveal"><img src="{{ 'model-hero.jpg' | asset_url }}" alt="Glazed skin with the balm" width="1080" height="1350"></div>
        <div class="gtile reveal"><img src="{{ 'hero-product.jpg' | asset_url }}" alt="The glow balm" width="1080" height="1350"></div>
      </div>
    </div>
  </section>
{% schema %}
{
  "name": "Gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seen in the wild." }
  ],
  "presets": [ { "name": "Gallery" } ]
}
{% endschema %}
