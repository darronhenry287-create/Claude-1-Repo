<section class="section" style="background:var(--paper);border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="sec-head center">
        <span class="kicker" style="justify-content:center">{{ section.settings.kicker }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p class="lede">{{ section.settings.lede }}</p>
      </div>
      <div class="gallery__grid">
        <div class="gtile reveal">{%- if section.settings.image1 != blank -%}<img src="{{ section.settings.image1 | image_url: width: 1080 }}" alt="Applying the balm" width="{{ section.settings.image1.width }}" height="{{ section.settings.image1.height }}">{%- else -%}<img src="{{ 'model-apply.jpg' | asset_url }}" alt="Applying the balm" width="1080" height="1350">{%- endif -%}</div>
        <div class="gtile reveal">{%- if section.settings.image2 != blank -%}<img src="{{ section.settings.image2 | image_url: width: 1024 }}" alt="Balm texture" width="{{ section.settings.image2.width }}" height="{{ section.settings.image2.height }}">{%- else -%}<img src="{{ 'texture.jpg' | asset_url }}" alt="Balm texture" width="1024" height="1024">{%- endif -%}</div>
        <div class="gtile reveal">{%- if section.settings.image3 != blank -%}<img src="{{ section.settings.image3 | image_url: width: 1080 }}" alt="Glazed glowing skin" width="{{ section.settings.image3.width }}" height="{{ section.settings.image3.height }}">{%- else -%}<img src="{{ 'model-glow.jpg' | asset_url }}" alt="Glazed glowing skin" width="1080" height="1350">{%- endif -%}</div>
        <div class="gtile reveal">{%- if section.settings.image4 != blank -%}<img src="{{ section.settings.image4 | image_url: width: 1024 }}" alt="The balm and its ingredients" width="{{ section.settings.image4.width }}" height="{{ section.settings.image4.height }}">{%- else -%}<img src="{{ 'flatlay.jpg' | asset_url }}" alt="The balm and its ingredients" width="1024" height="1024">{%- endif -%}</div>
        <div class="gtile reveal">{%- if section.settings.image5 != blank -%}<img src="{{ section.settings.image5 | image_url: width: 1080 }}" alt="Glazed skin with the balm" width="{{ section.settings.image5.width }}" height="{{ section.settings.image5.height }}">{%- else -%}<img src="{{ 'model-hero.jpg' | asset_url }}" alt="Glazed skin with the balm" width="1080" height="1350">{%- endif -%}</div>
        <div class="gtile reveal">{%- if section.settings.image6 != blank -%}<img src="{{ section.settings.image6 | image_url: width: 1080 }}" alt="The glow balm" width="{{ section.settings.image6.width }}" height="{{ section.settings.image6.height }}">{%- else -%}<img src="{{ 'hero-product.jpg' | asset_url }}" alt="The glow balm" width="1080" height="1350">{%- endif -%}</div>
      </div>
    </div>
  </section>
{% schema %}
{
  "name": "Gallery",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "#glazedskin" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seen in the wild." },
    { "type": "inline_richtext", "id": "lede", "label": "Lede", "default": "Real glow, real swipes. Tag <strong>#glazedskin</strong> to be featured." },
    { "type": "image_picker", "id": "image1", "label": "Image 1" },
    { "type": "image_picker", "id": "image2", "label": "Image 2" },
    { "type": "image_picker", "id": "image3", "label": "Image 3" },
    { "type": "image_picker", "id": "image4", "label": "Image 4" },
    { "type": "image_picker", "id": "image5", "label": "Image 5" },
    { "type": "image_picker", "id": "image6", "label": "Image 6" }
  ],
  "presets": [ { "name": "Gallery" } ]
}
{% endschema %}
