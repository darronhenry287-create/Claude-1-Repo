<section class="section" data-product>
  <div class="wrap">
    <div class="pdp">
      <!-- gallery: main image + thumbnails (uploaded product images if present, else bundled marketing slides) -->
      <div class="pgallery" id="pgallery-main">
        {%- if product.images.size > 0 -%}
          {%- assign first_img = product.images.first -%}
          <div class="pgallery__main has-photo" id="pg-main">
            <img src="{{ first_img | image_url: width: 1080 }}" width="{{ first_img.width }}" height="{{ first_img.height }}" alt="{{ first_img.alt | escape | default: product.title }}">
            <button type="button" class="pcarousel__nav prev" data-pgal="prev" aria-label="Previous image">‹</button>
            <button type="button" class="pcarousel__nav next" data-pgal="next" aria-label="Next image">›</button>
          </div>
          <div class="pgallery__thumbs">
            {%- for image in product.images -%}
              <button type="button" class="pthumb has-photo{% if forloop.first %} active{% endif %}" data-full="{{ image | image_url: width: 1080 }}"><img src="{{ image | image_url: width: 220 }}" width="220" height="220" alt="{{ image.alt | escape | default: product.title }}"></button>
            {%- endfor -%}
          </div>
        {%- else -%}
          {%- assign slides = 'slide-1.jpg,slide-2.jpg,slide-3.jpg,slide-4.jpg,slide-5.jpg,slide-6.jpg' | split: ',' -%}
          <div class="pgallery__main has-photo" id="pg-main">
            <img src="{{ slides.first | asset_url }}" width="1080" height="1350" alt="{{ product.title | default: 'Pink Collagen Glow Balm' }}">
            <button type="button" class="pcarousel__nav prev" data-pgal="prev" aria-label="Previous image">‹</button>
            <button type="button" class="pcarousel__nav next" data-pgal="next" aria-label="Next image">›</button>
          </div>
          <div class="pgallery__thumbs">
            {%- for s in slides -%}
              <button type="button" class="pthumb has-photo{% if forloop.first %} active{% endif %}" data-full="{{ s | asset_url }}"><img src="{{ s | asset_url }}" width="220" height="220" alt="{{ product.title | default: 'Pink Collagen Glow Balm' }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- info -->
      <div class="pinfo">
        <span class="pinfo__type">{{ section.settings.eyebrow }}</span>
        <h1>{{ product.title | default: 'Pink Collagen Glow Balm' }}</h1>
        <div class="pinfo__rate"><span class="stars">★★★★★</span> {{ section.settings.rating_text }} {%- if section.settings.reviews_url != blank %} · <a href="{{ section.settings.reviews_url }}">read reviews</a>{% endif -%}</div>
        {%- assign cv = product.selected_or_first_available_variant -%}
        <div class="pinfo__price">
          <span class="now" id="p-now">{% if cv.price > 0 %}{{ cv.price | money }}{% else %}{{ section.settings.price_fallback | default: 'From $18' }}{% endif %}</span>
          <span class="was" id="p-was" {% unless cv.compare_at_price > cv.price %}style="display:none"{% endunless %}>{{ cv.compare_at_price | money }}</span>
          {%- if product.variants.size > 1 -%}<span class="save">Buy more, save more</span>{%- endif -%}
        </div>
        <div class="pinfo__desc">{% if product.description != blank %}{{ product.description }}{% else %}{{ section.settings.fallback_desc }}{% endif %}</div>

        <div class="pinfo__divider"></div>

        {% form 'product', product, id: 'product-form' %}
          <select name="id" id="variant-id" hidden>
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}" {% if variant == cv %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}</option>
            {%- endfor -%}
          </select>

          <input type="hidden" name="quantity" id="pack-qty" value="1">

          {%- if section.settings.show_packs -%}
          <label class="opt-label">{{ section.settings.packs_heading | default: 'Choose your pack' }}</label>
          <div class="tiers">
            {%- assign first_v = product.selected_or_first_available_variant -%}
            {%- for i in (1..3) -%}
              {%- assign idx = i | minus: 1 -%}
              {%- assign v = product.variants[idx] -%}
              {%- case i -%}
                {%- when 1 -%}{%- assign pname = section.settings.pack1_name -%}{%- assign pnote = section.settings.pack1_note -%}{%- assign pbadge = section.settings.pack1_badge -%}{%- assign pdemo = section.settings.pack1_price -%}{%- assign pdemo_cmp = section.settings.pack1_compare -%}
                {%- when 2 -%}{%- assign pname = section.settings.pack2_name -%}{%- assign pnote = section.settings.pack2_note -%}{%- assign pbadge = section.settings.pack2_badge -%}{%- assign pdemo = section.settings.pack2_price -%}{%- assign pdemo_cmp = section.settings.pack2_compare -%}
                {%- when 3 -%}{%- assign pname = section.settings.pack3_name -%}{%- assign pnote = section.settings.pack3_note -%}{%- assign pbadge = section.settings.pack3_badge -%}{%- assign pdemo = section.settings.pack3_price -%}{%- assign pdemo_cmp = section.settings.pack3_compare -%}
              {%- endcase -%}
              {%- if v != blank and v.price > 0 -%}
                {%- assign add_id = v.id -%}{%- assign add_qty = 1 -%}{%- assign now_c = v.price -%}{%- assign cmp_c = v.compare_at_price -%}
              {%- elsif first_v.price > 0 -%}
                {%- assign add_id = first_v.id -%}{%- assign add_qty = i -%}{%- assign now_c = first_v.price | times: i -%}{%- assign cmp_c = 0 -%}
              {%- else -%}
                {%- assign add_id = first_v.id -%}{%- assign add_qty = i -%}{%- assign now_c = pdemo | times: 100 -%}{%- if pdemo_cmp != blank -%}{%- assign cmp_c = pdemo_cmp | times: 100 -%}{%- else -%}{%- assign cmp_c = 0 -%}{%- endif -%}
              {%- endif -%}
              <label class="tier{% if i == 1 %} active{% endif %}" data-variant-id="{{ add_id }}" data-cart-qty="{{ add_qty }}" data-total="{{ now_c | divided_by: 100.0 }}" data-compare="{{ cmp_c | divided_by: 100.0 }}" data-label="{{ pname | escape }}">
                {%- if pbadge != blank -%}<span class="tier__flag">{{ pbadge }}</span>{%- endif -%}
                <span class="tier__radio"></span>
                <div class="tier__body"><div class="tier__title">{{ pname }}</div>{%- if pnote != blank -%}<div class="tier__sub">{{ pnote }}</div>{%- endif -%}</div>
                <div class="tier__price"><span class="p">{{ now_c | money }}</span>{%- if cmp_c > now_c -%} <span class="tier__was">{{ cmp_c | money }}</span>{%- endif -%}</div>
              </label>
            {%- endfor -%}
          </div>
          {%- endif -%}

          <div id="buy-anchor">
            <button type="submit" class="btn btn-pink btn-block btn-lg" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>
          </div>
        {% endform %}

        <div class="usps">
          {%- if section.settings.usp1 != blank -%}<div class="usp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.7"/><circle cx="17.5" cy="18" r="1.7"/></svg><span>{{ section.settings.usp1 }}</span></div>{%- endif -%}
          {%- if section.settings.usp2 != blank -%}<div class="usp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6z"/><path d="m9 12 2 2 4-4"/></svg><span>{{ section.settings.usp2 }}</span></div>{%- endif -%}
          {%- if section.settings.usp3 != blank -%}<div class="usp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21C7 17 4 13.5 4 9.5A3.5 3.5 0 0 1 12 7a3.5 3.5 0 0 1 8 2.5c0 4-3 7.5-8 11.5Z"/></svg><span>{{ section.settings.usp3 }}</span></div>{%- endif -%}
          {%- if section.settings.usp4 != blank -%}<div class="usp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg><span>{{ section.settings.usp4 }}</span></div>{%- endif -%}
        </div>

        {%- if section.settings.show_trust -%}
        <div class="ptrust">
          {%- if section.settings.trust1 != blank -%}<div><span class="ck"><img src="{{ 'dna.svg' | asset_url }}" alt="" width="16" height="16"></span>{{ section.settings.trust1 }}</div>{%- endif -%}
          {%- if section.settings.trust2 != blank -%}<div><span class="ck"><img src="{{ 'sparkle.svg' | asset_url }}" alt="" width="16" height="16"></span>{{ section.settings.trust2 }}</div>{%- endif -%}
          {%- if section.settings.trust3 != blank -%}<div><span class="ck"><img src="{{ 'heart.svg' | asset_url }}" alt="" width="16" height="16"></span>{{ section.settings.trust3 }}</div>{%- endif -%}
        </div>
        {%- endif -%}

        <div class="acc">
          <div class="acc__item open"><button class="acc__head" type="button">How to use <span class="pm"></span></button><div class="acc__body"><div class="acc__body-inner">{{ section.settings.how_to_use }}</div></div></div>
          <div class="acc__item"><button class="acc__head" type="button">Key ingredients <span class="pm"></span></button><div class="acc__body"><div class="acc__body-inner">{{ section.settings.ingredients }}</div></div></div>
          <div class="acc__item"><button class="acc__head" type="button">About the balm <span class="pm"></span></button><div class="acc__body"><div class="acc__body-inner">{{ section.settings.about }}</div></div></div>
          <div class="acc__item"><button class="acc__head" type="button">Shipping &amp; returns <span class="pm"></span></button><div class="acc__body"><div class="acc__body-inner">{{ section.settings.shipping }}</div></div></div>
        </div>
      </div>
    </div>
  </div>

  {%- if section.settings.show_sticky -%}
  <div class="stickybar" id="stickybar">
    <div class="stickybar__in">
      <div class="stickybar__info">
        <div class="stickybar__thumb">{% if product.featured_media %}<img src="{{ product.featured_media | image_url: width: 96 }}" width="46" height="46" alt="">{% else %}<img src="{{ 'hero-product.jpg' | asset_url }}" width="46" height="46" alt="">{% endif %}</div>
        <div><div class="stickybar__name">{{ product.title | default: 'Pink Collagen Glow Balm' }}</div><div class="stickybar__price" id="sticky-price">{% if cv.price > 0 %}{{ cv.price | money }}{% else %}{{ section.settings.price_fallback | default: 'From $18' }}{% endif %}</div></div>
      </div>
      <button type="submit" form="product-form" class="btn btn-pink">Add to bag</button>
    </div>
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PDRN pink collagen · multi-use glow stick" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "4.9 · 124 reviews" },
    { "type": "url", "id": "reviews_url", "label": "Reviews link" },
    { "type": "text", "id": "badge", "label": "Image badge", "default": "★ 4.9 · bestseller" },
    { "type": "text", "id": "price_fallback", "label": "Price placeholder (shown only before a real price is set)", "default": "From $18" },
    { "type": "richtext", "id": "fallback_desc", "label": "Description (used if the product has none)", "default": "<p>The melting balm that glazes skin in one swipe. Salmon-DNA PDRN, collagen and plumping peptides help skin look instantly plumper, smoother and dewier — anywhere it's dry or creasing. Mess-free stick, glides on over or under makeup.</p>" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust row", "default": true },
    { "type": "checkbox", "id": "show_sticky", "label": "Show sticky add-to-cart bar", "default": true },
    { "type": "paragraph", "content": "Buy-box USP row (icons are fixed; leave a field blank to hide it)" },
    { "type": "text", "id": "usp1", "label": "USP 1", "default": "Free shipping over $35" },
    { "type": "text", "id": "usp2", "label": "USP 2", "default": "30-day glow guarantee" },
    { "type": "text", "id": "usp3", "label": "USP 3", "default": "Cruelty-free formula" },
    { "type": "text", "id": "usp4", "label": "USP 4", "default": "Ships in 24 hours" },
    { "type": "paragraph", "content": "Trust row (under the buy box)" },
    { "type": "text", "id": "trust1", "label": "Trust 1", "default": "PDRN powered" },
    { "type": "text", "id": "trust2", "label": "Trust 2", "default": "Glides on, no mess" },
    { "type": "text", "id": "trust3", "label": "Trust 3", "default": "Cruelty-free" },
    { "type": "paragraph", "content": "PACK SELECTOR — always visible. The 3 packs below map to your product's 1st / 2nd / 3rd variant. Add a 'Pack' option with 3 variants (1 / 2 / 3 balms) + real prices and they take over automatically. With one variant, packs add quantities 1/2/3. The prices here only show until real variant prices exist. See SETUP.md." },
    { "type": "checkbox", "id": "show_packs", "label": "Show pack selector", "default": true },
    { "type": "text", "id": "packs_heading", "label": "Pack selector heading", "default": "Choose your pack" },
    { "type": "text", "id": "pack1_name", "label": "Pack 1 · name", "default": "Single balm" },
    { "type": "text", "id": "pack1_note", "label": "Pack 1 · subtitle", "default": "Try the glow" },
    { "type": "text", "id": "pack1_price", "label": "Pack 1 · demo price (number)", "default": "18" },
    { "type": "text", "id": "pack1_compare", "label": "Pack 1 · demo compare-at (number, optional)" },
    { "type": "text", "id": "pack1_badge", "label": "Pack 1 · badge (optional)" },
    { "type": "text", "id": "pack2_name", "label": "Pack 2 · name", "default": "Duo — save $4" },
    { "type": "text", "id": "pack2_note", "label": "Pack 2 · subtitle", "default": "Keep one, share one" },
    { "type": "text", "id": "pack2_price", "label": "Pack 2 · demo price (number)", "default": "32" },
    { "type": "text", "id": "pack2_compare", "label": "Pack 2 · demo compare-at (number, optional)", "default": "36" },
    { "type": "text", "id": "pack2_badge", "label": "Pack 2 · badge (optional)", "default": "Most popular" },
    { "type": "text", "id": "pack3_name", "label": "Pack 3 · name", "default": "Trio — save $9" },
    { "type": "text", "id": "pack3_note", "label": "Pack 3 · subtitle", "default": "17% off + free shipping" },
    { "type": "text", "id": "pack3_price", "label": "Pack 3 · demo price (number)", "default": "45" },
    { "type": "text", "id": "pack3_compare", "label": "Pack 3 · demo compare-at (number, optional)", "default": "54" },
    { "type": "text", "id": "pack3_badge", "label": "Pack 3 · badge (optional)", "default": "Best value" },
    { "type": "richtext", "id": "how_to_use", "label": "How to use", "default": "<p>Swipe directly onto clean skin or over makeup, anywhere you want a plump, dewy boost — under-eyes, smile lines, forehead, neck and lips. Pat in with a fingertip. Use morning and night, as often as you like.</p>" },
    { "type": "richtext", "id": "ingredients", "label": "Key ingredients", "default": "<p>Salmon PDRN (Polydeoxyribonucleotide), Hydrolyzed Collagen, Hyaluronic Acid, plumping peptides, Caffeine, Vitamin E (Tocopherol). Always patch test. Full INCI on the carton.</p>" },
    { "type": "richtext", "id": "about", "label": "About the balm", "default": "<p>A K-beauty-inspired pink collagen balm in a hygienic, mess-free twist-up stick. Designed to plump, hydrate and glaze on contact — for that glass-skin glow anywhere, anytime.</p>" },
    { "type": "richtext", "id": "shipping", "label": "Shipping & returns", "default": "<p>Free shipping over $35 (and on every trio), flat $4.95 below. Ships in 1–2 business days. Not glowing? Return within 30 days for a full refund.</p>" }
  ]
}
{% endschema %}
